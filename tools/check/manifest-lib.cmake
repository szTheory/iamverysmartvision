# Fixture-manifest helpers shared by manifests.cmake and files.cmake (include() after lib.cmake).
# Inputs used: FILELIST (path list file). Manifest files are selected from FILELIST only.
# Effective-redistributable rule (docs/fixture-manifest.md): yes only when redistributable is yes,
# licence_evidence is present, rights_review.status is not unreviewed and every derived_from input
# is itself effective yes. Anything else, including a missing or misspelled field, is no.
cmake_minimum_required(VERSION 3.25)

string(REPEAT "[0-9a-f]" 64 _hex64)
set(MANIFEST_HEX64_RE "^${_hex64}$")

# FILELIST text kept as "\n<path>\n<path>\n" so membership is an exact-line test.
function(manifest_filelist_read)
  file(READ "${FILELIST}" txt)
  set_property(GLOBAL PROPERTY MANIFEST_FILELIST_TEXT "\n${txt}\n")
endfunction()

function(manifest_in_filelist out path)
  get_property(txt GLOBAL PROPERTY MANIFEST_FILELIST_TEXT)
  string(FIND "${txt}" "\n${path}\n" pos)
  if(pos EQUAL -1)
    set(${out} FALSE PARENT_SCOPE)
  else()
    set(${out} TRUE PARENT_SCOPE)
  endif()
endfunction()

# Paths in an array of objects: doc, then the array key path, e.g. outputs or recipe sources.
function(manifest_array_paths out doc)
  set(res "")
  json_type(t "${doc}" ${ARGN})
  if(t STREQUAL "ARRAY")
    string(JSON n LENGTH "${doc}" ${ARGN})
    if(n GREATER 0)
      math(EXPR last "${n} - 1")
      foreach(i RANGE 0 ${last})
        json_type(pt "${doc}" ${ARGN} ${i} path)
        if(pt STREQUAL "STRING")
          string(JSON p GET "${doc}" ${ARGN} ${i} path)
          list(APPEND res "${p}")
        endif()
      endforeach()
    endif()
  endif()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# Output paths recorded in a manifest document.
function(manifest_listed_outputs out doc)
  manifest_array_paths(res "${doc}" outputs)
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# Every file path a manifest accounts for: outputs, notices and recipe sources.
function(manifest_listed_files out doc)
  manifest_array_paths(a "${doc}" outputs)
  manifest_array_paths(b "${doc}" notices)
  manifest_array_paths(c "${doc}" recipe sources)
  set(${out} "${a};${b};${c}" PARENT_SCOPE)
endfunction()

# Local part of the rule: the three conditions on the manifest itself (derived_from not applied).
function(manifest_local_yes out doc)
  set(res no)
  json_type(rt "${doc}" redistributable)
  json_type(et "${doc}" licence_evidence)
  json_type(vt "${doc}" rights_review)
  if(rt STREQUAL "STRING" AND et STREQUAL "OBJECT" AND vt STREQUAL "OBJECT")
    string(JSON red GET "${doc}" redistributable)
    json_type(ut "${doc}" licence_evidence url)
    json_type(ht "${doc}" licence_evidence text_sha256)
    json_type(st "${doc}" rights_review status)
    if(red STREQUAL "yes" AND ut STREQUAL "STRING" AND ht STREQUAL "STRING" AND st STREQUAL "STRING")
      string(JSON url GET "${doc}" licence_evidence url)
      string(JSON hsh GET "${doc}" licence_evidence text_sha256)
      string(JSON status GET "${doc}" rights_review status)
      string(STRIP "${url}" url)
      if(NOT url STREQUAL "" AND hsh MATCHES "${MANIFEST_HEX64_RE}"
         AND (status STREQUAL "owner-confirmed" OR status STREQUAL "author-attested"))
        set(res yes)
      endif()
    endif()
  endif()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# derived_from ids of a document as a list (string members only).
function(manifest_derived out doc)
  set(res "")
  json_type(t "${doc}" derived_from)
  if(t STREQUAL "ARRAY")
    string(JSON n LENGTH "${doc}" derived_from)
    if(n GREATER 0)
      math(EXPR last "${n} - 1")
      foreach(i RANGE 0 ${last})
        json_type(et "${doc}" derived_from ${i})
        if(et STREQUAL "STRING")
          string(JSON d GET "${doc}" derived_from ${i})
          list(APPEND res "${d}")
        endif()
      endforeach()
    endif()
  endif()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# Record one manifest in the registry used to resolve derived_from.
function(manifest_register id doc)
  manifest_local_yes(loc "${doc}")
  manifest_derived(deps "${doc}")
  if("${deps}" STREQUAL "")
    set(depstr "-")
  else()
    string(REPLACE ";" "|" depstr "${deps}")
  endif()
  set_property(GLOBAL APPEND PROPERTY MANIFEST_REG_IDS "${id}")
  set_property(GLOBAL APPEND PROPERTY MANIFEST_REG_LOCAL "${loc}")
  set_property(GLOBAL APPEND PROPERTY MANIFEST_REG_DEPS "${depstr}")
endfunction()

# Effective value of a registered id; unknown ids and cycles are no (least fixpoint, fail closed).
function(_manifest_eff_id out id visited)
  if("${id}" IN_LIST visited)
    set(${out} no PARENT_SCOPE)
    return()
  endif()
  get_property(ids GLOBAL PROPERTY MANIFEST_REG_IDS)
  get_property(locs GLOBAL PROPERTY MANIFEST_REG_LOCAL)
  get_property(deps GLOBAL PROPERTY MANIFEST_REG_DEPS)
  list(FIND ids "${id}" idx)
  if(idx EQUAL -1)
    set(${out} no PARENT_SCOPE)
    return()
  endif()
  list(GET locs ${idx} loc)
  if(NOT loc STREQUAL "yes")
    set(${out} no PARENT_SCOPE)
    return()
  endif()
  list(GET deps ${idx} depstr)
  if(NOT depstr STREQUAL "-")
    string(REPLACE "|" ";" dl "${depstr}")
    foreach(d IN LISTS dl)
      _manifest_eff_id(r "${d}" "${visited};${id}")
      if(NOT r STREQUAL "yes")
        set(${out} no PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endif()
  set(${out} yes PARENT_SCOPE)
endfunction()

# Effective redistributable of a document: local rule, then every derived_from input.
function(manifest_effective out doc)
  manifest_local_yes(loc "${doc}")
  if(NOT loc STREQUAL "yes")
    set(${out} no PARENT_SCOPE)
    return()
  endif()
  manifest_derived(deps "${doc}")
  foreach(d IN LISTS deps)
    _manifest_eff_id(r "${d}" "")
    if(NOT r STREQUAL "yes")
      set(${out} no PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} yes PARENT_SCOPE)
endfunction()

# Select manifests from FILELIST (sorted), parse and register them. Results in global properties:
#   MANIFEST_N, MANIFEST_PATH_<i>, MANIFEST_DOC_<i> (i = 0..N-1, only parseable object documents).
# report TRUE emits manifest-parse findings for unparseable manifests.
function(manifest_load_all report)
  manifest_filelist_read()
  file(READ "${FILELIST}" txt)
  gate_lines(lines "${txt}")
  set(sel "")
  foreach(l IN LISTS lines)
    gate_unprotect(l "${l}")
    if(l MATCHES "^fixtures/[A-Za-z0-9._-]+/manifest[.]json$")
      list(APPEND sel "${l}")
    endif()
  endforeach()
  list(SORT sel)
  set(n 0)
  foreach(p IN LISTS sel)
    if(NOT EXISTS "${ROOT}/${p}")
      continue()
    endif()
    file(READ "${ROOT}/${p}" doc)
    string(JSON t ERROR_VARIABLE e TYPE "${doc}")
    if(NOT "${e}" STREQUAL "NOTFOUND" OR NOT t STREQUAL "OBJECT")
      if(report)
        gate_fail(manifest-parse "${p}")
      endif()
      continue()
    endif()
    string(REGEX MATCH "^fixtures/([A-Za-z0-9._-]+)/" _m "${p}")
    set(dirname "${CMAKE_MATCH_1}")
    set(id "${dirname}")
    json_type(it "${doc}" id)
    if(it STREQUAL "STRING")
      string(JSON jid GET "${doc}" id)
      if(jid MATCHES "^[A-Za-z0-9._-]+$")
        set(id "${jid}")
      endif()
    endif()
    manifest_register("${id}" "${doc}")
    set_property(GLOBAL PROPERTY "MANIFEST_PATH_${n}" "${p}")
    set_property(GLOBAL PROPERTY "MANIFEST_DOC_${n}" "${doc}")
    math(EXPR n "${n} + 1")
  endforeach()
  set_property(GLOBAL PROPERTY MANIFEST_N "${n}")
endfunction()
