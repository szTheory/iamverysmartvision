# SPDX-License-Identifier: MIT
# Checker of the hand-assembled listings (D-26, D-29; plan 04-15). With no assembler (D-25) this
# step and the pack.words-* suite are what turn a transcription error into a gate failure.
# Inputs (passed with -D): ROOT (tree under test), FILELIST (repo-relative paths, one per line),
# CHECK_DIR (the real tools/check). Dump mode: -DDUMP=<listing id> (ROOT only; CHECK_DIR and
# FILELIST are not needed) checks that one listing with the rules below and, when it is clean,
# prints one `ADDR WORD` line per word (4 upper-case hex digits each) on stdout and nothing else,
# for the independent comparison with `ivs_pack --dump-words` (tests/pack-tap.sh).
# Listing grammar (docs/diagnostics.md): `#` lines are comments; before the first word line,
# `# <key>: <value>` lines with a key of HEADER_KEYS are the header; blank lines are ignored;
# every other line is a word line `ADDR HEX4 BITS... ROW ASM...`.
# Rules and tokens (every finding is `-- FAIL <token>: <path> <detail>`; at most 20 per token are
# listed, then one line with the exact total):
#   a word line that is not ADDR HEX4 BITS ROW ASM, bit groups not exactly 10 binary digits,
#   or bits whose value differs from HEX4 (vectors.cmake program_word rule)  listing-bits-mismatch
#   the ROW of an instruction line is not a most specific (leaf) row of its decle in
#   data/cp1610/opcode-families.json (vectors.cmake decle_leaves rule; a label check only)
#                                                                            listing-row-mismatch
#   an instruction of `words` w is not followed by exactly w - 1 `-` operand lines, or a `-` line
#   follows no instruction (an SDBD prefix is not modelled: such a listing fails closed)
#                                                                            listing-operand-count
#   a word above 03FF, a non-contiguous address, an address outside the declared window, or no
#   word line                                                                listing-range
#   header: id, kind and window present once (boot-stub also profile and contract), id and kind
#   equal to the inventory line, kind boot-stub or cart, window AAAA-BBBB with AAAA <= BBBB, a
#   header key after the first word line, a repeated key                     listing-header
#   data/expected/listings.ids (`<id> <kind> <path>` lines) is the exact set: a listed path that
#   does not exist, a malformed or duplicate line, or a FILELIST `*.listing.txt` outside
#   tools/check/controls/ that is not listed                                 listing-unlisted
# Anti-HLE guards of kind boot-stub (D-29):
#   an address outside 1000-101F, or more than 16 non-zero words             bootstub-size
#   an instruction row not in data/expected/bootstub-rows.ids, or an id of that file that is
#   not a row of the family table                                            bootstub-row
#   no non-zero word at the reset.r7 or interrupt.iab_value address of the profile named by the
#   header (data/profiles/<profile>.json, whose id must equal it)            bootstub-vector
# Emulator project names in listing text are the denylist step's scope (listings are not
# excluded from it). Stats: listings=<n> listing-words=<n>.
cmake_minimum_required(VERSION 3.25)

set(DUMP_MODE FALSE)
if(DEFINED DUMP AND NOT "${DUMP}" STREQUAL "")
  set(DUMP_MODE TRUE)
  set(required_inputs ROOT)
else()
  set(required_inputs ROOT FILELIST CHECK_DIR)
endif()
foreach(required IN LISTS required_inputs)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "listing.cmake is missing ${required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")

set(CAP 20)
set(LTOKENS listing-bits-mismatch listing-row-mismatch listing-operand-count listing-range
  listing-header listing-unlisted bootstub-size bootstub-row bootstub-vector)
set(HEADER_KEYS id kind contract profile window label entry stack)
set(KINDS boot-stub cart)
set(H4 "[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]")

# Finding with a per-token cap; totals are reported at the end (copied from vectors.cmake).
function(lfail token detail)
  gate_incr("tok_${token}")
  gate_count(n "tok_${token}")
  if(n LESS_EQUAL ${CAP})
    gate_fail(${token} "${detail}")
  endif()
endfunction()

# String member value, or empty when absent or not a string (vectors.cmake vget).
function(vget out obj)
  set(v "")
  json_type(t "${obj}" ${ARGN})
  if(t STREQUAL "STRING")
    string(JSON v GET "${obj}" ${ARGN})
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Family rows: mask, value, eq relations, refines target (the vectors.cmake row loader), plus
# the `words` column for the operand-count rule.
set(R_IDS "")
set(R_MASKS "")
set(R_VALS "")
set(R_EQS "")
set(R_REFS "")
set(R_WORDS "")
if(EXISTS "${ROOT}/data/cp1610/opcode-families.json")
  file(READ "${ROOT}/data/cp1610/opcode-families.json" fdoc)
  string(JSON nr ERROR_VARIABLE e LENGTH "${fdoc}" rows)
  if("${e}" STREQUAL "NOTFOUND" AND nr GREATER 0)
    math(EXPR last "${nr} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON rec GET "${fdoc}" rows ${i})
      vget(rid "${rec}" id)
      vget(pattern "${rec}" pattern)
      if(NOT "${pattern}" MATCHES "^[01.][01.][01.][01.][01.][01.][01.][01.][01.][01.]$")
        continue()
      endif()
      set(mask 0)
      set(val 0)
      string(REGEX REPLACE "(.)" "\\1;" chars "${pattern}")
      foreach(c IN LISTS chars)
        if("${c}" STREQUAL "")
          continue()
        elseif("${c}" STREQUAL ".")
          math(EXPR mask "${mask} * 2")
          math(EXPR val "${val} * 2")
        elseif("${c}" STREQUAL "1")
          math(EXPR mask "${mask} * 2 + 1")
          math(EXPR val "${val} * 2 + 1")
        else()
          math(EXPR mask "${mask} * 2 + 1")
          math(EXPR val "${val} * 2")
        endif()
      endforeach()
      set(eqs "")
      json_type(et "${rec}" eq)
      if(et STREQUAL "ARRAY")
        string(JSON en LENGTH "${rec}" eq)
        if(en GREATER 0)
          math(EXPR elast "${en} - 1")
          foreach(k RANGE 0 ${elast})
            string(JSON eqv GET "${rec}" eq ${k})
            if("${eqv}" MATCHES "^([0-9]+):([0-9]+)=([0-9]+):([0-9]+)$")
              list(APPEND eqs "${CMAKE_MATCH_1},${CMAKE_MATCH_2},${CMAKE_MATCH_3},${CMAKE_MATCH_4}")
            endif()
          endforeach()
        endif()
      endif()
      if("${eqs}" STREQUAL "")
        set(eqs "-")
      else()
        string(REPLACE ";" "|" eqs "${eqs}")
      endif()
      vget(refines "${rec}" refines)
      if(refines STREQUAL "")
        set(refines "-")
      endif()
      set(words 0)
      json_type(wt "${rec}" words)
      if(wt STREQUAL "NUMBER")
        string(JSON words GET "${rec}" words)
      endif()
      list(APPEND R_IDS "${rid}")
      list(APPEND R_MASKS "${mask}")
      list(APPEND R_VALS "${val}")
      list(APPEND R_EQS "${eqs}")
      list(APPEND R_REFS "${refines}")
      list(APPEND R_WORDS "${words}")
    endforeach()
  endif()
endif()

# Rows that may label decle d: the leaves among the matching rows (a match that another match
# refines is not a leaf). Copied from vectors.cmake decle_leaves (one rule set).
function(decle_leaves out d)
  set(matches "")
  foreach(rid m v eqs IN ZIP_LISTS R_IDS R_MASKS R_VALS R_EQS)
    math(EXPR x "${d} & ${m}")
    if(NOT x EQUAL v)
      continue()
    endif()
    if(NOT "${eqs}" STREQUAL "-")
      set(holds TRUE)
      string(REPLACE "|" ";" eqlist "${eqs}")
      foreach(e IN LISTS eqlist)
        string(REPLACE "," ";" f "${e}")
        list(GET f 0 h1)
        list(GET f 1 l1)
        list(GET f 3 l2)
        math(EXPR w "(1 << (${h1} - ${l1} + 1)) - 1")
        math(EXPR a "(${d} >> ${l1}) & ${w}")
        math(EXPR b "(${d} >> ${l2}) & ${w}")
        if(NOT a EQUAL b)
          set(holds FALSE)
        endif()
      endforeach()
      if(NOT holds)
        continue()
      endif()
    endif()
    list(APPEND matches "${rid}")
  endforeach()
  set(targets "")
  foreach(rid ref IN ZIP_LISTS R_IDS R_REFS)
    if("${rid}" IN_LIST matches AND NOT ref STREQUAL "-")
      list(APPEND targets "${ref}")
    endif()
  endforeach()
  set(leaves "")
  foreach(rid IN LISTS matches)
    if(NOT "${rid}" IN_LIST targets)
      list(APPEND leaves "${rid}")
    endif()
  endforeach()
  set(${out} "${leaves}" PARENT_SCOPE)
endfunction()

# Program string -> numeric hex word and numeric binary part; ok FALSE when malformed.
# Copied from vectors.cmake program_word (one rule set).
function(program_word out_ok out_hex out_bin s)
  set(${out_ok} FALSE PARENT_SCOPE)
  if(NOT "${s}" MATCHES "^([0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ([01][01 ]*[01])$")
    return()
  endif()
  string(TOUPPER "${CMAKE_MATCH_1}" hx)
  string(REPLACE " " "" bits "${CMAKE_MATCH_2}")
  math(EXPR hv "0x${hx}")
  set(bv 0)
  string(LENGTH "${bits}" nb)
  math(EXPR nb1 "${nb} - 1")
  foreach(i RANGE 0 ${nb1})
    string(SUBSTRING "${bits}" ${i} 1 bc)
    math(EXPR bv "${bv} * 2 + ${bc}")
  endforeach()
  set(${out_ok} TRUE PARENT_SCOPE)
  set(${out_hex} "${hv}" PARENT_SCOPE)
  set(${out_bin} "${bv}" PARENT_SCOPE)
endfunction()

# `$XXXX` profile value -> number; empty when malformed.
function(dollar_hex out s)
  set(v "")
  if("${s}" MATCHES "^[$](${H4})$")
    math(EXPR v "0x${CMAKE_MATCH_1}")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Plain id list: first token of each non-# line, file order (vectors.cmake first_tokens).
function(first_tokens out relpath)
  set(ids "")
  if(EXISTS "${ROOT}/${relpath}")
    file(STRINGS "${ROOT}/${relpath}" lines)
    foreach(l IN LISTS lines)
      string(STRIP "${l}" l)
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      string(REGEX REPLACE "[ \t].*$" "" l "${l}")
      list(APPEND ids "${l}")
    endforeach()
  endif()
  set(${out} "${ids}" PARENT_SCOPE)
endfunction()

# ---- Inventories ---------------------------------------------------------------------------
set(INV "data/expected/listings.ids")
set(L_IDS "")
set(L_KINDS "")
set(L_PATHS "")
if(NOT EXISTS "${ROOT}/${INV}")
  lfail(listing-unlisted "${INV} is missing")
else()
  file(STRINGS "${ROOT}/${INV}" lines)
  foreach(l IN LISTS lines)
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    if(NOT l MATCHES "^([a-z0-9][a-z0-9-]*)[ \t]+([a-z-]+)[ \t]+([A-Za-z0-9._/-]+[.]listing[.]txt)$")
      lfail(listing-unlisted "${INV} malformed line: ${l}")
      continue()
    endif()
    set(lid "${CMAKE_MATCH_1}")
    set(lkind "${CMAKE_MATCH_2}")
    set(lpath "${CMAKE_MATCH_3}")
    if(lid IN_LIST L_IDS OR lpath IN_LIST L_PATHS)
      lfail(listing-unlisted "${INV} duplicate id or path: ${l}")
      continue()
    endif()
    list(APPEND L_IDS "${lid}")
    list(APPEND L_KINDS "${lkind}")
    list(APPEND L_PATHS "${lpath}")
  endforeach()
endif()

first_tokens(STUB_ROWS "data/expected/bootstub-rows.ids")
if(NOT EXISTS "${ROOT}/data/expected/bootstub-rows.ids" OR "${STUB_ROWS}" STREQUAL "")
  lfail(bootstub-row "data/expected/bootstub-rows.ids is missing or empty")
endif()
foreach(r IN LISTS STUB_ROWS)
  if(NOT r IN_LIST R_IDS)
    lfail(bootstub-row "data/expected/bootstub-rows.ids ${r} is not a row of data/cp1610/opcode-families.json")
  endif()
endforeach()

if(NOT DUMP_MODE)
  file(STRINGS "${FILELIST}" all_paths)
  foreach(p IN LISTS all_paths)
    if(p MATCHES "[.]listing[.]txt$" AND NOT p MATCHES "^tools/check/controls/" AND NOT p IN_LIST L_PATHS)
      lfail(listing-unlisted "${p} is not in ${INV}")
    endif()
  endforeach()
endif()

# ---- One listing ---------------------------------------------------------------------------
# Checks listing lid of kind lkind at lpath; returns its word count in out_n and its
# `ADDR WORD` dump text (as parsed here, upper-case hex) in out_dump.
function(check_listing out_n out_dump lid lkind lpath)
  set(${out_n} 0 PARENT_SCOPE)
  set(${out_dump} "" PARENT_SCOPE)
  set(f "${ROOT}/${lpath}")
  if(NOT EXISTS "${f}")
    lfail(listing-unlisted "${lpath} (listed as ${lid}) does not exist")
    return()
  endif()
  file(READ "${f}" txt)
  gate_lines(lines "${txt}")
  set(hdr_keys "")
  set(hdr_id "")
  set(hdr_kind "")
  set(hdr_window "")
  set(hdr_profile "")
  set(lineno 0)
  set(nwords 0)
  set(nonzero 0)
  set(next_addr -1)
  set(pending 0)
  set(pending_row "")
  set(addrs "")
  set(atexts "")
  set(words "")
  set(dump "")
  set(win_lo -1)
  set(win_hi -1)
  foreach(l IN LISTS lines)
    math(EXPR lineno "${lineno} + 1")
    gate_unprotect(l "${l}")
    string(REPLACE "\t" " " l "${l}")
    set(at "${lpath}:${lineno}")
    if(l MATCHES "^#")
      if(l MATCHES "^# ([a-z]+): (.*)$")
        set(key "${CMAKE_MATCH_1}")
        set(val "${CMAKE_MATCH_2}")
        if(key IN_LIST HEADER_KEYS)
          if(nwords GREATER 0)
            lfail(listing-header "${at} header key ${key} after the first word line")
          elseif(key IN_LIST hdr_keys)
            lfail(listing-header "${at} repeated header key ${key}")
          else()
            list(APPEND hdr_keys "${key}")
            set(hdr_${key} "${val}")
            if(key STREQUAL "window")
              if(val MATCHES "^(${H4})-(${H4})$")
                math(EXPR win_lo "0x${CMAKE_MATCH_1}")
                math(EXPR win_hi "0x${CMAKE_MATCH_2}")
                if(win_lo GREATER win_hi)
                  lfail(listing-header "${at} window ${val} is empty")
                  set(win_lo -1)
                endif()
              else()
                lfail(listing-header "${at} window ${val} is not AAAA-BBBB")
              endif()
            endif()
          endif()
        endif()
      endif()
      continue()
    endif()
    string(STRIP "${l}" s)
    if(s STREQUAL "")
      continue()
    endif()
    # Word line: ADDR HEX4 BITS ROW ASM.
    if(NOT l MATCHES "^(${H4}) +(${H4}) +([01][01 ]*[01]|[01]) +([^ ]+) +([^ ].*)$")
      lfail(listing-bits-mismatch "${at} is not ADDR HEX4 BITS ROW ASM")
      continue()
    endif()
    set(a_txt "${CMAKE_MATCH_1}")
    set(h_txt "${CMAKE_MATCH_2}")
    set(b_txt "${CMAKE_MATCH_3}")
    set(row "${CMAKE_MATCH_4}")
    string(TOUPPER "${a_txt}" a_up)
    string(TOUPPER "${h_txt}" h_up)
    math(EXPR addr "0x${a_txt}")
    string(REPLACE " " "" b_digits "${b_txt}")
    string(LENGTH "${b_digits}" nbits)
    program_word(ok hv bv "${h_txt} ${b_txt}")
    if(NOT nbits EQUAL 10)
      lfail(listing-bits-mismatch "${at} bit groups hold ${nbits} digits, not 10")
    elseif(NOT ok OR NOT hv EQUAL bv)
      lfail(listing-bits-mismatch "${at} bits ${b_txt} do not equal ${h_up}")
    endif()
    math(EXPR hv "0x${h_txt}")
    if(hv GREATER 1023)
      lfail(listing-range "${at} word ${h_up} is above 03FF")
    endif()
    if(nwords GREATER 0 AND NOT addr EQUAL next_addr)
      lfail(listing-range "${at} address ${a_up} is not contiguous")
    endif()
    if(win_lo LESS 0)
      lfail(listing-range "${at} word line without a valid window header")
    elseif(addr LESS win_lo OR addr GREATER win_hi)
      lfail(listing-range "${at} address ${a_up} is outside the window ${hdr_window}")
    endif()
    math(EXPR next_addr "${addr} + 1")
    math(EXPR nwords "${nwords} + 1")
    if(NOT hv EQUAL 0)
      math(EXPR nonzero "${nonzero} + 1")
    endif()
    list(APPEND addrs "${addr}")
    list(APPEND atexts "${a_up}")
    list(APPEND words "${hv}")
    string(APPEND dump "${a_up} ${h_up}\n")
    # Row label and operand count.
    if(row STREQUAL "-")
      if(pending GREATER 0)
        math(EXPR pending "${pending} - 1")
      else()
        lfail(listing-operand-count "${at} operand line follows no instruction that needs one")
      endif()
      continue()
    endif()
    if(pending GREATER 0)
      lfail(listing-operand-count "${at} ${pending_row} lacks ${pending} operand line(s)")
    endif()
    math(EXPR d "${hv} & 1023")
    decle_leaves(leaves ${d})
    if(NOT row IN_LIST leaves)
      string(REPLACE ";" "," leaves_txt "${leaves}")
      lfail(listing-row-mismatch "${at} ${row} (decle ${h_up} is labelled by: ${leaves_txt})")
    endif()
    set(w 1)
    list(FIND R_IDS "${row}" ri)
    if(ri GREATER -1)
      list(GET R_WORDS ${ri} w)
    endif()
    math(EXPR pending "${w} - 1")
    set(pending_row "${row}")
    if(lkind STREQUAL "boot-stub" AND NOT row IN_LIST STUB_ROWS)
      lfail(bootstub-row "${at} row ${row} is not in data/expected/bootstub-rows.ids")
    endif()
  endforeach()
  if(pending GREATER 0)
    lfail(listing-operand-count "${lpath} ${pending_row} lacks ${pending} operand line(s) at the end")
  endif()
  if(nwords EQUAL 0)
    lfail(listing-range "${lpath} has no word line")
  endif()

  # Header.
  set(need id kind window)
  if(lkind STREQUAL "boot-stub")
    list(APPEND need profile contract)
  endif()
  foreach(k IN LISTS need)
    if(NOT k IN_LIST hdr_keys)
      lfail(listing-header "${lpath} lacks header key ${k}")
    endif()
  endforeach()
  if("id" IN_LIST hdr_keys AND NOT hdr_id STREQUAL lid)
    lfail(listing-header "${lpath} id ${hdr_id} is not the inventory id ${lid}")
  endif()
  if("kind" IN_LIST hdr_keys AND NOT hdr_kind STREQUAL lkind)
    lfail(listing-header "${lpath} kind ${hdr_kind} is not the inventory kind ${lkind}")
  endif()
  if(NOT lkind IN_LIST KINDS)
    lfail(listing-header "${lpath} kind ${lkind} is not one of: boot-stub cart")
  endif()

  # Anti-HLE guards (D-29).
  if(lkind STREQUAL "boot-stub")
    foreach(a ax IN ZIP_LISTS addrs atexts)
      if(a LESS 4096 OR a GREATER 4127)
        lfail(bootstub-size "${lpath} address ${ax} is outside 1000-101F")
      endif()
    endforeach()
    if(nonzero GREATER 16)
      lfail(bootstub-size "${lpath} has ${nonzero} non-zero words, more than 16")
    endif()
    set(pf "data/profiles/${hdr_profile}.json")
    if(hdr_profile STREQUAL "" OR NOT hdr_profile MATCHES "^[a-z0-9-]+$" OR NOT EXISTS "${ROOT}/${pf}")
      lfail(bootstub-vector "${lpath} profile '${hdr_profile}' has no file data/profiles/<profile>.json")
    else()
      file(READ "${ROOT}/${pf}" pdoc)
      vget(pid "${pdoc}" id)
      if(NOT pid STREQUAL hdr_profile)
        lfail(bootstub-vector "${lpath} ${pf} has id '${pid}', not ${hdr_profile}")
      endif()
      foreach(field reset.r7 interrupt.iab_value)
        vget(pv "${pdoc}" fields ${field} value)
        dollar_hex(va "${pv}")
        if(va STREQUAL "")
          lfail(bootstub-vector "${lpath} ${pf} field ${field} value '${pv}' is not \$XXXX")
          continue()
        endif()
        list(FIND addrs "${va}" k)
        set(wv 0)
        if(k GREATER -1)
          list(GET words ${k} wv)
        endif()
        if(wv EQUAL 0)
          lfail(bootstub-vector "${lpath} no non-zero word at ${pv} (${field})")
        endif()
      endforeach()
    endif()
  endif()
  set(${out_n} ${nwords} PARENT_SCOPE)
  set(${out_dump} "${dump}" PARENT_SCOPE)
endfunction()

# ---- Run -----------------------------------------------------------------------------------
if(DUMP_MODE)
  list(FIND L_IDS "${DUMP}" k)
  if(k LESS 0)
    message(FATAL_ERROR "listing.cmake: ${DUMP} is not an id of ${INV}")
  endif()
  list(GET L_KINDS ${k} lkind)
  list(GET L_PATHS ${k} lpath)
  check_listing(n dump "${DUMP}" "${lkind}" "${lpath}")
  get_property(failures GLOBAL PROPERTY GATE_FAILURES)
  if(NOT "${failures}" STREQUAL "")
    message(FATAL_ERROR "listing.cmake: ${DUMP} has findings; no dump")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo_append "${dump}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "listing.cmake: dump write failed")
  endif()
  return()
endif()

set(n_listings 0)
set(n_words 0)
foreach(lid lkind lpath IN ZIP_LISTS L_IDS L_KINDS L_PATHS)
  check_listing(n dump "${lid}" "${lkind}" "${lpath}")
  math(EXPR n_listings "${n_listings} + 1")
  math(EXPR n_words "${n_words} + ${n}")
endforeach()

# Exact totals for capped tokens.
foreach(tok IN LISTS LTOKENS)
  gate_count(n "tok_${tok}")
  if(n GREATER ${CAP})
    gate_fail(${tok} "${n} findings in total, first ${CAP} listed")
  endif()
endforeach()

gate_stat(listings ${n_listings})
gate_stat(listing-words ${n_words})
gate_finish(listing)
