# SPDX-License-Identifier: MIT
# Structural checker of the CP-1610 vector data (D-14, A-07, A-13): every
# data/cp1610/vectors/*.json named by FILELIST, the vector inventories and the expected skips.
# Inputs (passed with -D): ROOT (tree under test), FILELIST (repo-relative paths, one per line),
# CHECK_DIR (the real tools/check; the emulator-name lists are read from here, never from ROOT).
# Rules and tokens (every finding is `-- FAIL <token>: <file> <id> <detail>`; at most 20 per
# token are listed, then one line with the exact total):
#   file set = stems of data/expected/cp1610-vector-files.ids     vector-file-unlisted, vector-file-missing
#   top and per-vector keys, including init and expect keys      vector-missing-key, vector-unknown-key
#   JSON types, schema_version 1, group = stem, blank derivation,
#   id shape, program string shape, kind name, parse failure     vector-format
#   kind source: tier source-expectation, no policy;
#   kind policy: policy in cp1610-policies.ids, no tier          vector-kind-fields
#   cite ASCII and carrying `pdf N`                              vector-bad-cite
#   `source` and every `sources` entry an id of data/sources.json vector-unknown-source
#   row in cp1610-rows.ids or a unit name                        vector-unknown-row
#   first decle (second after an SDBD word $0001) is encoded by the declared row and the row is
#   the most specific one (a leaf under `refines`, or a leaf linked by also_encodes); a label
#   check only, never an expected value; skipped for unit rows   vector-row-mismatch
#   program binary part (spaces removed) equals its hex word     vector-program-mismatch
#   text fields free of the emulator names in CHECK_DIR lists    vector-emulator-name
#   ids unique, equal to cp1610-vectors.ids and to the first
#   tokens of tests/<suite>.ids (`# suite=` line)                vector-duplicate-id, vector-id-missing,
#                                                                vector-id-extra, vector-suite-drift
#   cp1610-skips.ids lines name a vector and a discrepancy id    vector-skip-unknown
# Stats: vectors=<n> source=<n> policy=<n>. Coverage derivation is plan 02-05's, the review
# record kind plan 02-16's.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT FILELIST CHECK_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "vectors.cmake is missing ${required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")

set(CAP 20)
set(UNIT_ROWS UNIT-RESET UNIT-INT UNIT-BUS UNIT-HALT UNIT-NOTRESET)
set(ID_RE "^cpu[.][A-Z0-9@-]+[.][A-Za-z0-9-]+$")
set(VTOKENS vector-file-unlisted vector-file-missing vector-missing-key vector-unknown-key
  vector-format vector-kind-fields vector-bad-cite vector-unknown-source vector-unknown-row
  vector-row-mismatch vector-program-mismatch vector-emulator-name vector-duplicate-id
  vector-id-missing vector-id-extra vector-suite-drift vector-skip-unknown)

# Finding with a per-token cap; totals are reported at the end.
function(vfail token detail)
  gate_incr("tok_${token}")
  gate_count(n "tok_${token}")
  if(n LESS_EQUAL ${CAP})
    gate_fail(${token} "${detail}")
  endif()
endfunction()

# Plain id list from a text file: first token of each non-# line, file order (may repeat).
function(first_tokens out relpath)
  set(ids "")
  if(EXISTS "${ROOT}/${relpath}")
    file(STRINGS "${ROOT}/${relpath}" lines)
    foreach(l IN LISTS lines)
      string(STRIP "${l}" l)
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      string(REGEX REPLACE "[ \t].*$" "" l "${l}")
      list(APPEND ids "${l}")
    endforeach()
  endif()
  set(${out} "${ids}" PARENT_SCOPE)
endfunction()

# Presence, type and allowed keys of one object. ARGN: "key:TYPE|TYPE" (required) or
# "?key:TYPE|TYPE" (optional); every other member is an unknown key.
function(vshape lbl prefix obj)
  set(allowed "")
  foreach(spec IN LISTS ARGN)
    set(optional FALSE)
    if(spec MATCHES "^[?]")
      set(optional TRUE)
      string(SUBSTRING "${spec}" 1 -1 spec)
    endif()
    string(FIND "${spec}" ":" c)
    string(SUBSTRING "${spec}" 0 ${c} key)
    math(EXPR c1 "${c} + 1")
    string(SUBSTRING "${spec}" ${c1} -1 types)
    string(REPLACE "|" ";" types "${types}")
    list(APPEND allowed "${key}")
    json_type(t "${obj}" "${key}")
    if(t STREQUAL "MISSING")
      if(NOT optional)
        vfail(vector-missing-key "${lbl} ${prefix}${key}")
      endif()
    elseif(NOT "${t}" IN_LIST types)
      vfail(vector-format "${lbl} ${prefix}${key} (type ${t})")
    endif()
  endforeach()
  json_members(mem "${obj}")
  foreach(m IN LISTS mem)
    if(NOT "${m}" IN_LIST allowed)
      vfail(vector-unknown-key "${lbl} ${prefix}${m}")
    endif()
  endforeach()
endfunction()

# Every element of an array member must be a string.
function(vstrings lbl key obj)
  json_type(t "${obj}" ${key})
  if(NOT t STREQUAL "ARRAY")
    return()
  endif()
  string(JSON n LENGTH "${obj}" ${key})
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE 0 ${last})
      json_type(et "${obj}" ${key} ${i})
      if(NOT et STREQUAL "STRING")
        vfail(vector-format "${lbl} ${key}[${i}] (type ${et})")
      endif()
    endforeach()
  endif()
endfunction()

# String member value, or empty when absent or not a string.
function(vget out obj)
  set(v "")
  json_type(t "${obj}" ${ARGN})
  if(t STREQUAL "STRING")
    string(JSON v GET "${obj}" ${ARGN})
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Emulator names: union of the shared cite-only list and the vector list, from CHECK_DIR only.
set(NAMES "")
foreach(list_file denylist-cite.txt vector-emulator-names.txt)
  if(NOT EXISTS "${CHECK_DIR}/${list_file}")
    message(FATAL_ERROR "vectors.cmake: ${CHECK_DIR}/${list_file} is missing")
  endif()
  file(STRINGS "${CHECK_DIR}/${list_file}" lines)
  foreach(l IN LISTS lines)
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    string(TOLOWER "${l}" l)
    list(APPEND NAMES "${l}")
  endforeach()
endforeach()
list(REMOVE_DUPLICATES NAMES)

function(vnames lbl field text)
  string(TOLOWER "${text}" low)
  foreach(name IN LISTS NAMES)
    string(FIND "${low}" "${name}" at)
    if(at GREATER -1)
      vfail(vector-emulator-name "${lbl} ${field}")
      return()
    endif()
  endforeach()
endfunction()

# Reference sets.
first_tokens(ROW_IDS "data/expected/cp1610-rows.ids")
first_tokens(POLICY_IDS "data/expected/cp1610-policies.ids")
first_tokens(DISC_IDS "data/expected/discrepancies.ids")
first_tokens(FILE_STEMS "data/expected/cp1610-vector-files.ids")
set(SOURCE_IDS "")
if(EXISTS "${ROOT}/data/sources.json")
  file(READ "${ROOT}/data/sources.json" sdoc)
  string(JSON ns ERROR_VARIABLE e LENGTH "${sdoc}" sources)
  if("${e}" STREQUAL "NOTFOUND" AND ns GREATER 0)
    math(EXPR last "${ns} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON sid ERROR_VARIABLE e GET "${sdoc}" sources ${i} id)
      if("${e}" STREQUAL "NOTFOUND")
        list(APPEND SOURCE_IDS "${sid}")
      endif()
    endforeach()
  endif()
endif()

# Family rows: mask, value, eq relations, refines target, also_encodes (as in coverage.cmake).
set(R_IDS "")
set(R_MASKS "")
set(R_VALS "")
set(R_EQS "")
set(R_REFS "")
set(R_ALSO "")
if(EXISTS "${ROOT}/data/cp1610/opcode-families.json")
  file(READ "${ROOT}/data/cp1610/opcode-families.json" fdoc)
  string(JSON nr ERROR_VARIABLE e LENGTH "${fdoc}" rows)
  if("${e}" STREQUAL "NOTFOUND" AND nr GREATER 0)
    math(EXPR last "${nr} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON rec GET "${fdoc}" rows ${i})
      vget(rid "${rec}" id)
      vget(pattern "${rec}" pattern)
      if(NOT "${pattern}" MATCHES "^[01.][01.][01.][01.][01.][01.][01.][01.][01.][01.]$")
        continue()
      endif()
      set(mask 0)
      set(val 0)
      string(REGEX REPLACE "(.)" "\\1;" chars "${pattern}")
      foreach(c IN LISTS chars)
        if("${c}" STREQUAL "")
          continue()
        elseif("${c}" STREQUAL ".")
          math(EXPR mask "${mask} * 2")
          math(EXPR val "${val} * 2")
        elseif("${c}" STREQUAL "1")
          math(EXPR mask "${mask} * 2 + 1")
          math(EXPR val "${val} * 2 + 1")
        else()
          math(EXPR mask "${mask} * 2 + 1")
          math(EXPR val "${val} * 2")
        endif()
      endforeach()
      set(eqs "")
      json_type(et "${rec}" eq)
      if(et STREQUAL "ARRAY")
        string(JSON en LENGTH "${rec}" eq)
        if(en GREATER 0)
          math(EXPR elast "${en} - 1")
          foreach(k RANGE 0 ${elast})
            string(JSON eqv GET "${rec}" eq ${k})
            if("${eqv}" MATCHES "^([0-9]+):([0-9]+)=([0-9]+):([0-9]+)$")
              list(APPEND eqs "${CMAKE_MATCH_1},${CMAKE_MATCH_2},${CMAKE_MATCH_3},${CMAKE_MATCH_4}")
            endif()
          endforeach()
        endif()
      endif()
      if("${eqs}" STREQUAL "")
        set(eqs "-")
      else()
        string(REPLACE ";" "|" eqs "${eqs}")
      endif()
      vget(refines "${rec}" refines)
      if(refines STREQUAL "")
        set(refines "-")
      endif()
      set(also "|")
      json_type(at "${rec}" also_encodes)
      if(at STREQUAL "ARRAY")
        string(JSON an LENGTH "${rec}" also_encodes)
        if(an GREATER 0)
          math(EXPR alast "${an} - 1")
          foreach(k RANGE 0 ${alast})
            string(JSON a GET "${rec}" also_encodes ${k})
            set(also "${also}${a}|")
          endforeach()
        endif()
      endif()
      list(APPEND R_IDS "${rid}")
      list(APPEND R_MASKS "${mask}")
      list(APPEND R_VALS "${val}")
      list(APPEND R_EQS "${eqs}")
      list(APPEND R_REFS "${refines}")
      list(APPEND R_ALSO "${also}")
    endforeach()
  endif()
endif()

# Rows that may label decle d: the leaves among the matching rows (a match that another match
# refines is not a leaf). Several leaves only occur as an also_encodes coincidence, checked by
# the cp1610 step; each of them may label the decle.
function(decle_leaves out d)
  set(matches "")
  foreach(rid m v eqs IN ZIP_LISTS R_IDS R_MASKS R_VALS R_EQS)
    math(EXPR x "${d} & ${m}")
    if(NOT x EQUAL v)
      continue()
    endif()
    if(NOT "${eqs}" STREQUAL "-")
      set(holds TRUE)
      string(REPLACE "|" ";" eqlist "${eqs}")
      foreach(e IN LISTS eqlist)
        string(REPLACE "," ";" f "${e}")
        list(GET f 0 h1)
        list(GET f 1 l1)
        list(GET f 3 l2)
        math(EXPR w "(1 << (${h1} - ${l1} + 1)) - 1")
        math(EXPR a "(${d} >> ${l1}) & ${w}")
        math(EXPR b "(${d} >> ${l2}) & ${w}")
        if(NOT a EQUAL b)
          set(holds FALSE)
        endif()
      endforeach()
      if(NOT holds)
        continue()
      endif()
    endif()
    list(APPEND matches "${rid}")
  endforeach()
  set(targets "")
  foreach(rid ref IN ZIP_LISTS R_IDS R_REFS)
    if("${rid}" IN_LIST matches AND NOT ref STREQUAL "-")
      list(APPEND targets "${ref}")
    endif()
  endforeach()
  set(leaves "")
  foreach(rid IN LISTS matches)
    if(NOT "${rid}" IN_LIST targets)
      list(APPEND leaves "${rid}")
    endif()
  endforeach()
  set(${out} "${leaves}" PARENT_SCOPE)
endfunction()

# Program string -> numeric hex word and numeric binary part; ok FALSE when malformed.
function(program_word out_ok out_hex out_bin s)
  set(${out_ok} FALSE PARENT_SCOPE)
  if(NOT "${s}" MATCHES "^([0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ([01][01 ]*[01])$")
    return()
  endif()
  string(TOUPPER "${CMAKE_MATCH_1}" hx)
  string(REPLACE " " "" bits "${CMAKE_MATCH_2}")
  math(EXPR hv "0x${hx}")
  set(bv 0)
  string(LENGTH "${bits}" nb)
  math(EXPR nb1 "${nb} - 1")
  foreach(i RANGE 0 ${nb1})
    string(SUBSTRING "${bits}" ${i} 1 bc)
    math(EXPR bv "${bv} * 2 + ${bc}")
  endforeach()
  set(${out_ok} TRUE PARENT_SCOPE)
  set(${out_hex} "${hv}" PARENT_SCOPE)
  set(${out_bin} "${bv}" PARENT_SCOPE)
endfunction()

# ---- Files ---------------------------------------------------------------------------------
file(STRINGS "${FILELIST}" all_paths)
set(STEMS "")
foreach(p IN LISTS all_paths)
  if(p MATCHES "^data/cp1610/vectors/([^/]+)[.]json$")
    list(APPEND STEMS "${CMAKE_MATCH_1}")
  endif()
endforeach()
list(SORT STEMS)
list(REMOVE_DUPLICATES STEMS)
foreach(stem IN LISTS STEMS)
  if(NOT stem IN_LIST FILE_STEMS)
    vfail(vector-file-unlisted "data/cp1610/vectors/${stem}.json")
  endif()
endforeach()
foreach(stem IN LISTS FILE_STEMS)
  if(NOT stem IN_LIST STEMS)
    vfail(vector-file-missing "data/cp1610/vectors/${stem}.json")
  endif()
endforeach()

# ---- Vectors -------------------------------------------------------------------------------
set(VEC_IDS "")
set(n_vec 0)
set(n_source 0)
set(n_policy 0)
set(STATE_SPECS "?intff:NUMBER" "?dbd:NUMBER" "?prev_interruptible:NUMBER" "?run_state:STRING"
  "?halt_pending:NUMBER" "?busak:NUMBER" "?fault_reason:STRING" "?status:OBJECT" "?mem:ARRAY")
foreach(stem IN LISTS STEMS)
  set(rel "data/cp1610/vectors/${stem}.json")
  file(READ "${ROOT}/${rel}" doc)
  string(JSON dt ERROR_VARIABLE e TYPE "${doc}")
  if(NOT "${e}" STREQUAL "NOTFOUND" OR NOT dt STREQUAL "OBJECT")
    vfail(vector-format "${rel} - (does not parse as a JSON object)")
    continue()
  endif()
  vshape("${rel} -" "" "${doc}" "schema_version:NUMBER" "source:STRING" "group:STRING" "note:STRING"
    "vectors:ARRAY")
  json_type(t "${doc}" schema_version)
  if(t STREQUAL "NUMBER")
    string(JSON sv GET "${doc}" schema_version)
    if(NOT sv STREQUAL "1")
      vfail(vector-format "${rel} - schema_version ${sv}")
    endif()
  endif()
  vget(group "${doc}" group)
  json_type(t "${doc}" group)
  if(t STREQUAL "STRING" AND NOT group STREQUAL stem)
    vfail(vector-format "${rel} - group is not the file stem")
  endif()
  vget(src "${doc}" source)
  json_type(t "${doc}" source)
  if(t STREQUAL "STRING" AND NOT src IN_LIST SOURCE_IDS)
    vfail(vector-unknown-source "${rel} - source")
  endif()
  vget(note "${doc}" note)
  vnames("${rel} -" note "${note}")
  json_type(t "${doc}" vectors)
  if(NOT t STREQUAL "ARRAY")
    continue()
  endif()
  string(JSON nv LENGTH "${doc}" vectors)
  if(nv EQUAL 0)
    continue()
  endif()
  math(EXPR last "${nv} - 1")
  foreach(i RANGE 0 ${last})
    string(JSON vec GET "${doc}" vectors ${i})
    math(EXPR n_vec "${n_vec} + 1")
    json_type(vt "${vec}")
    if(NOT vt STREQUAL "OBJECT")
      vfail(vector-format "${rel} #${i} (not an object)")
      continue()
    endif()
    vget(id "${vec}" id)
    if(id STREQUAL "")
      set(id "#${i}")
    endif()
    set(lbl "${rel} ${id}")
    vshape("${lbl}" "" "${vec}" "id:STRING" "row:STRING" "kind:STRING" "cite:STRING"
      "sources:ARRAY" "asm:STRING" "program:ARRAY" "derivation:STRING" "init:OBJECT" "expect:OBJECT"
      "covers:ARRAY" "?tier:STRING" "?policy:STRING" "?bus:ARRAY" "?bus_basis:STRING" "?steps:NUMBER"
      "?step_lines:ARRAY" "?config:OBJECT" "?ebci:ARRAY" "?waits:ARRAY" "?iab:STRING"
      "?reset:BOOLEAN" "?program_at:STRING")
    vstrings("${lbl}" sources "${vec}")
    vstrings("${lbl}" program "${vec}")
    vstrings("${lbl}" covers "${vec}")
    json_type(t "${vec}" init)
    if(t STREQUAL "OBJECT")
      string(JSON init GET "${vec}" init)
      vshape("${lbl}" "init." "${init}" "?r:ARRAY" "?lines:OBJECT" ${STATE_SPECS})
    endif()
    json_type(t "${vec}" expect)
    if(t STREQUAL "OBJECT")
      string(JSON exp GET "${vec}" expect)
      vshape("${lbl}" "expect." "${exp}" "?r:OBJECT" "?cycles:NUMBER" "?units:ARRAY" "?events:ARRAY"
        ${STATE_SPECS})
    endif()

    # id shape and uniqueness
    if(NOT id MATCHES "${ID_RE}")
      vfail(vector-format "${lbl} id shape")
    endif()
    if(id IN_LIST VEC_IDS)
      vfail(vector-duplicate-id "${lbl}")
    endif()
    list(APPEND VEC_IDS "${id}")

    # derivation
    vget(derivation "${vec}" derivation)
    string(STRIP "${derivation}" dstrip)
    json_type(t "${vec}" derivation)
    if(t STREQUAL "STRING" AND dstrip STREQUAL "")
      vfail(vector-format "${lbl} derivation is blank")
    endif()

    # kind fields
    vget(kind "${vec}" kind)
    json_type(tier_t "${vec}" tier)
    json_type(pol_t "${vec}" policy)
    vget(tier "${vec}" tier)
    vget(policy "${vec}" policy)
    if(kind STREQUAL "source")
      math(EXPR n_source "${n_source} + 1")
      if(NOT tier STREQUAL "source-expectation")
        vfail(vector-kind-fields "${lbl} kind source needs tier source-expectation")
      endif()
      if(NOT pol_t STREQUAL "MISSING")
        vfail(vector-kind-fields "${lbl} kind source carries policy")
      endif()
    elseif(kind STREQUAL "policy")
      math(EXPR n_policy "${n_policy} + 1")
      if(NOT policy IN_LIST POLICY_IDS)
        vfail(vector-kind-fields "${lbl} policy not in cp1610-policies.ids")
      endif()
      if(NOT tier_t STREQUAL "MISSING")
        vfail(vector-kind-fields "${lbl} kind policy carries tier")
      endif()
    elseif(NOT kind STREQUAL "")
      vfail(vector-format "${lbl} kind")
    endif()

    # cite
    json_type(t "${vec}" cite)
    if(t STREQUAL "STRING")
      vget(cite "${vec}" cite)
      if(cite MATCHES "[^ -~]" OR NOT cite MATCHES "pdf [0-9]+")
        vfail(vector-bad-cite "${lbl}")
      endif()
    endif()

    # sources
    json_type(t "${vec}" sources)
    if(t STREQUAL "ARRAY")
      string(JSON nsrc LENGTH "${vec}" sources)
      if(nsrc GREATER 0)
        math(EXPR slast "${nsrc} - 1")
        foreach(k RANGE 0 ${slast})
          vget(s "${vec}" sources ${k})
          if(NOT s IN_LIST SOURCE_IDS)
            vfail(vector-unknown-source "${lbl} sources[${k}]")
          endif()
        endforeach()
      endif()
    endif()

    # program words
    set(words "")
    set(program_ok TRUE)
    json_type(t "${vec}" program)
    if(t STREQUAL "ARRAY")
      string(JSON np LENGTH "${vec}" program)
      if(np GREATER 0)
        math(EXPR plast "${np} - 1")
        foreach(k RANGE 0 ${plast})
          json_type(pt "${vec}" program ${k})
          if(NOT pt STREQUAL "STRING")
            set(program_ok FALSE)
            continue()
          endif()
          string(JSON pw GET "${vec}" program ${k})
          program_word(ok hv bv "${pw}")
          if(NOT ok)
            vfail(vector-format "${lbl} program[${k}] is not '<hex4> <binary groups>'")
            set(program_ok FALSE)
            continue()
          endif()
          if(NOT hv EQUAL bv)
            vfail(vector-program-mismatch "${lbl} program[${k}]")
          endif()
          list(APPEND words "${hv}")
        endforeach()
      endif()
    else()
      set(program_ok FALSE)
    endif()

    # row
    vget(row "${vec}" row)
    json_type(t "${vec}" row)
    if(t STREQUAL "STRING")
      if(row IN_LIST UNIT_ROWS)
        # unit rows carry no instruction encoding
      elseif(NOT row IN_LIST ROW_IDS)
        vfail(vector-unknown-row "${lbl} ${row}")
      elseif(program_ok)
        list(LENGTH words nw)
        set(d -1)
        if(nw GREATER 0)
          list(GET words 0 w0)
          if(w0 EQUAL 1 AND nw GREATER 1)
            list(GET words 1 w0)
          endif()
          math(EXPR d "${w0} & 1023")
        endif()
        if(d LESS 0)
          vfail(vector-row-mismatch "${lbl} ${row} (no program word)")
        else()
          decle_leaves(leaves ${d})
          if(NOT row IN_LIST leaves)
            string(REPLACE ";" "," leaves_txt "${leaves}")
            vfail(vector-row-mismatch "${lbl} ${row} (decle ${d} is labelled by: ${leaves_txt})")
          endif()
        endif()
      endif()
    endif()

    # emulator names in text fields
    foreach(field id cite asm derivation tier policy)
      vget(txt "${vec}" ${field})
      vnames("${lbl}" ${field} "${txt}")
    endforeach()
    json_type(t "${vec}" covers)
    if(t STREQUAL "ARRAY")
      string(JSON nc LENGTH "${vec}" covers)
      if(nc GREATER 0)
        math(EXPR clast "${nc} - 1")
        foreach(k RANGE 0 ${clast})
          vget(txt "${vec}" covers ${k})
          vnames("${lbl}" "covers[${k}]" "${txt}")
        endforeach()
      endif()
    endif()
  endforeach()
endforeach()

# ---- Inventories ---------------------------------------------------------------------------
set(UNIQ_IDS ${VEC_IDS})
list(REMOVE_DUPLICATES UNIQ_IDS)
first_tokens(LISTED "data/expected/cp1610-vectors.ids")
set(seen "")
foreach(id IN LISTS LISTED)
  if(id IN_LIST seen)
    vfail(vector-duplicate-id "data/expected/cp1610-vectors.ids ${id}")
  endif()
  list(APPEND seen "${id}")
  if(NOT id IN_LIST UNIQ_IDS)
    vfail(vector-id-missing "data/expected/cp1610-vectors.ids ${id}")
  endif()
endforeach()
foreach(id IN LISTS UNIQ_IDS)
  if(NOT id IN_LIST LISTED)
    vfail(vector-id-extra "data/expected/cp1610-vectors.ids ${id}")
  endif()
endforeach()

set(suite "")
if(EXISTS "${ROOT}/data/expected/cp1610-vectors.ids")
  file(STRINGS "${ROOT}/data/expected/cp1610-vectors.ids" hdr REGEX "^#[ \t]*suite=")
  foreach(h IN LISTS hdr)
    if(suite STREQUAL "" AND h MATCHES "^#[ \t]*suite=([a-z0-9][a-z0-9-]*)")
      set(suite "${CMAKE_MATCH_1}")
    endif()
  endforeach()
endif()
if(suite STREQUAL "")
  vfail(vector-suite-drift "data/expected/cp1610-vectors.ids (no # suite= line)")
elseif(NOT EXISTS "${ROOT}/data/expected/tests/${suite}.ids")
  vfail(vector-suite-drift "data/expected/tests/${suite}.ids (missing)")
else()
  first_tokens(SUITE_IDS "data/expected/tests/${suite}.ids")
  foreach(id IN LISTS SUITE_IDS)
    if(NOT id IN_LIST UNIQ_IDS)
      vfail(vector-suite-drift "data/expected/tests/${suite}.ids ${id} (no such vector)")
    endif()
  endforeach()
  foreach(id IN LISTS UNIQ_IDS)
    if(NOT id IN_LIST SUITE_IDS)
      vfail(vector-suite-drift "data/expected/tests/${suite}.ids ${id} (not listed)")
    endif()
  endforeach()
endif()

if(EXISTS "${ROOT}/data/expected/cp1610-skips.ids")
  file(STRINGS "${ROOT}/data/expected/cp1610-skips.ids" lines)
  foreach(l IN LISTS lines)
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    if(NOT l MATCHES "^([^ \t]+)[ \t]+([^ \t]+)$")
      vfail(vector-skip-unknown "data/expected/cp1610-skips.ids '${l}' (not '<id> <C-id>')")
      continue()
    endif()
    set(sid "${CMAKE_MATCH_1}")
    set(cid "${CMAKE_MATCH_2}")
    if(NOT sid IN_LIST UNIQ_IDS)
      vfail(vector-skip-unknown "data/expected/cp1610-skips.ids ${sid} (no such vector)")
    endif()
    if(NOT cid IN_LIST DISC_IDS)
      vfail(vector-skip-unknown "data/expected/cp1610-skips.ids ${sid} ${cid} (no such discrepancy)")
    endif()
  endforeach()
endif()

# Exact totals for capped tokens.
foreach(tok IN LISTS VTOKENS)
  gate_count(n "tok_${tok}")
  if(n GREATER ${CAP})
    gate_fail(${tok} "${n} findings in total, first ${CAP} listed")
  endif()
endforeach()

gate_stat(vectors ${n_vec})
gate_stat(source ${n_source})
gate_stat(policy ${n_policy})
gate_finish(vectors)
