# SPDX-License-Identifier: MIT
# Structural checker of the CP-1610 vector data (D-14, A-07, A-13): every
# data/cp1610/vectors/*.json named by FILELIST, the vector inventories and the expected skips.
# Inputs (passed with -D): ROOT (tree under test), FILELIST (repo-relative paths, one per line),
# CHECK_DIR (the real tools/check; the emulator-name lists are read from here, never from ROOT).
# Rules and tokens (every finding is `-- FAIL <token>: <file> <id> <detail>`; at most 20 per
# token are listed, then one line with the exact total):
#   file set = stems of data/expected/cp1610-vector-files.ids     vector-file-unlisted, vector-file-missing
#   top and per-vector keys, including init and expect keys      vector-missing-key, vector-unknown-key
#   JSON types, schema_version 1, group = stem, blank derivation,
#   id shape, program string shape, kind name, parse failure     vector-format
#   kind source: tier source-expectation, no policy;
#   kind policy: policy in cp1610-policies.ids, no tier          vector-kind-fields
#   cite ASCII and carrying `pdf N`                              vector-bad-cite
#   `source` and every `sources` entry an id of data/sources.json vector-unknown-source
#   row in cp1610-rows.ids or a unit name                        vector-unknown-row
#   first decle (second after an SDBD word $0001) is encoded by the declared row and the row is
#   the most specific one (a leaf under `refines`, or a leaf linked by also_encodes); a label
#   check only, never an expected value; skipped for unit rows   vector-row-mismatch
#   program binary part (spaces removed) equals its hex word     vector-program-mismatch
#   text fields free of the emulator names in CHECK_DIR lists    vector-emulator-name
#   ids unique, equal to cp1610-vectors.ids and to the first
#   tokens of tests/<suite>.ids (`# suite=` line)                vector-duplicate-id, vector-id-missing,
#                                                                vector-id-extra, vector-suite-drift
#   cp1610-skips.ids lines name a vector and a discrepancy id    vector-skip-unknown
# Coverage (D-16, A-05, A-13; plan 02-05). Table columns status_bits, cycles_printed,
# cycle_modifiers, refines and sdbd are the coverage inventory only, never expected values.
#   a `covers` tag its own init/expect/program does not prove      vector-tag-false
#   a row not in cp1610-coverage-pending.ids without a vector      vector-row-uncovered
#   set/clear per status_bits flag, preserved per other flag
#   (exemptions only in cp1610-flag-exempt.ids)                    vector-flag-uncovered
#   cycles:base/mod per +k modifier, n0/n1 for `6/8` rows,
#   POL-BR-01 taken/not-taken for `7/9` rows (B: taken only)       vector-cycles-uncovered
#   expect.cycles absent exactly on kind=source vectors of the
#   `7/9` rows (string equality), present on every other vector     vector-cycles-basis
#   a policy not pending without a vector naming it                 vector-policy-uncovered
#   ... or without a fault whose must-fail vector names it          vector-policy-no-fault
#   a pending row or policy that a vector names                     vector-pending-covered
#   cp1610-addr-required.ids `<ROW> <addr tag>` line not met;
#   an `addr:sdbd` vector per `supported` sdbd row once class:sdbd
#   is not pending                                                  vector-addr-uncovered
#   ... malformed line, unknown row, tag outside addr:, empty file
#   without `#allow-empty:`                                          vector-addr-required-format
#   a non-pending row without a vector carrying a non-empty bus     vector-bus-uncovered
#   cp1610-branch-required.ids line not met / malformed             vector-branch-uncovered,
#                                                                   vector-branch-required-format
#   cp1610-modifier-witness.ids `<ROW> cycles:mod <WITNESS_ROW>`:
#   ROW has one +k modifier, WITNESS_ROW refines ROW               vector-witness-format
#   ... a single-step WITNESS_ROW vector tagged cycles:base asserts
#   ROW's base plus k (replaces only ROW's cycles:mod requirement)  vector-witness-uncovered
# Stats: vectors=<n> source=<n> policy=<n> rows-pending=<n> policies-pending=<n>
# bus-figure-pages=<distinct pdf pages cited by bus_basis=figure vectors>. The review record
# kind is plan 02-16's.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT FILELIST CHECK_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "vectors.cmake is missing ${required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")

