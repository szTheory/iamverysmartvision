# Finding with a per-token cap; totals are reported at the end.
function(vfail token detail)
  gate_incr("tok_${token}")
  gate_count(n "tok_${token}")
  if(n LESS_EQUAL ${CAP})
    gate_fail(${token} "${detail}")
  endif()
endfunction()

# Plain id list from a text file: first token of each non-# line, file order (may repeat).
function(first_tokens out relpath)
  set(ids "")
  if(EXISTS "${ROOT}/${relpath}")
    file(STRINGS "${ROOT}/${relpath}" lines)
    foreach(l IN LISTS lines)
      string(STRIP "${l}" l)
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      string(REGEX REPLACE "[ \t].*$" "" l "${l}")
      list(APPEND ids "${l}")
    endforeach()
  endif()
  set(${out} "${ids}" PARENT_SCOPE)
endfunction()

# Spec list of vshape, split once: "key:TYPE|TYPE" (required) or "?key:TYPE|TYPE" (optional)
# becomes <sp>_KEYS, <sp>_OPT (TRUE for an optional key) and <sp>_TYPES, one element per key.
function(vspecs sp)
  set(keys "")
  set(opts "")
  set(typs "")
  foreach(spec IN LISTS ARGN)
    set(optional FALSE)
    if(spec MATCHES "^[?]")
      set(optional TRUE)
      string(SUBSTRING "${spec}" 1 -1 spec)
    endif()
    string(FIND "${spec}" ":" c)
    string(SUBSTRING "${spec}" 0 ${c} key)
    math(EXPR c1 "${c} + 1")
    string(SUBSTRING "${spec}" ${c1} -1 types)
    list(APPEND keys "${key}")
    list(APPEND opts ${optional})
    list(APPEND typs "${types}")
  endforeach()
  set(${sp}_KEYS "${keys}" PARENT_SCOPE)
  set(${sp}_OPT "${opts}" PARENT_SCOPE)
  set(${sp}_TYPES "${typs}" PARENT_SCOPE)
endfunction()

# Presence, type and allowed keys of one object against the spec set `sp` (see vspecs); every
# other member is an unknown key. `mem` is the member list of obj (json_members): a spec key
# that is not a member is MISSING without a lookup, a member is typed with one lookup. The type
# of every spec key (MISSING when absent) is left in ${tp}<key> of the caller, so the caller
# never types the same member again.
function(vshape lbl prefix obj mem tp sp)
  foreach(key optional types IN ZIP_LISTS ${sp}_KEYS ${sp}_OPT ${sp}_TYPES)
    set(t MISSING)
    if("${key}" IN_LIST mem)
      string(JSON t ERROR_VARIABLE terr TYPE "${obj}" "${key}")
      if(NOT "${terr}" STREQUAL "NOTFOUND")
        set(t MISSING)
      endif()
    endif()
    set(${tp}${key} "${t}" PARENT_SCOPE)
    if(t STREQUAL "MISSING")
      if(NOT optional)
        vfail(vector-missing-key "${lbl} ${prefix}${key}")
      endif()
    elseif(NOT "${t}" STREQUAL "${types}")
      string(REPLACE "|" ";" tlist "${types}")
      if(NOT "${t}" IN_LIST tlist)
        vfail(vector-format "${lbl} ${prefix}${key} (type ${t})")
      endif()
    endif()
  endforeach()
  foreach(m IN LISTS mem)
    if(NOT "${m}" IN_LIST ${sp}_KEYS)
      vfail(vector-unknown-key "${lbl} ${prefix}${m}")
    endif()
  endforeach()
endfunction()

# Every element of an array member must be a string. `atype` is the member's type and `atext`
# its JSON text (both read once from the vector); nothing is checked unless it is an ARRAY.
function(vstrings lbl key atype atext)
  if(NOT "${atype}" STREQUAL "ARRAY")
    return()
  endif()
  string(JSON n LENGTH "${atext}")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE 0 ${last})
      json_type(et "${atext}" ${i})
      if(NOT et STREQUAL "STRING")
        vfail(vector-format "${lbl} ${key}[${i}] (type ${et})")
      endif()
    endforeach()
  endif()
endfunction()

# String member value, or empty when absent or not a string.
function(vget out obj)
  set(v "")
  json_type(t "${obj}" ${ARGN})
  if(t STREQUAL "STRING")
    string(JSON v GET "${obj}" ${ARGN})
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# String value of a member the loop below has typed (VT_<key>) and fetched (VS_<key>): empty when
# the member is absent or not a string, as vget gives for the same member of the object itself.
function(vcached out key)
  set(v "")
  if("${VT_${key}}" STREQUAL "STRING")
    set(v "${VS_${key}}")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# The members of a vector object that the checks read (the vshape keys below), and those whose
# value is fetched once per vector.
vspecs(VEC "id:STRING" "row:STRING" "kind:STRING" "cite:STRING"
  "sources:ARRAY" "asm:STRING" "program:ARRAY" "derivation:STRING" "init:OBJECT" "expect:OBJECT"
  "covers:ARRAY" "?tier:STRING" "?policy:STRING" "?bus:ARRAY" "?bus_basis:STRING" "?steps:NUMBER"
  "?step_lines:ARRAY" "?config:OBJECT" "?ebci:ARRAY" "?waits:ARRAY" "?iab:STRING"
  "?reset:BOOLEAN" "?program_at:STRING")
set(VEC_VALUE_KEYS id row kind cite sources asm program derivation init expect covers tier policy
  bus_basis steps ebci program_at)

# Emulator names: union of the shared cite-only list and the vector list, from CHECK_DIR only.
set(NAMES "")
foreach(list_file denylist-cite.txt vector-emulator-names.txt)
  if(NOT EXISTS "${CHECK_DIR}/${list_file}")
    message(FATAL_ERROR "vectors.cmake: ${CHECK_DIR}/${list_file} is missing")
  endif()
  file(STRINGS "${CHECK_DIR}/${list_file}" lines)
  foreach(l IN LISTS lines)
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    string(TOLOWER "${l}" l)
    list(APPEND NAMES "${l}")
  endforeach()
endforeach()
list(REMOVE_DUPLICATES NAMES)

function(vnames lbl field text)
  string(TOLOWER "${text}" low)
  foreach(name IN LISTS NAMES)
    string(FIND "${low}" "${name}" at)
    if(at GREATER -1)
      vfail(vector-emulator-name "${lbl} ${field}")
      return()
    endif()
  endforeach()
endfunction()

# Reference sets.
first_tokens(ROW_IDS "data/expected/cp1610-rows.ids")
first_tokens(POLICY_IDS "data/expected/cp1610-policies.ids")
first_tokens(DISC_IDS "data/expected/discrepancies.ids")
first_tokens(FILE_STEMS "data/expected/cp1610-vector-files.ids")
set(SOURCE_IDS "")
if(EXISTS "${ROOT}/data/sources.json")
  file(READ "${ROOT}/data/sources.json" sdoc)
  string(JSON ns ERROR_VARIABLE e LENGTH "${sdoc}" sources)
  if("${e}" STREQUAL "NOTFOUND" AND ns GREATER 0)
    math(EXPR last "${ns} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON sid ERROR_VARIABLE e GET "${sdoc}" sources ${i} id)
      if("${e}" STREQUAL "NOTFOUND")
        list(APPEND SOURCE_IDS "${sid}")
      endif()
    endforeach()
  endif()
endif()

# Family rows: mask, value, eq relations, refines target, also_encodes (as in coverage.cmake).
set(R_IDS "")
set(R_MASKS "")
set(R_VALS "")
set(R_EQS "")
set(R_REFS "")
set(R_ALSO "")
set(R_STATUS "")
set(R_CYC "")
set(R_MODS "")
set(R_SDBD "")
if(EXISTS "${ROOT}/data/cp1610/opcode-families.json")
  file(READ "${ROOT}/data/cp1610/opcode-families.json" fdoc)
  string(JSON nr ERROR_VARIABLE e LENGTH "${fdoc}" rows)
  if("${e}" STREQUAL "NOTFOUND" AND nr GREATER 0)
    math(EXPR last "${nr} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON rec GET "${fdoc}" rows ${i})
      vget(rid "${rec}" id)
      vget(pattern "${rec}" pattern)
      if(NOT "${pattern}" MATCHES "^[01.][01.][01.][01.][01.][01.][01.][01.][01.][01.]$")
        continue()
      endif()
      set(mask 0)
      set(val 0)
      string(REGEX REPLACE "(.)" "\\1;" chars "${pattern}")
      foreach(c IN LISTS chars)
        if("${c}" STREQUAL "")
          continue()
        elseif("${c}" STREQUAL ".")
          math(EXPR mask "${mask} * 2")
          math(EXPR val "${val} * 2")
        elseif("${c}" STREQUAL "1")
          math(EXPR mask "${mask} * 2 + 1")
          math(EXPR val "${val} * 2 + 1")
        else()
          math(EXPR mask "${mask} * 2 + 1")
          math(EXPR val "${val} * 2")
        endif()
      endforeach()
      set(eqs "")
      json_type(et "${rec}" eq)
      if(et STREQUAL "ARRAY")
        string(JSON en LENGTH "${rec}" eq)
        if(en GREATER 0)
          math(EXPR elast "${en} - 1")
          foreach(k RANGE 0 ${elast})
            string(JSON eqv GET "${rec}" eq ${k})
            if("${eqv}" MATCHES "^([0-9]+):([0-9]+)=([0-9]+):([0-9]+)$")
              list(APPEND eqs "${CMAKE_MATCH_1},${CMAKE_MATCH_2},${CMAKE_MATCH_3},${CMAKE_MATCH_4}")
            endif()
          endforeach()
        endif()
      endif()
      if("${eqs}" STREQUAL "")
        set(eqs "-")
      else()
        string(REPLACE ";" "|" eqs "${eqs}")
      endif()
      vget(refines "${rec}" refines)
      if(refines STREQUAL "")
        set(refines "-")
      endif()
      set(also "|")
      json_type(at "${rec}" also_encodes)
      if(at STREQUAL "ARRAY")
        string(JSON an LENGTH "${rec}" also_encodes)
        if(an GREATER 0)
          math(EXPR alast "${an} - 1")
          foreach(k RANGE 0 ${alast})
            string(JSON a GET "${rec}" also_encodes ${k})
            set(also "${also}${a}|")
          endforeach()
        endif()
      endif()
      list(APPEND R_IDS "${rid}")
      list(APPEND R_MASKS "${mask}")
      list(APPEND R_VALS "${val}")
      list(APPEND R_EQS "${eqs}")
      list(APPEND R_REFS "${refines}")
      list(APPEND R_ALSO "${also}")
      # Coverage columns (inventory only): `;` is made `,` so each stays one list element.
      vget(col "${rec}" status_bits)
      string(REPLACE ";" "," col "${col}")
      list(APPEND R_STATUS "${col}_")
      vget(col "${rec}" cycles_printed)
      list(APPEND R_CYC "${col}_")
      set(mods "")
      json_type(mt "${rec}" cycle_modifiers)
      if(mt STREQUAL "ARRAY")
        string(JSON mn LENGTH "${rec}" cycle_modifiers)
        if(mn GREATER 0)
          math(EXPR mlast "${mn} - 1")
          foreach(k RANGE 0 ${mlast})
            vget(m "${rec}" cycle_modifiers ${k})
            string(REPLACE ";" "," m "${m}")
            string(REPLACE "|" "/" m "${m}")
            set(mods "${mods}${m}|")
          endforeach()
        endif()
      endif()
      list(APPEND R_MODS "${mods}_")
      vget(col "${rec}" sdbd)
      list(APPEND R_SDBD "${col}_")
    endforeach()
  endif()
endif()

# Rows that may label decle d: the leaves among the matching rows (a match that another match
# refines is not a leaf). Several leaves only occur as an also_encodes coincidence, checked by
# the cp1610 step; each of them may label the decle.
function(decle_leaves_compute out d)
  set(matches "")
  foreach(rid m v eqs IN ZIP_LISTS R_IDS R_MASKS R_VALS R_EQS)
    math(EXPR x "${d} & ${m}")
    if(NOT x EQUAL v)
      continue()
    endif()
    if(NOT "${eqs}" STREQUAL "-")
      set(holds TRUE)
      string(REPLACE "|" ";" eqlist "${eqs}")
      foreach(e IN LISTS eqlist)
        string(REPLACE "," ";" f "${e}")
        list(GET f 0 h1)
        list(GET f 1 l1)
        list(GET f 3 l2)
        math(EXPR w "(1 << (${h1} - ${l1} + 1)) - 1")
        math(EXPR a "(${d} >> ${l1}) & ${w}")
        math(EXPR b "(${d} >> ${l2}) & ${w}")
        if(NOT a EQUAL b)
          set(holds FALSE)
        endif()
      endforeach()
      if(NOT holds)
        continue()
      endif()
    endif()
    list(APPEND matches "${rid}")
  endforeach()
  set(targets "")
  foreach(rid ref IN ZIP_LISTS R_IDS R_REFS)
    if("${rid}" IN_LIST matches AND NOT ref STREQUAL "-")
      list(APPEND targets "${ref}")
    endif()
  endforeach()
  set(leaves "")
  foreach(rid IN LISTS matches)
    if(NOT "${rid}" IN_LIST targets)
      list(APPEND leaves "${rid}")
    endif()
  endforeach()
  set(${out} "${leaves}" PARENT_SCOPE)
endfunction()

# decle_leaves, computed once per decle value: the R_* tables are complete before the first
# call and never change after it, so the answer depends on d alone. The stored value carries an
# `L:` prefix so an empty answer stays distinguishable from an unset property.
function(decle_leaves out d)
  get_property(hit GLOBAL PROPERTY "VEC_DECLE_LEAVES_${d}")
  if("${hit}" STREQUAL "")
    decle_leaves_compute(leaves ${d})
    set(hit "L:${leaves}")
    set_property(GLOBAL PROPERTY "VEC_DECLE_LEAVES_${d}" "${hit}")
  endif()
  string(SUBSTRING "${hit}" 2 -1 leaves)
  set(${out} "${leaves}" PARENT_SCOPE)
endfunction()

# Program string -> numeric hex word and numeric binary part; ok FALSE when malformed.
function(program_word out_ok out_hex out_bin s)
  set(${out_ok} FALSE PARENT_SCOPE)
  if(NOT "${s}" MATCHES "^([0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ([01][01 ]*[01])$")
    return()
  endif()
  string(TOUPPER "${CMAKE_MATCH_1}" hx)
  string(REPLACE " " "" bits "${CMAKE_MATCH_2}")
  math(EXPR hv "0x${hx}")
  set(bv 0)
  string(LENGTH "${bits}" nb)
  math(EXPR nb1 "${nb} - 1")
  foreach(i RANGE 0 ${nb1})
    string(SUBSTRING "${bits}" ${i} 1 bc)
    math(EXPR bv "${bv} * 2 + ${bc}")
  endforeach()
  set(${out_ok} TRUE PARENT_SCOPE)
  set(${out_hex} "${hv}" PARENT_SCOPE)
  set(${out_bin} "${bv}" PARENT_SCOPE)
endfunction()

# Hex string of 1 to 4 digits -> number; empty when malformed.
function(hexnum out s)
  set(v "")
  if("${s}" MATCHES "^[0-9A-Fa-f][0-9A-Fa-f]?[0-9A-Fa-f]?[0-9A-Fa-f]?$")
    math(EXPR v "0x${s}")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# ---- Files ---------------------------------------------------------------------------------
file(STRINGS "${FILELIST}" all_paths)
set(STEMS "")
foreach(p IN LISTS all_paths)
  if(p MATCHES "^data/cp1610/vectors/([^/]+)[.]json$")
    list(APPEND STEMS "${CMAKE_MATCH_1}")
  endif()
endforeach()
list(SORT STEMS)
list(REMOVE_DUPLICATES STEMS)
foreach(stem IN LISTS STEMS)
  if(NOT stem IN_LIST FILE_STEMS)
    vfail(vector-file-unlisted "data/cp1610/vectors/${stem}.json")
  endif()
endforeach()
foreach(stem IN LISTS FILE_STEMS)
  if(NOT stem IN_LIST STEMS)
    vfail(vector-file-missing "data/cp1610/vectors/${stem}.json")
  endif()
endforeach()

# ---- Vectors -------------------------------------------------------------------------------
set(VEC_IDS "")
set(n_vec 0)
set(n_source 0)
set(n_policy 0)
set(STATE_SPECS "?intff:NUMBER" "?dbd:NUMBER" "?prev_interruptible:NUMBER" "?run_state:STRING"
  "?halt_pending:NUMBER" "?busak:NUMBER" "?fault_reason:STRING" "?status:OBJECT" "?mem:ARRAY")
vspecs(DOC "schema_version:NUMBER" "source:STRING" "group:STRING" "note:STRING" "vectors:ARRAY")
vspecs(INIT "?r:ARRAY" "?lines:OBJECT" ${STATE_SPECS})
vspecs(EXP "?r:OBJECT" "?cycles:NUMBER" "?units:ARRAY" "?events:ARRAY" ${STATE_SPECS})
foreach(stem IN LISTS STEMS)
  set(rel "data/cp1610/vectors/${stem}.json")
  file(READ "${ROOT}/${rel}" doc)
  string(JSON dt ERROR_VARIABLE e TYPE "${doc}")
  if(NOT "${e}" STREQUAL "NOTFOUND" OR NOT dt STREQUAL "OBJECT")
    vfail(vector-format "${rel} - (does not parse as a JSON object)")
    continue()
  endif()
  json_members(dmem "${doc}")
  vshape("${rel} -" "" "${doc}" "${dmem}" DT_ DOC)
  json_type(t "${doc}" schema_version)
  if(t STREQUAL "NUMBER")
    string(JSON sv GET "${doc}" schema_version)
    if(NOT sv STREQUAL "1")
      vfail(vector-format "${rel} - schema_version ${sv}")
    endif()
  endif()
  vget(group "${doc}" group)
  json_type(t "${doc}" group)
  if(t STREQUAL "STRING" AND NOT group STREQUAL stem)
    vfail(vector-format "${rel} - group is not the file stem")
  endif()
  vget(src "${doc}" source)
  json_type(t "${doc}" source)
  if(t STREQUAL "STRING" AND NOT src IN_LIST SOURCE_IDS)
    vfail(vector-unknown-source "${rel} - source")
  endif()
  vget(note "${doc}" note)
  vnames("${rel} -" note "${note}")
  json_type(t "${doc}" vectors)
  if(NOT t STREQUAL "ARRAY")
    continue()
  endif()
  string(JSON nv LENGTH "${doc}" vectors)
  if(nv EQUAL 0)
    continue()
  endif()
  math(EXPR last "${nv} - 1")
  foreach(i RANGE 0 ${last})
    string(JSON vec GET "${doc}" vectors ${i})
    math(EXPR n_vec "${n_vec} + 1")
    json_type(vt "${vec}")
    if(NOT vt STREQUAL "OBJECT")
      vfail(vector-format "${rel} #${i} (not an object)")
      continue()
    endif()
    vget(id "${vec}" id)
    if(id STREQUAL "")
      set(id "#${i}")
    endif()
    set(lbl "${rel} ${id}")
    # The vector object is read here and in few places below: its members are typed once by
    # vshape (VT_<key>) and the ones the checks use are fetched once (VS_<key>: the string, the
    # number text, or the JSON text of an array or object). The checks read these variables or
    # the JSON text of a member, not the whole vector object again (every lookup in a text parses
    # that whole text).
    json_members(vmem "${vec}")
    vshape("${lbl}" "" "${vec}" "${vmem}" VT_ VEC)
    foreach(vk IN LISTS VEC_VALUE_KEYS)
      set(VS_${vk} "")
      if("${VT_${vk}}" MATCHES "^(STRING|NUMBER|ARRAY|OBJECT)$")
        string(JSON VS_${vk} GET "${vec}" "${vk}")
      endif()
    endforeach()
    vstrings("${lbl}" sources "${VT_sources}" "${VS_sources}")
    vstrings("${lbl}" program "${VT_program}" "${VS_program}")
    vstrings("${lbl}" covers "${VT_covers}" "${VS_covers}")
    # init and expect: typed by their own vshape call. `r` and `status` of both and `cycles` of
    # expect are fetched as text for the facts below; a member that is absent or of another type
    # reads as an empty object, so a lookup in it finds nothing.
    set(init_r_text "{}")
    set(init_st_text "{}")
    set(exp_r_text "{}")
    set(exp_st_text "{}")
    set(exp_cyc_type MISSING)
    set(exp_cyc "")
    if("${VT_init}" STREQUAL "OBJECT")
      set(init "${VS_init}")
      json_members(imem "${init}")
      vshape("${lbl}" "init." "${init}" "${imem}" IT_ INIT)
      if("${IT_r}" MATCHES "^(ARRAY|OBJECT)$")
        string(JSON init_r_text GET "${init}" r)
      endif()
      if("${IT_status}" MATCHES "^(ARRAY|OBJECT)$")
        string(JSON init_st_text GET "${init}" status)
      endif()
    endif()
    if("${VT_expect}" STREQUAL "OBJECT")
      set(exp "${VS_expect}")
      json_members(xmem "${exp}")
      vshape("${lbl}" "expect." "${exp}" "${xmem}" XT_ EXP)
      if("${XT_r}" MATCHES "^(ARRAY|OBJECT)$")
        string(JSON exp_r_text GET "${exp}" r)
      endif()
      if("${XT_status}" MATCHES "^(ARRAY|OBJECT)$")
        string(JSON exp_st_text GET "${exp}" status)
      endif()
      set(exp_cyc_type "${XT_cycles}")
      if("${XT_cycles}" STREQUAL "NUMBER")
        string(JSON exp_cyc GET "${exp}" cycles)
      endif()
    endif()

    # id shape and uniqueness
    if(NOT id MATCHES "${ID_RE}")
      vfail(vector-format "${lbl} id shape")
    endif()
    if(id IN_LIST VEC_IDS)
      vfail(vector-duplicate-id "${lbl}")
    endif()
    list(APPEND VEC_IDS "${id}")

    # derivation
    vcached(derivation derivation)
    string(STRIP "${derivation}" dstrip)
    set(t "${VT_derivation}")
    if(t STREQUAL "STRING" AND dstrip STREQUAL "")
      vfail(vector-format "${lbl} derivation is blank")
    endif()

    # kind fields
    vcached(kind kind)
    set(tier_t "${VT_tier}")
    set(pol_t "${VT_policy}")
    vcached(tier tier)
    vcached(policy policy)
    if(kind STREQUAL "source")
      math(EXPR n_source "${n_source} + 1")
      if(NOT tier STREQUAL "source-expectation")
        vfail(vector-kind-fields "${lbl} kind source needs tier source-expectation")
      endif()
      if(NOT pol_t STREQUAL "MISSING")
        vfail(vector-kind-fields "${lbl} kind source carries policy")
      endif()
    elseif(kind STREQUAL "policy")
      math(EXPR n_policy "${n_policy} + 1")
      if(NOT policy IN_LIST POLICY_IDS)
        vfail(vector-kind-fields "${lbl} policy not in cp1610-policies.ids")
      endif()
      if(NOT tier_t STREQUAL "MISSING")
        vfail(vector-kind-fields "${lbl} kind policy carries tier")
      endif()
    elseif(NOT kind STREQUAL "")
      vfail(vector-format "${lbl} kind")
    endif()

    # cite
    if("${VT_cite}" STREQUAL "STRING")
      set(cite "${VS_cite}")
      if(cite MATCHES "[^ -~]" OR NOT cite MATCHES "pdf [0-9]+")
        vfail(vector-bad-cite "${lbl}")
      endif()
    endif()

    # sources
    if("${VT_sources}" STREQUAL "ARRAY")
      string(JSON nsrc LENGTH "${VS_sources}")
      if(nsrc GREATER 0)
        math(EXPR slast "${nsrc} - 1")
        foreach(k RANGE 0 ${slast})
          vget(s "${VS_sources}" ${k})
          if(NOT s IN_LIST SOURCE_IDS)
            vfail(vector-unknown-source "${lbl} sources[${k}]")
          endif()
        endforeach()
      endif()
    endif()

    # program words
    set(words "")
    set(program_ok TRUE)
    if("${VT_program}" STREQUAL "ARRAY")
      string(JSON np LENGTH "${VS_program}")
      if(np GREATER 0)
        math(EXPR plast "${np} - 1")
        foreach(k RANGE 0 ${plast})
          json_type(pt "${VS_program}" ${k})
          if(NOT pt STREQUAL "STRING")
            set(program_ok FALSE)
            continue()
          endif()
          string(JSON pw GET "${VS_program}" ${k})
          program_word(ok hv bv "${pw}")
          if(NOT ok)
            vfail(vector-format "${lbl} program[${k}] is not '<hex4> <binary groups>'")
            set(program_ok FALSE)
            continue()
          endif()
          if(NOT hv EQUAL bv)
            vfail(vector-program-mismatch "${lbl} program[${k}]")
          endif()
          list(APPEND words "${hv}")
        endforeach()
      endif()
    else()
      set(program_ok FALSE)
    endif()

    # row
    vcached(row row)
    if("${VT_row}" STREQUAL "STRING")
      if(row IN_LIST UNIT_ROWS)
        # unit rows carry no instruction encoding
      elseif(NOT row IN_LIST ROW_IDS)
        vfail(vector-unknown-row "${lbl} ${row}")
      elseif(program_ok)
        list(LENGTH words nw)
        set(d -1)
        if(nw GREATER 0)
          list(GET words 0 w0)
          if(w0 EQUAL 1 AND nw GREATER 1)
            list(GET words 1 w0)
          endif()
          math(EXPR d "${w0} & 1023")
        endif()
        if(d LESS 0)
          vfail(vector-row-mismatch "${lbl} ${row} (no program word)")
        else()
          decle_leaves(leaves ${d})
          if(NOT row IN_LIST leaves)
            string(REPLACE ";" "," leaves_txt "${leaves}")
            vfail(vector-row-mismatch "${lbl} ${row} (decle ${d} is labelled by: ${leaves_txt})")
          endif()
        endif()
      endif()
    endif()

    # emulator names in text fields
    foreach(field id cite asm derivation tier policy)
      vcached(txt ${field})
      vnames("${lbl}" ${field} "${txt}")
    endforeach()
    # The same walk collects the tags of the coverage facts below (`;` made `,`).
    set(tags "")
    if("${VT_covers}" STREQUAL "ARRAY")
      string(JSON nc LENGTH "${VS_covers}")
      if(nc GREATER 0)
        math(EXPR clast "${nc} - 1")
        foreach(k RANGE 0 ${clast})
          vget(txt "${VS_covers}" ${k})
          vnames("${lbl}" "covers[${k}]" "${txt}")
          string(REPLACE ";" "," txt "${txt}")
          list(APPEND tags "${txt}")
        endforeach()
      endif()
    endif()

    # Coverage facts of this vector, read back by the coverage section below.
    set(vi ${n_vec})
    set(V${vi}_id "${id}")
    set(V${vi}_lbl "${lbl}")
    set(V${vi}_row "${row}")
    set(V${vi}_kind "${kind}")
    set(V${vi}_policy "${policy}")
    set(V${vi}_tags "${tags}")
    set(steps 1)
    if("${VT_steps}" STREQUAL "NUMBER")
      set(steps "${VS_steps}")
    endif()
    set(V${vi}_steps "${steps}")
    set(cyc "")
    if(exp_cyc_type STREQUAL "NUMBER")
      set(cyc "${exp_cyc}")
    endif()
    set(V${vi}_cycles "${cyc}")
    if(program_ok)
      set(V${vi}_words "${words}")
    else()
      set(V${vi}_words "")
    endif()
    vget(txt "${init_r_text}" 7)
    hexnum(ir7 "${txt}")
    if(ir7 STREQUAL "")
      set(ir7 0)
    endif()
    vcached(txt program_at)
    hexnum(start "${txt}")
    if(start STREQUAL "")
      set(start ${ir7})
    endif()
    set(V${vi}_start "${start}")
    json_type(t "${exp_r_text}" 7)
    if(t STREQUAL "MISSING")
      set(V${vi}_r7 "${ir7}")
      set(V${vi}_r7set FALSE)
    else()
      vget(txt "${exp_r_text}" 7)
      hexnum(er7 "${txt}")
      set(V${vi}_r7 "${er7}")
      set(V${vi}_r7set TRUE)
    endif()
    set(ebci "")
    if("${VT_ebci}" STREQUAL "ARRAY")
      string(JSON ne LENGTH "${VS_ebci}")
      if(ne GREATER 0)
        math(EXPR elast "${ne} - 1")
        foreach(k RANGE 0 ${elast})
          json_type(et "${VS_ebci}" ${k})
          if(et STREQUAL "NUMBER")
            string(JSON ev GET "${VS_ebci}" ${k})
            list(APPEND ebci "${ev}")
          endif()
        endforeach()
      endif()
    endif()
    set(V${vi}_ebci "${ebci}")
    set(nb 0)
    if("${VT_bus}" STREQUAL "ARRAY")
      string(JSON nb LENGTH "${vec}" bus)
    endif()
    set(V${vi}_bus "${nb}")
    vcached(V${vi}_basis bus_basis)
    vcached(V${vi}_cite cite)
    foreach(f IN LISTS FLAGS)
      set(iv 0)
      json_type(t "${init_st_text}" ${f})
      if(t STREQUAL "NUMBER")
        string(JSON iv GET "${init_st_text}" ${f})
      endif()
      set(V${vi}_i${f} "${iv}")
      set(ev "")
      json_type(t "${exp_st_text}" ${f})
      if(t STREQUAL "NUMBER")
        string(JSON ev GET "${exp_st_text}" ${f})
      endif()
      set(V${vi}_e${f} "${ev}")
    endforeach()
  endforeach()
endforeach()

