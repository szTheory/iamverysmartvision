# Is vector i a single-step vector whose expect.cycles equals want?
function(cycles_is out i want)
  set(r FALSE)
  if("${V${i}_steps}" STREQUAL "1" AND NOT "${V${i}_cycles}" STREQUAL "" AND NOT "${want}" STREQUAL "")
    if(V${i}_cycles EQUAL want)
      set(r TRUE)
    endif()
  endif()
  set(${out} ${r} PARENT_SCOPE)
endfunction()

# Proof of one tag against vector i's own data: out = TRUE, FALSE, or SKIP for tag families
# this checker does not define (free-form labels such as `fetch:bus`).
function(vprove out i tag)
  set(r SKIP)
  set(row "${V${i}_row}")
  row_cols(rc "${row}")
  if(tag MATCHES "^flag-(set|clear|preserved):(.*)$")
    set(how "${CMAKE_MATCH_1}")
    set(f "${CMAKE_MATCH_2}")
    set(r FALSE)
    if(f IN_LIST FLAGS)
      set(iv "${V${i}_i${f}}")
      set(ev "${V${i}_e${f}}")
      # set: init 0, expect 1; clear: init 1, expect 0; preserved: absent from expect, init 1
      if(how STREQUAL "set" AND iv EQUAL 0 AND "${ev}" STREQUAL "1")
        set(r TRUE)
      elseif(how STREQUAL "clear" AND iv EQUAL 1 AND "${ev}" STREQUAL "0")
        set(r TRUE)
      elseif(how STREQUAL "preserved" AND iv EQUAL 1 AND "${ev}" STREQUAL "")
        set(r TRUE)
      endif()
    endif()
  elseif(tag MATCHES "^cycles:(.*)$")
    set(what "${CMAKE_MATCH_1}")
    set(r FALSE)
    if(what STREQUAL "base" AND rc_found)
      cycles_is(r ${i} "${rc_lead}")
    elseif(what STREQUAL "mod" AND rc_found AND rc_nplus EQUAL 1)
      math(EXPR want "${rc_lead} + ${rc_k}")
      cycles_is(r ${i} "${want}")
    elseif(what MATCHES "^n([01])$" AND rc_cyc STREQUAL "6/8" AND "${V${i}_kind}" STREQUAL "source")
      # shift rows printed `6/8`: N=0 asserts 6 cycles, N=1 asserts 8
      if(CMAKE_MATCH_1 STREQUAL "0" AND "${V${i}_cycles}" STREQUAL "6")
        set(r TRUE)
      elseif(CMAKE_MATCH_1 STREQUAL "1" AND "${V${i}_cycles}" STREQUAL "8")
        set(r TRUE)
      endif()
    elseif(what MATCHES "^(taken|not-taken)$" AND rc_cyc STREQUAL "7/9"
        AND "${V${i}_kind}" STREQUAL "policy" AND "${V${i}_policy}" STREQUAL "POL-BR-01")
      # A-05 policy: taken asserts the larger printed value (9), not taken the smaller (7)
      if(what STREQUAL "taken" AND "${V${i}_cycles}" STREQUAL "9")
        set(r TRUE)
      elseif(what STREQUAL "not-taken" AND "${V${i}_cycles}" STREQUAL "7")
        set(r TRUE)
      endif()
    endif()
  elseif(tag MATCHES "^policy:(.*)$")
    set(r FALSE)
    if("${CMAKE_MATCH_1}" IN_LIST POLICY_IDS)
      set(r TRUE)
    endif()
  elseif(tag MATCHES "^(addr|branch|ebci):")
    set(fam "${CMAKE_MATCH_1}")
    set(r FALSE)
    set(words "${V${i}_words}")
    list(LENGTH words nw)
    if(nw GREATER 0)
      list(GET words 0 w0)
      math(EXPR d0 "${w0} & 1023")
      # Addressing fields come from the target word: the second one after an SDBD word $0001.
      set(d ${d0})
      if(w0 EQUAL 1 AND nw GREATER 1)
        list(GET words 1 w1)
        math(EXPR d "${w1} & 1023")
      endif()
      math(EXPR mmm "(${d} >> 3) & 7")
      math(EXPR ddd "${d} & 7")
      if(fam STREQUAL "addr")
        # MMM (bits 5..3): 0 direct, 1-3 indirect, 4-5 auto-increment, 6 stack, 7 immediate
        if(tag STREQUAL "addr:sdbd")
          if(w0 EQUAL 1 AND nw GREATER 1)
            set(r TRUE)
          endif()
        elseif(tag STREQUAL "addr:direct" AND mmm EQUAL 0)
          set(r TRUE)
        elseif(tag STREQUAL "addr:indirect" AND mmm GREATER_EQUAL 1 AND mmm LESS_EQUAL 3)
          set(r TRUE)
        elseif(tag STREQUAL "addr:autoinc" AND mmm GREATER_EQUAL 4 AND mmm LESS_EQUAL 5)
          set(r TRUE)
        elseif(tag STREQUAL "addr:stack" AND mmm EQUAL 6)
          set(r TRUE)
        elseif(tag STREQUAL "addr:immediate" AND mmm EQUAL 7)
          set(r TRUE)
        elseif(tag STREQUAL "addr:r7-dest" AND ddd EQUAL 7 AND V${i}_r7set)
          set(r TRUE)
        endif()
      elseif(fam STREQUAL "branch")
        # Branch format `1000 S? cccc` (bits 9..6 = 1000). Bit 5 is the direction bit printed as
        # S on pdf 54 ("S is 0 for +, 1 for -"); pdf 47: 0 adds the displacement to PC+2
        # (forward), 1 adds its ones complement to PC+2 (backward). Taken when the final R7
        # differs from start PC + 2, not taken when it equals it (16-bit wrap).
        math(EXPR fmt "${d0} >> 6")
        math(EXPR sbit "(${d0} >> 5) & 1")
        math(EXPR next "(${V${i}_start} + 2) & 65535")
        set(r7 "${V${i}_r7}")
        if(tag MATCHES "^branch:(fwd|back)-(taken|not-taken)$" AND "${V${i}_steps}" STREQUAL "1"
            AND fmt EQUAL 8 AND NOT r7 STREQUAL "")
          set(dir "${CMAKE_MATCH_1}")
          set(how "${CMAKE_MATCH_2}")
          if((dir STREQUAL "fwd" AND sbit EQUAL 0) OR (dir STREQUAL "back" AND sbit EQUAL 1))
            if(how STREQUAL "taken" AND NOT r7 EQUAL next)
              set(r TRUE)
            elseif(how STREQUAL "not-taken" AND r7 EQUAL next)
              set(r TRUE)
            endif()
          endif()
        endif()
      elseif(tag MATCHES "^ebci:e([0-9]|1[0-5])-(true|false)$")
        # E code = first decle AND $F; true when the vector's ebci list holds it
        set(e "${CMAKE_MATCH_1}")
        set(how "${CMAKE_MATCH_2}")
        math(EXPR dl "${d0} & 15")
        if(dl EQUAL e)
          if(how STREQUAL "true" AND e IN_LIST V${i}_ebci)
            set(r TRUE)
          elseif(how STREQUAL "false" AND NOT e IN_LIST V${i}_ebci)
            set(r TRUE)
          endif()
        endif()
      endif()
    endif()
  endif()
  set(${out} ${r} PARENT_SCOPE)
endfunction()

# Tag proofs. PROVEN holds `<row>|<tag>` for every proven tag; NAMES_<i> the policies vector i
# names (its policy key plus proven policy: tags); BUSROWS the rows with a non-empty bus list.
set(PROVEN "")
set(BUSROWS "")
set(FIG_PAGES "")
set(VIDX "")
if(n_vec GREATER 0)
  foreach(i RANGE 1 ${n_vec})
    if(NOT DEFINED V${i}_row)
      continue()
    endif()
    list(APPEND VIDX ${i})
    set(row "${V${i}_row}")
    set(NAMES_${i} "")
    if(NOT "${V${i}_policy}" STREQUAL "")
      list(APPEND NAMES_${i} "${V${i}_policy}")
    endif()
    foreach(tag IN LISTS V${i}_tags)
      vprove(ok ${i} "${tag}")
      if(ok STREQUAL "FALSE")
        vfail(vector-tag-false "${V${i}_lbl} ${tag}")
      elseif(ok STREQUAL "TRUE")
        list(APPEND PROVEN "${row}|${tag}")
        if(tag MATCHES "^policy:(.*)$")
          list(APPEND NAMES_${i} "${CMAKE_MATCH_1}")
        endif()
      endif()
    endforeach()
    if(V${i}_bus GREATER 0)
      list(APPEND BUSROWS "${row}")
    endif()
    if("${V${i}_basis}" STREQUAL "figure")
      string(REGEX MATCHALL "pdf [0-9]+" pages "${V${i}_cite}")
      list(APPEND FIG_PAGES ${pages})
    endif()

    # A-05 cycle basis: kind=source vectors on the `7/9` rows (string equality) omit
    # expect.cycles; every other vector asserts it (shift rows `6/8` included).
    row_cols(rc "${row}")
    if("${V${i}_kind}" STREQUAL "source" AND rc_cyc STREQUAL "7/9")
      if(NOT "${V${i}_cycles}" STREQUAL "")
        vfail(vector-cycles-basis "${V${i}_lbl} kind source on a 7/9 row asserts expect.cycles")
      endif()
    elseif("${V${i}_cycles}" STREQUAL "")
      vfail(vector-cycles-basis "${V${i}_lbl} omits expect.cycles")
    endif()

    # A pending row or policy holds no vector.
    if(row IN_LIST PENDING)
      vfail(vector-pending-covered "${V${i}_lbl} row ${row} is pending")
    endif()
    foreach(p IN LISTS NAMES_${i})
      if("policy:${p}" IN_LIST PENDING)
        vfail(vector-pending-covered "${V${i}_lbl} policy ${p} is pending")
      endif()
    endforeach()
  endforeach()
endif()
list(REMOVE_DUPLICATES PROVEN)
list(REMOVE_DUPLICATES BUSROWS)
list(REMOVE_DUPLICATES FIG_PAGES)

# Data lines of a coverage list file: sets <p>_lines (data lines, `;` made `,`), <p>_allow
# (an `#allow-empty: <reason>` line exists) and <p>_exists.
function(cov_lines p rel)
  set(exists FALSE)
  set(allow FALSE)
  set(out "")
  if(EXISTS "${ROOT}/${rel}")
    set(exists TRUE)
    file(STRINGS "${ROOT}/${rel}" lines)
    foreach(l IN LISTS lines)
      string(STRIP "${l}" l)
      if(l MATCHES "^#allow-empty:[ \t]*[^ \t]")
        set(allow TRUE)
      elseif(NOT l STREQUAL "" AND NOT l MATCHES "^#")
        string(REPLACE ";" "," l "${l}")
        list(APPEND out "${l}")
      endif()
    endforeach()
  endif()
  set(${p}_lines "${out}" PARENT_SCOPE)
  set(${p}_allow ${allow} PARENT_SCOPE)
  set(${p}_exists ${exists} PARENT_SCOPE)
endfunction()

# Cycle-modifier witness (A-13): a `+k` branch that its own row cannot encode, because a
# refining row owns that encoding, is witnessed by the refining row. Valid lines fill WITNESSED
# (rows whose cycles:mod requirement is replaced).
set(WITNESSED "")
set(wrel "data/expected/cp1610-modifier-witness.ids")
cov_lines(wl "${wrel}")
if(NOT wl_exists)
  vfail(vector-witness-format "${wrel} (missing)")
elseif("${wl_lines}" STREQUAL "" AND NOT wl_allow)
  vfail(vector-witness-format "${wrel} (no data lines and no #allow-empty: line)")
endif()
set(wseen "")
foreach(l IN LISTS wl_lines)
  if(NOT l MATCHES "^([^ \t]+)[ \t]+([^ \t]+)[ \t]+([^ \t]+)$")
    vfail(vector-witness-format "${wrel} '${l}' is not '<ROW> cycles:mod <WITNESS_ROW>'")
    continue()
  endif()
  set(wrow "${CMAKE_MATCH_1}")
  set(wtag "${CMAKE_MATCH_2}")
  set(wit "${CMAKE_MATCH_3}")
  row_cols(wa "${wrow}")
  row_cols(wb "${wit}")
  if(NOT wtag STREQUAL "cycles:mod")
    vfail(vector-witness-format "${wrel} '${l}' tag is not cycles:mod")
  elseif(NOT wa_found OR NOT wb_found OR NOT wrow IN_LIST ROW_IDS OR NOT wit IN_LIST ROW_IDS)
    vfail(vector-witness-format "${wrel} '${l}' names an unknown row")
  elseif(NOT wa_nplus EQUAL 1)
    vfail(vector-witness-format "${wrel} '${l}' ${wrow} has ${wa_nplus} +k modifiers, not 1")
  elseif(NOT wb_refines STREQUAL wrow)
    vfail(vector-witness-format "${wrel} '${l}' ${wit} refines '${wb_refines}', not ${wrow}")
  elseif(wrow IN_LIST wseen)
    vfail(vector-witness-format "${wrel} '${l}' repeats ${wrow}")
  else()
    list(APPEND wseen "${wrow}")
    list(APPEND WITNESSED "${wrow}")
    if(NOT wrow IN_LIST PENDING)
      math(EXPR want "${wa_lead} + ${wa_k}")
      if(wit IN_LIST PENDING)
        vfail(vector-witness-uncovered "${wrow} cycles:mod: witness row ${wit} is pending")
      else()
        set(met FALSE)
        foreach(i IN LISTS VIDX)
          if("${V${i}_row}" STREQUAL "${wit}" AND "cycles:base" IN_LIST V${i}_tags)
            vprove(okb ${i} "cycles:base")
            cycles_is(okw ${i} "${want}")
            if(okb STREQUAL "TRUE" AND okw)
              set(met TRUE)
              break()
            endif()
          endif()
        endforeach()
        if(NOT met)
          vfail(vector-witness-uncovered "${wrow} cycles:mod: no single-step ${wit} vector tagged cycles:base asserts ${want} cycles")
        endif()
      endif()
    endif()
  endif()
endforeach()

# Derived requirements for every table row that is not pending.
set(n_rows_pending 0)
foreach(row IN LISTS R_IDS)
  if(row IN_LIST PENDING)
    math(EXPR n_rows_pending "${n_rows_pending} + 1")
    continue()
  endif()
  set(has FALSE)
  foreach(i IN LISTS VIDX)
    if("${V${i}_row}" STREQUAL "${row}")
      set(has TRUE)
      break()
    endif()
  endforeach()
  if(NOT has)
    vfail(vector-row-uncovered "${row}")
  endif()
  row_cols(rc "${row}")

  # Flags: status_bits lists the changed flags; the two `N=` forms count as their union.
  string(REGEX REPLACE "N=[01]:" "" st "${rc_status}")
  string(REGEX MATCHALL "[A-Za-z]+" st "${st}")
  set(changed "")
  foreach(f IN LISTS st)
    if(f STREQUAL "none")
      continue()
    elseif(f IN_LIST FLAGS)
      list(APPEND changed "${f}")
    else()
      vfail(vector-flag-uncovered "${row} status_bits '${rc_status}' not understood")
    endif()
  endforeach()
  foreach(f IN LISTS FLAGS)
    if(f IN_LIST changed)
      foreach(how set clear)
        if(NOT "${row}/flag-${how}:${f}" IN_LIST EXEMPT AND NOT "${row}|flag-${how}:${f}" IN_LIST PROVEN)
          vfail(vector-flag-uncovered "${row} flag-${how}:${f}")
        endif()
      endforeach()
    elseif(NOT "${row}|flag-preserved:${f}" IN_LIST PROVEN)
      vfail(vector-flag-uncovered "${row} flag-preserved:${f}")
    endif()
  endforeach()

  # Cycles.
  set(need "")
  if(rc_cyc STREQUAL "7/9")
    # POL-BR-01 (A-05); B is unconditional (pdf 54), so it has no not-taken case.
    list(APPEND need cycles:taken)
    if(NOT row STREQUAL "B")
      list(APPEND need cycles:not-taken)
    endif()
  elseif(rc_cyc STREQUAL "6/8")
    list(APPEND need cycles:n0 cycles:n1)
  endif()
  if(rc_nplus EQUAL 1)
    list(APPEND need cycles:base)
    if(NOT row IN_LIST WITNESSED)
      list(APPEND need cycles:mod)
    endif()
  elseif(rc_nplus GREATER 1)
    vfail(vector-cycles-uncovered "${row} has ${rc_nplus} +k modifiers (no rule)")
  endif()
  foreach(tag IN LISTS need)
    if(NOT "${row}|${tag}" IN_LIST PROVEN)
      vfail(vector-cycles-uncovered "${row} ${tag}")
    endif()
  endforeach()

  # Bus (ROADMAP SC4 per row) and the SDBD form of rows whose sdbd column is `supported`.
  if(has AND NOT row IN_LIST BUSROWS)
    vfail(vector-bus-uncovered "${row} (no vector with a non-empty bus list)")
  endif()
  if(rc_sdbd MATCHES "^supported" AND NOT "class:sdbd" IN_LIST PENDING
      AND NOT "${row}|addr:sdbd" IN_LIST PROVEN)
    vfail(vector-addr-uncovered "${row} addr:sdbd (sdbd column '${rc_sdbd}')")
  endif()
endforeach()

# Required-tag files: `<ROW> <tag>` per line; rows that are not pending need a vector of that
# row carrying that (proven) tag.
function(req_file rel fmt_tok unc_tok family_re)
  cov_lines(rq "${rel}")
  if(NOT rq_exists)
    vfail(${fmt_tok} "${rel} (missing)")
    return()
  endif()
  if("${rq_lines}" STREQUAL "" AND NOT rq_allow)
    vfail(${fmt_tok} "${rel} (no data lines and no #allow-empty: line)")
  endif()
  set(seen "")
  foreach(l IN LISTS rq_lines)
    if(NOT l MATCHES "^([^ \t]+)[ \t]+([^ \t]+)$")
      vfail(${fmt_tok} "${rel} '${l}' is not '<ROW> <tag>'")
      continue()
    endif()
    set(row "${CMAKE_MATCH_1}")
    set(tag "${CMAKE_MATCH_2}")
    if(NOT row IN_LIST ROW_IDS OR NOT row IN_LIST R_IDS)
      vfail(${fmt_tok} "${rel} '${l}' unknown row")
    elseif(NOT tag MATCHES "${family_re}")
      vfail(${fmt_tok} "${rel} '${l}' tag outside this file's family")
    elseif("${row}|${tag}" IN_LIST seen)
      vfail(${fmt_tok} "${rel} '${l}' repeated")
    else()
      list(APPEND seen "${row}|${tag}")
      if(NOT row IN_LIST PENDING AND NOT "${row}|${tag}" IN_LIST PROVEN)
        vfail(${unc_tok} "${row} ${tag}")
      endif()
    endif()
  endforeach()
endfunction()
req_file("data/expected/cp1610-addr-required.ids" vector-addr-required-format vector-addr-uncovered
  "^addr:(direct|indirect|autoinc|stack|immediate|sdbd|r7-dest)$")
req_file("data/expected/cp1610-branch-required.ids" vector-branch-required-format
  vector-branch-uncovered
  "^(branch:(fwd|back)-(taken|not-taken)|ebci:e([0-9]|1[0-5])-(true|false))$")

# Exemption lines must name a row and a set/clear case of a flag the row changes.
foreach(x IN LISTS EXEMPT)
  set(okx FALSE)
  if(x MATCHES "^(.+)/flag-(set|clear):([A-Z]+)$")
    set(xr "${CMAKE_MATCH_1}")
    set(xf "${CMAKE_MATCH_3}")
    row_cols(xc "${xr}")
    if(xc_found AND xf IN_LIST FLAGS AND xc_status MATCHES "(^|[ ,:])${xf}(,|$)")
      set(okx TRUE)
    endif()
  endif()
  if(NOT okx)
    vfail(vector-flag-uncovered "data/expected/cp1610-flag-exempt.ids '${x}' is not '<ROW>/flag-set|clear:<changed flag>'")
  endif()
endforeach()

# Policies: each one not pending needs a vector naming it and a fault whose must-fail vector
# names it (data/expected/faults/cpu.ids, column 2).
set(FAULT_NAMES "")
if(EXISTS "${ROOT}/data/expected/faults/cpu.ids")
  file(STRINGS "${ROOT}/data/expected/faults/cpu.ids" lines)
  foreach(l IN LISTS lines)
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    string(REGEX REPLACE "[ \t]+" ";" cols "${l}")
    list(LENGTH cols ncols)
    if(ncols LESS 2)
      continue()
    endif()
    list(GET cols 1 mf)
    foreach(i IN LISTS VIDX)
      if("${V${i}_id}" STREQUAL "${mf}")
        list(APPEND FAULT_NAMES ${NAMES_${i}})
      endif()
    endforeach()
  endforeach()
endif()
set(n_pol_pending 0)
foreach(p IN LISTS POLICY_IDS)
  if("policy:${p}" IN_LIST PENDING)
    math(EXPR n_pol_pending "${n_pol_pending} + 1")
    continue()
  endif()
  set(has FALSE)
  foreach(i IN LISTS VIDX)
    if(p IN_LIST NAMES_${i})
      set(has TRUE)
      break()
    endif()
  endforeach()
  if(NOT has)
    vfail(vector-policy-uncovered "${p}")
  endif()
  if(NOT p IN_LIST FAULT_NAMES)
    vfail(vector-policy-no-fault "${p} (no fault in data/expected/faults/cpu.ids has a must-fail vector naming it)")
  endif()
endforeach()
list(LENGTH FIG_PAGES n_fig_pages)

# Exact totals for capped tokens.
foreach(tok IN LISTS VTOKENS)
  gate_count(n "tok_${tok}")
  if(n GREATER ${CAP})
    gate_fail(${tok} "${n} findings in total, first ${CAP} listed")
  endif()
endforeach()

gate_stat(vectors ${n_vec})
gate_stat(source ${n_source})
gate_stat(policy ${n_policy})
gate_stat(rows-pending ${n_rows_pending})
gate_stat(policies-pending ${n_pol_pending})
gate_stat(bus-figure-pages ${n_fig_pages})
gate_finish(vectors)
