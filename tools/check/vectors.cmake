# ---- Coverage (D-16, A-05, A-13) -----------------------------------------------------------
# Table columns of one row into <p>_found/_cyc/_lead/_nplus/_k/_status/_sdbd/_refines.
# _lead is the leading integer of cycles_printed; _nplus counts `+k` modifiers and _k is the k
# of the last one (meaningful when _nplus is 1).
function(row_cols p row)
  list(FIND R_IDS "${row}" ix)
  set(found FALSE)
  set(cyc "")
  set(lead "")
  set(nplus 0)
  set(k "")
  set(status "")
  set(sdbd "")
  set(refines "-")
  if(ix GREATER -1)
    set(found TRUE)
    list(GET R_CYC ${ix} cyc)
    string(REGEX REPLACE "_$" "" cyc "${cyc}")
    if(cyc MATCHES "^([0-9]+)")
      set(lead "${CMAKE_MATCH_1}")
    endif()
    list(GET R_MODS ${ix} mods)
    string(REGEX REPLACE "_$" "" mods "${mods}")
    string(REPLACE "|" ";" mods "${mods}")
    foreach(m IN LISTS mods)
      if(m MATCHES "^[+]([0-9]+)[ ]")
        math(EXPR nplus "${nplus} + 1")
        set(k "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    list(GET R_STATUS ${ix} status)
    string(REGEX REPLACE "_$" "" status "${status}")
    list(GET R_SDBD ${ix} sdbd)
    string(REGEX REPLACE "_$" "" sdbd "${sdbd}")
    list(GET R_REFS ${ix} refines)
  endif()
  foreach(v found cyc lead nplus k status sdbd refines)
    set(${p}_${v} "${${v}}" PARENT_SCOPE)
  endforeach()
endfunction()

