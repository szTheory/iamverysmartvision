# Control core-purity-generated-scan: a toy generator with the reviewed interface
# (-DROOT=<tree> -DOUT=<file>) that writes a const table holding a floating literal.
cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED ROOT OR NOT DEFINED OUT)
  message(FATAL_ERROR "IvsToyTable: missing -DROOT or -DOUT")
endif()
file(WRITE "${OUT}" "/* Generated by the toy control generator. */
static const unsigned ivs_toy_table[2] = { 1u, (unsigned)(0.5 * 4) };
")
