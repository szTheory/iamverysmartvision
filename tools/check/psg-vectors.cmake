# SPDX-License-Identifier: MIT
# Structural checker of the PSG vector files (AUD-01, D-07, D-10, D-23; plan 05-01), pure and text based: every
# data/psg/vectors/*.txt named by FILELIST, its inventories and the coverage of data/psg/rules.json.
# Inputs (passed with -D): ROOT (tree under test), FILELIST (repo-relative paths, one per line),
# CHECK_DIR (the real tools/check; the emulator-name lists are read from here, never from ROOT).
# Line grammar (documented in the header of every vector file, closed key set, keys in this order, derive last):
#   V <id> rule=<PSG-Rnn> kind=<source|policy> tier=<tier> cite=<SRC-id>@<locator>|none set=<AAAA:HHHH[@<step>][+...]>|-
#     [pin=<port>:<HH>] steps=<n> expect=<kind>:<values> derive=<words>
# Rules and tokens (every finding is `-- FAIL <token>: <file> <id> <detail>`; at most 20 per token are listed, then one line
# with the exact total):
#   a line, key, value shape or expect kind outside the grammar, a repeated
#   key, an emulator name from the CHECK_DIR lists in a vector line or in the
#   rule file, or a malformed row of the register-address literal             psg-vector-grammar
#   vector rule that is not a rule of data/psg/rules.json                       psg-vector-unknown-rule
#   a rule of data/psg/rules.json that no vector names, or whose `vectors`
#   list differs from the set of vectors naming it                              psg-rule-without-vector
#   a vector without a tier, or without a cite, or kind source whose tier is
#   not source-expectation or whose cite is none, or a cite whose SRC id is
#   not in data/expected/sources.ids                                            psg-vector-no-cite-or-tier
#   a vector id that is not unique or does not start with `psg.`               psg-vector-orphan-id
#   a kind=policy vector whose tier is not an id of data/expected/psg-policies.ids,
#   or a policy id no vector names                                              psg-rule-unknown-default-unresolved
#   a file under data/psg/vectors/ that is not a stem of data/expected/psg-vector-files.ids,
#   or a listed stem without a file                                             psg-vector-unlisted-file
# Profile and test cross-checks (plan 05-04, D-07, D-12; each is skipped only where its input files do not exist, and the
# registration check fails when only one of its two files exists):
#   a `fields` path of a rule (not `engine:<name>`) that is neither a line of data/expected/profile-fields.ids nor a
#   field of data/psg/fields-pending.ids (`<field> <owning plan>`, the fields a later plan adds)     psg-rule-field-missing
#   a fields-pending line whose field is already in the profile inventory (the owning plan did not
#   delete it)                                                                                      psg-field-pending-stale
#   the profile psg.regmap (data/profiles/<stem>.json, for each data/psg/<stem>.regmap.literal.txt)
#   whose 16 records differ from the register-address literal in address, write mask or read mask,
#   or a profile without the field                                                                  psg-regmap-profile-mismatch
#   a vector id of a family that is not listed in data/psg/vectors-pending.ids (`<family> <owning plan>`) and
#   is absent from data/expected/tests/psg.ids, or an id of a listed (pending) family that is already
#   registered there; the family of `psg.<family>.<name>` is its second dotted token                psg-vector-registration
# A pending line that is not `<name> 05-NN` is a psg-vector-grammar finding.
# JSON read: data/psg/rules.json (ids, vectors lists, fields) and, once per literal, the profile's psg.regmap. The resolver
# and trigger text of a rule is the hook's (kinds/psg-rule.cmake). Stats: psg-vectors=<n> psg-policies=<n>.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT FILELIST CHECK_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "psg-vectors.cmake is missing ${required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")

set(CAP 20)
set(PTOKENS psg-vector-grammar psg-vector-unknown-rule psg-rule-without-vector psg-vector-no-cite-or-tier
  psg-vector-orphan-id psg-rule-unknown-default-unresolved psg-vector-unlisted-file
  psg-rule-field-missing psg-field-pending-stale psg-regmap-profile-mismatch psg-vector-registration)
set(DOLLAR "$")
set(EXPECT_KINDS read edge-spacing toggles shifts level-seq period silent gate index table)

function(pfail token detail)
  gate_incr("tok_${token}")
  gate_count(n "tok_${token}")
  if(n LESS_EQUAL ${CAP})
    gate_fail(${token} "${detail}")
  endif()
endfunction()

function(read_list out relpath)
  set(res "")
  if(EXISTS "${ROOT}/${relpath}")
    file(READ "${ROOT}/${relpath}" txt)
    gate_lines(lines "${txt}")
    foreach(l IN LISTS lines)
      gate_unprotect(l "${l}")
      string(STRIP "${l}" l)
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      string(REGEX REPLACE "[ \t].*$" "" first "${l}")
      list(APPEND res "${first}")
    endforeach()
  endif()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# `<name> <owning plan>` lines of a pending list: the names, with a grammar finding for a line of another shape.
function(read_pending out relpath)
  set(res "")
  if(EXISTS "${ROOT}/${relpath}")
    file(READ "${ROOT}/${relpath}" txt)
    gate_lines(lines "${txt}")
    set(ln 0)
    foreach(l IN LISTS lines)
      math(EXPR ln "${ln} + 1")
      gate_unprotect(l "${l}")
      string(STRIP "${l}" l)
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      if(l MATCHES "^([A-Za-z][A-Za-z0-9_.]*) 05-[0-9][0-9]$")
        list(APPEND res "${CMAKE_MATCH_1}")
      else()
        pfail(psg-vector-grammar "${relpath}:${ln} pending line '${l}' is not '<name> 05-NN'")
      endif()
    endforeach()
  endif()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

read_list(SRC_IDS "data/expected/sources.ids")
read_list(POLICY_IDS "data/expected/psg-policies.ids")
read_list(FILE_STEMS "data/expected/psg-vector-files.ids")

# Emulator names (lower case, one per line) from the real tools/check.
set(NAMES "")
foreach(list_file denylist-cite.txt vector-emulator-names.txt)
  if(EXISTS "${CHECK_DIR}/${list_file}")
    file(STRINGS "${CHECK_DIR}/${list_file}" nl)
    foreach(n IN LISTS nl)
      string(STRIP "${n}" n)
      if(NOT n STREQUAL "" AND NOT n MATCHES "^#")
        string(TOLOWER "${n}" n)
        list(APPEND NAMES "${n}")
      endif()
    endforeach()
  endif()
endforeach()
list(APPEND NAMES libasm)

# Rules of data/psg/rules.json: ids and `vectors` lists, and the emulator-name scan of the whole file.
set(RULE_IDS "")
if(EXISTS "${ROOT}/data/psg/rules.json")
  file(READ "${ROOT}/data/psg/rules.json" rdoc)
  string(TOLOWER "${rdoc}" rlow)
  foreach(n IN LISTS NAMES)
    string(FIND "${rlow}" "${n}" pos)
    if(pos GREATER -1)
      pfail(psg-vector-grammar "data/psg/rules.json emulator name '${n}'")
    endif()
  endforeach()
  string(JSON nr ERROR_VARIABLE e LENGTH "${rdoc}" rules)
  if("${e}" STREQUAL "NOTFOUND" AND nr GREATER 0)
    math(EXPR last "${nr} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON rid ERROR_VARIABLE e GET "${rdoc}" rules ${i} id)
      if(NOT "${e}" STREQUAL "NOTFOUND")
        continue()
      endif()
      list(APPEND RULE_IDS "${rid}")
      set(RVEC_${rid} "")
      set(RFIELDS_${rid} "")
      string(JSON nfl ERROR_VARIABLE e LENGTH "${rdoc}" rules ${i} fields)
      if("${e}" STREQUAL "NOTFOUND" AND nfl GREATER 0)
        math(EXPR flast "${nfl} - 1")
        foreach(j RANGE 0 ${flast})
          string(JSON fld GET "${rdoc}" rules ${i} fields ${j})
          list(APPEND RFIELDS_${rid} "${fld}")
        endforeach()
      endif()
      string(JSON nv ERROR_VARIABLE e LENGTH "${rdoc}" rules ${i} vectors)
      if("${e}" STREQUAL "NOTFOUND" AND nv GREATER 0)
        math(EXPR vlast "${nv} - 1")
        foreach(j RANGE 0 ${vlast})
          string(JSON vid GET "${rdoc}" rules ${i} vectors ${j})
          list(APPEND RVEC_${rid} "${vid}")
        endforeach()
      endif()
    endforeach()
  endif()
endif()

# Vector files named by FILELIST.
file(STRINGS "${FILELIST}" paths)
set(VFILES "")
foreach(p IN LISTS paths)
  if(p MATCHES "^data/psg/vectors/([^/]+)[.]txt$" AND EXISTS "${ROOT}/${p}")
    list(APPEND VFILES "${p}")
  elseif(p MATCHES "^data/psg/vectors/" AND EXISTS "${ROOT}/${p}")
    pfail(psg-vector-unlisted-file "${p} (not a .txt vector file)")
  endif()
endforeach()
list(SORT VFILES)
set(STEMS_SEEN "")
foreach(p IN LISTS VFILES)
  string(REGEX REPLACE "^data/psg/vectors/(.*)[.]txt$" "\\1" stem "${p}")
  list(APPEND STEMS_SEEN "${stem}")
  if(NOT stem IN_LIST FILE_STEMS)
    pfail(psg-vector-unlisted-file "${p}")
  endif()
endforeach()
foreach(stem IN LISTS FILE_STEMS)
  if(NOT stem IN_LIST STEMS_SEEN)
    pfail(psg-vector-unlisted-file "data/psg/vectors/${stem}.txt (listed, no file)")
  endif()
endforeach()

# Expected keys in order; pin is optional.
set(KEY_ORDER rule kind tier cite set pin steps expect)

set(n_vec 0)
set(ALL_IDS "")
set(USED_POLICIES "")
foreach(p IN LISTS VFILES)
  file(READ "${ROOT}/${p}" txt)
  gate_lines(lines "${txt}")
  set(lineno 0)
  foreach(l IN LISTS lines)
    math(EXPR lineno "${lineno} + 1")
    gate_unprotect(l "${l}")
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    set(at "${p}:${lineno}")
    if(NOT l MATCHES "^V [^ ]+ ")
      pfail(psg-vector-grammar "${at} not a vector line")
      continue()
    endif()
    math(EXPR n_vec "${n_vec} + 1")
    string(TOLOWER "${l}" llow)
    foreach(n IN LISTS NAMES)
      string(FIND "${llow}" "${n}" pos)
      if(pos GREATER -1)
        pfail(psg-vector-grammar "${at} emulator name '${n}'")
      endif()
    endforeach()
    # derive is the rest of the line
    string(FIND "${l}" " derive=" dpos)
    if(dpos LESS 0)
      pfail(psg-vector-grammar "${at} no derive=")
      continue()
    endif()
    string(SUBSTRING "${l}" 0 ${dpos} head)
    math(EXPR dstart "${dpos} + 8")
    string(SUBSTRING "${l}" ${dstart} -1 derive)
    if("${derive}" STREQUAL "")
      pfail(psg-vector-grammar "${at} empty derive")
    endif()
    string(REPLACE " " ";" toks "${head}")
    list(LENGTH toks nt)
    list(GET toks 1 vid)
    if(NOT vid MATCHES "^psg[.][A-Za-z0-9.-]+$")
      pfail(psg-vector-orphan-id "${at} ${vid}")
    endif()
    if(vid IN_LIST ALL_IDS)
      pfail(psg-vector-orphan-id "${at} ${vid} (duplicate id)")
    endif()
    list(APPEND ALL_IDS "${vid}")
    # keys after V and the id
    list(REMOVE_AT toks 0 1)
    set(vals_rule "")
    set(vals_kind "")
    set(vals_tier "")
    set(vals_cite "")
    set(vals_set "")
    set(vals_steps "")
    set(vals_expect "")
    set(ki 0)
    list(LENGTH KEY_ORDER nk)
    foreach(tok IN LISTS toks)
      # advance over keys that this token does not name; a missing tier or cite is its own token
      set(matched FALSE)
      while(ki LESS nk AND NOT matched)
        list(GET KEY_ORDER ${ki} key)
        if(tok MATCHES "^${key}=(.*)$")
          set(vals_${key} "${CMAKE_MATCH_1}")
          set(matched TRUE)
          math(EXPR ki "${ki} + 1")
        else()
          if(key STREQUAL "tier" OR key STREQUAL "cite")
            pfail(psg-vector-no-cite-or-tier "${at} ${vid} no ${key}=")
          elseif(NOT key STREQUAL "pin")
            pfail(psg-vector-grammar "${at} ${vid} key ${key} missing or out of order")
          endif()
          math(EXPR ki "${ki} + 1")
        endif()
      endwhile()
      if(NOT matched)
        pfail(psg-vector-grammar "${at} ${vid} unknown or repeated key in '${tok}'")
      endif()
    endforeach()
    while(ki LESS nk)
      list(GET KEY_ORDER ${ki} key)
      if(key STREQUAL "tier" OR key STREQUAL "cite")
        pfail(psg-vector-no-cite-or-tier "${at} ${vid} no ${key}=")
      elseif(NOT key STREQUAL "pin")
        pfail(psg-vector-grammar "${at} ${vid} key ${key} missing")
      endif()
      math(EXPR ki "${ki} + 1")
    endwhile()
    # value shapes
    set(h4 "[0-9A-F][0-9A-F][0-9A-F][0-9A-F]")
    if(NOT "${vals_rule}" MATCHES "^PSG-R[0-9][0-9]$")
      pfail(psg-vector-grammar "${at} ${vid} rule '${vals_rule}'")
    elseif(NOT "${vals_rule}" IN_LIST RULE_IDS)
      pfail(psg-vector-unknown-rule "${at} ${vid} ${vals_rule}")
    else()
      list(APPEND RULE_VECS_${vals_rule} "${vid}")
      list(APPEND RULES_SEEN "${vals_rule}")
    endif()
    if(NOT "${vals_kind}" MATCHES "^(source|policy)$")
      pfail(psg-vector-grammar "${at} ${vid} kind '${vals_kind}'")
    endif()
    if(NOT "${vals_set}" MATCHES "^(-|${h4}:${h4}(@[0-9]+)?(\\+${h4}:${h4}(@[0-9]+)?)*)$")
      pfail(psg-vector-grammar "${at} ${vid} set '${vals_set}'")
    endif()
    if(NOT "${vals_steps}" MATCHES "^[0-9]+$")
      pfail(psg-vector-grammar "${at} ${vid} steps '${vals_steps}'")
    endif()
    if("${vals_expect}" MATCHES "^([a-z0-9-]+):[^ ]+$")
      set(ekind "${CMAKE_MATCH_1}")
      if(NOT "${ekind}" IN_LIST EXPECT_KINDS)
        pfail(psg-vector-grammar "${at} ${vid} expect kind '${ekind}'")
      endif()
    else()
      pfail(psg-vector-grammar "${at} ${vid} expect '${vals_expect}'")
    endif()
    # pin shape, when a pin token exists
    foreach(tok IN LISTS toks)
      if(tok MATCHES "^pin=(.*)$")
        set(pinval "${CMAKE_MATCH_1}")
        if(NOT "${pinval}" MATCHES "^[01]:[0-9A-F][0-9A-F]$")
          pfail(psg-vector-grammar "${at} ${vid} pin '${pinval}'")
        endif()
      endif()
    endforeach()
    # kind, tier and cite relations
    if("${vals_kind}" STREQUAL "source")
      if(NOT "${vals_tier}" STREQUAL "source-expectation")
        pfail(psg-vector-no-cite-or-tier "${at} ${vid} source vector tier '${vals_tier}'")
      endif()
      if("${vals_cite}" STREQUAL "none")
        pfail(psg-vector-no-cite-or-tier "${at} ${vid} source vector without a cite")
      endif()
    elseif("${vals_kind}" STREQUAL "policy")
      list(APPEND USED_POLICIES "${vals_tier}")
      if(NOT "${vals_tier}" IN_LIST POLICY_IDS)
        pfail(psg-rule-unknown-default-unresolved "${at} ${vid} policy '${vals_tier}' is not in data/expected/psg-policies.ids")
      endif()
    endif()
    if(NOT "${vals_cite}" STREQUAL "" AND NOT "${vals_cite}" STREQUAL "none")
      if("${vals_cite}" MATCHES "^(SRC-[a-z0-9-]+)@[A-Za-z0-9._,-]+$")
        set(csrc "${CMAKE_MATCH_1}")
        if(NOT "${csrc}" IN_LIST SRC_IDS)
          pfail(psg-vector-no-cite-or-tier "${at} ${vid} cite source ${csrc} is not registered")
        endif()
      else()
        pfail(psg-vector-no-cite-or-tier "${at} ${vid} cite '${vals_cite}'")
      endif()
    endif()
  endforeach()
endforeach()

# Policy ids that no vector names.
foreach(pid IN LISTS POLICY_IDS)
  if(NOT pid IN_LIST USED_POLICIES)
    pfail(psg-rule-unknown-default-unresolved "policy ${pid} is named by no vector")
  endif()
endforeach()

# Rule coverage in both directions.
foreach(rid IN LISTS RULE_IDS)
  set(have ${RULE_VECS_${rid}})
  if(NOT have)
    pfail(psg-rule-without-vector "${rid} has no vector")
    continue()
  endif()
  list(SORT have)
  set(want ${RVEC_${rid}})
  list(SORT want)
  if(NOT "${have}" STREQUAL "${want}")
    pfail(psg-rule-without-vector "${rid} vectors list differs from the vectors naming the rule")
  endif()
endforeach()

# Register-address literal: sixteen rows 01F0..01FF, each once.
file(STRINGS "${FILELIST}" paths2)
foreach(p IN LISTS paths2)
  if(p MATCHES "^data/psg/[^/]+[.]regmap[.]literal[.]txt$" AND EXISTS "${ROOT}/${p}")
    file(READ "${ROOT}/${p}" rtxt)
    gate_lines(rlines "${rtxt}")
    set(raddrs "")
    foreach(l IN LISTS rlines)
      gate_unprotect(l "${l}")
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      if(NOT l MATCHES "^(01F[0-9A-F]) role=[a-z-]+ gi=R[0-9]+ n=[0-9]+ w=([0-9A-F][0-9A-F][0-9A-F][0-9A-F]) r=([0-9A-F][0-9A-F][0-9A-F][0-9A-F]) src=(SRC-[a-z0-9-]+)@[A-Za-z0-9._,-]+ tag=[a-z0-9-]+ conf=C[0-9]+$")
        pfail(psg-vector-grammar "${p} malformed row '${l}'")
        continue()
      endif()
      set(ra "${CMAKE_MATCH_1}")
      set(rwm "${CMAKE_MATCH_2}")
      set(rrm "${CMAKE_MATCH_3}")
      set(rsrc "${CMAKE_MATCH_4}")
      if(ra IN_LIST raddrs)
        pfail(psg-vector-grammar "${p} duplicate address ${ra}")
      endif()
      list(APPEND raddrs "${ra}")
      set(LITW_${ra} "${rwm}")
      set(LITR_${ra} "${rrm}")
      if(NOT "${rsrc}" IN_LIST SRC_IDS)
        pfail(psg-vector-grammar "${p} ${ra} unknown source ${rsrc}")
      endif()
    endforeach()
    list(LENGTH raddrs nra)
    if(NOT nra EQUAL 16)
      pfail(psg-vector-grammar "${p} has ${nra} rows, want 16")
    elseif(p MATCHES "^data/psg/([^/]+)[.]regmap[.]literal[.]txt$")
      # The profile's psg.regmap against the literal: address, write mask and read mask of every record.
      set(pstem "${CMAKE_MATCH_1}")
      set(prel "data/profiles/${pstem}.json")
      if(EXISTS "${ROOT}/${prel}")
        file(READ "${ROOT}/${prel}" pdoc)
        string(JSON nrec ERROR_VARIABLE e LENGTH "${pdoc}" fields psg.regmap value)
        if(NOT "${e}" STREQUAL "NOTFOUND")
          pfail(psg-regmap-profile-mismatch "${prel} has no fields.psg.regmap array to compare with ${p}")
        elseif(NOT nrec EQUAL 16)
          pfail(psg-regmap-profile-mismatch "${prel} psg.regmap has ${nrec} records, ${p} has 16")
        else()
          set(rk 0)
          foreach(ra IN LISTS raddrs)
            string(JSON paddr ERROR_VARIABLE e1 GET "${pdoc}" fields psg.regmap value ${rk} addr)
            string(JSON pw ERROR_VARIABLE e2 GET "${pdoc}" fields psg.regmap value ${rk} wmask)
            string(JSON pr ERROR_VARIABLE e3 GET "${pdoc}" fields psg.regmap value ${rk} rmask)
            if(NOT "${e1}${e2}${e3}" STREQUAL "NOTFOUNDNOTFOUNDNOTFOUND")
              pfail(psg-regmap-profile-mismatch "${prel} psg.regmap record ${rk} has no addr, wmask or rmask")
            elseif(NOT "${paddr}" STREQUAL "${DOLLAR}${ra}" OR NOT "${pw}" STREQUAL "${DOLLAR}${LITW_${ra}}"
                   OR NOT "${pr}" STREQUAL "${DOLLAR}${LITR_${ra}}")
              pfail(psg-regmap-profile-mismatch "${prel} psg.regmap record ${rk} is ${paddr} w=${pw} r=${pr}, ${p} has ${ra} w=${LITW_${ra}} r=${LITR_${ra}}")
            endif()
            math(EXPR rk "${rk} + 1")
          endforeach()
        endif()
      endif()
    endif()
  endif()
endforeach()

# Rule fields against the profile inventory and the pending list.
if(EXISTS "${ROOT}/data/expected/profile-fields.ids")
  read_list(PROFILE_FIELDS "data/expected/profile-fields.ids")
  if(NOT EXISTS "${ROOT}/data/psg/fields-pending.ids")
    pfail(psg-rule-field-missing "data/psg/fields-pending.ids is missing")
  endif()
  read_pending(PENDING_FIELDS "data/psg/fields-pending.ids")
  foreach(rid IN LISTS RULE_IDS)
    foreach(fld IN LISTS RFIELDS_${rid})
      if(NOT fld MATCHES "^engine:" AND NOT fld IN_LIST PROFILE_FIELDS AND NOT fld IN_LIST PENDING_FIELDS)
        pfail(psg-rule-field-missing "${rid} field ${fld} is neither in data/expected/profile-fields.ids nor in data/psg/fields-pending.ids")
      endif()
    endforeach()
  endforeach()
  foreach(fld IN LISTS PENDING_FIELDS)
    if(fld IN_LIST PROFILE_FIELDS)
      pfail(psg-field-pending-stale "data/psg/fields-pending.ids lists ${fld}, which the profile now has")
    endif()
  endforeach()
endif()

# Vector families against the suite's test inventory: wired families are registered, pending ones are not.
if(EXISTS "${ROOT}/data/expected/tests/psg.ids" OR EXISTS "${ROOT}/data/psg/vectors-pending.ids")
  foreach(need data/expected/tests/psg.ids data/psg/vectors-pending.ids)
    if(NOT EXISTS "${ROOT}/${need}")
      pfail(psg-vector-registration "${need} is missing")
    endif()
  endforeach()
  read_list(PSG_TEST_IDS "data/expected/tests/psg.ids")
  read_pending(PENDING_FAMILIES "data/psg/vectors-pending.ids")
  foreach(vid IN LISTS ALL_IDS)
    if(vid MATCHES "^psg[.]([A-Za-z0-9-]+)[.]")
      set(fam "${CMAKE_MATCH_1}")
      if(fam IN_LIST PENDING_FAMILIES)
        if(vid IN_LIST PSG_TEST_IDS)
          pfail(psg-vector-registration "${vid} is in data/expected/tests/psg.ids but family ${fam} is still pending")
        endif()
      elseif(NOT vid IN_LIST PSG_TEST_IDS)
        pfail(psg-vector-registration "${vid} (family ${fam}) is not in data/expected/tests/psg.ids and the family is not pending")
      endif()
    endif()
  endforeach()
endif()

foreach(tok IN LISTS PTOKENS)
  gate_count(n "tok_${tok}")
  if(n GREATER ${CAP})
    gate_fail(${tok} "${n} findings in total, first ${CAP} listed")
  endif()
endforeach()

list(LENGTH POLICY_IDS n_pol)
gate_stat(psg-vectors ${n_vec})
gate_stat(psg-policies ${n_pol})
gate_finish(psgvec)
