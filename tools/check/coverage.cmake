# SPDX-License-Identifier: MIT
# Decode coverage of the CP-1610 family table (FND-06, D-12.8, D-12.9).
# Input (passed with -D): ROOT, the tree under test (required).
# For every 10-bit decle pattern p in 0..1023 the rows whose fixed bits and `eq` relations hold for p
# are its matches; a match that is the `refines` target of another match is not a leaf.
#   zero matches                         -> coverage-unclaimed: <10-bit binary>
#   leaves not all linked by also_encodes -> coverage-ambiguous: <10-bit binary>
#   leaves all linked by also_encodes     -> one coincidence
#   a refining row matching where its target does not -> coverage-refines-outside: <id>
#   no rows at all                        -> coverage-empty
# Stats: patterns=<n> unclaimed=<n> ambiguous=<n> coincidences=<n>.
# At most 20 findings are listed; the totals are always exact.
# Speed: rows are read once into parallel lists; per pattern only an integer mask test runs per row
# and the relations are evaluated for the few rows that pass it.
cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED ROOT OR "${ROOT}" STREQUAL "")
  message(FATAL_ERROR "coverage.cmake is missing ROOT")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")

set(CAP 20)

function(bin10 out p)
  set(s "")
  set(v ${p})
  foreach(i RANGE 1 10)
    math(EXPR b "${v} & 1")
    math(EXPR v "${v} >> 1")
    set(s "${b}${s}")
  endforeach()
  set(${out} "${s}" PARENT_SCOPE)
endfunction()

# Report a finding unless the cap is reached; the first finding past the cap says so once.
function(report token detail)
  gate_incr(findings)
  gate_count(n findings)
  if(n LESS_EQUAL ${CAP})
    gate_fail(${token} "${detail}")
  else()
    math(EXPR capnext "${CAP} + 1")
    if(n EQUAL capnext)
      gate_fail(coverage-more "further findings not listed (cap ${CAP})")
    endif()
  endif()
endfunction()

read_record_file(DOC "data/cp1610/opcode-families.json" coverage)
set(IDS "")
set(MASKS "")
set(VALS "")
set(REFS "")
set(EQS "")
set(ALSO "")
set(IDXS "")
set(nrows 0)
if(NOT "${DOC}" STREQUAL "")
  json_type(rows_type "${DOC}" rows)
  set(n 0)
  if(rows_type STREQUAL ARRAY)
    string(JSON n LENGTH "${DOC}" rows)
  endif()
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    # Pass 1: ids, masks, values, relations.
    foreach(i RANGE 0 ${last})
      string(JSON rec GET "${DOC}" rows ${i})
      set(id "#${i}")
      json_type(it "${rec}" id)
      if(it STREQUAL STRING)
        string(JSON id GET "${rec}" id)
      endif()
      set(pattern "")
      json_type(pt "${rec}" pattern)
      if(pt STREQUAL STRING)
        string(JSON pattern GET "${rec}" pattern)
      endif()
      if(NOT "${pattern}" MATCHES "^[01.][01.][01.][01.][01.][01.][01.][01.][01.][01.]$")
        gate_fail(coverage-bad-row "${id}")
        continue()
      endif()
      set(mask 0)
      set(val 0)
      string(REGEX REPLACE "(.)" "\\1;" chars "${pattern}")
      foreach(c IN LISTS chars)
        if("${c}" STREQUAL "")
          continue()
        endif()
        if("${c}" STREQUAL ".")
          math(EXPR mask "${mask} * 2")
          math(EXPR val "${val} * 2")
        elseif("${c}" STREQUAL "1")
          math(EXPR mask "${mask} * 2 + 1")
          math(EXPR val "${val} * 2 + 1")
        else()
          math(EXPR mask "${mask} * 2 + 1")
          math(EXPR val "${val} * 2")
        endif()
      endforeach()
      # eq relations, kept as "h1,l1,h2,l2" entries joined with "|" ("-" when none).
      set(eqs "")
      json_type(et "${rec}" eq)
      if(et STREQUAL ARRAY)
        string(JSON en LENGTH "${rec}" eq)
        if(en GREATER 0)
          math(EXPR elast "${en} - 1")
          foreach(k RANGE 0 ${elast})
            string(JSON e GET "${rec}" eq ${k})
            if("${e}" MATCHES "^([0-9]+):([0-9]+)=([0-9]+):([0-9]+)$")
              list(APPEND eqs "${CMAKE_MATCH_1},${CMAKE_MATCH_2},${CMAKE_MATCH_3},${CMAKE_MATCH_4}")
            else()
              gate_fail(coverage-bad-row "${id}")
            endif()
          endforeach()
        endif()
      endif()
      if("${eqs}" STREQUAL "")
        set(eqs "-")
      else()
        string(REPLACE ";" "|" eqs "${eqs}")
      endif()
      # also_encodes ids wrapped as "|a|b|" for exact substring tests.
      set(also "|")
      json_type(at "${rec}" also_encodes)
      if(at STREQUAL ARRAY)
        string(JSON an LENGTH "${rec}" also_encodes)
        if(an GREATER 0)
          math(EXPR alast "${an} - 1")
          foreach(k RANGE 0 ${alast})
            string(JSON a GET "${rec}" also_encodes ${k})
            set(also "${also}${a}|")
          endforeach()
        endif()
      endif()
      list(APPEND IDS "${id}")
      list(APPEND MASKS "${mask}")
      list(APPEND VALS "${val}")
      list(APPEND EQS "${eqs}")
      list(APPEND ALSO "${also}")
      list(APPEND IDXS "${nrows}")
      math(EXPR nrows "${nrows} + 1")
    endforeach()
    # Pass 2: refines targets as row indexes (-1 none, -2 unknown id).
    foreach(i RANGE 0 ${last})
      string(JSON rec GET "${DOC}" rows ${i})
      set(pattern "")
      json_type(pt "${rec}" pattern)
      if(pt STREQUAL STRING)
        string(JSON pattern GET "${rec}" pattern)
      endif()
      if(NOT "${pattern}" MATCHES "^[01.][01.][01.][01.][01.][01.][01.][01.][01.][01.]$")
        continue()
      endif()
      set(target -1)
      json_type(rt "${rec}" refines)
      if(rt STREQUAL STRING)
        string(JSON refines GET "${rec}" refines)
        list(FIND IDS "${refines}" target)
        if(target EQUAL -1)
          set(target -2)
        endif()
      endif()
      list(APPEND REFS "${target}")
    endforeach()
  endif()
endif()

if(nrows EQUAL 0)
  gate_fail(coverage-empty "data/cp1610/opcode-families.json")
  set(unclaimed 0)
  set(ambiguous 0)
  set(coincidences 0)
else()
  set(unclaimed 0)
  set(ambiguous 0)
  set(coincidences 0)
  foreach(p RANGE 0 1023)
    set(matches "")
    foreach(m v i IN ZIP_LISTS MASKS VALS IDXS)
      math(EXPR x "${p} & ${m}")
      if(NOT x EQUAL v)
        continue()
      endif()
      list(GET EQS ${i} eqs)
      if(NOT "${eqs}" STREQUAL "-")
        set(holds TRUE)
        string(REPLACE "|" ";" eqlist "${eqs}")
        foreach(e IN LISTS eqlist)
          string(REPLACE "," ";" f "${e}")
          list(GET f 0 h1)
          list(GET f 1 l1)
          list(GET f 2 h2)
          list(GET f 3 l2)
          math(EXPR w "(1 << (${h1} - ${l1} + 1)) - 1")
          math(EXPR a "(${p} >> ${l1}) & ${w}")
          math(EXPR b "(${p} >> ${l2}) & ${w}")
          if(NOT a EQUAL b)
            set(holds FALSE)
          endif()
        endforeach()
        if(NOT holds)
          continue()
        endif()
      endif()
      list(APPEND matches ${i})
    endforeach()
    list(LENGTH matches nm)
    if(nm EQUAL 0)
      math(EXPR unclaimed "${unclaimed} + 1")
      bin10(bits ${p})
      report(coverage-unclaimed "${bits}")
      continue()
    endif()
    # Leaves: matches that no other match refines; a refining row must sit inside its target.
    set(targets "")
    foreach(i IN LISTS matches)
      list(GET REFS ${i} t)
      if(t GREATER_EQUAL 0)
        if(NOT "${t}" IN_LIST matches)
          list(GET IDS ${i} rid)
          report(coverage-refines-outside "${rid}")
        endif()
        list(APPEND targets ${t})
      endif()
    endforeach()
    set(leaves "")
    foreach(i IN LISTS matches)
      if(NOT "${i}" IN_LIST targets)
        list(APPEND leaves ${i})
      endif()
    endforeach()
    list(LENGTH leaves nl)
    if(nl EQUAL 1)
      continue()
    endif()
    if(nl EQUAL 0)
      math(EXPR ambiguous "${ambiguous} + 1")
      bin10(bits ${p})
      report(coverage-ambiguous "${bits}")
      continue()
    endif()
    # Several leaves are a declared coincidence only when every pair is linked by also_encodes.
    set(linked TRUE)
    math(EXPR lastl "${nl} - 1")
    foreach(x RANGE 0 ${lastl})
      foreach(y RANGE 0 ${lastl})
        if(x LESS y)
          list(GET leaves ${x} lx)
          list(GET leaves ${y} ly)
          list(GET IDS ${lx} idx)
          list(GET IDS ${ly} idy)
          list(GET ALSO ${lx} alx)
          list(GET ALSO ${ly} aly)
          string(FIND "${alx}" "|${idy}|" fxy)
          string(FIND "${aly}" "|${idx}|" fyx)
          if(fxy EQUAL -1 AND fyx EQUAL -1)
            set(linked FALSE)
          endif()
        endif()
      endforeach()
    endforeach()
    if(linked)
      math(EXPR coincidences "${coincidences} + 1")
    else()
      math(EXPR ambiguous "${ambiguous} + 1")
      bin10(bits ${p})
      report(coverage-ambiguous "${bits}")
    endif()
  endforeach()
endif()

gate_stat(patterns 1024)
gate_stat(unclaimed ${unclaimed})
gate_stat(ambiguous ${ambiguous})
gate_stat(coincidences ${coincidences})
gate_finish(coverage)
