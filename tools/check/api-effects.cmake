# SPDX-License-Identifier: MIT
# Static checker of the API effect table (D-06, D-09, D-15, API-06, plan 03-13). It reads, from
# ROOT (the tree under test; the control runner passes its own tree):
#   core/include/ivs/ivs_status.h      the `#define IVS_OK 0` and `#define IVS_E_<NAME> (<n>)` lines
#   data/expected/api-statuses.ids     the frozen status pin, `NAME VALUE` per line
#   core/include/ivs/*.h               every line that starts `IVS_API ` (one-line prototypes; the
#                                      function name is the identifier before the first `(`)
#   data/api/api-effects.json          the effect table
#   data/expected/tests/*.ids          the test inventories (first token per line; `skip-ok` second)
# Inputs (passed with -D): ROOT, CHECK_DIR (unused beyond the guard; kept for the step contract).
# Rules and tokens (every finding is `-- FAIL <token>: <detail>`; at most 20 per token are listed,
# then one line with the exact total):
#   a name defined in the header and pinned with a different value, or one value used by two
#   names (a reused number)                                          api-status-renumbered
#   a name on one side only (header define without a pin line, or a pin line without a define)
#                                                                    api-status-unpinned
#   a defined or pinned value in the reserved band -24..-31          api-status-reserved
#   an IVS_API declaration whose function is not a JSON call (or an IVS_API line without a
#   parsable `name(`)                                                api-call-undocumented
#   a JSON call that no IVS_API line declares                        api-call-undeclared
#   a refusal row, or a precedence `pinned_by` entry, citing a test id that is not a first token
#   of data/expected/tests/*.ids, a row with no test, or a row whose tests are all skip-ok
#                                                                    api-refusal-no-test
#   a refusal row whose effect is not a name of the `effects` registry  api-effect-unregistered
#   a pinned non-OK status that no refusal row of any call names     api-dead-status
#   shape: unreadable or missing input, bad JSON, schema_version not 1, missing, mistyped or
#   unknown keys, duplicate call or effect names, a call header other than the header that
#   declares it, a row or precedence status that is not a pinned non-OK name, two rows of one
#   call with the same status, a precedence status without a row of that call or a row status
#   absent from the call's precedence, an unparsable status define      api-effects-format
# The IVS_API list equality is the D-06 symbol check (the JSON `calls` are the symbol list; there
# is no separate calls inventory). Header self-containment is suite headers (plan 03-12).
# Residual (OQ-5): a cited test id is proven to exist in an inventory (and tests-inventory proves
# it ran in both presets), not to assert the row's status; each cited case asserts its own status.
# Stats: api-calls=<JSON calls> api-statuses=<pinned statuses, OK included> api-rows=<refusal rows>.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT CHECK_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "api-effects.cmake is missing ${required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")

set(CAP 20)
set(ATOKENS api-status-renumbered api-status-unpinned api-status-reserved api-call-undocumented
  api-call-undeclared api-refusal-no-test api-effect-unregistered api-dead-status api-effects-format)
set(STATUS_H "core/include/ivs/ivs_status.h")
set(PIN "data/expected/api-statuses.ids")
set(TABLE "data/api/api-effects.json")

# Finding with a per-token cap; totals are reported at the end.
function(afail token detail)
  gate_incr("tok_${token}")
  gate_count(n "tok_${token}")
  if(n LESS_EQUAL ${CAP})
    gate_fail(${token} "${detail}")
  endif()
endfunction()

# ---- 1. statuses: header defines against the pin ----
set(H_NAMES "")
if(EXISTS "${ROOT}/${STATUS_H}")
  file(STRINGS "${ROOT}/${STATUS_H}" hlines)
  foreach(l IN LISTS hlines)
    if(NOT l MATCHES "^[ \t]*#[ \t]*define[ \t]+(IVS_OK|IVS_E_[A-Za-z0-9_]*)([ \t]|$)")
      continue()
    endif()
    if(l MATCHES "^[ \t]*#[ \t]*define[ \t]+(IVS_OK|IVS_E_[A-Z0-9_]+)[ \t]+[(]?(-?[0-9]+)[)]?[ \t]*(/[*].*)?$")
      set(nm "${CMAKE_MATCH_1}")
      set(v "${CMAKE_MATCH_2}")
      if(nm IN_LIST H_NAMES)
        afail(api-effects-format "${STATUS_H}: ${nm} defined twice")
        continue()
      endif()
      list(APPEND H_NAMES "${nm}")
      set("H_VAL_${nm}" "${v}")
    else()
      afail(api-effects-format "${STATUS_H}: unparsable status define: ${l}")
    endif()
  endforeach()
else()
  afail(api-effects-format "${STATUS_H} missing")
endif()

set(P_NAMES "")
if(EXISTS "${ROOT}/${PIN}")
  file(STRINGS "${ROOT}/${PIN}" plines)
  foreach(l IN LISTS plines)
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    if(l MATCHES "^([A-Za-z0-9_]+)[ \t]+(-?[0-9]+)$")
      set(nm "${CMAKE_MATCH_1}")
      set(v "${CMAKE_MATCH_2}")
      if(nm IN_LIST P_NAMES)
        afail(api-effects-format "${PIN}: ${nm} pinned twice")
        continue()
      endif()
      list(APPEND P_NAMES "${nm}")
      set("P_VAL_${nm}" "${v}")
    else()
      afail(api-effects-format "${PIN}: unparsable line: ${l}")
    endif()
  endforeach()
else()
  afail(api-effects-format "${PIN} missing")
endif()

foreach(nm IN LISTS H_NAMES)
  if(NOT nm IN_LIST P_NAMES)
    afail(api-status-unpinned "${nm} (${H_VAL_${nm}}) is defined in ${STATUS_H} but not pinned in ${PIN}")
  elseif(NOT "${H_VAL_${nm}}" STREQUAL "${P_VAL_${nm}}")
    afail(api-status-renumbered "${nm} is ${H_VAL_${nm}} in ${STATUS_H} but pinned ${P_VAL_${nm}} in ${PIN}")
  endif()
endforeach()
foreach(nm IN LISTS P_NAMES)
  if(NOT nm IN_LIST H_NAMES)
    afail(api-status-unpinned "${nm} (${P_VAL_${nm}}) is pinned in ${PIN} but not defined in ${STATUS_H}")
  endif()
endforeach()
# Reserved band and reused numbers, on each side.
foreach(side H P)
  if(side STREQUAL "H")
    set(where "${STATUS_H}")
  else()
    set(where "${PIN}")
  endif()
  set(seen "")
  foreach(nm IN LISTS ${side}_NAMES)
    set(v "${${side}_VAL_${nm}}")
    if(v GREATER_EQUAL -31 AND v LESS_EQUAL -24)
      afail(api-status-reserved "${nm} = ${v} in ${where} (-24..-31 are reserved)")
    endif()
    if("v${v}" IN_LIST seen)
      afail(api-status-renumbered "${nm} reuses value ${v} in ${where}")
    endif()
    list(APPEND seen "v${v}")
  endforeach()
endforeach()
# A status the rows may name: pinned and not IVS_OK.
set(REFUSAL_NAMES ${P_NAMES})
list(REMOVE_ITEM REFUSAL_NAMES IVS_OK)

# ---- 2. the IVS_API declarations of core/include/ivs/*.h ----
set(DECL_NAMES "")
file(GLOB headers RELATIVE "${ROOT}" "${ROOT}/core/include/ivs/*.h")
list(SORT headers)
foreach(h IN LISTS headers)
  file(STRINGS "${ROOT}/${h}" dlines)
  foreach(l IN LISTS dlines)
    if(NOT l MATCHES "^IVS_API[ \t]")
      continue()
    endif()
    if(l MATCHES "([A-Za-z_][A-Za-z0-9_]*)[ \t]*[(]")
      set(fn "${CMAKE_MATCH_1}")
      if(fn IN_LIST DECL_NAMES)
        afail(api-effects-format "${fn} is declared IVS_API twice (${DECL_HDR_${fn}} and ${h})")
        continue()
      endif()
      list(APPEND DECL_NAMES "${fn}")
      set("DECL_HDR_${fn}" "${h}")
    else()
      afail(api-call-undocumented "${h}: IVS_API line without a parsable name(: ${l}")
    endif()
  endforeach()
endforeach()

# ---- 3. test inventories ----
set(TEST_IDS "")
set(SKIP_IDS "")
file(GLOB inventories RELATIVE "${ROOT}" "${ROOT}/data/expected/tests/*.ids")
foreach(f IN LISTS inventories)
  file(STRINGS "${ROOT}/${f}" tlines)
  foreach(l IN LISTS tlines)
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    if(l MATCHES "^([^ \t]+)[ \t]+skip-ok")
      list(APPEND SKIP_IDS "${CMAKE_MATCH_1}")
    endif()
    string(REGEX REPLACE "[ \t].*$" "" l "${l}")
    list(APPEND TEST_IDS "${l}")
  endforeach()
endforeach()

# ---- 4. the effect table ----
# Fetches a JSON value; on a missing path or a wrong type reports api-effects-format and returns
# the empty string. TYPE is the expected string(JSON TYPE) result.
function(jget out type where doc)
  set(${out} "" PARENT_SCOPE)
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" ${ARGN})
  if(NOT "${e}" STREQUAL "NOTFOUND")
    string(REPLACE ";" "." p "${ARGN}")
    afail(api-effects-format "${where}: missing ${p}")
    return()
  endif()
  if(NOT t STREQUAL "${type}")
    string(REPLACE ";" "." p "${ARGN}")
    afail(api-effects-format "${where}: ${p} is ${t}, not ${type}")
    return()
  endif()
  string(JSON v GET "${doc}" ${ARGN})
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Reports every member of obj outside the allowed list.
function(keys_only where obj)
  json_members(ks "${obj}")
  foreach(k IN LISTS ks)
    if(NOT k IN_LIST ARGN)
      afail(api-effects-format "${where}: unknown key ${k}")
    endif()
  endforeach()
endfunction()

# Checks a list of test ids (a JSON array of strings) against the inventories. Sets out to the
# number of ids that are present and not skip-ok.
function(check_tests out where arr)
  set(live 0)
  string(JSON n LENGTH "${arr}")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON tt TYPE "${arr}" ${i})
      if(NOT tt STREQUAL "STRING")
        afail(api-effects-format "${where}: test entry ${i} is ${tt}, not STRING")
        continue()
      endif()
      string(JSON id GET "${arr}" ${i})
      if(NOT id IN_LIST TEST_IDS)
        afail(api-refusal-no-test "${where}: ${id} is not a test id of data/expected/tests/*.ids")
      elseif(NOT id IN_LIST SKIP_IDS)
        math(EXPR live "${live} + 1")
      endif()
    endforeach()
  endif()
  set(${out} "${live}" PARENT_SCOPE)
endfunction()

set(n_calls 0)
set(n_rows 0)
set(CALL_NAMES "")
set(ROW_STATUSES "")
set(EFFECT_NAMES "")
set(doc "")
if(EXISTS "${ROOT}/${TABLE}")
  file(READ "${ROOT}/${TABLE}" doc)
  string(JSON t ERROR_VARIABLE e TYPE "${doc}")
  if(NOT "${e}" STREQUAL "NOTFOUND" OR NOT t STREQUAL "OBJECT")
    afail(api-effects-format "${TABLE}: not a JSON object")
    set(doc "")
  endif()
else()
  afail(api-effects-format "${TABLE} missing")
endif()

if(NOT doc STREQUAL "")
  keys_only("${TABLE}" "${doc}" schema_version note effects calls)
  jget(sv NUMBER "${TABLE}" "${doc}" schema_version)
  if(NOT "${sv}" STREQUAL "" AND NOT sv EQUAL 1)
    afail(api-effects-format "${TABLE}: schema_version ${sv}, not 1")
  endif()
  jget(dummy STRING "${TABLE}" "${doc}" note)

  # The effects registry.
  jget(effects ARRAY "${TABLE}" "${doc}" effects)
  if(NOT effects STREQUAL "")
    string(JSON ne LENGTH "${effects}")
    if(ne EQUAL 0)
      afail(api-effects-format "${TABLE}: the effects registry is empty")
    else()
      math(EXPR last "${ne} - 1")
      foreach(i RANGE 0 ${last})
        jget(ef OBJECT "${TABLE} effects[${i}]" "${effects}" ${i})
        if(ef STREQUAL "")
          continue()
        endif()
        keys_only("${TABLE} effects[${i}]" "${ef}" name definition)
        jget(en STRING "${TABLE} effects[${i}]" "${ef}" name)
        jget(dummy STRING "${TABLE} effects[${i}]" "${ef}" definition)
        if(en STREQUAL "")
          continue()
        endif()
        if(en IN_LIST EFFECT_NAMES)
          afail(api-effects-format "${TABLE}: effect ${en} registered twice")
        endif()
        list(APPEND EFFECT_NAMES "${en}")
      endforeach()
    endif()
  endif()

  # The calls.
  jget(calls ARRAY "${TABLE}" "${doc}" calls)
  if(NOT calls STREQUAL "")
    string(JSON nc LENGTH "${calls}")
    set(n_calls ${nc})
    if(nc GREATER 0)
      math(EXPR clast "${nc} - 1")
      foreach(ci RANGE 0 ${clast})
        jget(call OBJECT "${TABLE} calls[${ci}]" "${calls}" ${ci})
        if(call STREQUAL "")
          continue()
        endif()
        keys_only("${TABLE} calls[${ci}]" "${call}" name header on_ok precedence notes refusals)
        jget(cn STRING "${TABLE} calls[${ci}]" "${call}" name)
        if(cn STREQUAL "")
          continue()
        endif()
        set(w "${TABLE} ${cn}")
        if(cn IN_LIST CALL_NAMES)
          afail(api-effects-format "${w}: call listed twice")
        endif()
        list(APPEND CALL_NAMES "${cn}")
        jget(hdr STRING "${w}" "${call}" header)
        jget(dummy STRING "${w}" "${call}" on_ok)
        jget(notes ARRAY "${w}" "${call}" notes)
        if(NOT notes STREQUAL "")
          string(JSON nn LENGTH "${notes}")
          if(nn GREATER 0)
            math(EXPR nlast "${nn} - 1")
            foreach(ni RANGE 0 ${nlast})
              jget(dummy STRING "${w} notes" "${notes}" ${ni})
            endforeach()
          endif()
        endif()
        if(cn IN_LIST DECL_NAMES AND NOT hdr STREQUAL "" AND NOT hdr STREQUAL "${DECL_HDR_${cn}}")
          afail(api-effects-format "${w}: header ${hdr}, but it is declared in ${DECL_HDR_${cn}}")
        endif()

        # Refusal rows.
        set(call_rows "")
        jget(rows ARRAY "${w}" "${call}" refusals)
        if(NOT rows STREQUAL "")
          string(JSON nr LENGTH "${rows}")
          if(nr GREATER 0)
            math(EXPR rlast "${nr} - 1")
            foreach(ri RANGE 0 ${rlast})
              jget(row OBJECT "${w} refusals[${ri}]" "${rows}" ${ri})
              if(row STREQUAL "")
                continue()
              endif()
              math(EXPR n_rows "${n_rows} + 1")
              keys_only("${w} refusals[${ri}]" "${row}" status effect outs tests)
              jget(st STRING "${w} refusals[${ri}]" "${row}" status)
              jget(eff STRING "${w} refusals[${ri}]" "${row}" effect)
              jget(dummy STRING "${w} refusals[${ri}]" "${row}" outs)
              jget(tests ARRAY "${w} refusals[${ri}]" "${row}" tests)
              set(rw "${w} ${st}")
              if(NOT st IN_LIST REFUSAL_NAMES)
                afail(api-effects-format "${w} refusals[${ri}]: status '${st}' is not a pinned non-OK status")
              elseif(st IN_LIST call_rows)
                afail(api-effects-format "${rw}: two rows with this status")
              else()
                list(APPEND call_rows "${st}")
                list(APPEND ROW_STATUSES "${st}")
              endif()
              if(NOT eff STREQUAL "" AND NOT eff IN_LIST EFFECT_NAMES)
                afail(api-effect-unregistered "${rw}: effect '${eff}' is not in the effects registry")
              endif()
              if(NOT tests STREQUAL "")
                check_tests(live "${rw}" "${tests}")
                if(live EQUAL 0)
                  afail(api-refusal-no-test "${rw}: no cited test is in the inventories and not skip-ok")
                endif()
              endif()
            endforeach()
          endif()
        endif()

        # Precedence: pinned statuses, consistent with the rows, pinning tests in the inventories.
        set(prec_statuses "")
        jget(prec ARRAY "${w}" "${call}" precedence)
        if(NOT prec STREQUAL "")
          string(JSON np LENGTH "${prec}")
          if(np GREATER 0)
            math(EXPR plast "${np} - 1")
            foreach(pi RANGE 0 ${plast})
              jget(pe OBJECT "${w} precedence[${pi}]" "${prec}" ${pi})
              if(pe STREQUAL "")
                continue()
              endif()
              keys_only("${w} precedence[${pi}]" "${pe}" status checks pinned_by)
              jget(pst STRING "${w} precedence[${pi}]" "${pe}" status)
              jget(dummy STRING "${w} precedence[${pi}]" "${pe}" checks)
              if(NOT pst IN_LIST REFUSAL_NAMES)
                afail(api-effects-format "${w} precedence[${pi}]: status '${pst}' is not a pinned non-OK status")
              elseif(NOT pst IN_LIST call_rows)
                afail(api-effects-format "${w} precedence[${pi}]: ${pst} has no refusal row in this call")
              endif()
              list(APPEND prec_statuses "${pst}")
              json_type(pbt "${pe}" pinned_by)
              if(NOT pbt STREQUAL "MISSING")
                jget(pb ARRAY "${w} precedence[${pi}]" "${pe}" pinned_by)
                if(NOT pb STREQUAL "")
                  check_tests(dummy "${w} precedence[${pi}] pinned_by" "${pb}")
                endif()
              endif()
            endforeach()
          endif()
        endif()
        foreach(st IN LISTS call_rows)
          if(NOT st IN_LIST prec_statuses)
            afail(api-effects-format "${w}: row ${st} is absent from the call's precedence")
          endif()
        endforeach()
      endforeach()
    endif()
  endif()
endif()

# ---- 5. symbol list equality (D-06) and dead statuses ----
foreach(fn IN LISTS DECL_NAMES)
  if(NOT fn IN_LIST CALL_NAMES)
    afail(api-call-undocumented "${fn} (${DECL_HDR_${fn}}) has no call in ${TABLE}")
  endif()
endforeach()
foreach(cn IN LISTS CALL_NAMES)
  if(NOT cn IN_LIST DECL_NAMES)
    afail(api-call-undeclared "${cn} is a call of ${TABLE} but no core/include/ivs/*.h line declares it IVS_API")
  endif()
endforeach()
foreach(st IN LISTS REFUSAL_NAMES)
  if(NOT st IN_LIST ROW_STATUSES)
    afail(api-dead-status "${st} (${P_VAL_${st}}) has no refusal row in ${TABLE}")
  endif()
endforeach()

# Exact totals for capped tokens.
foreach(tok IN LISTS ATOKENS)
  gate_count(n "tok_${tok}")
  if(n GREATER ${CAP})
    gate_fail(${tok} "${n} findings in total, first ${CAP} listed")
  endif()
endforeach()

list(LENGTH P_NAMES n_statuses)
gate_stat(api-calls ${n_calls})
gate_stat(api-statuses ${n_statuses})
gate_stat(api-rows ${n_rows})
gate_finish(api-effects)
