# SPDX-License-Identifier: MIT
# Structural checker of the Phase 6 oracle files of the first STIC (VID-01..VID-04; D-01, D-02, D-12, D-13, D-18; plan 06-01),
# pure and text based: no renderer and no core output is read.
# Inputs (passed with -D): ROOT (tree under test), FILELIST (repo-relative paths, one per line), CHECK_DIR (the real tools/check).
# Closed token list (every finding is `-- FAIL <token>: <detail>`; at most 20 per token are listed, then one line with the exact total):
#   video-verdict-key-missing        a page-reading verdict key of docs/stic/reference-notes.md absent or not `<key>: <yes|no|partial> (...)`
#   video-regmap-row-count           a register-address literal (data/stic/*.regmap.literal.txt) without exactly 64 rows
#   video-regmap-row-bad             a row outside the row grammar, an address that is not the next of 0000..003F, a tag outside the
#                                    allowed set (a tier-5 tag is refused) or a source that is not an id of data/expected/sources.ids
#   video-rule-no-test               a test entry of a rule of data/stic/rules.json that is a prefix of no registered test id and is not
#                                    a line of data/stic/tests-pending.ids
#   video-rule-field-unregistered    a field of a rule (not engine:<name>) that is neither a line of data/expected/profile-fields.ids nor a
#                                    line of data/stic/fields-pending.ids
#   video-pending-stale              a pending line whose field is now in the profile inventory or whose family prefix now has a registered
#                                    test id, or a pending line that is not `<name> 0[68]-NN` (owner plan of Phase 6 or Phase 8)
#   video-geometry-literal           data/video/geometry.literal.txt: a row outside the grammar, a missing, repeated or unknown key, a tag
#                                    outside the allowed set, an unknown source, or an arithmetic relation that does not hold
#                                    (width = (card-columns - 1) x card-px width + last-column-px, height = card-rows x card-px height,
#                                    plane-bytes = width x height, slot-bytes = header-bytes + plane-bytes, width-formula, the visible area
#                                    within the grid, backtab-words = card-columns x card-rows)
#   video-cards-literal-rows         data/video/cards.literal.txt without exactly 64 rows of the grammar, one per (variant, bit),
#                                    each variant with sixteen bits, a role outside the role set, bits 15 and 14 not ign; the same grammar for
#                                    data/video/mob.literal.txt (plan 08-03: exactly 48 rows, one per (register, bit) of mobx, moby and moba,
#                                    every bit above the stored width of its register ign, a source id of data/expected/sources.ids)
#   video-chain-literal              data/video/chain-framing.literal.txt: a row outside the grammar, a missing key, a digest that is not
#                                    64 lowercase hex digits, h0 that is not the SHA-256 of IVS-VIDEO-LOG-V1, or a slot header whose
#                                    tick, index, width, height, flags or reserved field disagrees with the geometry literal
#   video-frame-dimension            a frame whose plane has not exactly 96 rows of 20 groups of 8 symbols
#   video-frame-symbol               a plane symbol outside 0-9A-F, a `-` outside every declared unknown rectangle (plan 08-03, D-05), a
#                                    position inside an unknown rectangle that is not `-`, or the 160th symbol of a row that is not the
#                                    cut-off mark
#   video-frame-tier-missing         a missing or invalid header key (frame, tier, oracle, rules, mode, display, border, stack, fill, sha256-text)
#                                    or a rule id that is not a rule of data/stic/rules.json; a header record outside the grammar, which
#                                    includes a malformed or out-of-plane `unknown <x> <y> <w> <h>` or `mob <i> <x> <y> <w> <h> color=<hex>
#                                    pixels=<n>` record, a repeated MOB index and two unknown rectangles that overlap
#   video-frame-popcount             a cell annotation outside the grammar, a foreground index equal to the background index, a cell whose
#                                    foreground or background pixel count differs from the card pattern, or an unlisted cell that is not uniform
#                                    (every cell whose area meets an unknown or mob rectangle skips the count and uniformity rules, the
#                                    annotation grammar still applies); a MOB colour whose count in the plane differs from the sum of the
#                                    `pixels` of the mob records of that colour, or that occurs outside the union of their rectangles
#   video-frame-hash-drift           the sha256-text key differs from the SHA-256 of the canonical text of the plane (the plane cropped to the
#                                    published width, spaces removed, upper-case hex, one LF-ended line per row); `sha256-text none` exactly when
#                                    the frame has at least one unknown record (a frame with an unknown region has no hash, so no unknown cell
#                                    can become evidence; a frame without one needs its hash)
#   video-frame-unregistered         a data/video/frames/*.frame file that is not an id of data/expected/video-frames.ids, or a listed id without a file
#   video-frame-hash-expect-drift    (plan 06-13, D-02, V6-4) a predicate file data/golden/<id>.expect with an `assert frame <n> hash == <hex>` line
#                                    whose hash differs from the `sha256-text` key of the frame literal that its header line `# frame: <n> <frame id>`
#                                    names, or with no such header line, or one naming a file that does not exist (the frame files are the only place
#                                    a digest is derived; an expectation file may only repeat it), or one naming a frame whose sha256-text is `none`
#                                    (plan 08-03: the frame has no hash)
#   video-frame-pair-region          (plan 07-02, D-21) a line of data/expected/video-frame-pairs.ids outside the grammar
#                                    `<idA> <idB> <x> <y> <w> <h> <count>` (two different frame ids, a rectangle inside the 159 x 96 plane,
#                                    count at least 1), an id that is not a registered frame with a file, a frame without 96 plane rows, a
#                                    pair whose planes differ at a position outside the rectangle (the first such position is named), or
#                                    whose number of differing positions is not count (the planes are compared position by position over the
#                                    published width); a pair that names a frame with an unknown record (plan 08-03: a frame with an
#                                    unknown region cannot be paired)
# Stats: stic-rows=<register rows> video-frames=<frames> video-hash-ties=<hash asserts tied to a frame literal> video-frame-pairs=<declared pairs>.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT FILELIST CHECK_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "video.cmake is missing ${required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")

set(CAP 20)
set(VTOKENS video-verdict-key-missing video-regmap-row-count video-regmap-row-bad video-rule-no-test
  video-rule-field-unregistered video-pending-stale video-geometry-literal video-cards-literal-rows video-chain-literal
  video-frame-dimension video-frame-symbol video-frame-tier-missing video-frame-popcount video-frame-hash-drift
  video-frame-unregistered video-frame-hash-expect-drift video-frame-pair-region)
set(VERDICT_KEYS registers-printed backtab-format-printed color-stack-printed display-enable-printed
  colors-numbered-printed window-lengths-printed bus-hold-printed rows-per-frame-printed visible-geometry-printed
  timing-figure-readable)
set(ALLOWED_TAGS tier1-primary-doc tier2-first-party-adjacent tier4-community unknown-default-chosen inference derived-by-recipe
  delegated-decision owner-decision)

function(pfail token detail)
  gate_incr("tok_${token}")
  gate_count(n "tok_${token}")
  if(n LESS_EQUAL ${CAP})
    gate_fail(${token} "${detail}")
  endif()
endfunction()

# First token of every non-comment, non-blank line of a file.
function(read_list out relpath)
  set(res "")
  if(EXISTS "${ROOT}/${relpath}")
    file(READ "${ROOT}/${relpath}" txt)
    gate_lines(lines "${txt}")
    foreach(l IN LISTS lines)
      gate_unprotect(l "${l}")
      string(STRIP "${l}" l)
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      string(REGEX REPLACE "[ \t].*$" "" first "${l}")
      list(APPEND res "${first}")
    endforeach()
  endif()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# `<name> 06-NN` lines of a pending list: the names, with a finding for a line of another shape.
function(read_pending out relpath)
  set(res "")
  if(EXISTS "${ROOT}/${relpath}")
    file(READ "${ROOT}/${relpath}" txt)
    gate_lines(lines "${txt}")
    set(ln 0)
    foreach(l IN LISTS lines)
      math(EXPR ln "${ln} + 1")
      gate_unprotect(l "${l}")
      string(STRIP "${l}" l)
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      if(l MATCHES "^([A-Za-z][A-Za-z0-9_.-]*) 0[68]-[0-9][0-9]$")
        list(APPEND res "${CMAKE_MATCH_1}")
      else()
        pfail(video-pending-stale "${relpath}:${ln} pending line '${l}' is not '<name> 0[68]-NN'")
      endif()
    endforeach()
  endif()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# Paths of FILELIST that match a regular expression and exist in the tree.
file(STRINGS "${FILELIST}" ALL_PATHS)
function(paths_matching out regex)
  set(res "")
  foreach(p IN LISTS ALL_PATHS)
    if(p MATCHES "${regex}" AND EXISTS "${ROOT}/${p}")
      list(APPEND res "${p}")
    endif()
  endforeach()
  list(SORT res)
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# ---- page-reading verdict keys (D-01)
set(NOTES "${ROOT}/docs/stic/reference-notes.md")
if(EXISTS "${NOTES}")
  file(READ "${NOTES}" ntxt)
  gate_lines(nlines "${ntxt}")
  foreach(key IN LISTS VERDICT_KEYS)
    set(found FALSE)
    foreach(l IN LISTS nlines)
      gate_unprotect(l "${l}")
      if(l MATCHES "^${key}: (yes|no|partial) [(].+[)]$")
        set(found TRUE)
        break()
      endif()
    endforeach()
    if(NOT found)
      pfail(video-verdict-key-missing "docs/stic/reference-notes.md ${key}")
    endif()
  endforeach()
else()
  pfail(video-verdict-key-missing "docs/stic/reference-notes.md is missing")
endif()

# ---- register-address literal tiling (D-02, D-04)
read_list(SRC_IDS "data/expected/sources.ids")
paths_matching(REGMAPS "^data/stic/[^/]+[.]regmap[.]literal[.]txt$")
set(n_rows 0)
foreach(p IN LISTS REGMAPS)
  file(READ "${ROOT}/${p}" txt)
  gate_lines(lines "${txt}")
  set(idx 0)
  foreach(l IN LISTS lines)
    gate_unprotect(l "${l}")
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    math(EXPR n_rows "${n_rows} + 1")
    if(NOT l MATCHES "^([0-9A-F][0-9A-F][0-9A-F][0-9A-F]) role=([a-z0-9-]+) class=(stored|strobe|collision|reserved) w=([0-9A-F][0-9A-F][0-9A-F][0-9A-F]) r=([0-9A-F][0-9A-F][0-9A-F][0-9A-F]) src=(SRC-[a-z0-9-]+)@([A-Za-z0-9._,-]+) tag=([a-z0-9-]+) conf=(C[0-9]+)$")
      pfail(video-regmap-row-bad "${p} row ${idx}: not a row of the grammar")
    else()
      set(addr "${CMAKE_MATCH_1}")
      set(srcid "${CMAKE_MATCH_6}")
      set(tag "${CMAKE_MATCH_8}")
      math(EXPR av "0x${addr}")
      if(NOT av EQUAL idx)
        pfail(video-regmap-row-bad "${p} row ${idx}: address ${addr} is not the next address")
      endif()
      if(NOT tag IN_LIST ALLOWED_TAGS)
        pfail(video-regmap-row-bad "${p} ${addr}: tag ${tag} is not allowed")
      endif()
      if(NOT srcid IN_LIST SRC_IDS)
        pfail(video-regmap-row-bad "${p} ${addr}: source ${srcid} is not in data/expected/sources.ids")
      endif()
    endif()
    math(EXPR idx "${idx} + 1")
  endforeach()
  if(NOT idx EQUAL 64)
    pfail(video-regmap-row-count "${p} has ${idx} rows, expected 64")
  endif()
endforeach()

# ---- rule inventory cross-checks: fields and test families against the profile, the suites and the pending lists
set(RULE_IDS "")
set(PROFILE_FIELDS "")
read_list(PROFILE_FIELDS "data/expected/profile-fields.ids")
read_pending(PENDING_FIELDS "data/stic/fields-pending.ids")
read_pending(PENDING_FAMILIES "data/stic/tests-pending.ids")
set(TEST_IDS "")
file(GLOB test_files "${ROOT}/data/expected/tests/*.ids")
foreach(tf IN LISTS test_files)
  file(RELATIVE_PATH rel "${ROOT}" "${tf}")
  read_list(ids "${rel}")
  list(APPEND TEST_IDS ${ids})
endforeach()

function(prefix_registered out prefix)
  set(hit FALSE)
  string(LENGTH "${prefix}" plen)
  foreach(t IN LISTS TEST_IDS)
    string(LENGTH "${t}" tlen)
    if(tlen GREATER plen OR tlen EQUAL plen)
      string(SUBSTRING "${t}" 0 ${plen} head)
      if(head STREQUAL "${prefix}")
        set(hit TRUE)
        break()
      endif()
    endif()
  endforeach()
  set(${out} "${hit}" PARENT_SCOPE)
endfunction()

if(EXISTS "${ROOT}/data/stic/rules.json")
  file(READ "${ROOT}/data/stic/rules.json" rdoc)
  string(JSON nr ERROR_VARIABLE e LENGTH "${rdoc}" rules)
  if("${e}" STREQUAL "NOTFOUND" AND nr GREATER 0)
    math(EXPR last "${nr} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON rid ERROR_VARIABLE e GET "${rdoc}" rules ${i} id)
      if(NOT "${e}" STREQUAL "NOTFOUND")
        continue()
      endif()
      list(APPEND RULE_IDS "${rid}")
      string(JSON nf ERROR_VARIABLE e LENGTH "${rdoc}" rules ${i} fields)
      if("${e}" STREQUAL "NOTFOUND" AND nf GREATER 0)
        math(EXPR flast "${nf} - 1")
        foreach(j RANGE 0 ${flast})
          string(JSON fld GET "${rdoc}" rules ${i} fields ${j})
          if(NOT fld MATCHES "^engine:" AND NOT fld IN_LIST PROFILE_FIELDS AND NOT fld IN_LIST PENDING_FIELDS)
            pfail(video-rule-field-unregistered "${rid} field ${fld} is neither in data/expected/profile-fields.ids nor in data/stic/fields-pending.ids")
          endif()
        endforeach()
      endif()
      string(JSON nt ERROR_VARIABLE e LENGTH "${rdoc}" rules ${i} tests)
      if("${e}" STREQUAL "NOTFOUND" AND nt GREATER 0)
        math(EXPR tlast "${nt} - 1")
        foreach(j RANGE 0 ${tlast})
          string(JSON fam GET "${rdoc}" rules ${i} tests ${j})
          prefix_registered(reg "${fam}")
          if(NOT reg AND NOT fam IN_LIST PENDING_FAMILIES)
            pfail(video-rule-no-test "${rid} test family ${fam} has no registered id and is not in data/stic/tests-pending.ids")
          endif()
        endforeach()
      endif()
    endforeach()
  endif()
endif()
foreach(fld IN LISTS PENDING_FIELDS)
  if(fld IN_LIST PROFILE_FIELDS)
    pfail(video-pending-stale "data/stic/fields-pending.ids lists ${fld}, which the profile now has")
  endif()
endforeach()
foreach(fam IN LISTS PENDING_FAMILIES)
  prefix_registered(reg "${fam}")
  if(reg)
    pfail(video-pending-stale "data/stic/tests-pending.ids lists ${fam}, which a registered test id now has")
  endif()
endforeach()


# ---- geometry literal (D-12, D-13)
function(check_geometry p)
  set(want card-columns card-rows card-px last-column-px width-formula width height grid visible-of-grid last-column-clip row-lines
    colors header-bytes plane-bytes slot-bytes not-displayed-sentinel display-off-fill backtab-base backtab-base-wiki backtab-words)
  file(READ "${ROOT}/${p}" txt)
  gate_lines(lines "${txt}")
  set(seen "")
  foreach(l IN LISTS lines)
    gate_unprotect(l "${l}")
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    if(NOT l MATCHES "^([a-z0-9-]+) (.+) tag=([a-z0-9-]+) src=(none|SRC-[a-z0-9-]+@[A-Za-z0-9._,-]+) conf=(none|C[0-9]+)$")
      pfail(video-geometry-literal "${p}: row outside the grammar: ${l}")
      continue()
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(val "${CMAKE_MATCH_2}")
    set(tag "${CMAKE_MATCH_3}")
    set(src "${CMAKE_MATCH_4}")
    if(NOT key IN_LIST want)
      pfail(video-geometry-literal "${p}: unknown key ${key}")
    endif()
    if(key IN_LIST seen)
      pfail(video-geometry-literal "${p}: key ${key} repeated")
    endif()
    list(APPEND seen "${key}")
    set(V_${key} "${val}")
    if(NOT tag IN_LIST ALLOWED_TAGS)
      pfail(video-geometry-literal "${p}: ${key} tag ${tag} is not allowed")
    endif()
    if(NOT src STREQUAL "none")
      string(REGEX REPLACE "@.*$" "" sid "${src}")
      if(NOT sid IN_LIST SRC_IDS)
        pfail(video-geometry-literal "${p}: ${key} source ${sid} is not in data/expected/sources.ids")
      endif()
    endif()
  endforeach()
  foreach(k IN LISTS want)
    if(NOT k IN_LIST seen)
      pfail(video-geometry-literal "${p}: key ${k} is missing")
      return()
    endif()
  endforeach()
  if(NOT V_card-px MATCHES "^([0-9]+) ([0-9]+)$")
    pfail(video-geometry-literal "${p}: card-px is not '<w> <h>'")
    return()
  endif()
  set(cw "${CMAKE_MATCH_1}")
  set(ch "${CMAKE_MATCH_2}")
  if(NOT V_grid MATCHES "^([0-9]+) ([0-9]+)$")
    pfail(video-geometry-literal "${p}: grid is not '<w> <h>'")
    return()
  endif()
  set(gw "${CMAKE_MATCH_1}")
  set(gh "${CMAKE_MATCH_2}")
  if(NOT V_visible-of-grid MATCHES "^([0-9]+) ([0-9]+)$")
    pfail(video-geometry-literal "${p}: visible-of-grid is not '<w> <h>'")
    return()
  endif()
  set(vw "${CMAKE_MATCH_1}")
  set(vh "${CMAKE_MATCH_2}")
  if(NOT V_width-formula MATCHES "^([0-9]+)[*]([0-9]+)[+]([0-9]+)$")
    pfail(video-geometry-literal "${p}: width-formula is not '<a>*<b>+<c>'")
    return()
  endif()
  math(EXPR fw "${CMAKE_MATCH_1} * ${CMAKE_MATCH_2} + ${CMAKE_MATCH_3}")
  math(EXPR w "(${V_card-columns} - 1) * ${cw} + ${V_last-column-px}")
  math(EXPR h "${V_card-rows} * ${ch}")
  math(EXPR pb "${V_width} * ${V_height}")
  math(EXPR sb "${V_header-bytes} + ${V_plane-bytes}")
  math(EXPR bw "${V_card-columns} * ${V_card-rows}")
  if(NOT w EQUAL V_width OR NOT fw EQUAL V_width)
    pfail(video-geometry-literal "${p}: width ${V_width} is not (columns - 1) x card width + last-column-px (${w}) or the width-formula (${fw})")
  endif()
  if(NOT h EQUAL V_height)
    pfail(video-geometry-literal "${p}: height ${V_height} is not rows x card height (${h})")
  endif()
  if(NOT pb EQUAL V_plane-bytes)
    pfail(video-geometry-literal "${p}: plane-bytes ${V_plane-bytes} is not width x height (${pb})")
  endif()
  if(NOT sb EQUAL V_slot-bytes)
    pfail(video-geometry-literal "${p}: slot-bytes ${V_slot-bytes} is not header-bytes + plane-bytes (${sb})")
  endif()
  if(NOT bw EQUAL V_backtab-words)
    pfail(video-geometry-literal "${p}: backtab-words ${V_backtab-words} is not columns x rows (${bw})")
  endif()
  if(vw GREATER gw OR vh GREATER gh OR NOT vw EQUAL V_width OR NOT vh EQUAL V_height)
    pfail(video-geometry-literal "${p}: the visible area ${vw} x ${vh} is not the published ${V_width} x ${V_height} within the grid ${gw} x ${gh}")
  endif()
  set(GEO_WIDTH "${V_width}" PARENT_SCOPE)
  set(GEO_HEIGHT "${V_height}" PARENT_SCOPE)
  set(GEO_SLOT "${V_slot-bytes}" PARENT_SCOPE)
endfunction()

set(GEO_WIDTH "")
set(GEO_HEIGHT "")
if(EXISTS "${ROOT}/data/video/geometry.literal.txt")
  check_geometry("data/video/geometry.literal.txt")
endif()

# ---- card and MOB bit-role literals (D-18; plan 08-03, D-05)
# One row grammar for both literals: `<variant> <bit 0..15> <role> src=<SRC-id>@<locator> tag=tier4-community conf=C<n>`, every (variant, bit) once,
# every bit from the first `ign` bit of its variant upward `ign`, the exact row count, and the source id in data/expected/sources.ids.
#   p            the repository-relative file; variants  the list of variants (registers);  variant_re and role_re  the alternations of the grammar
#   want_rows    the exact number of rows;          ign_from  a list of `<variant>:<first bit that must be ign>`
function(check_role_literal p variants variant_re role_re want_rows ign_from)
  file(READ "${ROOT}/${p}" txt)
  gate_lines(lines "${txt}")
  set(n 0)
  set(seen "")
  foreach(l IN LISTS lines)
    gate_unprotect(l "${l}")
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    math(EXPR n "${n} + 1")
    if(NOT l MATCHES "^(${variant_re}) ([0-9]+) (${role_re}) src=(SRC-[a-z0-9-]+)@[A-Za-z0-9._,-]+ tag=tier4-community conf=C[0-9]+$")
      pfail(video-cards-literal-rows "${p}: row ${n} outside the grammar: ${l}")
      continue()
    endif()
    set(variant "${CMAKE_MATCH_1}")
    set(bit "${CMAKE_MATCH_2}")
    set(role "${CMAKE_MATCH_3}")
    if(NOT CMAKE_MATCH_4 IN_LIST SRC_IDS)
      pfail(video-cards-literal-rows "${p}: row ${n} source ${CMAKE_MATCH_4} is not in data/expected/sources.ids")
    endif()
    if(bit GREATER 15)
      pfail(video-cards-literal-rows "${p}: row ${n} bit ${bit} is above 15")
    endif()
    set(ign_first 16)
    foreach(entry IN LISTS ign_from)
      if(entry MATCHES "^${variant}:([0-9]+)$")
        set(ign_first "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    if(bit GREATER_EQUAL ign_first AND NOT role STREQUAL "ign")
      pfail(video-cards-literal-rows "${p}: ${variant} bit ${bit} is ${role}, expected ign")
    endif()
    if("${variant}:${bit}" IN_LIST seen)
      pfail(video-cards-literal-rows "${p}: ${variant} bit ${bit} repeated")
    endif()
    list(APPEND seen "${variant}:${bit}")
  endforeach()
  if(NOT n EQUAL ${want_rows})
    pfail(video-cards-literal-rows "${p} has ${n} rows, expected ${want_rows}")
  endif()
  foreach(variant IN LISTS variants)
    foreach(bit RANGE 0 15)
      if(NOT "${variant}:${bit}" IN_LIST seen)
        pfail(video-cards-literal-rows "${p}: ${variant} bit ${bit} is missing")
      endif()
    endforeach()
  endforeach()
endfunction()

if(EXISTS "${ROOT}/data/video/cards.literal.txt")
  check_role_literal("data/video/cards.literal.txt" "fgbg;cs-grom;cs-gram;cs-sq" "fgbg|cs-grom|cs-gram|cs-sq"
    "ign|fg[0-3]|bg[0-3]|card[0-7]|sel|adv|fixed[01]|sq[0-3]c[0-2]" 64 "fgbg:14;cs-grom:14;cs-gram:14;cs-sq:14")
endif()
# The MOB register roles (plan 08-03): X 11 bits, Y 12 bits, attribute 14 bits, as in the register-address literal; 48 rows.
if(EXISTS "${ROOT}/data/video/mob.literal.txt")
  check_role_literal("data/video/mob.literal.txt" "mobx;moby;moba" "mobx|moby|moba"
    "ign|pos[0-7]|intr|visb|xsize|yres|ysiz2|ysiz4|xflip|yflip|color[0-3]|card[0-7]|sel|prio" 48 "mobx:11;moby:12;moba:14")
endif()

# ---- chain framing literal (D-13, D-16)
if(EXISTS "${ROOT}/data/video/chain-framing.literal.txt")
  set(p "data/video/chain-framing.literal.txt")
  file(READ "${ROOT}/${p}" txt)
  gate_lines(lines "${txt}")
  set(seen "")
  foreach(l IN LISTS lines)
    gate_unprotect(l "${l}")
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    if(NOT l MATCHES "^(h0|h1|h2|slot0-header|slot1-header|slot0-sha256|slot1-sha256) ([0-9a-fA-F]+) tag=derived-by-recipe src=none conf=none$")
      pfail(video-chain-literal "${p}: row outside the grammar: ${l}")
      continue()
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(val "${CMAKE_MATCH_2}")
    if(key IN_LIST seen)
      pfail(video-chain-literal "${p}: key ${key} repeated")
    endif()
    list(APPEND seen "${key}")
    set(CH_${key} "${val}")
    if(key MATCHES "header$")
      if(NOT val MATCHES "^[0-9A-F]+$" OR NOT "${val}" MATCHES "^[0-9A-F][0-9A-F]+$")
        pfail(video-chain-literal "${p}: ${key} is not upper-case hex")
      endif()
      string(LENGTH "${val}" vl)
      if(NOT vl EQUAL 64)
        pfail(video-chain-literal "${p}: ${key} has ${vl} hex digits, expected 64")
      endif()
    else()
      if(NOT val MATCHES "^[0-9a-f]+$")
        pfail(video-chain-literal "${p}: ${key} is not lower-case hex")
      endif()
      string(LENGTH "${val}" vl)
      if(NOT vl EQUAL 64)
        pfail(video-chain-literal "${p}: ${key} has ${vl} hex digits, expected 64")
      endif()
    endif()
  endforeach()
  foreach(k h0 h1 h2 slot0-header slot1-header slot0-sha256 slot1-sha256)
    if(NOT k IN_LIST seen)
      pfail(video-chain-literal "${p}: key ${k} is missing")
    endif()
  endforeach()
  if(DEFINED CH_h0)
    string(SHA256 want0 "IVS-VIDEO-LOG-V1")
    if(NOT CH_h0 STREQUAL want0)
      pfail(video-chain-literal "${p}: h0 is not the SHA-256 of IVS-VIDEO-LOG-V1")
    endif()
  endif()
  foreach(n 0 1)
    if(DEFINED CH_slot${n}-header)
      set(hv "${CH_slot${n}-header}")
      string(SUBSTRING "${hv}" 0 16 f_tick)
      string(SUBSTRING "${hv}" 16 16 f_index)
      string(SUBSTRING "${hv}" 32 8 f_width)
      string(SUBSTRING "${hv}" 40 8 f_height)
      string(SUBSTRING "${hv}" 48 8 f_flags)
      string(SUBSTRING "${hv}" 56 8 f_reserved)
      math(EXPR tick "0x${f_tick}")
      math(EXPR index "0x${f_index}")
      math(EXPR width "0x${f_width}")
      math(EXPR height "0x${f_height}")
      math(EXPR want_tick "(${n} + 1) * 4 * 57 * 262")
      if(NOT tick EQUAL want_tick)
        pfail(video-chain-literal "${p}: slot${n} tick ${tick} is not the end of frame ${n} (${want_tick})")
      endif()
      if(NOT index EQUAL n)
        pfail(video-chain-literal "${p}: slot${n} index ${index}")
      endif()
      if(NOT "${GEO_WIDTH}" STREQUAL "" AND (NOT width EQUAL GEO_WIDTH OR NOT height EQUAL GEO_HEIGHT))
        pfail(video-chain-literal "${p}: slot${n} width ${width} and height ${height} differ from data/video/geometry.literal.txt")
      endif()
      if(NOT f_flags STREQUAL "00000000" OR NOT f_reserved STREQUAL "00000000")
        pfail(video-chain-literal "${p}: slot${n} flags or reserved field is not zero")
      endif()
    endif()
  endforeach()
endif()

# ---- hand-derived frames (D-02, D-18, D-19)
read_list(FRAME_IDS "data/expected/video-frames.ids")
paths_matching(FRAME_FILES "^data/video/frames/[^/]+[.]frame$")
set(n_frames 0)
set(FRAME_STEMS "")

# Cell block of a plane: rows are the 96 space-free 160-symbol strings PLANE_<y>.
function(check_frame p stem)
  file(READ "${ROOT}/${p}" txt)
  gate_lines(lines "${txt}")
  set(in_plane FALSE)
  set(keys "")
  set(nrows 0)
  set(mode "")
  set(cells "")
  set(hash "")
  set(canon "")
  # Declared rectangles (plan 08-03, D-05): `unknown` records (UNK_<k> = "x;y;w;h") and `mob` records (MOB_<k> = "i;x;y;w;h;color;pixels").
  set(unk_n 0)
  set(mob_n 0)
  set(mob_seen "")
  foreach(l IN LISTS lines)
    gate_unprotect(l "${l}")
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    if(in_plane)
      math(EXPR nrows "${nrows} + 1")
      string(REPLACE " " ";" parts "${l}")
      list(LENGTH parts np)
      set(shape_ok TRUE)
      if(NOT np EQUAL 20)
        set(shape_ok FALSE)
      else()
        foreach(g IN LISTS parts)
          string(LENGTH "${g}" gl)
          if(NOT gl EQUAL 8)
            set(shape_ok FALSE)
          endif()
        endforeach()
      endif()
      if(NOT shape_ok)
        pfail(video-frame-dimension "${p} plane row ${nrows} is not 20 groups of 8 symbols")
        continue()
      endif()
      string(REPLACE " " "" row "${l}")
      string(SUBSTRING "${row}" 159 1 cut)
      if(NOT cut STREQUAL "-")
        pfail(video-frame-symbol "${p} plane row ${nrows} does not end with the cut-off mark")
      endif()
      set(PLANE_${nrows} "${row}")
      string(SUBSTRING "${row}" 0 159 body)
      string(APPEND canon "${body}\n")
      continue()
    endif()
    if(l STREQUAL "plane")
      set(in_plane TRUE)
      continue()
    endif()
    if(l MATCHES "^frame ([A-Za-z0-9-]+)$")
      list(APPEND keys frame)
      if(NOT CMAKE_MATCH_1 STREQUAL "${stem}")
        pfail(video-frame-tier-missing "${p} frame id ${CMAKE_MATCH_1} differs from the file stem")
      endif()
    elseif(l MATCHES "^tier (source-expectation|original-diagnostic)$")
      list(APPEND keys tier)
    elseif(l MATCHES "^oracle independent-derivation$")
      list(APPEND keys oracle)
    elseif(l MATCHES "^rules ((CR|STIC-R)[-0-9R]+( (CR|STIC-R)[-0-9R]+)*)$")
      list(APPEND keys rules)
      string(REPLACE " " ";" rl "${CMAKE_MATCH_1}")
      foreach(rid IN LISTS rl)
        if(NOT rid IN_LIST RULE_IDS)
          pfail(video-frame-tier-missing "${p} rule ${rid} is not a rule of data/stic/rules.json")
        endif()
      endforeach()
    elseif(l MATCHES "^mode (fgbg|cs)$")
      list(APPEND keys mode)
      set(mode "${CMAKE_MATCH_1}")
    elseif(l MATCHES "^display (on|off)$")
      list(APPEND keys display)
    elseif(l MATCHES "^border [0-9A-F]$")
      list(APPEND keys border)
    elseif(l MATCHES "^stack [0-9A-F] [0-9A-F] [0-9A-F] [0-9A-F]$")
      list(APPEND keys stack)
    elseif(l MATCHES "^fill [0-9A-F][0-9A-F][0-9A-F][0-9A-F]$")
      list(APPEND keys fill)
    elseif(l MATCHES "^sha256-text (none|[0-9a-f]+)$")
      list(APPEND keys sha256-text)
      set(hash "${CMAKE_MATCH_1}")
    elseif(l MATCHES "^gram ([0-9]+) ([01]+) ([01]+) ([01]+) ([01]+) ([01]+) ([01]+) ([01]+) ([01]+)$")
      set(gn "${CMAKE_MATCH_1}")
      set(GRAM_${gn} "${CMAKE_MATCH_2};${CMAKE_MATCH_3};${CMAKE_MATCH_4};${CMAKE_MATCH_5};${CMAKE_MATCH_6};${CMAKE_MATCH_7};${CMAKE_MATCH_8};${CMAKE_MATCH_9}")
      foreach(i RANGE 2 9)
        string(LENGTH "${CMAKE_MATCH_${i}}" gl)
        if(NOT gl EQUAL 8)
          pfail(video-frame-popcount "${p} gram ${gn} row is not 8 characters")
        endif()
      endforeach()
    elseif(l MATCHES "^cell ([0-9]+) ([0-9]+) ([0-9A-F][0-9A-F][0-9A-F][0-9A-F]) [|] (.+)$")
      list(APPEND cells "${CMAKE_MATCH_1}:${CMAKE_MATCH_2}")
      set(CELL_${CMAKE_MATCH_1}_${CMAKE_MATCH_2} "${CMAKE_MATCH_4}")
    elseif(l MATCHES "^unknown (0|[1-9][0-9]*) (0|[1-9][0-9]*) ([1-9][0-9]*) ([1-9][0-9]*)$")
      # An unknown rectangle: positions that no rule of the derivation fixes; the plane shows `-` there and the frame has no hash.
      set(ux "${CMAKE_MATCH_1}")
      set(uy "${CMAKE_MATCH_2}")
      set(uw "${CMAKE_MATCH_3}")
      set(uh "${CMAKE_MATCH_4}")
      math(EXPR ux_end "${ux} + ${uw}")
      math(EXPR uy_end "${uy} + ${uh}")
      if(ux_end GREATER 159 OR uy_end GREATER 96)
        pfail(video-frame-tier-missing "${p} unknown rectangle ${ux} ${uy} ${uw} ${uh} is outside the 159 x 96 plane")
      else()
        set(overlap FALSE)
        if(unk_n GREATER 0)
          foreach(k RANGE 1 ${unk_n})
            list(GET UNK_${k} 0 ox)
            list(GET UNK_${k} 1 oy)
            list(GET UNK_${k} 2 ow)
            list(GET UNK_${k} 3 oh)
            math(EXPR ox_end "${ox} + ${ow}")
            math(EXPR oy_end "${oy} + ${oh}")
            if(ux LESS ox_end AND ox LESS ux_end AND uy LESS oy_end AND oy LESS uy_end)
              set(overlap TRUE)
            endif()
          endforeach()
        endif()
        if(overlap)
          pfail(video-frame-tier-missing "${p} unknown rectangle ${ux} ${uy} ${uw} ${uh} overlaps an earlier unknown rectangle")
        else()
          math(EXPR unk_n "${unk_n} + 1")
          set(UNK_${unk_n} "${ux};${uy};${uw};${uh}")
        endif()
      endif()
    elseif(l MATCHES "^mob ([0-7]) (0|[1-9][0-9]*) (0|[1-9][0-9]*) ([1-9][0-9]*) ([1-9][0-9]*) color=([0-9A-F]) pixels=([1-9][0-9]*)$")
      # A MOB overlay: its visible pixels of one colour lie inside the rectangle; the count is the number of visible positions.
      set(mi "${CMAKE_MATCH_1}")
      set(mx "${CMAKE_MATCH_2}")
      set(my "${CMAKE_MATCH_3}")
      set(mw "${CMAKE_MATCH_4}")
      set(mh "${CMAKE_MATCH_5}")
      set(mcol "${CMAKE_MATCH_6}")
      set(mpix "${CMAKE_MATCH_7}")
      math(EXPR mx_end "${mx} + ${mw}")
      math(EXPR my_end "${my} + ${mh}")
      if(mi IN_LIST mob_seen)
        pfail(video-frame-tier-missing "${p} mob ${mi} is declared twice")
      elseif(mx_end GREATER 159 OR my_end GREATER 96)
        pfail(video-frame-tier-missing "${p} mob ${mi} rectangle ${mx} ${my} ${mw} ${mh} is outside the 159 x 96 plane")
      else()
        list(APPEND mob_seen "${mi}")
        math(EXPR mob_n "${mob_n} + 1")
        set(MOB_${mob_n} "${mi};${mx};${my};${mw};${mh};${mcol};${mpix}")
      endif()
    else()
      pfail(video-frame-tier-missing "${p} header line outside the grammar: ${l}")
    endif()
  endforeach()
  # The unknown count is exported at once: the pair check reads it (a frame with an unknown region cannot be paired).
  set(FRAME_HAS_UNKNOWN_${stem} ${unk_n} PARENT_SCOPE)
  foreach(k frame tier oracle rules mode display border stack fill sha256-text)
    if(NOT k IN_LIST keys)
      pfail(video-frame-tier-missing "${p} header key ${k} is missing")
    endif()
  endforeach()
  if(NOT nrows EQUAL 96)
    pfail(video-frame-dimension "${p} has ${nrows} plane rows, expected 96")
    return()
  endif()
  # plane symbols (plan 08-03): 0-9A-F everywhere, and `-` exactly on the positions of the unknown rectangles
  foreach(y RANGE 0 95)
    math(EXPR rn "${y} + 1")
    if(NOT DEFINED PLANE_${rn})
      continue()
    endif()
    string(SUBSTRING "${PLANE_${rn}}" 0 159 body)
    if(NOT body MATCHES "^[0-9A-F-]+$")
      pfail(video-frame-symbol "${p} plane row ${rn} has a symbol outside 0-9A-F")
      continue()
    endif()
    string(FIND "${body}" "-" dash_first)
    set(cover 0)
    set(inside_bad "")
    if(unk_n GREATER 0)
      foreach(k RANGE 1 ${unk_n})
        list(GET UNK_${k} 0 ux)
        list(GET UNK_${k} 1 uy)
        list(GET UNK_${k} 2 uw)
        list(GET UNK_${k} 3 uh)
        math(EXPR uy_end "${uy} + ${uh}")
        if(y GREATER_EQUAL uy AND y LESS uy_end)
          math(EXPR cover "${cover} + ${uw}")
          string(SUBSTRING "${body}" ${ux} ${uw} seg)
          string(REPLACE "-" "" seg_rest "${seg}")
          if(NOT "${seg_rest}" STREQUAL "" AND "${inside_bad}" STREQUAL "")
            set(seg_pos 0)
            while(seg_pos LESS ${uw})
              math(EXPR sx "${ux} + ${seg_pos}")
              string(SUBSTRING "${body}" ${sx} 1 sc)
              if(NOT sc STREQUAL "-")
                set(inside_bad "(${sx},${y})")
                break()
              endif()
              math(EXPR seg_pos "${seg_pos} + 1")
            endwhile()
          endif()
        endif()
      endforeach()
    endif()
    if(NOT "${inside_bad}" STREQUAL "")
      pfail(video-frame-symbol "${p} position ${inside_bad} inside an unknown rectangle is not -")
      continue()
    endif()
    if(dash_first LESS 0)
      continue()
    endif()
    string(REPLACE "-" "" body_nodash "${body}")
    string(LENGTH "${body}" body_len)
    string(LENGTH "${body_nodash}" nodash_len)
    math(EXPR dashes "${body_len} - ${nodash_len}")
    if(NOT dashes EQUAL cover)
      # more `-` than the unknown rectangles of this row cover: name the first one outside them
      set(dpos 0)
      set(dash_out "")
      while(dpos LESS 159 AND "${dash_out}" STREQUAL "")
        string(SUBSTRING "${body}" ${dpos} 1 dc)
        if(dc STREQUAL "-")
          set(dcovered FALSE)
          if(unk_n GREATER 0)
            foreach(k RANGE 1 ${unk_n})
              list(GET UNK_${k} 0 ux)
              list(GET UNK_${k} 1 uy)
              list(GET UNK_${k} 2 uw)
              list(GET UNK_${k} 3 uh)
              math(EXPR ux_end "${ux} + ${uw}")
              math(EXPR uy_end "${uy} + ${uh}")
              if(dpos GREATER_EQUAL ux AND dpos LESS ux_end AND y GREATER_EQUAL uy AND y LESS uy_end)
                set(dcovered TRUE)
              endif()
            endforeach()
          endif()
          if(NOT dcovered)
            set(dash_out "(${dpos},${y})")
          endif()
        endif()
        math(EXPR dpos "${dpos} + 1")
      endwhile()
      pfail(video-frame-symbol "${p} position ${dash_out} is - outside every unknown rectangle")
    endif()
  endforeach()
  # drift key: a frame with an unknown region has no hash, a frame without one needs its hash
  if(hash STREQUAL "none")
    if(unk_n EQUAL 0)
      pfail(video-frame-hash-drift "${p} sha256-text none without an unknown record: a frame with no unknown region needs its hash")
    endif()
  elseif(unk_n GREATER 0)
    pfail(video-frame-hash-drift "${p} has an unknown record and a numeric sha256-text: a frame with an unknown region has no hash")
  else()
    string(SHA256 got "${canon}")
    if(NOT got STREQUAL "${hash}")
      pfail(video-frame-hash-drift "${p} sha256-text ${hash} differs from the canonical plane digest ${got}")
    endif()
  endif()
  # MOB colours: the count of a colour symbol in the plane is the sum of the pixels of the mob records of that colour, and every
  # position of it lies inside the rectangle of one of those records
  set(mob_colors "")
  if(mob_n GREATER 0)
    foreach(k RANGE 1 ${mob_n})
      list(GET MOB_${k} 5 mc)
      if(NOT mc IN_LIST mob_colors)
        list(APPEND mob_colors "${mc}")
      endif()
    endforeach()
  endif()
  foreach(mc IN LISTS mob_colors)
    set(declared 0)
    set(rects "")
    foreach(k RANGE 1 ${mob_n})
      list(GET MOB_${k} 5 kc)
      if(kc STREQUAL "${mc}")
        list(GET MOB_${k} 6 kp)
        math(EXPR declared "${declared} + ${kp}")
        list(APPEND rects ${k})
      endif()
    endforeach()
    set(counted 0)
    set(stray "")
    foreach(y RANGE 0 95)
      math(EXPR rn "${y} + 1")
      if(NOT DEFINED PLANE_${rn})
        continue()
      endif()
      string(SUBSTRING "${PLANE_${rn}}" 0 159 body)
      string(FIND "${body}" "${mc}" mfirst)
      if(mfirst LESS 0)
        continue()
      endif()
      set(off 0)
      set(rest "${body}")
      while(TRUE)
        string(FIND "${rest}" "${mc}" mp)
        if(mp LESS 0)
          break()
        endif()
        math(EXPR mxp "${off} + ${mp}")
        math(EXPR counted "${counted} + 1")
        set(in_rect FALSE)
        foreach(k IN LISTS rects)
          list(GET MOB_${k} 1 rx)
          list(GET MOB_${k} 2 ry)
          list(GET MOB_${k} 3 rw)
          list(GET MOB_${k} 4 rh)
          math(EXPR rx_end "${rx} + ${rw}")
          math(EXPR ry_end "${ry} + ${rh}")
          if(mxp GREATER_EQUAL rx AND mxp LESS rx_end AND y GREATER_EQUAL ry AND y LESS ry_end)
            set(in_rect TRUE)
          endif()
        endforeach()
        if(NOT in_rect AND "${stray}" STREQUAL "")
          set(stray "(${mxp},${y})")
        endif()
        math(EXPR off "${mxp} + 1")
        math(EXPR mq "${mp} + 1")
        string(SUBSTRING "${rest}" ${mq} -1 rest)
      endwhile()
    endforeach()
    if(NOT counted EQUAL declared)
      pfail(video-frame-popcount "${p} mob colour ${mc} occurs ${counted} times in the plane, the mob records declare ${declared} pixels")
    endif()
    if(NOT "${stray}" STREQUAL "")
      pfail(video-frame-popcount "${p} mob colour ${mc} at ${stray} lies outside every mob rectangle of that colour")
    endif()
  endforeach()
  # cells whose area meets an unknown or mob rectangle skip the count and uniformity rules (7 columns for card column 19)
  set(rect_list "")
  if(unk_n GREATER 0)
    foreach(k RANGE 1 ${unk_n})
      list(GET UNK_${k} 0 tx)
      list(GET UNK_${k} 1 ty)
      list(GET UNK_${k} 2 tw)
      list(GET UNK_${k} 3 th)
      list(APPEND rect_list "${tx},${ty},${tw},${th}")
    endforeach()
  endif()
  if(mob_n GREATER 0)
    foreach(k RANGE 1 ${mob_n})
      list(GET MOB_${k} 1 tx)
      list(GET MOB_${k} 2 ty)
      list(GET MOB_${k} 3 tw)
      list(GET MOB_${k} 4 th)
      list(APPEND rect_list "${tx},${ty},${tw},${th}")
    endforeach()
  endif()
  foreach(rc IN LISTS rect_list)
    string(REPLACE "," ";" rcl "${rc}")
    list(GET rcl 0 tx)
    list(GET rcl 1 ty)
    list(GET rcl 2 tw)
    list(GET rcl 3 th)
    math(EXPR tc0 "${tx} / 8")
    math(EXPR tc1 "(${tx} + ${tw} - 1) / 8")
    math(EXPR tr0 "${ty} / 8")
    math(EXPR tr1 "(${ty} + ${th} - 1) / 8")
    foreach(tr RANGE ${tr0} ${tr1})
      foreach(tc RANGE ${tc0} ${tc1})
        set(TOUCH_${tr}_${tc} TRUE)
      endforeach()
    endforeach()
  endforeach()
  # annotated cells: pixel counts against the card pattern
  set(uniform_symbol "")
  foreach(r RANGE 0 11)
    foreach(c RANGE 0 19)
      math(EXPR x0 "${c} * 8")
      if(c EQUAL 19)
        set(drawn 7)
      else()
        set(drawn 8)
      endif()
      if(TOUCH_${r}_${c})
        if(DEFINED CELL_${r}_${c})
          set(ann "${CELL_${r}_${c}}")
          if(NOT ann MATCHES "^fgbg fg=([0-7]) bg=([0-9]+) (grom|gram) card=([0-9]+)$" AND
             NOT ann MATCHES "^cs adv=[01] fg=([0-9]+) (grom|gram) card=([0-9]+) bg=([0-9]+)$")
            pfail(video-frame-popcount "${p} cell (${r},${c}) annotation outside the grammar: ${ann}")
          endif()
        endif()
        continue()
      endif()
      if(DEFINED CELL_${r}_${c})
        set(ann "${CELL_${r}_${c}}")
        if(ann MATCHES "^fgbg fg=([0-7]) bg=([0-9]+) (grom|gram) card=([0-9]+)$")
          set(fg "${CMAKE_MATCH_1}")
          set(bg "${CMAKE_MATCH_2}")
          set(sel "${CMAKE_MATCH_3}")
          set(card "${CMAKE_MATCH_4}")
        elseif(ann MATCHES "^cs adv=[01] fg=([0-9]+) (grom|gram) card=([0-9]+) bg=([0-9]+)$")
          set(fg "${CMAKE_MATCH_1}")
          set(sel "${CMAKE_MATCH_2}")
          set(card "${CMAKE_MATCH_3}")
          set(bg "${CMAKE_MATCH_4}")
        else()
          pfail(video-frame-popcount "${p} cell (${r},${c}) annotation outside the grammar: ${ann}")
          continue()
        endif()
        if(fg EQUAL bg OR fg GREATER 15 OR bg GREATER 15)
          pfail(video-frame-popcount "${p} cell (${r},${c}) needs distinct foreground and background indices in 0..15")
          continue()
        endif()
        string(SUBSTRING "0123456789ABCDEF" ${fg} 1 fgc)
        string(SUBSTRING "0123456789ABCDEF" ${bg} 1 bgc)
        set(pat "00000000;00000000;00000000;00000000;00000000;00000000;00000000;00000000")
        if(sel STREQUAL "gram" AND DEFINED GRAM_${card})
          set(pat "${GRAM_${card}}")
        endif()
        set(pop 0)
        set(nfg 0)
        set(nbg 0)
        foreach(y RANGE 0 7)
          list(GET pat ${y} prow)
          string(SUBSTRING "${prow}" 0 ${drawn} pbits)
          string(REGEX REPLACE "0" "" ones "${pbits}")
          string(LENGTH "${ones}" k)
          math(EXPR pop "${pop} + ${k}")
          math(EXPR py "${r} * 8 + ${y} + 1")
          string(SUBSTRING "${PLANE_${py}}" ${x0} ${drawn} blk)
          string(REPLACE "${fgc}" "" t1 "${blk}")
          string(LENGTH "${t1}" l1)
          math(EXPR nfg "${nfg} + ${drawn} - ${l1}")
          string(REPLACE "${bgc}" "" t2 "${blk}")
          string(LENGTH "${t2}" l2)
          math(EXPR nbg "${nbg} + ${drawn} - ${l2}")
        endforeach()
        math(EXPR drawn_total "${drawn} * 8")
        math(EXPR want_bg "${drawn_total} - ${pop}")
        if(NOT nfg EQUAL pop OR NOT nbg EQUAL want_bg)
          pfail(video-frame-popcount "${p} cell (${r},${c}) has ${nfg} foreground and ${nbg} background pixels, the pattern gives ${pop} and ${want_bg}")
        endif()
      else()
        # unlisted cell: one uniform symbol
        set(sym "")
        foreach(y RANGE 0 7)
          math(EXPR py "${r} * 8 + ${y} + 1")
          string(SUBSTRING "${PLANE_${py}}" ${x0} ${drawn} blk)
          string(SUBSTRING "${blk}" 0 1 first)
          string(REPLACE "${first}" "" rest "${blk}")
          if(NOT "${rest}" STREQUAL "")
            pfail(video-frame-popcount "${p} unlisted cell (${r},${c}) is not uniform")
            break()
          endif()
          if(NOT "${sym}" STREQUAL "" AND NOT first STREQUAL "${sym}")
            pfail(video-frame-popcount "${p} unlisted cell (${r},${c}) is not uniform")
            break()
          endif()
          set(sym "${first}")
        endforeach()
        if(mode STREQUAL "fgbg")
          if("${uniform_symbol}" STREQUAL "")
            set(uniform_symbol "${sym}")
          elseif(NOT sym STREQUAL "${uniform_symbol}")
            pfail(video-frame-popcount "${p} unlisted cell (${r},${c}) shows ${sym}, other unlisted cells show ${uniform_symbol}")
          endif()
        endif()
      endif()
    endforeach()
  endforeach()
endfunction()

foreach(p IN LISTS FRAME_FILES)
  string(REGEX REPLACE "^data/video/frames/(.*)[.]frame$" "\\1" stem "${p}")
  list(APPEND FRAME_STEMS "${stem}")
  if(NOT stem IN_LIST FRAME_IDS)
    pfail(video-frame-unregistered "${p} is not an id of data/expected/video-frames.ids")
  endif()
  math(EXPR n_frames "${n_frames} + 1")
  check_frame("${p}" "${stem}")
endforeach()
foreach(id IN LISTS FRAME_IDS)
  if(NOT id IN_LIST FRAME_STEMS)
    pfail(video-frame-unregistered "data/video/frames/${id}.frame is listed in data/expected/video-frames.ids and has no file")
  endif()
endforeach()

# ---- hash tie of the predicate files (plan 06-13, D-02, V6-4): the frame hash an `.expect` asserts is the sha256-text key of its literal
paths_matching(EXPECT_FILES "^data/golden/[^/]+[.]expect$")
set(n_hash_ties 0)
foreach(p IN LISTS EXPECT_FILES)
  file(READ "${ROOT}/${p}" etxt)
  gate_lines(elines "${etxt}")
  set(named "")
  foreach(l IN LISTS elines)
    gate_unprotect(l "${l}")
    if(l MATCHES "^# frame: ([0-9]+) ([A-Za-z0-9-]+)$")
      set(NAMED_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
      list(APPEND named "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  foreach(l IN LISTS elines)
    gate_unprotect(l "${l}")
    if(NOT l MATCHES "^assert frame ([0-9]+) hash == ([0-9a-f]+)$")
      continue()
    endif()
    set(fidx "${CMAKE_MATCH_1}")
    set(fhash "${CMAKE_MATCH_2}")
    if(NOT fidx IN_LIST named)
      pfail(video-frame-hash-expect-drift "${p} asserts the hash of frame ${fidx} and has no header line '# frame: ${fidx} <frame id>'")
      continue()
    endif()
    set(fid "${NAMED_${fidx}}")
    set(fpath "data/video/frames/${fid}.frame")
    if(NOT EXISTS "${ROOT}/${fpath}")
      pfail(video-frame-hash-expect-drift "${p} names ${fpath}, which does not exist")
      continue()
    endif()
    file(STRINGS "${ROOT}/${fpath}" fl REGEX "^sha256-text (none|[0-9a-f]+)$")
    set(lit "")
    foreach(x IN LISTS fl)
      string(REGEX REPLACE "^sha256-text " "" lit "${x}")
    endforeach()
    if(lit STREQUAL "none")
      pfail(video-frame-hash-expect-drift "${p} asserts the hash of frame ${fidx}, but ${fid} has sha256-text none: the frame has no hash")
      continue()
    endif()
    if(NOT lit STREQUAL "${fhash}")
      pfail(video-frame-hash-expect-drift "${p} asserts frame ${fidx} hash ${fhash}, the sha256-text of ${fid} is ${lit}")
    endif()
    math(EXPR n_hash_ties "${n_hash_ties} + 1")
  endforeach()
  foreach(n IN LISTS named)
    unset(NAMED_${n})
  endforeach()
endforeach()

# ---- declared frame pairs (plan 07-02, D-21): the planes of a pair differ at exactly `count` positions, all inside the rectangle
# The published rows of a frame file: the 159 symbols left of the cut-off mark of each plane row, spaces removed (empty when unreadable).
function(read_plane out relpath)
  set(rows "")
  if(EXISTS "${ROOT}/${relpath}")
    file(READ "${ROOT}/${relpath}" txt)
    gate_lines(lines "${txt}")
    set(in_plane FALSE)
    foreach(l IN LISTS lines)
      gate_unprotect(l "${l}")
      if(in_plane)
        string(REPLACE " " "" row "${l}")
        string(LENGTH "${row}" rl)
        if(rl EQUAL 160)
          string(SUBSTRING "${row}" 0 159 body)
          list(APPEND rows "${body}")
        endif()
      elseif(l STREQUAL "plane")
        set(in_plane TRUE)
      endif()
    endforeach()
  endif()
  set(${out} "${rows}" PARENT_SCOPE)
endfunction()

function(check_pairs out)
  set(pairs 0)
  set(pf "data/expected/video-frame-pairs.ids")
  if(EXISTS "${ROOT}/${pf}")
    file(READ "${ROOT}/${pf}" ptxt)
    gate_lines(plines "${ptxt}")
    set(ln 0)
    foreach(l IN LISTS plines)
      math(EXPR ln "${ln} + 1")
      gate_unprotect(l "${l}")
      string(STRIP "${l}" l)
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      math(EXPR pairs "${pairs} + 1")
      if(NOT l MATCHES "^([A-Za-z0-9-]+) ([A-Za-z0-9-]+) ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+) ([0-9]+)$")
        pfail(video-frame-pair-region "${pf}:${ln} line outside the grammar '<idA> <idB> <x> <y> <w> <h> <count>': ${l}")
        continue()
      endif()
      set(ida "${CMAKE_MATCH_1}")
      set(idb "${CMAKE_MATCH_2}")
      set(rx "${CMAKE_MATCH_3}")
      set(ry "${CMAKE_MATCH_4}")
      set(rw "${CMAKE_MATCH_5}")
      set(rh "${CMAKE_MATCH_6}")
      set(want "${CMAKE_MATCH_7}")
      if(ida STREQUAL idb)
        pfail(video-frame-pair-region "${pf}:${ln} a pair needs two different frames, got ${ida} twice")
        continue()
      endif()
      math(EXPR rx_end "${rx} + ${rw}")
      math(EXPR ry_end "${ry} + ${rh}")
      if(rw EQUAL 0 OR rh EQUAL 0 OR rx_end GREATER 159 OR ry_end GREATER 96 OR want EQUAL 0)
        pfail(video-frame-pair-region "${pf}:${ln} rectangle ${rx} ${ry} ${rw} ${rh} count ${want} is empty, outside the 159 x 96 plane, or declares no difference")
        continue()
      endif()
      set(usable TRUE)
      foreach(id IN ITEMS ${ida} ${idb})
        if(NOT id IN_LIST FRAME_IDS OR NOT id IN_LIST FRAME_STEMS)
          pfail(video-frame-pair-region "${pf}:${ln} frame ${id} is not a registered frame with a file")
          set(usable FALSE)
        elseif(DEFINED FRAME_HAS_UNKNOWN_${id} AND FRAME_HAS_UNKNOWN_${id} GREATER 0)
          pfail(video-frame-pair-region "${pf}:${ln} frame ${id} has an unknown region and cannot be paired")
          set(usable FALSE)
        endif()
      endforeach()
      if(NOT usable)
        continue()
      endif()
      read_plane(rows_a "data/video/frames/${ida}.frame")
      read_plane(rows_b "data/video/frames/${idb}.frame")
      list(LENGTH rows_a na)
      list(LENGTH rows_b nb)
      if(NOT na EQUAL 96 OR NOT nb EQUAL 96)
        pfail(video-frame-pair-region "${pf}:${ln} the planes of ${ida} and ${idb} have ${na} and ${nb} rows, expected 96")
        continue()
      endif()
      set(count 0)
      set(first_out "")
      foreach(y RANGE 0 95)
        list(GET rows_a ${y} ra)
        list(GET rows_b ${y} rb)
        if(ra STREQUAL rb)
          continue()
        endif()
        foreach(x RANGE 0 158)
          string(SUBSTRING "${ra}" ${x} 1 ca)
          string(SUBSTRING "${rb}" ${x} 1 cb)
          if(ca STREQUAL cb)
            continue()
          endif()
          math(EXPR count "${count} + 1")
          if(x LESS rx OR x GREATER_EQUAL rx_end OR y LESS ry OR y GREATER_EQUAL ry_end)
            if(first_out STREQUAL "")
              set(first_out "(${x},${y})")
            endif()
          endif()
        endforeach()
      endforeach()
      if(NOT first_out STREQUAL "")
        pfail(video-frame-pair-region "${pf}:${ln} ${ida} and ${idb} differ at ${first_out}, outside the rectangle ${rx} ${ry} ${rw} ${rh}")
      endif()
      if(NOT count EQUAL want)
        pfail(video-frame-pair-region "${pf}:${ln} ${ida} and ${idb} differ at ${count} positions, the line declares ${want}")
      endif()
    endforeach()
  endif()
  set(${out} "${pairs}" PARENT_SCOPE)
endfunction()
check_pairs(n_pairs)

foreach(tok IN LISTS VTOKENS)
  gate_count(n "tok_${tok}")
  if(n GREATER ${CAP})
    gate_fail(${tok} "${n} findings in total, first ${CAP} listed")
  endif()
endforeach()

gate_stat(stic-rows ${n_rows})
gate_stat(video-frames ${n_frames})
gate_stat(video-hash-ties ${n_hash_ties})
gate_stat(video-frame-pairs ${n_pairs})
gate_finish(videochk)
