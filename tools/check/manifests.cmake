# SPDX-License-Identifier: MIT
# Fail-closed fixture-manifest checker (docs/fixture-manifest.md, schema_version 1).
# Inputs (passed with -D):
#   ROOT      the tree under test (required)
#   FILELIST  file with one repo-relative path per line (required)
# Manifests are the FILELIST paths fixtures/<dir>/manifest.json, processed in sorted order.
# Tokens: manifest-parse, manifest-unknown-key, manifest-missing-key, manifest-format,
#   manifest-id-dir-mismatch, manifest-duplicate-id, manifest-id-missing, manifest-id-extra,
#   manifest-inventory-empty, manifest-inventory-missing, manifest-yes-without-evidence,
#   manifest-committed-not-redistributable, manifest-unknown-derived, manifest-missing-output,
#   manifest-digest-mismatch, manifest-uncommitted-output-tracked, manifest-recipe-digest-mismatch.
# manifest-recipe-digest-mismatch (plan 07-05, D-29, A-12): in a committed manifest with a non-null
#   recipe, every recipe.sources path must exist with its recorded sha256, and recipe.tool_sha256 must
#   equal the digest of the sources entry that is the tool's own source (RECIPE_TOOL_SOURCES below);
#   a tool that is not registered there, or whose source is not listed, is the same finding.
# Success line: "manifests pass manifests=<n> effective-yes=<a> effective-no=<b>".
# Limit: a hash proves identity, not rights; duplicate JSON keys are not detectable.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT FILELIST)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "manifests.cmake is missing ${required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/manifest-lib.cmake")

set(DATE_RE "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$")
set(PATH_RE "^[A-Za-z0-9._/-]+$")
set(KINDS original-source original-built third-party-test system-image third-party-doc derived-output)
set(USES local-test ci repo release)
set(REVIEWS owner-confirmed author-attested unreviewed)
set(REDIST yes no unknown)
# recipe.tool name -> repo-relative path of that tool's own source (plan 07-05, D-29): the digest of
# this file is what recipe.tool_sha256 must equal. A new build tool is registered here, in the commit
# that gives its first manifest a recipe.
set(RECIPE_TOOL_SOURCES "ivs_asm=tools/asm/asm.c" "ivs_pack=tools/pack/pack.c")

# Presence, type and allowed keys of one object. ARGN holds "key:TYPE|TYPE" specs;
# every listed key is required and every other member is an unknown key.
function(check_shape lbl prefix obj)
  set(allowed "")
  foreach(spec IN LISTS ARGN)
    string(FIND "${spec}" ":" c)
    string(SUBSTRING "${spec}" 0 ${c} key)
    math(EXPR c1 "${c} + 1")
    string(SUBSTRING "${spec}" ${c1} -1 types)
    string(REPLACE "|" ";" types "${types}")
    list(APPEND allowed "${key}")
    json_type(t "${obj}" "${key}")
    if(t STREQUAL "MISSING")
      gate_fail(manifest-missing-key "${lbl}/${prefix}${key}")
    elseif(NOT "${t}" IN_LIST types)
      gate_fail(manifest-format "${lbl}/${prefix}${key}")
    endif()
  endforeach()
  json_members(mem "${obj}")
  foreach(m IN LISTS mem)
    if(NOT "${m}" IN_LIST allowed)
      gate_fail(manifest-unknown-key "${lbl}/${prefix}${m}")
    endif()
  endforeach()
endfunction()

# A STRING member must match a regex (skipped when absent or not a string).
function(check_match lbl field obj regex)
  json_type(t "${obj}" ${ARGN})
  if(t STREQUAL "STRING")
    string(JSON v GET "${obj}" ${ARGN})
    if(NOT v MATCHES "${regex}")
      gate_fail(manifest-format "${lbl}/${field}")
    endif()
  endif()
endfunction()

# A STRING member must be one of a list of values.
function(check_enum lbl field obj values_var)
  json_type(t "${obj}" ${ARGN})
  if(t STREQUAL "STRING")
    string(JSON v GET "${obj}" ${ARGN})
    if(NOT "${v}" IN_LIST ${values_var})
      gate_fail(manifest-format "${lbl}/${field}")
    endif()
  endif()
endfunction()

# Safe repository-relative path: charset, no leading slash, no parent segment.
function(path_ok out p)
  if(p MATCHES "${PATH_RE}" AND NOT p MATCHES "^/" AND NOT p MATCHES "(^|/)[.][.](/|$)")
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# Entries of an array of objects: shape, then path and digest formats.
function(check_entries lbl key obj)
  json_type(t "${obj}" ${key})
  if(NOT t STREQUAL "ARRAY")
    return()
  endif()
  string(JSON n LENGTH "${obj}" ${key})
  if(n EQUAL 0)
    return()
  endif()
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last})
    string(JSON e GET "${obj}" ${key} ${i})
    json_type(et "${e}")
    if(NOT et STREQUAL "OBJECT")
      gate_fail(manifest-format "${lbl}/${key}")
      continue()
    endif()
    if(key STREQUAL "outputs")
      check_shape("${lbl}" "${key}/" "${e}" path:STRING sha256:STRING size_bytes:NUMBER)
    else()
      check_shape("${lbl}" "${key}/" "${e}" path:STRING sha256:STRING)
    endif()
    check_match("${lbl}" "${key}/path" "${e}" "${PATH_RE}" path)
    check_match("${lbl}" "${key}/sha256" "${e}" "${MANIFEST_HEX64_RE}" sha256)
    json_type(pt "${e}" path)
    if(pt STREQUAL "STRING")
      string(JSON p GET "${e}" path)
      path_ok(ok "${p}")
      if(NOT ok)
        gate_fail(manifest-format "${lbl}/${key}/path")
      endif()
    endif()
  endforeach()
endfunction()

# Every element of an array member must be a STRING (optionally matching a regex).
function(check_string_array lbl key obj regex)
  json_type(t "${obj}" ${key})
  if(NOT t STREQUAL "ARRAY")
    return()
  endif()
  string(JSON n LENGTH "${obj}" ${key})
  if(n EQUAL 0)
    return()
  endif()
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last})
    json_type(et "${obj}" ${key} ${i})
    if(NOT et STREQUAL "STRING")
      gate_fail(manifest-format "${lbl}/${key}")
      continue()
    endif()
    string(JSON v GET "${obj}" ${key} ${i})
    if(NOT "${regex}" STREQUAL "" AND NOT v MATCHES "${regex}")
      gate_fail(manifest-format "${lbl}/${key}")
    endif()
  endforeach()
endfunction()

function(check_manifest path doc)
  string(REGEX MATCH "^fixtures/([A-Za-z0-9._-]+)/" _m "${path}")
  set(dirname "${CMAKE_MATCH_1}")
  set(lbl "${dirname}")
  json_type(it "${doc}" id)
  set(id "")
  if(it STREQUAL "STRING")
    string(JSON id GET "${doc}" id)
    if(id MATCHES "^[A-Za-z0-9._-]+$")
      set(lbl "${id}")
    endif()
  endif()

  # Top level: every schema-v1 key present with its type, no other key.
  check_shape("${lbl}" "" "${doc}"
    schema_version:NUMBER id:STRING kind:STRING committed:BOOLEAN path:STRING|NULL
    local_path:STRING|NULL source:OBJECT recipe:OBJECT|NULL inputs:ARRAY outputs:ARRAY
    licence:STRING licence_evidence:OBJECT|NULL copyright:ARRAY notices:ARRAY
    redistributable:STRING allowed_use:ARRAY rights_review:OBJECT derived_from:ARRAY note:STRING)

  json_type(vt "${doc}" schema_version)
  if(vt STREQUAL "NUMBER")
    string(JSON sv GET "${doc}" schema_version)
    if(NOT sv EQUAL 1)
      gate_fail(manifest-format "${lbl}/schema_version")
    endif()
  endif()
  check_match("${lbl}" id "${doc}" "^FX-[A-Za-z0-9._-]+$" id)
  if(it STREQUAL "STRING" AND NOT id STREQUAL dirname)
    gate_fail(manifest-id-dir-mismatch "${dirname}")
  endif()
  check_enum("${lbl}" kind "${doc}" KINDS kind)
  check_enum("${lbl}" redistributable "${doc}" REDIST redistributable)
  check_match("${lbl}" licence "${doc}" "^[A-Za-z0-9.:+() -]+$" licence)
  check_match("${lbl}" local_path "${doc}" "^refs/[A-Za-z0-9._-]+$" local_path)

  # allowed_use: array of known uses.
  json_type(ut "${doc}" allowed_use)
  set(uses "")
  if(ut STREQUAL "ARRAY")
    string(JSON nu LENGTH "${doc}" allowed_use)
    if(nu GREATER 0)
      math(EXPR lu "${nu} - 1")
      foreach(i RANGE 0 ${lu})
        json_type(et "${doc}" allowed_use ${i})
        string(JSON u ERROR_VARIABLE ue GET "${doc}" allowed_use ${i})
        if(NOT et STREQUAL "STRING" OR NOT "${u}" IN_LIST USES)
          gate_fail(manifest-format "${lbl}/allowed_use")
        else()
          list(APPEND uses "${u}")
        endif()
      endforeach()
    endif()
  endif()

  # Nested objects and arrays.
  json_type(st "${doc}" source)
  if(st STREQUAL "OBJECT")
    string(JSON o GET "${doc}" source)
    check_shape("${lbl}" "source/" "${o}" origin:STRING pin:STRING|NULL accessed:STRING|NULL holder:STRING|NULL)
    check_match("${lbl}" source/accessed "${o}" "${DATE_RE}" accessed)
  endif()
  json_type(rt "${doc}" recipe)
  if(rt STREQUAL "OBJECT")
    string(JSON o GET "${doc}" recipe)
    check_shape("${lbl}" "recipe/" "${o}" tool:STRING tool_version:STRING tool_sha256:STRING
      tool_licence:STRING command:STRING sources:ARRAY)
    check_match("${lbl}" recipe/tool_sha256 "${o}" "${MANIFEST_HEX64_RE}" tool_sha256)
    check_entries("${lbl}" sources "${o}")
  endif()
  json_type(et "${doc}" licence_evidence)
  if(et STREQUAL "OBJECT")
    string(JSON o GET "${doc}" licence_evidence)
    check_shape("${lbl}" "licence_evidence/" "${o}" url:STRING text_sha256:STRING accessed:STRING)
    check_match("${lbl}" licence_evidence/text_sha256 "${o}" "${MANIFEST_HEX64_RE}" text_sha256)
    check_match("${lbl}" licence_evidence/accessed "${o}" "${DATE_RE}" accessed)
  endif()
  json_type(gt "${doc}" rights_review)
  if(gt STREQUAL "OBJECT")
    string(JSON o GET "${doc}" rights_review)
    check_shape("${lbl}" "rights_review/" "${o}" status:STRING by:STRING|NULL date:STRING|NULL)
    check_enum("${lbl}" rights_review/status "${o}" REVIEWS status)
    check_match("${lbl}" rights_review/date "${o}" "${DATE_RE}" date)
  endif()
  check_entries("${lbl}" outputs "${doc}")
  check_entries("${lbl}" notices "${doc}")
  check_string_array("${lbl}" inputs "${doc}" "")
  check_string_array("${lbl}" copyright "${doc}" "")
  check_string_array("${lbl}" derived_from "${doc}" "^FX-[A-Za-z0-9._-]+$")

  # Committed state and path consistency.
  json_type(ct "${doc}" committed)
  set(committed FALSE)
  if(ct STREQUAL "BOOLEAN")
    string(JSON cv GET "${doc}" committed)
    if(cv)
      set(committed TRUE)
    endif()
  endif()
  manifest_listed_outputs(outs "${doc}")
  json_type(pt "${doc}" path)
  if(committed)
    if(pt STREQUAL "STRING")
      string(JSON pv GET "${doc}" path)
      if(NOT "${pv}" IN_LIST outs)
        gate_fail(manifest-format "${lbl}/path")
      endif()
    elseif(NOT pt STREQUAL "MISSING")
      gate_fail(manifest-format "${lbl}/path")
    endif()
  elseif(pt STREQUAL "STRING")
    gate_fail(manifest-format "${lbl}/path")
  endif()

  # Rights rules.
  manifest_local_yes(loc "${doc}")
  manifest_effective(eff "${doc}")
  json_type(dt "${doc}" redistributable)
  if(dt STREQUAL "STRING")
    string(JSON dv GET "${doc}" redistributable)
    if(dv STREQUAL "yes" AND NOT loc STREQUAL "yes")
      gate_fail(manifest-yes-without-evidence "${lbl}")
    endif()
  endif()
  set(needs_yes FALSE)
  if(committed OR "repo" IN_LIST uses OR "release" IN_LIST uses)
    set(needs_yes TRUE)
  endif()
  if(needs_yes AND NOT eff STREQUAL "yes")
    gate_fail(manifest-committed-not-redistributable "${lbl}")
  endif()
  manifest_derived(deps "${doc}")
  get_property(regids GLOBAL PROPERTY MANIFEST_REG_IDS)
  foreach(d IN LISTS deps)
    if(NOT "${d}" IN_LIST regids)
      gate_fail(manifest-unknown-derived "${lbl}/${d}")
    endif()
  endforeach()

  # Output bytes: committed outputs must exist with the recorded size and digest;
  # outputs of an uncommitted manifest must not be tracked.
  if(committed)
    if("${outs}" STREQUAL "")
      gate_fail(manifest-missing-output "${lbl} outputs")
    endif()
    json_type(ot "${doc}" outputs)
    if(ot STREQUAL "ARRAY")
      string(JSON nout LENGTH "${doc}" outputs)
      if(nout GREATER 0)
        math(EXPR lo "${nout} - 1")
        foreach(i RANGE 0 ${lo})
          json_type(pt2 "${doc}" outputs ${i} path)
          json_type(zt "${doc}" outputs ${i} size_bytes)
          json_type(ht "${doc}" outputs ${i} sha256)
          if(NOT pt2 STREQUAL "STRING" OR NOT zt STREQUAL "NUMBER" OR NOT ht STREQUAL "STRING")
            continue()
          endif()
          string(JSON op GET "${doc}" outputs ${i} path)
          string(JSON osz GET "${doc}" outputs ${i} size_bytes)
          string(JSON osha GET "${doc}" outputs ${i} sha256)
          string(TOLOWER "${osha}" osha)
          path_ok(ok "${op}")
          if(NOT ok OR NOT EXISTS "${ROOT}/${op}")
            gate_fail(manifest-missing-output "${lbl} ${op}")
            continue()
          endif()
          file(SIZE "${ROOT}/${op}" asz)
          file(SHA256 "${ROOT}/${op}" asha)
          if(NOT asz EQUAL osz OR NOT asha STREQUAL osha)
            gate_fail(manifest-digest-mismatch "${lbl} ${op}")
          endif()
        endforeach()
      endif()
    endif()
  else()
    foreach(op IN LISTS outs)
      manifest_in_filelist(tracked "${op}")
      if(tracked)
        gate_fail(manifest-uncommitted-output-tracked "${lbl} ${op}")
      endif()
    endforeach()
  endif()

  # Recipe bytes (plan 07-05, D-29, A-12): the sources of a non-null recipe exist with their recorded
  # digests, and tool_sha256 is the digest of the tool's own source entry, so a changed tool or
  # source cannot hide behind a stale recipe. Committed manifests only (an uncommitted manifest names
  # material that is not in the tree).
  json_type(rct "${doc}" recipe)
  if(committed AND rct STREQUAL "OBJECT")
    string(JSON rdoc GET "${doc}" recipe)
    set(src_paths "")
    set(src_actual "")
    json_type(srt "${rdoc}" sources)
    if(srt STREQUAL "ARRAY")
      string(JSON nrs LENGTH "${rdoc}" sources)
      if(nrs GREATER 0)
        math(EXPR lrs "${nrs} - 1")
        foreach(i RANGE 0 ${lrs})
          json_type(spt "${rdoc}" sources ${i} path)
          json_type(sht "${rdoc}" sources ${i} sha256)
          if(NOT spt STREQUAL "STRING" OR NOT sht STREQUAL "STRING")
            continue()
          endif()
          string(JSON sp GET "${rdoc}" sources ${i} path)
          string(JSON ssha GET "${rdoc}" sources ${i} sha256)
          string(TOLOWER "${ssha}" ssha)
          path_ok(ok "${sp}")
          if(NOT ok OR NOT EXISTS "${ROOT}/${sp}")
            gate_fail(manifest-recipe-digest-mismatch "${lbl} ${sp} (source missing)")
            continue()
          endif()
          file(SHA256 "${ROOT}/${sp}" asha)
          if(NOT asha STREQUAL ssha)
            gate_fail(manifest-recipe-digest-mismatch "${lbl} ${sp}")
          endif()
          list(APPEND src_paths "${sp}")
          list(APPEND src_actual "${asha}")
        endforeach()
      endif()
    endif()
    json_type(tnt "${rdoc}" tool)
    json_type(tht "${rdoc}" tool_sha256)
    if(tnt STREQUAL "STRING" AND tht STREQUAL "STRING")
      string(JSON tool GET "${rdoc}" tool)
      string(JSON tsha GET "${rdoc}" tool_sha256)
      string(TOLOWER "${tsha}" tsha)
      set(tool_src "")
      foreach(pair IN LISTS RECIPE_TOOL_SOURCES)
        string(REGEX MATCH "^([^=]+)=(.+)$" _pm "${pair}")
        if("${CMAKE_MATCH_1}" STREQUAL "${tool}")
          set(tool_src "${CMAKE_MATCH_2}")
        endif()
      endforeach()
      list(FIND src_paths "${tool_src}" ti)
      if(tool_src STREQUAL "")
        gate_fail(manifest-recipe-digest-mismatch "${lbl} tool ${tool} has no registered tool source")
      elseif(ti LESS 0)
        gate_fail(manifest-recipe-digest-mismatch "${lbl} sources do not list ${tool_src}, the source of ${tool}")
      else()
        list(GET src_actual ${ti} tool_actual)
        if(NOT tsha STREQUAL tool_actual)
          gate_fail(manifest-recipe-digest-mismatch "${lbl} tool_sha256 is not the digest of ${tool_src}")
        endif()
      endif()
    endif()
  endif()
endfunction()

# Load and register every manifest, then check each one in sorted path order.
manifest_load_all(TRUE)
get_property(n GLOBAL PROPERTY MANIFEST_N)
set(ids "")
set(eff_yes 0)
set(eff_no 0)
if(n GREATER 0)
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last})
    get_property(p GLOBAL PROPERTY "MANIFEST_PATH_${i}")
    get_property(doc GLOBAL PROPERTY "MANIFEST_DOC_${i}")
    check_manifest("${p}" "${doc}")
    json_type(it "${doc}" id)
    if(it STREQUAL "STRING")
      string(JSON mid GET "${doc}" id)
      list(APPEND ids "${mid}")
    endif()
    manifest_effective(eff "${doc}")
    if(eff STREQUAL "yes")
      math(EXPR eff_yes "${eff_yes} + 1")
    else()
      math(EXPR eff_no "${eff_no} + 1")
    endif()
  endforeach()
endif()

# Duplicate ids and set equality with the inventory.
list(SORT ids)
set(prev "")
foreach(i IN LISTS ids)
  if(i STREQUAL prev)
    gate_fail(manifest-duplicate-id "${i}")
  endif()
  set(prev "${i}")
endforeach()
set(uniq ${ids})
list(REMOVE_DUPLICATES uniq)
read_ids(want "data/expected/fixtures.ids" manifest)
foreach(i IN LISTS want)
  if(NOT "${i}" IN_LIST uniq)
    gate_fail(manifest-id-missing "${i}")
  endif()
endforeach()
foreach(i IN LISTS uniq)
  if(NOT "${i}" IN_LIST want)
    gate_fail(manifest-id-extra "${i}")
  endif()
endforeach()

gate_stat(manifests "${n}")
gate_stat(effective-yes "${eff_yes}")
gate_stat(effective-no "${eff_no}")
gate_finish(manifests)
