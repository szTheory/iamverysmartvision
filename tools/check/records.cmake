# SPDX-License-Identifier: MIT
# Generic JSON record checker driven by schema/<KIND>.txt (SKELETON.md section 4).
# Inputs (passed with -D):
#   ROOT   the tree under test (required)
#   KIND   the record kind, names schema/<KIND>.txt (required)
# Failure tokens: <kind>-file-missing|file-empty|parse|unknown-topkey|missing-top|
#   type|empty|duplicate-id|id-missing|id-extra|inventory-empty|unknown-key|missing|
#   blank|format|unknown-ref, plus hook-defined tokens.
# Success line: "<kind> pass records=<n> <hook stats>".
# Limit: duplicate JSON member keys are not detectable (CMake keeps the last).
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT KIND)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "records.cmake is missing ${required}")
  endif()
endforeach()
set(CHECK_HERE "${CMAKE_CURRENT_LIST_DIR}")
include("${CHECK_HERE}/lib.cmake")

set(SCHEMA "${CHECK_HERE}/schema/${KIND}.txt")
if(NOT EXISTS "${SCHEMA}")
  message(FATAL_ERROR "records.cmake: no schema for kind ${KIND}")
endif()

# ---- schema parse ----
file(READ "${SCHEMA}" schema_text)
gate_lines(schema_lines "${schema_text}")
set(REC_FILE "")
set(COLL_MODE "")
set(COLL_KEY "")
set(ID_KEY "")
set(INV_FILE "")
set(HOOK "")
set(TOPKEYS "")
set(HAVE_TOPKEYS FALSE)
set(REC_KEYS "")
set(HAVE_KEYS FALSE)
set(TOPS "")
set(RULES "")
foreach(raw IN LISTS schema_lines)
  string(STRIP "${raw}" raw)
  if(raw STREQUAL "" OR raw MATCHES "^#")
    continue()
  endif()
  string(REGEX REPLACE "[ \t]+" ";" toks "${raw}")
  list(GET toks 0 d)
  list(LENGTH toks nt)
  if(NOT d STREQUAL "topkeys" AND NOT d STREQUAL "keys" AND nt LESS 2)
    gate_fail(${KIND}-schema "${d}")
    continue()
  endif()
  if(d STREQUAL "file")
    list(GET toks 1 REC_FILE)
  elseif(d STREQUAL "topkeys")
    list(REMOVE_AT toks 0)
    set(TOPKEYS ${toks})
    set(HAVE_TOPKEYS TRUE)
  elseif(d STREQUAL "keys")
    list(REMOVE_AT toks 0)
    set(REC_KEYS ${toks})
    set(HAVE_KEYS TRUE)
  elseif(d STREQUAL "top")
    list(APPEND TOPS "${raw}")
  elseif(d STREQUAL "array" OR d STREQUAL "members")
    set(COLL_MODE "${d}")
    list(GET toks 1 COLL_KEY)
  elseif(d STREQUAL "idkey")
    list(GET toks 1 ID_KEY)
  elseif(d STREQUAL "inventory")
    list(GET toks 1 INV_FILE)
  elseif(d STREQUAL "hook")
    list(GET toks 1 HOOK)
  elseif(d MATCHES "^(req|nonblank|match|enumfrom|when)$")
    list(APPEND RULES "${raw}")
  else()
    gate_fail(${KIND}-schema "${d}")
  endif()
endforeach()
if(REC_FILE STREQUAL "" OR COLL_MODE STREQUAL "" OR (COLL_MODE STREQUAL "array" AND ID_KEY STREQUAL ""))
  message(FATAL_ERROR "records.cmake: schema ${KIND} needs file, array|members (and idkey for array)")
endif()

# ---- helpers ----
function(type_ok out actual spec)
  string(REPLACE "|" ";" allowed "${spec}")
  if("${actual}" IN_LIST allowed)
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# Ids of another JSON file's array (cached); the file is read from ROOT.
function(enum_ids out relpath arraykey idkey)
  set(prop "ENUM:${relpath}:${arraykey}:${idkey}")
  get_property(isset GLOBAL PROPERTY "${prop}" SET)
  if(NOT isset)
    set(ids "")
    read_record_file(edoc "${relpath}" ${KIND}-enum)
    if(NOT "${edoc}" STREQUAL "")
      json_type(et "${edoc}" ${arraykey})
      if(et STREQUAL ARRAY)
        string(JSON en LENGTH "${edoc}" ${arraykey})
        if(en GREATER 0)
          math(EXPR elast "${en} - 1")
          foreach(i RANGE 0 ${elast})
            string(JSON erec GET "${edoc}" ${arraykey} ${i})
            json_type(it "${erec}" ${idkey})
            if(it STREQUAL STRING)
              string(JSON eid GET "${erec}" ${idkey})
              list(APPEND ids "${eid}")
            endif()
          endforeach()
        endif()
      endif()
    endif()
    set_property(GLOBAL PROPERTY "${prop}" "${ids}")
  endif()
  get_property(ids GLOBAL PROPERTY "${prop}")
  set(${out} "${ids}" PARENT_SCOPE)
endfunction()

function(apply_rule id rec rule)
  string(REGEX REPLACE "[ \t]+" ";" toks "${rule}")
  list(GET toks 0 d)
  list(LENGTH toks nt)
  if(d STREQUAL "when")
    list(GET toks 1 cond)
    string(FIND "${cond}" "=" p)
    if(p LESS 1 OR nt LESS 3)
      gate_fail(${KIND}-schema "when")
      return()
    endif()
    string(SUBSTRING "${cond}" 0 ${p} ck)
    math(EXPR p1 "${p} + 1")
    string(SUBSTRING "${cond}" ${p1} -1 cv)
    json_type(ct "${rec}" ${ck})
    if(ct STREQUAL STRING)
      string(JSON actual GET "${rec}" ${ck})
      if("${actual}" STREQUAL "${cv}")
        list(REMOVE_AT toks 0 1)
        list(JOIN toks " " inner)
        apply_rule("${id}" "${rec}" "${inner}")
      endif()
    endif()
    return()
  endif()
  if(nt LESS 2)
    gate_fail(${KIND}-schema "${d}")
    return()
  endif()
  list(GET toks 1 key)
  string(REPLACE "/" ";" path "${key}")
  json_type(ty "${rec}" ${path})
  if(d STREQUAL "req")
    if(nt LESS 3)
      gate_fail(${KIND}-schema "req")
    elseif(ty STREQUAL MISSING)
      gate_fail(${KIND}-missing "${id}/${key}")
    else()
      list(GET toks 2 spec)
      type_ok(ok "${ty}" "${spec}")
      if(NOT ok)
        gate_fail(${KIND}-type "${id}/${key}")
      endif()
    endif()
  elseif(d STREQUAL "nonblank")
    if(ty STREQUAL MISSING)
      return()
    endif()
    set(blank FALSE)
    if(ty STREQUAL STRING)
      string(JSON v GET "${rec}" ${path})
      string(STRIP "${v}" v)
      if(v STREQUAL "")
        set(blank TRUE)
      endif()
    elseif(ty STREQUAL NULL)
      set(blank TRUE)
    elseif(ty STREQUAL OBJECT OR ty STREQUAL ARRAY)
      string(JSON bn LENGTH "${rec}" ${path})
      if(bn EQUAL 0)
        set(blank TRUE)
      endif()
    endif()
    if(blank)
      gate_fail(${KIND}-blank "${id}/${key}")
    endif()
  elseif(d STREQUAL "match")
    if(NOT ty STREQUAL STRING OR nt LESS 3)
      return()
    endif()
    list(GET toks 2 re)
    gate_unprotect(re "${re}")
    string(JSON v GET "${rec}" ${path})
    if(NOT "${v}" MATCHES "${re}")
      gate_fail(${KIND}-format "${id}/${key}")
    endif()
  elseif(d STREQUAL "enumfrom")
    if(NOT ty STREQUAL STRING OR nt LESS 5)
      return()
    endif()
    list(GET toks 2 rel)
    list(GET toks 3 arr)
    list(GET toks 4 ik)
    enum_ids(ids "${rel}" ${arr} ${ik})
    string(JSON v GET "${rec}" ${path})
    if(NOT "${v}" IN_LIST ids)
      gate_fail(${KIND}-unknown-ref "${id}/${key}")
    endif()
  endif()
endfunction()

# ---- read the record file and the top level ----
read_record_file(DOC "${REC_FILE}" ${KIND})
if("${DOC}" STREQUAL "")
  gate_finish(${KIND})
endif()
json_type(root_type "${DOC}")
if(NOT root_type STREQUAL OBJECT)
  gate_fail(${KIND}-type "<root>")
  gate_finish(${KIND})
endif()
set(REC_DOC "${DOC}")

if(HAVE_TOPKEYS)
  json_members(top_members "${DOC}")
  foreach(k IN LISTS top_members)
    if(NOT "${k}" IN_LIST TOPKEYS)
      gate_fail(${KIND}-unknown-topkey "${k}")
    endif()
  endforeach()
endif()
foreach(t IN LISTS TOPS)
  string(REGEX REPLACE "[ \t]+" ";" tt "${t}")
  list(LENGTH tt ntt)
  if(ntt LESS 3)
    gate_fail(${KIND}-schema "top")
    continue()
  endif()
  list(GET tt 1 key)
  list(GET tt 2 spec)
  json_type(ty "${DOC}" ${key})
  if(ty STREQUAL MISSING)
    gate_fail(${KIND}-missing-top "${key}")
  else()
    type_ok(ok "${ty}" "${spec}")
    if(NOT ok)
      gate_fail(${KIND}-type "${key}")
    endif()
  endif()
endforeach()

if(NOT HOOK STREQUAL "")
  include("${CHECK_HERE}/kinds/${HOOK}.cmake")
endif()

# ---- records ----
set(rec_ids "")
set(nrecs 0)
json_type(coll_type "${DOC}" ${COLL_KEY})
set(n 0)
if(coll_type STREQUAL ARRAY AND COLL_MODE STREQUAL "array")
  string(JSON n LENGTH "${DOC}" ${COLL_KEY})
elseif(coll_type STREQUAL OBJECT AND COLL_MODE STREQUAL "members")
  string(JSON n LENGTH "${DOC}" ${COLL_KEY})
endif()
if(n EQUAL 0)
  gate_fail(${KIND}-empty "${COLL_KEY}")
else()
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last})
    if(COLL_MODE STREQUAL "array")
      string(JSON rec GET "${DOC}" ${COLL_KEY} ${i})
      set(id "#${i}")
      json_type(it "${rec}" ${ID_KEY})
      if(it STREQUAL STRING)
        string(JSON id GET "${rec}" ${ID_KEY})
      endif()
    else()
      string(JSON id MEMBER "${DOC}" ${COLL_KEY} ${i})
      string(JSON rec GET "${DOC}" ${COLL_KEY} "${id}")
    endif()
    math(EXPR nrecs "${nrecs} + 1")
    json_type(rt "${rec}")
    if(NOT rt STREQUAL OBJECT)
      gate_fail(${KIND}-type "${id}")
      continue()
    endif()
    if("${id}" IN_LIST rec_ids)
      gate_fail(${KIND}-duplicate-id "${id}")
    else()
      list(APPEND rec_ids "${id}")
    endif()
    if(HAVE_KEYS)
      json_members(ms "${rec}")
      foreach(k IN LISTS ms)
        if(NOT "${k}" IN_LIST REC_KEYS)
          gate_fail(${KIND}-unknown-key "${id}/${k}")
        endif()
      endforeach()
    endif()
    foreach(rule IN LISTS RULES)
      apply_rule("${id}" "${rec}" "${rule}")
    endforeach()
    if(NOT HOOK STREQUAL "")
      cmake_language(CALL hook_record "${id}" "${rec}")
    endif()
  endforeach()
endif()

# ---- inventory (exact set, order-independent, sorted output) ----
if(NOT INV_FILE STREQUAL "")
  read_ids(inv "${INV_FILE}" ${KIND})
  list(SORT rec_ids)
  foreach(x IN LISTS inv)
    if(NOT "${x}" IN_LIST rec_ids)
      gate_fail(${KIND}-id-missing "${x}")
    endif()
  endforeach()
  foreach(x IN LISTS rec_ids)
    if(NOT "${x}" IN_LIST inv)
      gate_fail(${KIND}-id-extra "${x}")
    endif()
  endforeach()
endif()

gate_stat(records "${nrecs}")
if(NOT HOOK STREQUAL "")
  cmake_language(CALL hook_finish)
endif()
gate_finish(${KIND})
