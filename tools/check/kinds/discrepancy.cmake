# Hook for kind discrepancy (SKELETON.md section 4).
# Failure tokens: discrepancy-order: <id>, discrepancy-resolved-without-page: <id>,
#   discrepancy-format: <id>/default_policy (open or partial without the unknown-default-chosen prefix).
#   discrepancies-d10-missing: <id> (an open or partial entry whose resolver starts `measurement:` that no
#   line of data/expected/d10-measurements.ids names), discrepancies-d10-unknown: <line id>/<id> (an
#   inventory line naming an entry that does not exist or is neither open nor partial; D11 lines are
#   checked for existence only), discrepancies-d10-format: <line> (a malformed inventory line).
# Stats: discrepancies=<n>, pending-resolvers=<n>, open=<n>, d10-items=<n>.
cmake_minimum_required(VERSION 3.25)

function(hook_record id rec)
  gate_incr(disc-total)
  # Entries are stored in strictly ascending numeric id order.
  if("${id}" MATCHES "^C[0-9]+$")
    string(SUBSTRING "${id}" 1 -1 num)
    get_property(have GLOBAL PROPERTY DISC_LAST_NUM SET)
    if(have)
      get_property(prev GLOBAL PROPERTY DISC_LAST_NUM)
      if(NOT num GREATER prev)
        gate_fail(discrepancy-order "${id}")
      endif()
    endif()
    set_property(GLOBAL PROPERTY DISC_LAST_NUM "${num}")
  endif()
  set_property(GLOBAL APPEND PROPERTY DISC_ALL "${id}")
  set(is_meas FALSE)
  json_type(rt "${rec}" resolver)
  if(rt STREQUAL STRING)
    string(JSON resolver GET "${rec}" resolver)
    if("${resolver}" MATCHES "^pending:")
      gate_incr(disc-pending)
    endif()
    if("${resolver}" MATCHES "^measurement:")
      set(is_meas TRUE)
    endif()
  endif()
  json_type(st "${rec}" status)
  if(NOT st STREQUAL STRING)
    return()
  endif()
  string(JSON status GET "${rec}" status)
  if(status STREQUAL "open" OR status STREQUAL "partial")
    set_property(GLOBAL APPEND PROPERTY DISC_LIVE "${id}")
    if(is_meas)
      set_property(GLOBAL APPEND PROPERTY DISC_MEAS "${id}")
    endif()
  endif()
  if(status STREQUAL "open" OR status STREQUAL "partial")
    set(policy "")
    json_type(pt "${rec}" default_policy)
    if(pt STREQUAL STRING)
      string(JSON policy GET "${rec}" default_policy)
    endif()
    if(NOT "${policy}" MATCHES "^unknown-default-chosen: .+")
      gate_fail(discrepancy-format "${id}/default_policy")
    endif()
    if(status STREQUAL "open")
      gate_incr(disc-open)
    endif()
  elseif(status STREQUAL "resolved-primary")
    set(evidence "")
    json_type(et "${rec}" evidence)
    if(et STREQUAL STRING)
      string(JSON evidence GET "${rec}" evidence)
    endif()
    if(NOT "${evidence}" MATCHES "pdf [0-9]+")
      gate_fail(discrepancy-resolved-without-page "${id}")
    endif()
  endif()
endfunction()

function(hook_finish)
  gate_count(nt disc-total)
  gate_count(np disc-pending)
  gate_count(no disc-open)
  gate_stat(discrepancies "${nt}")
  gate_stat(pending-resolvers "${np}")
  gate_stat(open "${no}")
  # D10 and D11 inventory (plan 05-01, D-26): the exact owner-evidence list. Absent file: no check.
  set(inv "${ROOT}/data/expected/d10-measurements.ids")
  if(NOT EXISTS "${inv}")
    return()
  endif()
  get_property(all GLOBAL PROPERTY DISC_ALL)
  get_property(live GLOBAL PROPERTY DISC_LIVE)
  get_property(meas GLOBAL PROPERTY DISC_MEAS)
  file(STRINGS "${inv}" inv_lines)
  set(named "")
  set(items 0)
  foreach(line IN LISTS inv_lines)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    if(NOT line MATCHES "^(D1[01]-[A-Z]+-[0-9]+) [|] (C[0-9]+) [|] [^|]+ [|] [^| ]+$")
      gate_fail(discrepancies-d10-format "${line}")
      continue()
    endif()
    set(lid "${CMAKE_MATCH_1}")
    set(cid "${CMAKE_MATCH_2}")
    math(EXPR items "${items} + 1")
    list(APPEND named "${cid}")
    if(NOT cid IN_LIST all)
      gate_fail(discrepancies-d10-unknown "${lid}/${cid}")
    elseif(lid MATCHES "^D10-" AND NOT cid IN_LIST live)
      gate_fail(discrepancies-d10-unknown "${lid}/${cid}")
    endif()
  endforeach()
  foreach(cid IN LISTS meas)
    if(NOT cid IN_LIST named)
      gate_fail(discrepancies-d10-missing "${cid}")
    endif()
  endforeach()
  gate_stat(d10-items "${items}")
endfunction()
