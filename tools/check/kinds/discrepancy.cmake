# Hook for kind discrepancy (SKELETON.md section 4).
# Failure tokens: discrepancy-order: <id>, discrepancy-resolved-without-page: <id>,
#   discrepancy-format: <id>/default_policy (open or partial without the unknown-default-chosen prefix).
# Stats: discrepancies=<n>, pending-resolvers=<n>, open=<n>.
cmake_minimum_required(VERSION 3.25)

function(hook_record id rec)
  gate_incr(disc-total)
  # Entries are stored in strictly ascending numeric id order.
  if("${id}" MATCHES "^C[0-9]+$")
    string(SUBSTRING "${id}" 1 -1 num)
    get_property(have GLOBAL PROPERTY DISC_LAST_NUM SET)
    if(have)
      get_property(prev GLOBAL PROPERTY DISC_LAST_NUM)
      if(NOT num GREATER prev)
        gate_fail(discrepancy-order "${id}")
      endif()
    endif()
    set_property(GLOBAL PROPERTY DISC_LAST_NUM "${num}")
  endif()
  json_type(rt "${rec}" resolver)
  if(rt STREQUAL STRING)
    string(JSON resolver GET "${rec}" resolver)
    if("${resolver}" MATCHES "^pending:")
      gate_incr(disc-pending)
    endif()
  endif()
  json_type(st "${rec}" status)
  if(NOT st STREQUAL STRING)
    return()
  endif()
  string(JSON status GET "${rec}" status)
  if(status STREQUAL "open" OR status STREQUAL "partial")
    set(policy "")
    json_type(pt "${rec}" default_policy)
    if(pt STREQUAL STRING)
      string(JSON policy GET "${rec}" default_policy)
    endif()
    if(NOT "${policy}" MATCHES "^unknown-default-chosen: .+")
      gate_fail(discrepancy-format "${id}/default_policy")
    endif()
    if(status STREQUAL "open")
      gate_incr(disc-open)
    endif()
  elseif(status STREQUAL "resolved-primary")
    set(evidence "")
    json_type(et "${rec}" evidence)
    if(et STREQUAL STRING)
      string(JSON evidence GET "${rec}" evidence)
    endif()
    if(NOT "${evidence}" MATCHES "pdf [0-9]+")
      gate_fail(discrepancy-resolved-without-page "${id}")
    endif()
  endif()
endfunction()

function(hook_finish)
  gate_count(nt disc-total)
  gate_count(np disc-pending)
  gate_count(no disc-open)
  gate_stat(discrepancies "${nt}")
  gate_stat(pending-resolvers "${np}")
  gate_stat(open "${no}")
endfunction()
