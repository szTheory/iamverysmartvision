# Hook for kind cp1610-row (SKELETON.md section 4).
# Failure tokens: cp1610-row-pattern-length: <id>, cp1610-row-printed-mismatch: <id>,
#   cp1610-row-unknown-ref: <id>/<refines|also_encodes>, cp1610-row-format: <id>/<cite|sdbd|eq>.
# Stats: cp1610-rows=<n>.
# Cycles, status bits and interruptibility are transcription facts that no machine check can
# decide; only their presence is checked (the schema's req/nonblank lines). In particular no
# cycle value is required on any row: NOPP prints 7, not 7/9, on pdf 54.
cmake_minimum_required(VERSION 3.25)

function(hook_record id rec)
  gate_incr(cp1610-total)
  set_property(GLOBAL APPEND PROPERTY CP1610_IDS "${id}")

  json_type(pt "${rec}" pattern)
  set(pattern "")
  if(pt STREQUAL STRING)
    string(JSON pattern GET "${rec}" pattern)
    string(LENGTH "${pattern}" plen)
    if(NOT plen EQUAL 10)
      gate_fail(cp1610-row-pattern-length "${id}")
    endif()
    json_type(prt "${rec}" printed)
    if(prt STREQUAL STRING)
      string(JSON printed GET "${rec}" printed)
      string(REPLACE " " "" printed "${printed}")
      string(REGEX REPLACE "[A-Za-z]" "." printed "${printed}")
      if(NOT "${printed}" STREQUAL "${pattern}")
        gate_fail(cp1610-row-printed-mismatch "${id}")
      endif()
    endif()
  endif()

  # The cite must name at least one pdf page.
  json_type(ct "${rec}" cite)
  if(ct STREQUAL STRING)
    string(JSON cite GET "${rec}" cite)
    if(NOT "${cite}" MATCHES "pdf [0-9]+")
      gate_fail(cp1610-row-format "${id}/cite")
    endif()
  endif()

  # sdbd: not-applicable, unsupported, or `supported: <detail>`.
  json_type(st "${rec}" sdbd)
  if(st STREQUAL STRING)
    string(JSON sdbd GET "${rec}" sdbd)
    if(NOT "${sdbd}" MATCHES "^(not-applicable|unsupported|supported: .+)$")
      gate_fail(cp1610-row-format "${id}/sdbd")
    endif()
  endif()

  # eq entries relate two equal-width bit fields: <hi>:<lo>=<hi>:<lo>.
  json_type(et "${rec}" eq)
  if(et STREQUAL ARRAY)
    string(JSON en LENGTH "${rec}" eq)
    if(en GREATER 0)
      math(EXPR elast "${en} - 1")
      foreach(i RANGE 0 ${elast})
        json_type(eit "${rec}" eq ${i})
        set(good FALSE)
        if(eit STREQUAL STRING)
          string(JSON e GET "${rec}" eq ${i})
          if("${e}" MATCHES "^([0-9]+):([0-9]+)=([0-9]+):([0-9]+)$")
            set(h1 "${CMAKE_MATCH_1}")
            set(l1 "${CMAKE_MATCH_2}")
            set(h2 "${CMAKE_MATCH_3}")
            set(l2 "${CMAKE_MATCH_4}")
            math(EXPR w1 "${h1} - ${l1}")
            math(EXPR w2 "${h2} - ${l2}")
            if(w1 GREATER_EQUAL 0 AND w1 EQUAL w2 AND h1 LESS 10 AND h2 LESS 10)
              set(good TRUE)
            endif()
          endif()
        endif()
        if(NOT good)
          gate_fail(cp1610-row-format "${id}/eq")
        endif()
      endforeach()
    endif()
  endif()

  # refines and also_encodes are checked against the full id set in hook_finish.
  json_type(rt "${rec}" refines)
  if(rt STREQUAL STRING)
    string(JSON refines GET "${rec}" refines)
    set_property(GLOBAL APPEND PROPERTY CP1610_REFS "${id}|refines|${refines}")
  endif()
  json_type(at "${rec}" also_encodes)
  if(at STREQUAL ARRAY)
    string(JSON an LENGTH "${rec}" also_encodes)
    if(an GREATER 0)
      math(EXPR alast "${an} - 1")
      foreach(i RANGE 0 ${alast})
        json_type(ait "${rec}" also_encodes ${i})
        if(ait STREQUAL STRING)
          string(JSON a GET "${rec}" also_encodes ${i})
          set_property(GLOBAL APPEND PROPERTY CP1610_REFS "${id}|also_encodes|${a}")
        else()
          gate_fail(cp1610-row-format "${id}/also_encodes")
        endif()
      endforeach()
    endif()
  endif()
endfunction()

function(hook_finish)
  get_property(ids GLOBAL PROPERTY CP1610_IDS)
  get_property(refs GLOBAL PROPERTY CP1610_REFS)
  foreach(r IN LISTS refs)
    string(REPLACE "|" ";" parts "${r}")
    list(GET parts 0 id)
    list(GET parts 1 field)
    list(GET parts 2 target)
    if(NOT "${target}" IN_LIST ids)
      gate_fail(cp1610-row-unknown-ref "${id}/${field}")
    endif()
  endforeach()
  gate_count(n cp1610-total)
  gate_stat(cp1610-rows "${n}")
endfunction()
