# Hook for kind vector-review (A-07, A-12; plan 02-16): second-read markers of the vector files.
# Failure tokens (`-- FAIL <token>: <id> <detail>`):
#   vector-review-format             file_sha256 or derived_sha256 not 64 lowercase hex digits, file
#                                    not data/cp1610/vectors/<id>.json, a count not a whole number,
#                                    or a malformed line of the handoff record (`<stem> <64-hex>
#                                    <reviewer> <run-id>`, run-id matching ^[A-Za-z0-9._:/-]+$)
#   vector-review-stale              the current sha256 of the vector file differs from file_sha256
#   vector-review-reviewer           reviewer does not name an isolated run (isolated-subagent-blind-v<n>)
#   vector-review-count              vectors differs from the file's vector count, or agree > vectors
#   vector-review-unresolved         disagreements and resolutions differ in length
#   vector-review-handoff-mismatch   the handoff record data/expected/vector-review-handoff.ids has no
#                                    line for the id, or its last line for the id names another
#                                    sha256 or reviewer than the row (a later line replaces an earlier one)
# Stats: reviewed-vectors=<sum of vectors> review-disagreements=<sum of disagreements>.
cmake_minimum_required(VERSION 3.25)

string(REPEAT "[0-9a-f]" 64 VR_HEX64)
set(VR_REVIEWER_RE "^isolated-subagent-blind-v[0-9]+$")
set(VR_RUN_RE "^[A-Za-z0-9._:/-]+$")
set(VR_HANDOFF "data/expected/vector-review-handoff.ids")

# Parse the handoff record once: GLOBAL property VR_HANDOFF_<stem> = "<sha> <reviewer> <run-id>"
# of the last well-formed line for that stem; malformed lines fail vector-review-format.
function(vr_load_handoff)
  get_property(done GLOBAL PROPERTY VR_HANDOFF_LOADED SET)
  if(done)
    return()
  endif()
  set_property(GLOBAL PROPERTY VR_HANDOFF_LOADED TRUE)
  set(f "${ROOT}/${VR_HANDOFF}")
  if(NOT EXISTS "${f}")
    set_property(GLOBAL PROPERTY VR_HANDOFF_MISSING TRUE)
    return()
  endif()
  file(STRINGS "${f}" lines)
  set(n 0)
  foreach(l IN LISTS lines)
    math(EXPR n "${n} + 1")
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    string(REGEX REPLACE "[ \t]+" ";" toks "${l}")
    list(LENGTH toks nt)
    if(NOT nt EQUAL 4)
      gate_fail(vector-review-format "${VR_HANDOFF} line ${n} (columns)")
      continue()
    endif()
    list(GET toks 0 stem)
    list(GET toks 1 sha)
    list(GET toks 2 rev)
    list(GET toks 3 run)
    if(NOT stem MATCHES "^[a-z0-9-]+$" OR NOT sha MATCHES "^${VR_HEX64}$"
       OR NOT rev MATCHES "${VR_REVIEWER_RE}" OR NOT run MATCHES "${VR_RUN_RE}")
      gate_fail(vector-review-format "${VR_HANDOFF} line ${n}")
      continue()
    endif()
    set_property(GLOBAL PROPERTY "VR_HANDOFF_${stem}" "${sha} ${rev} ${run}")
  endforeach()
endfunction()

function(vr_get out rec key)
  set(${out} "" PARENT_SCOPE)
  json_type(t "${rec}" ${key})
  if(t STREQUAL "STRING" OR t STREQUAL "NUMBER")
    string(JSON v GET "${rec}" ${key})
    set(${out} "${v}" PARENT_SCOPE)
  endif()
endfunction()

function(hook_record id rec)
  vr_load_handoff()
  vr_get(file "${rec}" file)
  vr_get(fsha "${rec}" file_sha256)
  vr_get(dsha "${rec}" derived_sha256)
  vr_get(rev "${rec}" reviewer)
  vr_get(nvec "${rec}" vectors)
  vr_get(agree "${rec}" agree)

  # format
  if(NOT fsha MATCHES "^${VR_HEX64}$")
    gate_fail(vector-review-format "${id} file_sha256")
  endif()
  if(NOT dsha MATCHES "^${VR_HEX64}$")
    gate_fail(vector-review-format "${id} derived_sha256")
  endif()
  if(NOT file STREQUAL "data/cp1610/vectors/${id}.json")
    gate_fail(vector-review-format "${id} file")
  endif()
  set(counts_ok TRUE)
  if(NOT nvec MATCHES "^[0-9]+$" OR NOT agree MATCHES "^[0-9]+$")
    gate_fail(vector-review-format "${id} vectors/agree")
    set(counts_ok FALSE)
  endif()

  # stale: the vector file as it is now
  set(f "${ROOT}/data/cp1610/vectors/${id}.json")
  set(have_n "")
  if(EXISTS "${f}")
    file(SHA256 "${f}" have)
    if(NOT "${have}" STREQUAL "${fsha}")
      gate_fail(vector-review-stale "${id}")
    endif()
    file(READ "${f}" vdoc)
    string(JSON vt ERROR_VARIABLE verr TYPE "${vdoc}" vectors)
    if("${verr}" STREQUAL "NOTFOUND" AND vt STREQUAL "ARRAY")
      string(JSON have_n LENGTH "${vdoc}" vectors)
    endif()
  else()
    gate_fail(vector-review-stale "${id} (file missing)")
  endif()

  # reviewer
  if(NOT rev MATCHES "${VR_REVIEWER_RE}")
    gate_fail(vector-review-reviewer "${id}")
  endif()

  # counts
  if(counts_ok)
    if(NOT "${have_n}" STREQUAL "${nvec}")
      gate_fail(vector-review-count "${id} vectors")
    endif()
    if(agree GREATER nvec)
      gate_fail(vector-review-count "${id} agree")
    endif()
    vr_incr_by(reviewed-vectors "${nvec}")
  endif()

  # disagreements and resolutions
  set(nd -1)
  set(nr -2)
  json_type(dt "${rec}" disagreements)
  json_type(rt "${rec}" resolutions)
  if(dt STREQUAL "ARRAY")
    string(JSON nd LENGTH "${rec}" disagreements)
    vr_incr_by(review-disagreements "${nd}")
  endif()
  if(rt STREQUAL "ARRAY")
    string(JSON nr LENGTH "${rec}" resolutions)
  endif()
  if(dt STREQUAL "ARRAY" AND rt STREQUAL "ARRAY" AND NOT nd EQUAL nr)
    gate_fail(vector-review-unresolved "${id} disagreements=${nd} resolutions=${nr}")
  endif()

  # committed handoff record
  get_property(missing GLOBAL PROPERTY VR_HANDOFF_MISSING)
  get_property(line GLOBAL PROPERTY "VR_HANDOFF_${id}")
  if(missing)
    gate_fail(vector-review-handoff-mismatch "${id} (no ${VR_HANDOFF})")
  elseif("${line}" STREQUAL "")
    gate_fail(vector-review-handoff-mismatch "${id} (no handoff line)")
  else()
    string(REPLACE " " ";" ht "${line}")
    list(GET ht 0 hsha)
    list(GET ht 1 hrev)
    if(NOT "${hsha}" STREQUAL "${dsha}")
      gate_fail(vector-review-handoff-mismatch "${id} derived_sha256")
    endif()
    if(NOT "${hrev}" STREQUAL "${rev}")
      gate_fail(vector-review-handoff-mismatch "${id} reviewer")
    endif()
  endif()
endfunction()

function(vr_incr_by key n)
  get_property(v GLOBAL PROPERTY "GATE_CNT_${key}")
  if("${v}" STREQUAL "")
    set(v 0)
  endif()
  math(EXPR v "${v} + ${n}")
  set_property(GLOBAL PROPERTY "GATE_CNT_${key}" "${v}")
endfunction()

function(hook_finish)
  # Malformed handoff lines fail even when no row names them.
  vr_load_handoff()
  gate_count(rv reviewed-vectors)
  gate_count(rd review-disagreements)
  gate_stat(reviewed-vectors "${rv}")
  gate_stat(review-disagreements "${rd}")
endfunction()
