# Hook for kind evidence-tiers: the two vocabularies must never share an id (D-09).
# Failure token: evidence-tiers-conflated: <id>.
cmake_minimum_required(VERSION 3.25)

function(hook_record id rec)
endfunction()

function(hook_finish)
  set(tag_ids "")
  json_type(tt "${REC_DOC}" source_authority_tags)
  if(tt STREQUAL ARRAY)
    string(JSON tn LENGTH "${REC_DOC}" source_authority_tags)
    if(tn GREATER 0)
      math(EXPR tlast "${tn} - 1")
      foreach(i RANGE 0 ${tlast})
        json_type(it "${REC_DOC}" source_authority_tags ${i} id)
        if(it STREQUAL STRING)
          string(JSON tid GET "${REC_DOC}" source_authority_tags ${i} id)
          list(APPEND tag_ids "${tid}")
        endif()
      endforeach()
    endif()
  endif()
  json_type(et "${REC_DOC}" evidence_tiers)
  if(et STREQUAL ARRAY)
    string(JSON en LENGTH "${REC_DOC}" evidence_tiers)
    if(en GREATER 0)
      math(EXPR elast "${en} - 1")
      foreach(i RANGE 0 ${elast})
        json_type(it "${REC_DOC}" evidence_tiers ${i} id)
        if(it STREQUAL STRING)
          string(JSON eid GET "${REC_DOC}" evidence_tiers ${i} id)
          if("${eid}" IN_LIST tag_ids)
            gate_fail(evidence-tiers-conflated "${eid}")
          endif()
        endif()
      endforeach()
    endif()
  endif()
endfunction()
