# Hook for kind source (SKELETON.md section 4): the reference-document registry.
# Failure tokens: source-format: <id>/<field>, source-local-path: <id>,
#   source-reference-only-unexplained: <id>, source-digest-mismatch: <id>.
# Stats: sources=<n>, refs-verified=<k>/<hashed count>.
# A cached file under refs/ is optional (CI has no cache, so 0/N is the expected state there);
# when it is present, its size and sha256 must equal the pinned values.
cmake_minimum_required(VERSION 3.25)

function(hook_record id rec)
  gate_incr(source-total)
  set(capture "")
  json_type(ct "${rec}" capture)
  if(ct STREQUAL STRING)
    string(JSON capture GET "${rec}" capture)
  endif()

  json_type(shat "${rec}" sha256)
  json_type(szt "${rec}" size_bytes)
  json_type(lpt "${rec}" local_path)

  if(capture STREQUAL "hashed")
    gate_incr(source-hashed)
    set(sha "")
    if(shat STREQUAL STRING)
      string(JSON sha GET "${rec}" sha256)
    endif()
    string(LENGTH "${sha}" shalen)
    if(NOT shalen EQUAL 64)
      gate_fail(source-format "${id}/sha256")
    endif()
    set(size "")
    if(szt STREQUAL NUMBER)
      string(JSON size GET "${rec}" size_bytes)
    else()
      gate_fail(source-format "${id}/size_bytes")
    endif()
    set(lp "")
    if(lpt STREQUAL STRING)
      string(JSON lp GET "${rec}" local_path)
    endif()
    set(lp_ok FALSE)
    if("${lp}" MATCHES "^refs/[A-Za-z0-9-]+[.][a-z0-9]+$")
      string(FIND "${lp}" "refs/${id}." pos)
      if(pos EQUAL 0)
        set(lp_ok TRUE)
      endif()
    endif()
    if(NOT lp_ok)
      gate_fail(source-local-path "${id}")
      return()
    endif()
    # Verify a cached copy when one is present.
    if(EXISTS "${ROOT}/${lp}" AND NOT IS_DIRECTORY "${ROOT}/${lp}")
      file(SIZE "${ROOT}/${lp}" have_size)
      file(SHA256 "${ROOT}/${lp}" have_sha)
      if("${have_size}" STREQUAL "${size}" AND "${have_sha}" STREQUAL "${sha}")
        gate_incr(source-verified)
      else()
        gate_fail(source-digest-mismatch "${id}")
      endif()
    endif()
  elseif(capture STREQUAL "reference-only")
    if(NOT shat STREQUAL NULL)
      gate_fail(source-format "${id}/sha256")
    endif()
    if(NOT szt STREQUAL NULL)
      gate_fail(source-format "${id}/size_bytes")
    endif()
    if(NOT lpt STREQUAL NULL)
      gate_fail(source-format "${id}/local_path")
    endif()
    # The note must say why the document is not hashed.
    set(note "")
    json_type(nt "${rec}" note)
    if(nt STREQUAL STRING)
      string(JSON note GET "${rec}" note)
    endif()
    string(TOLOWER "${note}" lnote)
    string(FIND "${lnote}" "hash" hpos)
    if(hpos LESS 0)
      gate_fail(source-reference-only-unexplained "${id}")
    endif()
  endif()
endfunction()

function(hook_finish)
  gate_count(n source-total)
  gate_count(nh source-hashed)
  gate_count(nv source-verified)
  gate_stat(sources "${n}")
  gate_stat(refs-verified "${nv}/${nh}")
endfunction()
