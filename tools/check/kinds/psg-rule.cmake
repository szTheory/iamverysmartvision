# Hook for kind psg-rule (D-07, D-12; plan 05-01): the PSG rule inventory data/psg/rules.json.
# Failure tokens (`-- FAIL <token>: <id> <detail>`):
#   psg-rule-field                    a `fields` entry that is neither a dotted lowercase profile field path nor `engine:<name>`,
#                                     or an empty `fields` list
#   psg-rule-cite                     cite that is neither `none` nor `<SRC-id>@<locator>` with the id in data/expected/sources.ids
#   psg-rule-conflict                 conflict that is not an id of data/expected/discrepancies.ids
#   psg-rule-unknown-default-unresolved  a rule whose basis is not 8910-primary-literal without `resolver:` and `trigger:` in its note
#                                     (the policy-id half of this token is in psg-vectors.cmake)
# Stats: psg-rules=<n>.
cmake_minimum_required(VERSION 3.25)

function(psg_read_inventory out relpath)
  set(res "")
  if(EXISTS "${ROOT}/${relpath}")
    file(READ "${ROOT}/${relpath}" txt)
    gate_lines(lines "${txt}")
    foreach(l IN LISTS lines)
      gate_unprotect(l "${l}")
      string(STRIP "${l}" l)
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      string(REGEX REPLACE "[ \t].*$" "" first "${l}")
      list(APPEND res "${first}")
    endforeach()
  endif()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

function(hook_record id rec)
  gate_incr(psg-rule-total)
  psg_read_inventory(src_ids "data/expected/sources.ids")
  psg_read_inventory(disc_ids "data/expected/discrepancies.ids")
  # fields
  json_type(ft "${rec}" fields)
  if(ft STREQUAL ARRAY)
    string(JSON nf LENGTH "${rec}" fields)
    if(nf EQUAL 0)
      gate_fail(psg-rule-field "${id} empty fields list")
    else()
      math(EXPR last "${nf} - 1")
      foreach(i RANGE 0 ${last})
        string(JSON f GET "${rec}" fields ${i})
        if(NOT f MATCHES "^(engine:[a-z0-9-]+|[a-z][a-z0-9_]*([.][a-z0-9_]+)*)$")
          gate_fail(psg-rule-field "${id} ${f}")
        endif()
      endforeach()
    endif()
  endif()
  # cite
  json_type(ct "${rec}" cite)
  if(ct STREQUAL STRING)
    string(JSON cite GET "${rec}" cite)
    if(NOT cite STREQUAL "none")
      if(cite MATCHES "^(SRC-[a-z0-9-]+)@[A-Za-z0-9._,-]+$")
        if(NOT "${CMAKE_MATCH_1}" IN_LIST src_ids)
          gate_fail(psg-rule-cite "${id} ${cite}")
        endif()
      else()
        gate_fail(psg-rule-cite "${id} ${cite}")
      endif()
    endif()
  endif()
  # conflict
  json_type(kt "${rec}" conflict)
  if(kt STREQUAL STRING)
    string(JSON conflict GET "${rec}" conflict)
    if(NOT conflict IN_LIST disc_ids)
      gate_fail(psg-rule-conflict "${id} ${conflict}")
    endif()
  endif()
  # resolver and trigger for every rule that is not primary-literal
  json_type(bt "${rec}" basis)
  json_type(nt "${rec}" note)
  if(bt STREQUAL STRING AND nt STREQUAL STRING)
    string(JSON basis GET "${rec}" basis)
    string(JSON note GET "${rec}" note)
    if(NOT basis STREQUAL "8910-primary-literal")
      string(FIND "${note}" "resolver:" p1)
      string(FIND "${note}" "trigger:" p2)
      if(p1 LESS 0 OR p2 LESS 0)
        gate_fail(psg-rule-unknown-default-unresolved "${id} basis ${basis} without resolver and trigger")
      endif()
    endif()
  endif()
endfunction()

function(hook_finish)
  gate_count(n psg-rule-total)
  gate_stat(psg-rules "${n}")
endfunction()
