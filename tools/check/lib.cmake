# Shared helpers for every checker (include() from a cmake -P script).
# Failure lines are `-- FAIL <token>: <detail>` on STATUS (never word-wrapped);
# the script ends with exactly one FATAL_ERROR (nonzero exit) via gate_finish().
# Inputs used by helpers: ROOT (tree under test).
cmake_minimum_required(VERSION 3.25)

function(gate_fail token detail)
  message(STATUS "FAIL ${token}: ${detail}")
  set_property(GLOBAL APPEND PROPERTY GATE_FAILURES "${token}")
endfunction()

function(gate_stat key value)
  set_property(GLOBAL APPEND PROPERTY GATE_STATS "${key}=${value}")
endfunction()

# Counters kept in global properties so nested functions and hooks can bump them.
function(gate_incr key)
  get_property(v GLOBAL PROPERTY "GATE_CNT_${key}")
  if("${v}" STREQUAL "")
    set(v 0)
  endif()
  math(EXPR v "${v} + 1")
  set_property(GLOBAL PROPERTY "GATE_CNT_${key}" "${v}")
endfunction()

function(gate_count out key)
  get_property(v GLOBAL PROPERTY "GATE_CNT_${key}")
  if("${v}" STREQUAL "")
    set(v 0)
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

function(gate_finish name)
  get_property(failures GLOBAL PROPERTY GATE_FAILURES)
  get_property(stats GLOBAL PROPERTY GATE_STATS)
  list(LENGTH failures n)
  if(n GREATER 0)
    message(FATAL_ERROR "${name}: ${n} failure(s)")
  endif()
  string(REPLACE ";" " " stats "${stats}")
  message(STATUS "${name} pass ${stats}")
endfunction()

# Protect characters that CMake lists treat specially, then split text into lines.
# Elements stay protected; call gate_unprotect() on each element before use.
function(gate_lines out text)
  string(REPLACE ";" "<SC>" text "${text}")
  string(REPLACE "[" "<LB>" text "${text}")
  string(REPLACE "]" "<RB>" text "${text}")
  string(REPLACE "\n" ";" text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(gate_unprotect out text)
  string(REPLACE "<SC>" ";" text "${text}")
  string(REPLACE "<LB>" "[" text "${text}")
  string(REPLACE "<RB>" "]" text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Type of a JSON element, or MISSING when the path does not exist.
function(json_type out doc)
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" ${ARGN})
  if(NOT "${e}" STREQUAL "NOTFOUND")
    set(${out} "MISSING" PARENT_SCOPE)
  else()
    set(${out} "${t}" PARENT_SCOPE)
  endif()
endfunction()

# Inventory file: one id per line, '#' comments, optional '#allow-empty: <reason>'.
# Result is the sorted unique id list (C-locale bytewise).
function(read_ids out relpath kind)
  set(${out} "" PARENT_SCOPE)
  set(f "${ROOT}/${relpath}")
  if(NOT EXISTS "${f}")
    gate_fail(${kind}-inventory-missing "${relpath}")
    return()
  endif()
  file(READ "${f}" txt)
  gate_lines(lines "${txt}")
  set(ids "")
  set(allow FALSE)
  foreach(l IN LISTS lines)
    gate_unprotect(l "${l}")
    string(STRIP "${l}" l)
    if(l STREQUAL "")
      continue()
    endif()
    if(l MATCHES "^#allow-empty:[ \t]*[^ \t]")
      set(allow TRUE)
      continue()
    endif()
    if(l MATCHES "^#")
      continue()
    endif()
    list(APPEND ids "${l}")
  endforeach()
  list(LENGTH ids total)
  if(total EQUAL 0)
    if(NOT allow)
      gate_fail(${kind}-inventory-empty "${relpath}")
    endif()
    return()
  endif()
  list(SORT ids)
  set(uniq ${ids})
  list(REMOVE_DUPLICATES uniq)
  list(LENGTH uniq nuniq)
  if(NOT nuniq EQUAL total)
    gate_fail(${kind}-inventory-duplicate "${relpath}")
  endif()
  set(${out} "${uniq}" PARENT_SCOPE)
endfunction()

# Record file: must exist, be non-empty and parse as JSON. Empty result on failure.
function(read_record_file out relpath kind)
  set(${out} "" PARENT_SCOPE)
  set(f "${ROOT}/${relpath}")
  if(NOT EXISTS "${f}")
    gate_fail(${kind}-file-missing "${relpath}")
    return()
  endif()
  file(SIZE "${f}" sz)
  if(sz EQUAL 0)
    gate_fail(${kind}-file-empty "${relpath}")
    return()
  endif()
  file(READ "${f}" doc)
  string(JSON t ERROR_VARIABLE e TYPE "${doc}")
  if(NOT "${e}" STREQUAL "NOTFOUND")
    gate_fail(${kind}-parse "${relpath}")
    return()
  endif()
  set(${out} "${doc}" PARENT_SCOPE)
endfunction()

# Member names of a JSON object, in document order (empty list for {}).
function(json_members out json)
  set(m "")
  string(JSON n LENGTH "${json}")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON k MEMBER "${json}" ${i})
      list(APPEND m "${k}")
    endforeach()
  endif()
  set(${out} "${m}" PARENT_SCOPE)
endfunction()
