# SPDX-License-Identifier: MIT
# Literal memory-map checker (D-21; plan 03-05 static rules, plan 03-06 adds the dump comparison).
# Inputs (passed with -D): ROOT (tree under test), FILELIST (repo-relative paths, one per line),
# CHECK_DIR (the real tools/check). Reads only FILELIST paths under ROOT: data/profiles/*.json,
# data/memmap/*, data/sources.json, data/tiers.json and data/discrepancies.json. Writes nothing.
# Row grammar (documented in the header of every literal file):
#   <R|W> <LO>-<HI> <device> w=<bits> impl=<real|stub|none> mirror=<words|-> gate=<name|->
#   src=<SRC-id>@<locator> tag=<tag> [conf=C<n>]
# Rules and tokens (every finding is `-- FAIL <token>: <file> ...`; at most 20 per token are
# listed, then one line with the exact total):
#   every data/profiles/<id>.json has data/memmap/<id>.literal.txt   memmap-literal-missing
#   every data/memmap/ file is <id>.literal.txt of an existing profile memmap-literal-orphan
#   row shape: single spaces, 9 or 10 columns, keys in order, view R|W, LO/HI four uppercase hex
#   digits with LO <= HI, device in {stic scratchpad psg sysram exec grom gram cart undriven},
#   w 0..16, impl real|stub|none, mirror - or a positive power of two, gate - or one of
#   {stic-regs gmem}; consistency: undriven <=> impl=none, undriven has w=0 mirror=- gate=-,
#   stub has w=0, real has w>0                                       memmap-literal-grammar
#   per view the rows (sorted by LO) tile 0000-FFFF: a gap            memmap-literal-hole
#   ... two rows sharing an address                                   memmap-literal-overlap
#   src=none on a row that is not undriven, not tagged
#   unknown-default-chosen or without conf=; a src id without a
#   non-blank locator in [A-Za-z0-9._,-]                             memmap-literal-no-cite
#   src id not an id of data/sources.json                            memmap-literal-unknown-source
#   tag tier5-emulator-hint, or a src whose authority_tier is
#   tier5-emulator-hint (emulator code is never a source)            memmap-literal-tier5
#   tag not an id of data/tiers.json source_authority_tags            memmap-literal-unknown-tag
#   conf id not an id of data/discrepancies.json                      memmap-literal-unknown-conf
# A row whose view and range parse takes part in the tiling check even when another column is
# malformed, so one bad column reports one finding.
# Stats: literal-rows=<rows over all literal files> views=<2 x profiles>.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT FILELIST CHECK_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "memmap.cmake is missing ${required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")

set(CAP 20)
set(MTOKENS memmap-literal-missing memmap-literal-orphan memmap-literal-grammar
  memmap-literal-hole memmap-literal-overlap memmap-literal-no-cite
  memmap-literal-unknown-source memmap-literal-tier5 memmap-literal-unknown-tag
  memmap-literal-unknown-conf)
set(DEVICES stic scratchpad psg sysram exec grom gram cart undriven)
set(GATES stic-regs gmem)
set(TIER5 tier5-emulator-hint)

# Finding with a per-token cap; totals are reported at the end.
function(mfail token detail)
  gate_incr("tok_${token}")
  gate_count(n "tok_${token}")
  if(n LESS_EQUAL ${CAP})
    gate_fail(${token} "${detail}")
  endif()
endfunction()

# Four uppercase hex digits of a value 0..65535 (also 65536 is never passed).
function(mm_hex4 out v)
  math(EXPR h "${v}" OUTPUT_FORMAT HEXADECIMAL)
  string(SUBSTRING "${h}" 2 -1 h)
  string(TOUPPER "${h}" h)
  string(LENGTH "${h}" n)
  while(n LESS 4)
    set(h "0${h}")
    math(EXPR n "${n} + 1")
  endwhile()
  set(${out} "${h}" PARENT_SCOPE)
endfunction()

# Reference sets from the tree under test.
set(SOURCE_IDS "")
set(SOURCE_TIER5 "")
if(EXISTS "${ROOT}/data/sources.json")
  file(READ "${ROOT}/data/sources.json" sdoc)
  string(JSON ns ERROR_VARIABLE e LENGTH "${sdoc}" sources)
  if("${e}" STREQUAL "NOTFOUND" AND ns GREATER 0)
    math(EXPR last "${ns} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON sid ERROR_VARIABLE e GET "${sdoc}" sources ${i} id)
      if(NOT "${e}" STREQUAL "NOTFOUND")
        continue()
      endif()
      list(APPEND SOURCE_IDS "${sid}")
      string(JSON stier ERROR_VARIABLE e GET "${sdoc}" sources ${i} authority_tier)
      if("${e}" STREQUAL "NOTFOUND" AND "${stier}" STREQUAL "${TIER5}")
        list(APPEND SOURCE_TIER5 "${sid}")
      endif()
    endforeach()
  endif()
endif()
set(TAG_IDS "")
if(EXISTS "${ROOT}/data/tiers.json")
  file(READ "${ROOT}/data/tiers.json" tdoc)
  string(JSON nt ERROR_VARIABLE e LENGTH "${tdoc}" source_authority_tags)
  if("${e}" STREQUAL "NOTFOUND" AND nt GREATER 0)
    math(EXPR last "${nt} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON tid ERROR_VARIABLE e GET "${tdoc}" source_authority_tags ${i} id)
      if("${e}" STREQUAL "NOTFOUND")
        list(APPEND TAG_IDS "${tid}")
      endif()
    endforeach()
  endif()
endif()
set(DISC_IDS "")
if(EXISTS "${ROOT}/data/discrepancies.json")
  file(READ "${ROOT}/data/discrepancies.json" ddoc)
  string(JSON nd ERROR_VARIABLE e LENGTH "${ddoc}" discrepancies)
  if("${e}" STREQUAL "NOTFOUND" AND nd GREATER 0)
    math(EXPR last "${nd} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON did ERROR_VARIABLE e GET "${ddoc}" discrepancies ${i} id)
      if("${e}" STREQUAL "NOTFOUND")
        list(APPEND DISC_IDS "${did}")
      endif()
    endforeach()
  endif()
endif()

# Profiles and memmap files named by FILELIST (sorted by the gate and the control runner).
file(STRINGS "${FILELIST}" paths)
set(PROFILES "")
set(MM_FILES "")
foreach(p IN LISTS paths)
  if(p MATCHES "^data/profiles/([^/]+)[.]json$")
    if(EXISTS "${ROOT}/${p}")
      list(APPEND PROFILES "${CMAKE_MATCH_1}")
    endif()
  elseif(p MATCHES "^data/memmap/")
    if(EXISTS "${ROOT}/${p}")
      list(APPEND MM_FILES "${p}")
    endif()
  endif()
endforeach()
list(SORT PROFILES)
list(SORT MM_FILES)

set(LITERALS "")
foreach(id IN LISTS PROFILES)
  set(rel "data/memmap/${id}.literal.txt")
  if(rel IN_LIST MM_FILES)
    list(APPEND LITERALS "${rel}")
  else()
    mfail(memmap-literal-missing "${rel} (profile data/profiles/${id}.json)")
  endif()
endforeach()
foreach(rel IN LISTS MM_FILES)
  if(NOT rel IN_LIST LITERALS)
    mfail(memmap-literal-orphan "${rel} (not <profile-id>.literal.txt of a profile in data/profiles)")
  endif()
endforeach()

# One literal file: grammar, provenance, then tiling per view.
set(n_rows 0)
foreach(rel IN LISTS LITERALS)
  file(READ "${ROOT}/${rel}" txt)
  gate_lines(lines "${txt}")
  set(lineno 0)
  set(SPANS_R "")
  set(SPANS_W "")
  foreach(l IN LISTS lines)
    math(EXPR lineno "${lineno} + 1")
    gate_unprotect(l "${l}")
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    math(EXPR n_rows "${n_rows} + 1")
    set(at "${rel}:${lineno}")
    string(REPLACE " " ";" toks "${l}")
    list(LENGTH toks nt)
    set(bad "")

    # View and range first: they feed the tiling check on their own.
    set(view "")
    set(lo "")
    set(hi "")
    if(nt GREATER 1)
      list(GET toks 0 t0)
      list(GET toks 1 t1)
      if(t0 MATCHES "^[RW]$")
        set(view "${t0}")
      else()
        string(APPEND bad " view '${t0}'")
      endif()
      if(t1 MATCHES "^([0-9A-F][0-9A-F][0-9A-F][0-9A-F])-([0-9A-F][0-9A-F][0-9A-F][0-9A-F])$")
        math(EXPR lo "0x${CMAKE_MATCH_1}")
        math(EXPR hi "0x${CMAKE_MATCH_2}")
        if(lo GREATER hi)
          string(APPEND bad " LO above HI")
          set(lo "")
          set(hi "")
        endif()
      else()
        string(APPEND bad " range '${t1}'")
      endif()
    endif()
    if(NOT view STREQUAL "" AND NOT lo STREQUAL "")
      mm_hex4(lo4 ${lo})
      mm_hex4(hi4 ${hi})
      list(APPEND SPANS_${view} "${lo4}:${hi4}")
    endif()

    # Keys of columns 4 onward, in order: w impl mirror gate src tag, then an optional conf.
    set(keys "")
    if(nt GREATER 3)
      math(EXPR lastk "${nt} - 1")
      foreach(k RANGE 3 ${lastk})
        list(GET toks ${k} tk)
        string(REGEX REPLACE "=.*$" "" tk "${tk}")
        string(APPEND keys " ${tk}")
      endforeach()
    endif()
    if(NOT (keys STREQUAL " w impl mirror gate src tag" OR keys STREQUAL " w impl mirror gate src tag conf"))
      string(STRIP "${keys}" keys)
      mfail(memmap-literal-grammar "${at} expected <view> <LO-HI> <device> then w impl mirror gate src tag [conf], found ${nt} columns with keys '${keys}'")
      continue()
    endif()
    list(GET toks 2 device)
    list(GET toks 3 tw)
    list(GET toks 4 timpl)
    list(GET toks 5 tmirror)
    list(GET toks 6 tgate)
    list(GET toks 7 tsrc)
    list(GET toks 8 ttag)
    set(tconf "")
    if(nt EQUAL 10)
      list(GET toks 9 tconf)
    endif()

    if(NOT device IN_LIST DEVICES)
      string(APPEND bad " device '${device}'")
    endif()
    set(w "")
    if(tw MATCHES "^w=([0-9]|1[0-6])$")
      set(w "${CMAKE_MATCH_1}")
    else()
      string(APPEND bad " width '${tw}'")
    endif()
    set(impl "")
    if(timpl MATCHES "^impl=(real|stub|none)$")
      set(impl "${CMAKE_MATCH_1}")
    else()
      string(APPEND bad " impl '${timpl}'")
    endif()
    set(mirror "")
    if(tmirror MATCHES "^mirror=(-|[1-9][0-9]*)$")
      set(mirror "${CMAKE_MATCH_1}")
      if(NOT mirror STREQUAL "-")
        math(EXPR pw "${mirror} & (${mirror} - 1)")
        if(NOT pw EQUAL 0 OR mirror GREATER 65536)
          string(APPEND bad " mirror ${mirror} is not a power of two up to 65536")
        endif()
      endif()
    else()
      string(APPEND bad " mirror '${tmirror}'")
    endif()
    set(gate "")
    # Two steps: if() evaluates a parenthesised group before MATCHES sets CMAKE_MATCH_1.
    set(gname "")
    if(tgate MATCHES "^gate=(.+)$")
      set(gname "${CMAKE_MATCH_1}")
    endif()
    if(gname STREQUAL "-" OR gname IN_LIST GATES)
      set(gate "${gname}")
    else()
      string(APPEND bad " gate '${tgate}'")
    endif()
    # Consistency of device, impl, width, mirror and gate.
    if(NOT impl STREQUAL "" AND NOT w STREQUAL "")
      if(device STREQUAL "undriven")
        if(NOT impl STREQUAL "none" OR NOT w EQUAL 0 OR NOT mirror STREQUAL "-" OR NOT gate STREQUAL "-")
          string(APPEND bad " undriven needs impl=none w=0 mirror=- gate=-")
        endif()
      elseif(impl STREQUAL "none")
        string(APPEND bad " impl=none on a driven device")
      elseif(impl STREQUAL "stub" AND NOT w EQUAL 0)
        string(APPEND bad " impl=stub needs w=0")
      elseif(impl STREQUAL "real" AND w EQUAL 0)
        string(APPEND bad " impl=real needs w>0")
      endif()
    endif()
    if(NOT bad STREQUAL "")
      string(STRIP "${bad}" bad)
      mfail(memmap-literal-grammar "${at} ${bad}")
      continue()
    endif()

    # Provenance: tag, src, conf.
    string(SUBSTRING "${ttag}" 4 -1 tag)
    set(tag_ok TRUE)
    if(tag STREQUAL "${TIER5}")
      mfail(memmap-literal-tier5 "${at} tag ${tag}")
      set(tag_ok FALSE)
    elseif(NOT tag IN_LIST TAG_IDS)
      mfail(memmap-literal-unknown-tag "${at} tag '${tag}'")
      set(tag_ok FALSE)
    endif()
    set(conf "")
    if(NOT tconf STREQUAL "")
      string(SUBSTRING "${tconf}" 5 -1 conf)
      if(NOT conf MATCHES "^C[0-9]+$" OR NOT conf IN_LIST DISC_IDS)
        mfail(memmap-literal-unknown-conf "${at} conf '${conf}'")
      endif()
    endif()
    string(SUBSTRING "${tsrc}" 4 -1 src)
    if(src STREQUAL "none")
      if(NOT device STREQUAL "undriven" OR NOT tag STREQUAL "unknown-default-chosen" OR conf STREQUAL "")
        mfail(memmap-literal-no-cite "${at} src=none needs an undriven row tagged unknown-default-chosen with conf=")
      endif()
    else()
      string(FIND "${src}" "@" atpos)
      if(atpos EQUAL -1)
        set(sid "${src}")
        set(loc "")
      else()
        string(SUBSTRING "${src}" 0 ${atpos} sid)
        math(EXPR lp "${atpos} + 1")
        string(SUBSTRING "${src}" ${lp} -1 loc)
      endif()
      if(NOT sid IN_LIST SOURCE_IDS)
        mfail(memmap-literal-unknown-source "${at} source '${sid}'")
      elseif(sid IN_LIST SOURCE_TIER5)
        mfail(memmap-literal-tier5 "${at} source ${sid} is tier5-emulator-hint")
      endif()
      if(NOT loc MATCHES "^[A-Za-z0-9._,-]+$")
        mfail(memmap-literal-no-cite "${at} source ${sid} has no locator in [A-Za-z0-9._,-]")
      endif()
    endif()
  endforeach()

  # Tiling per view: sorted LO:HI pairs (four uppercase hex digits sort numerically).
  foreach(view R W)
    set(spans ${SPANS_${view}})
    list(SORT spans)
    set(next 0)
    set(prev "")
    foreach(s IN LISTS spans)
      string(REPLACE ":" ";" lh "${s}")
      list(GET lh 0 slo)
      list(GET lh 1 shi)
      math(EXPR vlo "0x${slo}")
      math(EXPR vhi "0x${shi}")
      if(vlo GREATER next)
        math(EXPR gap_hi "${vlo} - 1")
        mm_hex4(g0 ${next})
        mm_hex4(g1 ${gap_hi})
        mfail(memmap-literal-hole "${rel} ${view} ${g0}-${g1}")
      elseif(vlo LESS next)
        mfail(memmap-literal-overlap "${rel} ${view} ${prev} ${slo}-${shi}")
      endif()
      math(EXPR after "${vhi} + 1")
      if(after GREATER next)
        set(next ${after})
        set(prev "${slo}-${shi}")
      endif()
    endforeach()
    if(next LESS 65536)
      mm_hex4(g0 ${next})
      mfail(memmap-literal-hole "${rel} ${view} ${g0}-FFFF")
    endif()
  endforeach()
endforeach()

# Exact totals for capped tokens.
foreach(tok IN LISTS MTOKENS)
  gate_count(n "tok_${tok}")
  if(n GREATER ${CAP})
    gate_fail(${tok} "${n} findings in total, first ${CAP} listed")
  endif()
endforeach()

list(LENGTH PROFILES n_prof)
math(EXPR n_views "2 * ${n_prof}")
gate_stat(literal-rows ${n_rows})
gate_stat(views ${n_views})
gate_finish(memmap)
