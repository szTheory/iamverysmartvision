# SPDX-License-Identifier: MIT
# Controller literal checker (D-02, D-03; plan 05-01). Pure and text only: it reads the tree under test
# (data/input/*.literal.txt named by FILELIST, data/expected/{input-bits,input-policies,sources,
# source-authority-tags}.ids and, from plan 05-05, the profiles data/profiles/*.json named by FILELIST), writes nothing.
# Inputs (passed with -D): ROOT (tree under test), FILELIST (repo-relative paths, one per line),
# CHECK_DIR (the real tools/check).
# Row grammar (documented in the header of every literal file):
#   <NAME> pins=<n,n> cleared=<HH> wiki=<HH> byte=<HH> src=<SRC-id>@<locator> tag=<tag> conf=C<n>
# Rules and tokens (every finding is `-- FAIL <token>: <detail>`; at most 20 per token are listed, then
# one line with the exact total):
#   a row or a file that does not follow the grammar, or no literal file    input-literal-grammar
#   name set differs from data/expected/input-bits.ids (detail names
#   the kind: missing, unknown or duplicate)                                 input-literal-name-set
#   pins mapped through the pin-to-bit map (pin 4 = b0, 3 = b1, 2 = b2,
#   1 = b3, 9 = b4, 8 = b5, 7 = b6, 6 = b7) differ from cleared             input-pins-mismatch
#   cleared differs from wiki                                                input-wiki-mismatch
#   byte differs from FF XOR cleared                                         input-byte-mismatch
#   tag absent from data/expected/source-authority-tags.ids, or a tier 5 tag input-tag
#   src id absent from data/expected/sources.ids                             input-source-unknown
#   KEY_1 is not 7E, or KEY_1 with KEY_9 (FF XOR (cleared OR cleared)) is not 5A   input-anchor
#   data/expected/input-policies.ids differs from the D-03 table of result
#   classes and tags below                                                   input-policy-inventory
#   (plan 05-05) the profile fields input.control.<name> (the member names of data/profiles/*.json, read
#   with string(JSON)) against the literal rows, when the tree has literal rows:
#   a profile `lines` mask differs from the literal `cleared` of the same name  input-profile-mask-mismatch
#   a literal control without its field input.control.<lower name>, or an
#   input.control.* field with no literal row                                  input-profile-field-missing
#   an input.control.* value that is not exactly an object with the single
#   string key lines holding a dollar sign and two uppercase hex digits (this
#   also proves the field names are the pinned control names and carry no
#   host vocabulary: a name outside the literal is a missing-row finding)      input-profile-field-shape
# Stats: input-rows=<rows over all literal files> input-policies=<classes> input-profile-fields=<fields>.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT FILELIST CHECK_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "input.cmake is missing ${required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")

set(CAP 20)
set(ITOKENS input-literal-grammar input-literal-name-set input-pins-mismatch input-wiki-mismatch
  input-byte-mismatch input-tag input-source-unknown input-anchor input-policy-inventory
  input-profile-mask-mismatch input-profile-field-missing input-profile-field-shape)

function(ifail token detail)
  gate_incr("tok_${token}")
  gate_count(n "tok_${token}")
  if(n LESS_EQUAL ${CAP})
    gate_fail(${token} "${detail}")
  endif()
endfunction()

# Two uppercase hex digits of a value 0..255.
function(hex2 out v)
  math(EXPR h "${v}" OUTPUT_FORMAT HEXADECIMAL)
  string(SUBSTRING "${h}" 2 -1 h)
  string(TOUPPER "${h}" h)
  string(LENGTH "${h}" n)
  if(n LESS 2)
    set(h "0${h}")
  endif()
  set(${out} "${h}" PARENT_SCOPE)
endfunction()

# Pin-to-bit map of the controller port.
set(PIN_BIT_4 0)
set(PIN_BIT_3 1)
set(PIN_BIT_2 2)
set(PIN_BIT_1 3)
set(PIN_BIT_9 4)
set(PIN_BIT_8 5)
set(PIN_BIT_7 6)
set(PIN_BIT_6 7)

# The D-03 table of result classes and their tags (class:tag).
set(POLICY_TABLE
  single-control:tier4-community key-key:tier4-community disc-side:tier4-community
  key-disc:inference key-side:inference side-side:inference
  disc-disc-adjacent:unknown-default-chosen disc-disc-other:unknown-default-chosen
  opposite-directions:unknown-default-chosen three-or-more:unknown-default-chosen
  bit31-words2-3-flags:refusal-unchanged)

# Reference id sets from the tree under test (text inventories, '#' comments).
function(read_set out relpath)
  set(res "")
  if(EXISTS "${ROOT}/${relpath}")
    file(READ "${ROOT}/${relpath}" txt)
    gate_lines(lines "${txt}")
    foreach(l IN LISTS lines)
      gate_unprotect(l "${l}")
      string(STRIP "${l}" l)
      if(l STREQUAL "" OR l MATCHES "^#")
        continue()
      endif()
      string(REGEX REPLACE "[ \t].*$" "" first "${l}")
      list(APPEND res "${first}")
    endforeach()
  endif()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

read_set(BIT_LINES "data/expected/input-bits.ids")
set(NAMES "")
foreach(b IN LISTS BIT_LINES)
  string(REGEX REPLACE "^IVS_CTRL_" "" nm "${b}")
  list(APPEND NAMES "${nm}")
endforeach()
read_set(SRC_IDS "data/expected/sources.ids")
read_set(TAG_IDS "data/expected/source-authority-tags.ids")

# Literal files named by FILELIST.
file(STRINGS "${FILELIST}" paths)
set(LITS "")
foreach(p IN LISTS paths)
  if(p MATCHES "^data/input/[^/]+[.]literal[.]txt$" AND EXISTS "${ROOT}/${p}")
    list(APPEND LITS "${p}")
  endif()
endforeach()
list(SORT LITS)
if(NOT LITS)
  ifail(input-literal-grammar "no data/input/<profile>.literal.txt")
endif()

set(n_rows 0)
set(LIT_NAMES "")
foreach(rel IN LISTS LITS)
  file(READ "${ROOT}/${rel}" txt)
  gate_lines(lines "${txt}")
  set(seen "")
  set(CLEARED_KEY_1 "")
  set(CLEARED_KEY_9 "")
  set(BYTE_KEY_1 "")
  set(lineno 0)
  foreach(l IN LISTS lines)
    math(EXPR lineno "${lineno} + 1")
    gate_unprotect(l "${l}")
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    math(EXPR n_rows "${n_rows} + 1")
    set(at "${rel}:${lineno}")
    if(NOT l MATCHES "^([A-Z0-9_]+) pins=([0-9](,[0-9])*) cleared=([0-9A-F][0-9A-F]) wiki=([0-9A-F][0-9A-F]) byte=([0-9A-F][0-9A-F]) src=(SRC-[a-z0-9-]+)@([A-Za-z0-9._,-]+) tag=([a-z0-9-]+) conf=(C[0-9]+)$")
      ifail(input-literal-grammar "${at}")
      continue()
    endif()
    set(nm "${CMAKE_MATCH_1}")
    set(pins "${CMAKE_MATCH_2}")
    set(cleared "${CMAKE_MATCH_4}")
    set(wiki "${CMAKE_MATCH_5}")
    set(byte "${CMAKE_MATCH_6}")
    set(src "${CMAKE_MATCH_7}")
    set(tag "${CMAKE_MATCH_9}")
    if(nm IN_LIST seen)
      ifail(input-literal-name-set "duplicate ${nm}")
    endif()
    list(APPEND seen "${nm}")
    list(APPEND LIT_NAMES "${nm}")
    if(NOT nm IN_LIST NAMES)
      ifail(input-literal-name-set "unknown ${nm}")
    endif()
    # pins to bits
    string(REPLACE "," ";" pin_list "${pins}")
    set(mask 0)
    foreach(pin IN LISTS pin_list)
      if(DEFINED PIN_BIT_${pin})
        math(EXPR mask "${mask} | (1 << ${PIN_BIT_${pin}})")
      else()
        ifail(input-pins-mismatch "${at} ${nm}: pin ${pin} is not on the map")
      endif()
    endforeach()
    hex2(mask_hex "${mask}")
    if(NOT mask_hex STREQUAL cleared)
      ifail(input-pins-mismatch "${at} ${nm}: pins ${pins} give ${mask_hex}, cleared ${cleared}")
    endif()
    if(NOT cleared STREQUAL wiki)
      ifail(input-wiki-mismatch "${at} ${nm}: cleared ${cleared}, wiki ${wiki}")
    endif()
    math(EXPR want "255 ^ 0x${cleared}")
    hex2(want_hex "${want}")
    if(NOT byte STREQUAL want_hex)
      ifail(input-byte-mismatch "${at} ${nm}: byte ${byte}, FF XOR ${cleared} is ${want_hex}")
    endif()
    if(tag STREQUAL "tier5-emulator-hint" OR NOT tag IN_LIST TAG_IDS)
      ifail(input-tag "${at} ${nm}: tag '${tag}'")
    endif()
    if(NOT src IN_LIST SRC_IDS)
      ifail(input-source-unknown "${at} ${nm}: ${src}")
    endif()
    set(LIT_CLEARED_${nm} "${cleared}")
    if(nm STREQUAL "KEY_1")
      set(CLEARED_KEY_1 "${cleared}")
      set(BYTE_KEY_1 "${byte}")
    elseif(nm STREQUAL "KEY_9")
      set(CLEARED_KEY_9 "${cleared}")
    endif()
  endforeach()
  foreach(nm IN LISTS NAMES)
    if(NOT nm IN_LIST seen)
      ifail(input-literal-name-set "missing ${nm}")
    endif()
  endforeach()
  # anchors of the wiki prose (notes 2 and 3 of the literal header)
  if(NOT CLEARED_KEY_1 STREQUAL "")
    math(EXPR k1 "255 ^ 0x${CLEARED_KEY_1}")
    hex2(k1_hex "${k1}")
    if(NOT k1_hex STREQUAL "7E")
      ifail(input-anchor "${rel}: KEY_1 is ${k1_hex}, the wiki reads 7E")
    endif()
    if(NOT CLEARED_KEY_9 STREQUAL "")
      math(EXPR k19 "255 ^ (0x${CLEARED_KEY_1} | 0x${CLEARED_KEY_9})")
      hex2(k19_hex "${k19}")
      if(NOT k19_hex STREQUAL "5A")
        ifail(input-anchor "${rel}: KEY_1 with KEY_9 is ${k19_hex}, the wiki reads 5A")
      endif()
    endif()
  endif()
endforeach()

# Profile fields input.control.<name> against the literal rows (plan 05-05, D-02). Active when the tree has
# literal rows; every data/profiles/*.json named by FILELIST is compared.
set(n_pfields 0)
if(LIT_NAMES)
  foreach(p IN LISTS paths)
    if(NOT p MATCHES "^data/profiles/[^/]+[.]json$" OR NOT EXISTS "${ROOT}/${p}")
      continue()
    endif()
    file(READ "${ROOT}/${p}" pdoc)
    string(JSON nfields ERROR_VARIABLE perr LENGTH "${pdoc}" fields)
    if(NOT "${perr}" STREQUAL "NOTFOUND")
      ifail(input-profile-field-missing "${p} has no fields object")
      continue()
    endif()
    # The input.control.* members, by their lower case names.
    set(have "")
    if(nfields GREATER 0)
      math(EXPR plast "${nfields} - 1")
      foreach(i RANGE ${plast})
        string(JSON fk MEMBER "${pdoc}" fields ${i})
        if(fk MATCHES "^input[.]control[.](.*)$")
          list(APPEND have "${CMAKE_MATCH_1}")
        endif()
      endforeach()
    endif()
    # Every literal control has its field.
    set(want_lower "")
    foreach(nm IN LISTS LIT_NAMES)
      string(TOLOWER "${nm}" lower)
      list(APPEND want_lower "${lower}")
      if(NOT lower IN_LIST have)
        ifail(input-profile-field-missing "${p}: no field input.control.${lower} for the literal row ${nm}")
      endif()
    endforeach()
    # Every field has its literal row, the shape of one string key lines and the literal's mask.
    foreach(h IN LISTS have)
      math(EXPR n_pfields "${n_pfields} + 1")
      if(NOT h IN_LIST want_lower)
        ifail(input-profile-field-missing "${p}: field input.control.${h} has no literal row")
        continue()
      endif()
      string(TOUPPER "${h}" upper)
      string(JSON vt ERROR_VARIABLE verr TYPE "${pdoc}" fields "input.control.${h}" value)
      if(NOT "${verr}" STREQUAL "NOTFOUND" OR NOT vt STREQUAL "OBJECT")
        ifail(input-profile-field-shape "${p}: input.control.${h} value is not an object")
        continue()
      endif()
      string(JSON vobj GET "${pdoc}" fields "input.control.${h}" value)
      string(JSON nk LENGTH "${vobj}")
      set(shape_ok TRUE)
      if(NOT nk EQUAL 1)
        set(shape_ok FALSE)
      else()
        string(JSON k0 MEMBER "${vobj}" 0)
        string(JSON lt ERROR_VARIABLE lerr TYPE "${vobj}" lines)
        if(NOT k0 STREQUAL "lines" OR NOT "${lerr}" STREQUAL "NOTFOUND" OR NOT lt STREQUAL "STRING")
          set(shape_ok FALSE)
        endif()
      endif()
      if(NOT shape_ok)
        ifail(input-profile-field-shape "${p}: input.control.${h} value is not exactly one string key lines")
        continue()
      endif()
      string(JSON lines GET "${vobj}" lines)
      if(NOT lines MATCHES "^[$]([0-9A-F][0-9A-F])$")
        ifail(input-profile-field-shape "${p}: input.control.${h} lines '${lines}' is not a dollar sign and two uppercase hex digits")
        continue()
      endif()
      set(pmask "${CMAKE_MATCH_1}")
      if(NOT pmask STREQUAL "${LIT_CLEARED_${upper}}")
        ifail(input-profile-mask-mismatch "${p}: input.control.${h} lines ${pmask}, the literal cleared ${LIT_CLEARED_${upper}}")
      endif()
    endforeach()
  endforeach()
endif()

# Policy classes (data/expected/input-policies.ids): exact set and tags of the D-03 table.
set(n_pol 0)
set(have_pol "")
if(EXISTS "${ROOT}/data/expected/input-policies.ids")
  file(READ "${ROOT}/data/expected/input-policies.ids" ptxt)
  gate_lines(plines "${ptxt}")
  foreach(l IN LISTS plines)
    gate_unprotect(l "${l}")
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    if(NOT l MATCHES "^([a-z0-9-]+) ([a-z0-9-]+)( .*)?$")
      ifail(input-policy-inventory "malformed line '${l}'")
      continue()
    endif()
    math(EXPR n_pol "${n_pol} + 1")
    set(cls "${CMAKE_MATCH_1}")
    set(ptag "${CMAKE_MATCH_2}")
    list(APPEND have_pol "${cls}")
    set(want_tag "")
    foreach(pair IN LISTS POLICY_TABLE)
      if(pair MATCHES "^${cls}:(.*)$")
        set(want_tag "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    if(want_tag STREQUAL "")
      ifail(input-policy-inventory "unknown class ${cls}")
    elseif(NOT want_tag STREQUAL ptag)
      ifail(input-policy-inventory "class ${cls} has tag ${ptag}, the table has ${want_tag}")
    endif()
  endforeach()
else()
  ifail(input-policy-inventory "data/expected/input-policies.ids is missing")
endif()
foreach(pair IN LISTS POLICY_TABLE)
  string(REGEX REPLACE ":.*$" "" cls "${pair}")
  if(NOT cls IN_LIST have_pol)
    ifail(input-policy-inventory "missing class ${cls}")
  endif()
endforeach()

foreach(tok IN LISTS ITOKENS)
  gate_count(n "tok_${tok}")
  if(n GREATER ${CAP})
    gate_fail(${tok} "${n} findings in total, first ${CAP} listed")
  endif()
endforeach()

gate_stat(input-rows ${n_rows})
gate_stat(input-policies ${n_pol})
gate_stat(input-profile-fields ${n_pfields})
gate_finish(input)
