# SPDX-License-Identifier: MIT
# Tracked-file rights check (docs/RIGHTS.md, docs/fixture-manifest.md).
# Inputs (passed with -D):
#   ROOT      the tree under test (required)
#   FILELIST  file with one repo-relative path per line (required)
# Rules, applied to FILELIST paths in sorted order:
#   refs/ paths                         -> files-tracked-refs
#   .env and .env.* files               -> files-env
#   ROM, PDF or image-like extension not listed as a committed output of an effective-yes manifest
#                                       -> files-unlisted-binary
#   file inside repository-root fixtures/<dir>/ that its manifest does not list
#                                       -> files-unlisted-fixture-file
#   repository-root fixtures/<dir>/ without a manifest.json -> files-fixture-without-manifest
# Tokens also: files-filelist-empty.
# Success line: "files pass tracked=<n> binaries-listed=<k>".
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT FILELIST)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "files.cmake is missing ${required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/manifest-lib.cmake")

set(BINARY_EXT int bin rom itv cfg cc3 pdf png jpg jpeg gif)

# Manifests (parse problems are reported by the manifests step, not here). An unparseable
# manifest lists nothing, so its files fail closed below.
manifest_load_all(FALSE)
get_property(nm GLOBAL PROPERTY MANIFEST_N)
set(mdirs "")
set(mfiles "")
set(binary_ok "")
if(nm GREATER 0)
  math(EXPR lastm "${nm} - 1")
  foreach(i RANGE 0 ${lastm})
    get_property(mp GLOBAL PROPERTY "MANIFEST_PATH_${i}")
    get_property(doc GLOBAL PROPERTY "MANIFEST_DOC_${i}")
    string(REGEX MATCH "^fixtures/([A-Za-z0-9._-]+)/" _m "${mp}")
    list(APPEND mdirs "${CMAKE_MATCH_1}")
    manifest_listed_files(listed "${doc}")
    set(entry "|")
    foreach(f IN LISTS listed)
      if(f MATCHES "^[A-Za-z0-9._/-]+$")
        string(APPEND entry "${f}|")
      endif()
    endforeach()
    list(APPEND mfiles "${entry}")
    # Binary-like outputs count only when the manifest is committed and effective yes.
    json_type(ct "${doc}" committed)
    if(ct STREQUAL "BOOLEAN")
      string(JSON cv GET "${doc}" committed)
      manifest_effective(eff "${doc}")
      if(cv AND eff STREQUAL "yes")
        manifest_listed_outputs(outs "${doc}")
        foreach(o IN LISTS outs)
          if(o MATCHES "^[A-Za-z0-9._/-]+$")
            list(APPEND binary_ok "${o}")
          endif()
        endforeach()
      endif()
    endif()
  endforeach()
endif()

file(READ "${FILELIST}" list_text)
gate_lines(lines "${list_text}")
set(paths "")
foreach(l IN LISTS lines)
  gate_unprotect(l "${l}")
  if(NOT l STREQUAL "")
    list(APPEND paths "${l}")
  endif()
endforeach()
list(SORT paths)
list(LENGTH paths ntracked)
if(ntracked EQUAL 0)
  gate_fail(files-filelist-empty "FILELIST")
endif()

set(fixture_dirs "")
set(manifest_dirs "")
set(nbin 0)
foreach(p IN LISTS paths)
  if(p MATCHES "^refs/")
    gate_fail(files-tracked-refs "${p}")
  endif()
  get_filename_component(name "${p}" NAME)
  if(name STREQUAL ".env" OR name MATCHES "^[.]env[.]")
    gate_fail(files-env "${p}")
  endif()
  get_filename_component(ext "${p}" LAST_EXT)
  string(TOLOWER "${ext}" ext)
  string(REGEX REPLACE "^[.]" "" ext "${ext}")
  if(NOT "${ext}" STREQUAL "" AND "${ext}" IN_LIST BINARY_EXT)
    if("${p}" IN_LIST binary_ok)
      math(EXPR nbin "${nbin} + 1")
    else()
      gate_fail(files-unlisted-binary "${p}")
    endif()
  endif()
  # Repository-root fixtures/ only (same anchor as manifests.cmake).
  if(p MATCHES "^fixtures/([A-Za-z0-9._-]+)/(.+)$")
    set(fdir "${CMAKE_MATCH_1}")
    set(rest "${CMAKE_MATCH_2}")
    list(APPEND fixture_dirs "${fdir}")
    if(rest STREQUAL "manifest.json")
      list(APPEND manifest_dirs "${fdir}")
    else()
      list(FIND mdirs "${fdir}" idx)
      set(listed_ok FALSE)
      if(NOT idx EQUAL -1)
        list(GET mfiles ${idx} entry)
        string(FIND "${entry}" "|${p}|" pos)
        if(NOT pos EQUAL -1)
          set(listed_ok TRUE)
        endif()
      endif()
      if(NOT listed_ok)
        gate_fail(files-unlisted-fixture-file "${p}")
      endif()
    endif()
  endif()
endforeach()

list(REMOVE_DUPLICATES fixture_dirs)
list(SORT fixture_dirs)
foreach(d IN LISTS fixture_dirs)
  if(NOT "${d}" IN_LIST manifest_dirs)
    gate_fail(files-fixture-without-manifest "${d}")
  endif()
endforeach()

gate_stat(tracked "${ntracked}")
gate_stat(binaries-listed "${nbin}")
gate_finish(files)
