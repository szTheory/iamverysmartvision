# SPDX-License-Identifier: MIT
# Mechanical diff of one committed vector file against an isolated reader's output (D-15, A-12).
# Usage: cmake -DROOT=<repo> -DFILE=<stem> [-DDERIVED_DIR=<dir>] -P vector-diff.cmake
#   DERIVED_DIR  default ${ROOT}/build/review/derived; opened read-only, never written
# Inputs: DERIVED_DIR/<stem>.json (written only by an isolated reader subagent) and
# DERIVED_DIR/HANDOFF.txt (written only by the orchestrator; one line per stem,
# `<stem> <sha256 of the derived file> <reviewer> <run-id>`, a later line for a stem replaces an
# earlier one). Input checks, in this order; the first failing check prints
# `-- FAIL <token>: <stem> <detail>` and ends non-zero:
#   review-derived-missing     the derived file is absent
#   review-handoff-mismatch    HANDOFF.txt absent, no line for the stem, the line malformed
#                              (4 columns, 64 lowercase hex, isolated-subagent-blind-v<n>,
#                              run-id ^[A-Za-z0-9._:/-]+$) or naming another sha256
#   review-derived-format      not the reader shape (top keys schema_version file blind_sha256
#                              reviewer vectors; entries index expect derivation [bus]), entries
#                              not keyed by a unique index, an expect key outside the vector
#                              expect schema, or a reviewer that is not an isolated run label or
#                              differs from the HANDOFF.txt label
#   review-blind-mismatch      blind_sha256 differs from the sha256 of the projection of the current
#                              committed file (ivs_blind_project of vector-blind.cmake)
#   review-derived-incomplete  a projection index without a derived entry (`MISSING <index> <id>`
#                              lines first)
#   review-derived-extra       a derived index the projection lacks
# Comparison (only when every input check passed): indices map back to ids through the projection
# map and opaque policy tokens back to policy ids through ivs_blind_policy_tokens. Per vector,
# init merged with the committed expect delta is compared with init merged with the reader's
# delta (listing an unchanged field is not a disagreement): registers, flags, intff, dbd,
# prev_interruptible, run_state, halt_pending, busak, fault_reason, memory; cycles, units and
# events where the committed vector asserts them; the bus list when both sides give one (cycles of
# bus entries compared only for bus_basis figure). Output: `DIFF <id> <field> committed=<v>
# reader=<v>` per disagreement (` policy=<id>` appended for policy vectors), then
# `diff-summary file=<stem> vectors=<n> agree=<n> disagree=<n> derived_sha256=<hex> run_id=<run-id>`;
# exit 0 (disagreements are data for plan 02-17, not tool failures).
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT FILE)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "vector-diff.cmake is missing ${required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/vector-blind.cmake")
if(NOT DEFINED DERIVED_DIR OR "${DERIVED_DIR}" STREQUAL "")
  set(DERIVED_DIR "${ROOT}/build/review/derived")
endif()
set(stem "${FILE}")
set(dfile "${DERIVED_DIR}/${stem}.json")
string(REPEAT "[0-9a-f]" 64 HEX64)
set(REVIEWER_RE "^isolated-subagent-blind-v[0-9]+$")
set(RUN_RE "^[A-Za-z0-9._:/-]+$")
set(STATE_FIELDS r0 r1 r2 r3 r4 r5 r6 r7 S Z OV C intff dbd prev_interruptible run_state
  halt_pending busak fault_reason)
set(EXPECT_KEYS r status intff dbd prev_interruptible run_state halt_pending busak fault_reason
  mem cycles units events)

function(vd_stop token detail)
  message(STATUS "FAIL ${token}: ${stem} ${detail}")
  message(FATAL_ERROR "vector-diff: ${token}")
endfunction()

function(vd_fail token detail)
  message(STATUS "FAIL ${token}: ${stem} ${detail}")
  set_property(GLOBAL APPEND PROPERTY VD_FAILURES "${token}")
endfunction()

function(vd_end_if_failed token)
  get_property(f GLOBAL PROPERTY VD_FAILURES)
  if(NOT "${f}" STREQUAL "")
    message(FATAL_ERROR "vector-diff: ${token}")
  endif()
endfunction()

# ---- 1. derived file present ----
if(NOT EXISTS "${dfile}" OR IS_DIRECTORY "${dfile}")
  vd_stop(review-derived-missing "${stem}.json absent")
endif()
file(SHA256 "${dfile}" derived_sha)

# ---- 2. handoff line ----
set(hfile "${DERIVED_DIR}/HANDOFF.txt")
if(NOT EXISTS "${hfile}")
  vd_stop(review-handoff-mismatch "HANDOFF.txt absent")
endif()
file(STRINGS "${hfile}" hlines)
set(hline "")
foreach(l IN LISTS hlines)
  string(STRIP "${l}" l)
  if(l MATCHES "^${stem}([ \t]|$)")
    set(hline "${l}")
  endif()
endforeach()
if(hline STREQUAL "")
  vd_stop(review-handoff-mismatch "no HANDOFF.txt line")
endif()
string(REGEX REPLACE "[ \t]+" ";" htoks "${hline}")
list(LENGTH htoks hn)
if(NOT hn EQUAL 4)
  vd_stop(review-handoff-mismatch "malformed HANDOFF.txt line")
endif()
list(GET htoks 1 h_sha)
list(GET htoks 2 h_rev)
list(GET htoks 3 h_run)
if(NOT h_sha MATCHES "^${HEX64}$" OR NOT h_rev MATCHES "${REVIEWER_RE}" OR NOT h_run MATCHES "${RUN_RE}")
  vd_stop(review-handoff-mismatch "malformed HANDOFF.txt line")
endif()
if(NOT h_sha STREQUAL derived_sha)
  vd_stop(review-handoff-mismatch "sha256 of the derived file differs from HANDOFF.txt")
endif()

# ---- 3. reader shape ----
file(READ "${dfile}" ddoc)
string(JSON dt ERROR_VARIABLE derr TYPE "${ddoc}")
if(NOT "${derr}" STREQUAL "NOTFOUND" OR NOT dt STREQUAL "OBJECT")
  vd_stop(review-derived-format "not a JSON object")
endif()
json_members(dtop "${ddoc}")
set(want_top schema_version file blind_sha256 reviewer vectors)
foreach(k IN LISTS dtop)
  if(NOT k IN_LIST want_top)
    vd_fail(review-derived-format "top key ${k}")
  endif()
endforeach()
foreach(k IN LISTS want_top)
  if(NOT k IN_LIST dtop)
    vd_fail(review-derived-format "missing top key ${k}")
  endif()
endforeach()
vd_end_if_failed(review-derived-format)
string(JSON d_schema GET "${ddoc}" schema_version)
string(JSON d_file GET "${ddoc}" file)
string(JSON d_blind GET "${ddoc}" blind_sha256)
string(JSON d_rev GET "${ddoc}" reviewer)
if(NOT d_schema STREQUAL "1")
  vd_fail(review-derived-format "schema_version")
endif()
if(NOT d_file STREQUAL stem)
  vd_fail(review-derived-format "file")
endif()
if(NOT d_blind MATCHES "^${HEX64}$")
  vd_fail(review-derived-format "blind_sha256")
endif()
if(NOT d_rev MATCHES "${REVIEWER_RE}" OR NOT d_rev STREQUAL h_rev)
  vd_fail(review-derived-format "reviewer")
endif()
json_type(dvt "${ddoc}" vectors)
set(d_indices "")
set(nd 0)
if(NOT dvt STREQUAL "ARRAY")
  vd_fail(review-derived-format "vectors is not an array")
else()
  string(JSON nd LENGTH "${ddoc}" vectors)
endif()
if(nd GREATER 0)
  math(EXPR dlast "${nd} - 1")
  foreach(i RANGE 0 ${dlast})
    string(JSON e GET "${ddoc}" vectors ${i})
    json_type(et "${e}")
    if(NOT et STREQUAL "OBJECT")
      vd_fail(review-derived-format "entry #${i} is not an object")
      continue()
    endif()
    json_members(em "${e}")
    foreach(k IN LISTS em)
      if(NOT k MATCHES "^(index|expect|derivation|bus)$")
        vd_fail(review-derived-format "entry #${i} key ${k}")
      endif()
    endforeach()
    json_type(it "${e}" index)
    json_type(xt "${e}" expect)
    json_type(vt "${e}" derivation)
    json_type(bt "${e}" bus)
    if(NOT it STREQUAL "STRING")
      vd_fail(review-derived-format "entry #${i} without index")
      continue()
    endif()
    string(JSON idx GET "${e}" index)
    if(NOT idx MATCHES "^v[0-9][0-9][0-9]$")
      vd_fail(review-derived-format "entry #${i} index shape")
      continue()
    endif()
    if(idx IN_LIST d_indices)
      vd_fail(review-derived-format "duplicate index ${idx}")
      continue()
    endif()
    list(APPEND d_indices "${idx}")
    set_property(GLOBAL PROPERTY "VD_D_${idx}" "${i}")
    if(NOT xt STREQUAL "OBJECT")
      vd_fail(review-derived-format "${idx} expect")
    else()
      string(JSON x GET "${e}" expect)
      json_members(xm "${x}")
      foreach(k IN LISTS xm)
        if(NOT k IN_LIST EXPECT_KEYS)
          vd_fail(review-derived-format "${idx} expect key ${k}")
        endif()
      endforeach()
    endif()
    set(dv "")
    if(vt STREQUAL "STRING")
      string(JSON dv GET "${e}" derivation)
      string(STRIP "${dv}" dv)
    endif()
    if(dv STREQUAL "")
      vd_fail(review-derived-format "${idx} derivation")
    endif()
    if(NOT bt STREQUAL "MISSING" AND NOT bt STREQUAL "ARRAY")
      vd_fail(review-derived-format "${idx} bus")
    endif()
  endforeach()
endif()
vd_end_if_failed(review-derived-format)

# ---- 4. blinded copy is the projection of the current committed file ----
set(cfile "${ROOT}/data/cp1610/vectors/${stem}.json")
ivs_blind_project("${cfile}" ptext pmap)
ivs_blind_failed(pf)
if(pf GREATER 0 OR "${ptext}" STREQUAL "")
  vd_stop(review-blind-mismatch "the current committed file does not project")
endif()
string(SHA256 p_sha "${ptext}")
if(NOT p_sha STREQUAL d_blind)
  vd_stop(review-blind-mismatch "blind_sha256 is not the projection of the current committed file")
endif()

# ---- 5. complete and no extra ----
set(p_indices "")
set(missing_lines "")
foreach(pair IN LISTS pmap)
  string(REGEX REPLACE " .*$" "" idx "${pair}")
  string(REGEX REPLACE "^[^ ]+ " "" vid "${pair}")
  list(APPEND p_indices "${idx}")
  set_property(GLOBAL PROPERTY "VD_ID_${idx}" "${vid}")
  if(NOT idx IN_LIST d_indices)
    list(APPEND missing_lines "MISSING ${idx} ${vid}")
  endif()
endforeach()
if(NOT "${missing_lines}" STREQUAL "")
  ivs_blind_print(${missing_lines})
  list(LENGTH missing_lines nmiss)
  vd_fail(review-derived-incomplete "${nmiss} index(es) without a derived entry")
endif()
foreach(idx IN LISTS d_indices)
  if(NOT idx IN_LIST p_indices)
    vd_fail(review-derived-extra "${idx}")
  endif()
endforeach()
get_property(f GLOBAL PROPERTY VD_FAILURES)
if(NOT "${f}" STREQUAL "")
  message(FATAL_ERROR "vector-diff: incomplete or extra entries")
endif()

# ---- 6. comparison ----
ivs_blind_policy_tokens("${ROOT}" ptokens)
file(READ "${cfile}" cdoc)
string(JSON ncv LENGTH "${cdoc}" vectors)
math(EXPR clast "${ncv} - 1")
foreach(i RANGE 0 ${clast})
  string(JSON cid GET "${cdoc}" vectors ${i} id)
  set_property(GLOBAL PROPERTY "VD_C_${cid}" "${i}")
endforeach()
string(JSON npv LENGTH "${ptext}" vectors)
math(EXPR plast "${npv} - 1")
foreach(i RANGE 0 ${plast})
  string(JSON pidx GET "${ptext}" vectors ${i} index)
  json_type(ptt "${ptext}" vectors ${i} policy)
  if(ptt STREQUAL "STRING")
    string(JSON ptok GET "${ptext}" vectors ${i} policy)
    foreach(pair IN LISTS ptokens)
      string(REGEX REPLACE " .*$" "" tk "${pair}")
      string(REGEX REPLACE "^[^ ]+ " "" pp "${pair}")
      if(tk STREQUAL ptok)
        set_property(GLOBAL PROPERTY "VD_POL_${pidx}" "${pp}")
      endif()
    endforeach()
  endif()
endforeach()

function(vd_norm out v)
  string(TOUPPER "${v}" v)
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Apply init or an expect delta onto the variables <prefix>_<field> of the caller (a macro, so the
# variables land in the caller's scope); memory addresses touched are appended to <prefix>_memaddrs.
macro(vd_apply prefix obj)
  json_type(_t "${obj}" r)
  if(_t STREQUAL "ARRAY")
    foreach(_k RANGE 7)
      string(JSON _v ERROR_VARIABLE _e GET "${obj}" r ${_k})
      if("${_e}" STREQUAL "NOTFOUND")
        vd_norm(${prefix}_r${_k} "${_v}")
      endif()
    endforeach()
  elseif(_t STREQUAL "OBJECT")
    string(JSON _rob GET "${obj}" r)
    json_members(_rm "${_rob}")
    foreach(_k IN LISTS _rm)
      string(JSON _v GET "${_rob}" "${_k}")
      vd_norm(${prefix}_r${_k} "${_v}")
    endforeach()
  endif()
  json_type(_t "${obj}" status)
  if(_t STREQUAL "OBJECT")
    string(JSON _sob GET "${obj}" status)
    json_members(_sm "${_sob}")
    foreach(_k IN LISTS _sm)
      string(JSON ${prefix}_${_k} GET "${_sob}" "${_k}")
    endforeach()
  endif()
  foreach(_k intff dbd prev_interruptible run_state halt_pending busak fault_reason)
    json_type(_t "${obj}" ${_k})
    if(NOT _t STREQUAL "MISSING")
      string(JSON _v GET "${obj}" ${_k})
      vd_norm(${prefix}_${_k} "${_v}")
    endif()
  endforeach()
  json_type(_t "${obj}" mem)
  if(_t STREQUAL "ARRAY")
    string(JSON _nm LENGTH "${obj}" mem)
    if(_nm GREATER 0)
      math(EXPR _ml "${_nm} - 1")
      foreach(_k RANGE 0 ${_ml})
        string(JSON _a ERROR_VARIABLE _e1 GET "${obj}" mem ${_k} 0)
        string(JSON _w ERROR_VARIABLE _e2 GET "${obj}" mem ${_k} 1)
        if("${_e1}" STREQUAL "NOTFOUND" AND "${_e2}" STREQUAL "NOTFOUND")
          vd_norm(_a "${_a}")
          vd_norm(${prefix}_mem_${_a} "${_w}")
          list(APPEND ${prefix}_memaddrs "${_a}")
        endif()
      endforeach()
    endif()
  endif()
endmacro()

# Canonical text of a list member (units in order, events as a sorted set) or `absent`.
function(vd_names out obj key sorted)
  json_type(t "${obj}" ${key})
  if(NOT t STREQUAL "ARRAY")
    set(${out} "absent" PARENT_SCOPE)
    return()
  endif()
  string(JSON n LENGTH "${obj}" ${key})
  set(v "")
  if(n GREATER 0)
    math(EXPR l "${n} - 1")
    foreach(k RANGE 0 ${l})
      string(JSON x GET "${obj}" ${key} ${k})
      list(APPEND v "${x}")
    endforeach()
  endif()
  if(sorted)
    list(SORT v)
  endif()
  list(JOIN v "," v)
  if(v STREQUAL "")
    set(v "none")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Canonical text of a bus list: `cycle:kind:addr:data` joined by `|` (cycle `*` unless with_cycles).
function(vd_bus out obj with_cycles)
  string(JSON n LENGTH "${obj}" bus)
  set(v "")
  if(n GREATER 0)
    math(EXPR l "${n} - 1")
    foreach(k RANGE 0 ${l})
      set(parts "")
      foreach(c RANGE 3)
        string(JSON x ERROR_VARIABLE e GET "${obj}" bus ${k} ${c})
        if(NOT "${e}" STREQUAL "NOTFOUND")
          set(x "?")
        endif()
        string(TOUPPER "${x}" x)
        if(c EQUAL 0 AND NOT with_cycles)
          set(x "*")
        endif()
        list(APPEND parts "${x}")
      endforeach()
      list(JOIN parts ":" e)
      list(APPEND v "${e}")
    endforeach()
  endif()
  list(JOIN v "|" v)
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

set(out_lines "")
set(n_agree 0)
set(n_dis 0)
set(n_total 0)
foreach(idx IN LISTS p_indices)
  math(EXPR n_total "${n_total} + 1")
  get_property(vid GLOBAL PROPERTY "VD_ID_${idx}")
  get_property(ci GLOBAL PROPERTY "VD_C_${vid}")
  get_property(di GLOBAL PROPERTY "VD_D_${idx}")
  get_property(pol GLOBAL PROPERTY "VD_POL_${idx}")
  set(suffix "")
  if(NOT "${pol}" STREQUAL "")
    set(suffix " policy=${pol}")
  endif()
  string(JSON cvec GET "${cdoc}" vectors ${ci})
  string(JSON init GET "${cvec}" init)
  string(JSON cexp GET "${cvec}" expect)
  string(JSON dent GET "${ddoc}" vectors ${di})
  string(JSON dexp GET "${dent}" expect)

  # base state: defaults, init, then program words at program_at (default init R7)
  foreach(k RANGE 7)
    set(B_r${k} 0000)
  endforeach()
  foreach(k S Z OV C intff dbd halt_pending busak)
    set(B_${k} 0)
  endforeach()
  set(B_prev_interruptible 1)
  set(B_run_state RUNNING)
  set(B_fault_reason NONE)
  set(B_memaddrs "")
  vd_apply(B "${init}")
  set(pc "${B_r7}")
  json_type(t "${cvec}" program_at)
  if(t STREQUAL "STRING")
    string(JSON pc GET "${cvec}" program_at)
  endif()
  math(EXPR pcn "0x${pc}")
  string(JSON np LENGTH "${cvec}" program)
  if(np GREATER 0)
    math(EXPR pl "${np} - 1")
    foreach(k RANGE 0 ${pl})
      string(JSON pw GET "${cvec}" program ${k})
      string(SUBSTRING "${pw}" 0 4 pw)
      math(EXPR a "(${pcn} + ${k}) & 0xFFFF" OUTPUT_FORMAT HEXADECIMAL)
      string(REGEX REPLACE "^0x" "" a "${a}")
      string(LENGTH "${a}" al)
      while(al LESS 4)
        set(a "0${a}")
        math(EXPR al "${al} + 1")
      endwhile()
      vd_norm(a "${a}")
      if(NOT DEFINED B_mem_${a})
        vd_norm(B_mem_${a} "${pw}")
        list(APPEND B_memaddrs "${a}")
      endif()
    endforeach()
  endif()

  # committed (C) and reader (D) states start from the base
  foreach(f IN LISTS STATE_FIELDS)
    set(C_${f} "${B_${f}}")
    set(D_${f} "${B_${f}}")
  endforeach()
  set(C_memaddrs "")
  set(D_memaddrs "")
  vd_apply(C "${cexp}")
  vd_apply(D "${dexp}")

  set(diffs "")
  foreach(f IN LISTS STATE_FIELDS)
    if(NOT "${C_${f}}" STREQUAL "${D_${f}}")
      list(APPEND diffs "DIFF ${vid} ${f} committed=${C_${f}} reader=${D_${f}}${suffix}")
    endif()
  endforeach()
  set(addrs ${C_memaddrs} ${D_memaddrs})
  list(REMOVE_DUPLICATES addrs)
  list(SORT addrs)
  foreach(a IN LISTS addrs)
    set(cv "unset")
    set(dv "unset")
    if(DEFINED B_mem_${a})
      set(cv "${B_mem_${a}}")
      set(dv "${B_mem_${a}}")
    endif()
    if(DEFINED C_mem_${a})
      set(cv "${C_mem_${a}}")
    endif()
    if(DEFINED D_mem_${a})
      set(dv "${D_mem_${a}}")
    endif()
    if(NOT cv STREQUAL dv)
      list(APPEND diffs "DIFF ${vid} mem:${a} committed=${cv} reader=${dv}${suffix}")
    endif()
  endforeach()
  # clear per-vector memory variables
  foreach(a IN LISTS addrs B_memaddrs)
    unset(B_mem_${a})
    unset(C_mem_${a})
    unset(D_mem_${a})
  endforeach()

  json_type(t "${cexp}" cycles)
  if(t STREQUAL "NUMBER")
    string(JSON cc GET "${cexp}" cycles)
    set(dc "absent")
    json_type(t2 "${dexp}" cycles)
    if(t2 STREQUAL "NUMBER")
      string(JSON dc GET "${dexp}" cycles)
    endif()
    if(NOT cc STREQUAL dc)
      list(APPEND diffs "DIFF ${vid} cycles committed=${cc} reader=${dc}${suffix}")
    endif()
  endif()
  json_type(t "${cexp}" units)
  if(t STREQUAL "ARRAY")
    vd_names(cu "${cexp}" units FALSE)
    vd_names(du "${dexp}" units FALSE)
    if(NOT cu STREQUAL du)
      list(APPEND diffs "DIFF ${vid} units committed=${cu} reader=${du}${suffix}")
    endif()
  endif()
  json_type(t "${cexp}" events)
  if(t STREQUAL "ARRAY")
    vd_names(ce "${cexp}" events TRUE)
    vd_names(de "${dexp}" events TRUE)
    if(NOT ce STREQUAL de)
      list(APPEND diffs "DIFF ${vid} events committed=${ce} reader=${de}${suffix}")
    endif()
  endif()
  json_type(cbt "${cvec}" bus)
  json_type(dbt "${dent}" bus)
  if(cbt STREQUAL "ARRAY" AND dbt STREQUAL "ARRAY")
    set(with_cycles FALSE)
    json_type(t "${cvec}" bus_basis)
    if(t STREQUAL "STRING")
      string(JSON basis GET "${cvec}" bus_basis)
      if(basis STREQUAL "figure")
        set(with_cycles TRUE)
      endif()
    endif()
    vd_bus(cb "${cvec}" ${with_cycles})
    vd_bus(db "${dent}" ${with_cycles})
    if(NOT cb STREQUAL db)
      list(APPEND diffs "DIFF ${vid} bus committed=${cb} reader=${db}${suffix}")
    endif()
  endif()

  if("${diffs}" STREQUAL "")
    math(EXPR n_agree "${n_agree} + 1")
  else()
    math(EXPR n_dis "${n_dis} + 1")
    list(APPEND out_lines ${diffs})
  endif()
endforeach()

list(APPEND out_lines
  "diff-summary file=${stem} vectors=${n_total} agree=${n_agree} disagree=${n_dis} derived_sha256=${derived_sha} run_id=${h_run}")
ivs_blind_print(${out_lines})
