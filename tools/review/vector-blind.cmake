# SPDX-License-Identifier: MIT
# Blinded-copy writer for the second reading of the CP-1610 vector files (D-15, A-12).
# Usage: cmake -DROOT=<repo> [-DFILE=<stem>] [-DOUT_DIR=<dir>] [-DPOLICY_MAP=1] -P vector-blind.cmake
#   ROOT        the tree whose data/cp1610/vectors/*.json are projected (required)
#   FILE        one stem; default every stem of data/expected/cp1610-vector-files.ids
#   OUT_DIR     default ${ROOT}/build/review/blind; one <stem>.json per stem
#   POLICY_MAP  1: print `policy-token <token> <policy id>` lines and write nothing (doc author and
#               vector-diff.cmake only; never given to a reader)
# Blinded copy: {"schema_version": 1, "file": "<stem>", "vectors": [...]}; per vector, in this order:
#   index     `v` plus 3 digits, numbered in ascending order of the sha256 of the committed id
#   policy    kind=policy only: the opaque token (`p` plus 2 digits, numbered in ascending order of
#             the sha256 of each id of data/expected/cp1610-policies.ids; same in every copy)
#   has_bus   true when the committed vector has a non-empty bus list
#   program   the hex4 word of each program string
#   init      the committed init, copied whole, plus `stimulus` holding whichever of
#             steps step_lines config ebci waits iab reset program_at the vector has
# Dropped (never present at any depth): see IVS_BLIND_DROPPED.
# Failure tokens (`-- FAIL <token>: <stem> <what>`, never a value):
#   review-blind-unknown-key  a vector key outside the plan 02-02 vector schema
#   review-blind-leak         the projected text holds a dropped key (quoted, at any depth), a
#                             committed id or cite string of that file, or the literal POL-
#   review-blind-input        a vector file or inventory missing or unparseable, a program string
#                             without a hex4 word, a policy vector whose policy has no token
# The text is scanned before it is written; a file that fails is not written (and an older copy
# of it is removed). Success prints only `blind <stem> vectors=<n>` per file, never vector content.
# include() from another script defines the functions only (ivs_blind_project,
# ivs_blind_policy_tokens); the main block runs only when this file is the -P script.
cmake_minimum_required(VERSION 3.25)

include("${CMAKE_CURRENT_LIST_DIR}/../check/lib.cmake")

set(IVS_BLIND_DROPPED id row kind tier cite sources asm derivation expect bus bus_basis covers)
set(IVS_BLIND_STIMULUS steps step_lines config ebci waits iab reset program_at)
set(IVS_BLIND_SCHEMA ${IVS_BLIND_DROPPED} policy program init ${IVS_BLIND_STIMULUS})

# JSON string escaping for the canonical writer.
function(ivs_blind_escape out s)
  string(REPLACE "\\" "\\\\" s "${s}")
  string(REPLACE "\"" "\\\"" s "${s}")
  string(REPLACE "\n" "\\n" s "${s}")
  string(REPLACE "\r" "\\r" s "${s}")
  string(REPLACE "\t" "\\t" s "${s}")
  set(${out} "\"${s}\"" PARENT_SCOPE)
endfunction()

# Canonical one-line JSON of the element of doc at the path in ARGN (sorted object members,
# `, ` and `: ` separators). Independent of the CMake version's own JSON pretty-printer.
function(ivs_blind_canon out doc)
  string(JSON t TYPE "${doc}" ${ARGN})
  if(t STREQUAL "OBJECT")
    string(JSON n LENGTH "${doc}" ${ARGN})
    set(parts "")
    if(n GREATER 0)
      math(EXPR last "${n} - 1")
      set(names "")
      foreach(i RANGE 0 ${last})
        string(JSON k MEMBER "${doc}" ${ARGN} ${i})
        list(APPEND names "${k}")
      endforeach()
      list(SORT names)
      foreach(k IN LISTS names)
        ivs_blind_canon(v "${doc}" ${ARGN} "${k}")
        ivs_blind_escape(ek "${k}")
        list(APPEND parts "${ek}: ${v}")
      endforeach()
    endif()
    list(JOIN parts ", " body)
    set(${out} "{${body}}" PARENT_SCOPE)
  elseif(t STREQUAL "ARRAY")
    string(JSON n LENGTH "${doc}" ${ARGN})
    set(body "")
    if(n GREATER 0)
      math(EXPR last "${n} - 1")
      foreach(i RANGE 0 ${last})
        ivs_blind_canon(v "${doc}" ${ARGN} ${i})
        if(i EQUAL 0)
          set(body "${v}")
        else()
          string(APPEND body ", ${v}")
        endif()
      endforeach()
    endif()
    set(${out} "[${body}]" PARENT_SCOPE)
  elseif(t STREQUAL "STRING")
    string(JSON v GET "${doc}" ${ARGN})
    ivs_blind_escape(v "${v}")
    set(${out} "${v}" PARENT_SCOPE)
  elseif(t STREQUAL "BOOLEAN")
    string(JSON v GET "${doc}" ${ARGN})
    if(v)
      set(${out} "true" PARENT_SCOPE)
    else()
      set(${out} "false" PARENT_SCOPE)
    endif()
  elseif(t STREQUAL "NULL")
    set(${out} "null" PARENT_SCOPE)
  else()
    string(JSON v GET "${doc}" ${ARGN})
    set(${out} "${v}" PARENT_SCOPE)
  endif()
endfunction()

# Opaque policy tokens of <root>/data/expected/cp1610-policies.ids: a list of `<token> <policy id>`
# pairs, tokens p01.. assigned in ascending order of the sha256 of each policy id.
function(ivs_blind_policy_tokens root outvar)
  set(${outvar} "" PARENT_SCOPE)
  set(f "${root}/data/expected/cp1610-policies.ids")
  if(NOT EXISTS "${f}")
    gate_fail(review-blind-input "cp1610-policies.ids missing")
    return()
  endif()
  file(STRINGS "${f}" lines)
  set(keyed "")
  foreach(l IN LISTS lines)
    string(STRIP "${l}" l)
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    string(REGEX REPLACE "[ \t].*$" "" pid "${l}")
    string(SHA256 h "${pid}")
    list(APPEND keyed "${h} ${pid}")
  endforeach()
  list(SORT keyed)
  set(pairs "")
  set(n 0)
  foreach(e IN LISTS keyed)
    math(EXPR n "${n} + 1")
    string(REGEX REPLACE "^[0-9a-f]+ " "" pid "${e}")
    if(n LESS 10)
      set(tok "p0${n}")
    else()
      set(tok "p${n}")
    endif()
    list(APPEND pairs "${tok} ${pid}")
  endforeach()
  set(${outvar} "${pairs}" PARENT_SCOPE)
endfunction()

# Element texts of the top-level `vectors` array of the parsed document `doc` from one parse of
# the document: a lookup of element i parses the whole document, so asking for every element of
# an n-element array costs n times the document. On success the caller gets ${out}_N = n and
# ${out}_<i> (i from 0); otherwise ${out}_N is -1 and the caller looks each element up itself.
# CMake's writer prints each element of an array of objects as a block between a line `  {` and
# a line `  }` (indent 2) and escapes newlines in strings, so the text `\n  },\n  {\n` occurs only
# between two elements; an array that does not print that way gives a different count or a
# different head or tail and is refused. The same helper is in tools/check/vectors.cmake.
function(vector_elements out doc)
  set(${out}_N -1 PARENT_SCOPE)
  string(JSON n ERROR_VARIABLE e LENGTH "${doc}" vectors)
  if(NOT "${e}" STREQUAL "NOTFOUND" OR n LESS 2)
    return()
  endif()
  string(JSON arr ERROR_VARIABLE e GET "${doc}" vectors)
  if(NOT "${e}" STREQUAL "NOTFOUND")
    return()
  endif()
  string(ASCII 1 sep)
  string(REPLACE "\n  },\n  {\n" "\n  }${sep}{\n" arr "${arr}")
  string(LENGTH "${arr}" alen)
  string(SUBSTRING "${arr}" 0 5 head)
  math(EXPR tail_at "${alen} - 3")
  string(SUBSTRING "${arr}" ${tail_at} 3 tail)
  if(NOT "${head}" STREQUAL "[\n  {" OR NOT "${tail}" STREQUAL "}\n]")
    return()
  endif()
  # drop the opening `[` + newline + 2 spaces and the closing newline + `]`
  math(EXPR rest_len "${alen} - 6")
  string(SUBSTRING "${arr}" 4 ${rest_len} rest)
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last})
    string(FIND "${rest}" "${sep}" pos)
    if(i LESS ${last})
      if(pos EQUAL -1)
        return()
      endif()
      string(SUBSTRING "${rest}" 0 ${pos} piece)
      math(EXPR pos1 "${pos} + 1")
      string(SUBSTRING "${rest}" ${pos1} -1 rest)
    else()
      if(NOT pos EQUAL -1)
        return()
      endif()
      set(piece "${rest}")
    endif()
    set(${out}_${i} "${piece}" PARENT_SCOPE)
  endforeach()
  set(${out}_N ${n} PARENT_SCOPE)
endfunction()

# Project the committed vector file <json-in> (a path; the stem is its file name without .json)
# into the blinded text <out-json-var> and the `index id` pair list <out-map-var>. Policy tokens
# come from ${ROOT}. Findings go through gate_fail; the caller reads the GATE_FAILURES property
# (see ivs_blind_failed).
function(ivs_blind_project json_in out_json out_map)
  set(${out_json} "" PARENT_SCOPE)
  set(${out_map} "" PARENT_SCOPE)
  get_filename_component(stem "${json_in}" NAME_WE)
  if(NOT EXISTS "${json_in}")
    gate_fail(review-blind-input "${stem} file missing")
    return()
  endif()
  file(READ "${json_in}" doc)
  string(JSON vt ERROR_VARIABLE perr TYPE "${doc}" vectors)
  if(NOT "${perr}" STREQUAL "NOTFOUND" OR NOT vt STREQUAL "ARRAY")
    gate_fail(review-blind-input "${stem} parse or no vectors array")
    return()
  endif()
  ivs_blind_policy_tokens("${ROOT}" ptok)

  string(JSON nv LENGTH "${doc}" vectors)
  set(keyed "")
  set(ids "")
  set(cites "")
  if(nv GREATER 0)
    math(EXPR last "${nv} - 1")
    vector_elements(ve "${doc}")
    foreach(i RANGE 0 ${last})
      # The object text of every vector is fetched once and kept for the projection loop below.
      set(vec "")
      if(ve_N EQUAL nv)
        set(vec "${ve_${i}}")
        string(JSON vtype ERROR_VARIABLE verr TYPE "${vec}")
        if(NOT "${verr}" STREQUAL "NOTFOUND")
          set(vec "")
        endif()
      endif()
      if(vec STREQUAL "")
        string(JSON vec GET "${doc}" vectors ${i})
      endif()
      set(BLIND_VEC_${i} "${vec}")
      json_members(mem "${vec}")
      set(BLIND_MEM_${i} "${mem}")
      foreach(k IN LISTS mem)
        if(NOT "${k}" IN_LIST IVS_BLIND_SCHEMA)
          gate_fail(review-blind-unknown-key "${stem} ${k}")
        endif()
      endforeach()
      json_type(it "${vec}" id)
      if(NOT it STREQUAL "STRING")
        gate_fail(review-blind-input "${stem} vector #${i} without id")
        continue()
      endif()
      string(JSON id GET "${vec}" id)
      list(APPEND ids "${id}")
      json_type(ct "${vec}" cite)
      if(ct STREQUAL "STRING")
        string(JSON cite GET "${vec}" cite)
        if(NOT cite STREQUAL "")
          list(APPEND cites "${cite}")
        endif()
      endif()
      string(SHA256 h "${id}")
      list(APPEND keyed "${h} ${i}")
    endforeach()
  endif()
  list(SORT keyed)

  set(text "{\n  \"schema_version\": 1,\n  \"file\": \"${stem}\",\n  \"vectors\": [")
  set(map "")
  set(n 0)
  foreach(e IN LISTS keyed)
    math(EXPR n "${n} + 1")
    string(REGEX REPLACE "^[0-9a-f]+ " "" i "${e}")
    if(n LESS 10)
      set(index "v00${n}")
    elseif(n LESS 100)
      set(index "v0${n}")
    else()
      set(index "v${n}")
    endif()
    set(vec "${BLIND_VEC_${i}}")
    set(vmem "${BLIND_MEM_${i}}")
    string(JSON id GET "${vec}" id)
    list(APPEND map "${index} ${id}")

    # policy token (kind=policy only)
    set(policy_line "")
    json_type(kt "${vec}" kind)
    set(kind "")
    if(kt STREQUAL "STRING")
      string(JSON kind GET "${vec}" kind)
    endif()
    if(kind STREQUAL "policy")
      set(tok "")
      json_type(pt "${vec}" policy)
      if(pt STREQUAL "STRING")
        string(JSON pid GET "${vec}" policy)
        foreach(pair IN LISTS ptok)
          string(REGEX REPLACE "^[^ ]+ " "" ppid "${pair}")
          if(ppid STREQUAL pid)
            string(REGEX REPLACE " .*$" "" tok "${pair}")
          endif()
        endforeach()
      endif()
      if(tok STREQUAL "")
        gate_fail(review-blind-input "${stem} ${index} policy without token")
      else()
        set(policy_line "\n      \"policy\": \"${tok}\",")
      endif()
    endif()

    # has_bus
    set(has_bus false)
    # (a key that is not a member of the vector is MISSING without a lookup)
    set(bt MISSING)
    if("bus" IN_LIST vmem)
      json_type(bt "${vec}" bus)
    endif()
    if(bt STREQUAL "ARRAY")
      string(JSON nb LENGTH "${vec}" bus)
      if(nb GREATER 0)
        set(has_bus true)
      endif()
    endif()

    # program: hex4 words only
    set(words "")
    json_type(prt "${vec}" program)
    if(prt STREQUAL "ARRAY")
      string(JSON np LENGTH "${vec}" program)
      if(np GREATER 0)
        math(EXPR plast "${np} - 1")
        foreach(p RANGE 0 ${plast})
          json_type(pwt "${vec}" program ${p})
          set(w "")
          if(pwt STREQUAL "STRING")
            string(JSON pw GET "${vec}" program ${p})
            string(REGEX MATCH "^[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]( |$)" w "${pw}")
            string(STRIP "${w}" w)
          endif()
          if(w STREQUAL "")
            gate_fail(review-blind-input "${stem} ${index} program word ${p}")
          else()
            list(APPEND words "\"${w}\"")
          endif()
        endforeach()
      endif()
    else()
      gate_fail(review-blind-input "${stem} ${index} program")
    endif()
    list(JOIN words ", " words)

    # init (whole) plus stimulus
    set(init_body "")
    json_type(itt "${vec}" init)
    if(itt STREQUAL "OBJECT")
      string(JSON init GET "${vec}" init)
      json_type(st "${init}" stimulus)
      if(NOT st STREQUAL "MISSING")
        gate_fail(review-blind-unknown-key "${stem} init.stimulus")
      endif()
      ivs_blind_canon(init_c "${init}")
      string(REGEX REPLACE "^[{](.*)[}]$" "\\1" init_body "${init_c}")
    else()
      gate_fail(review-blind-input "${stem} ${index} init")
    endif()
    set(stim "")
    foreach(k IN LISTS IVS_BLIND_STIMULUS)
      set(skt MISSING)
      if("${k}" IN_LIST vmem)
        json_type(skt "${vec}" ${k})
      endif()
      if(NOT skt STREQUAL "MISSING")
        ivs_blind_canon(sv "${vec}" ${k})
        list(APPEND stim "\"${k}\": ${sv}")
      endif()
    endforeach()
    list(JOIN stim ", " stim)
    if(init_body STREQUAL "")
      set(init_text "{\"stimulus\": {${stim}}}")
    else()
      set(init_text "{${init_body}, \"stimulus\": {${stim}}}")
    endif()

    if(n GREATER 1)
      string(APPEND text ",")
    endif()
    string(APPEND text "\n    {\n      \"index\": \"${index}\",${policy_line}\n      \"has_bus\": ${has_bus},\n"
      "      \"program\": [${words}],\n      \"init\": ${init_text}\n    }")
  endforeach()
  string(APPEND text "\n  ]\n}\n")

  # Leak scan of the projected text (independent of the projection rules above).
  foreach(k IN LISTS IVS_BLIND_DROPPED)
    string(FIND "${text}" "\"${k}\"" pos)
    if(pos GREATER -1)
      gate_fail(review-blind-leak "${stem} key ${k}")
    endif()
  endforeach()
  set(id_hit FALSE)
  foreach(x IN LISTS ids)
    string(FIND "${text}" "${x}" pos)
    if(pos GREATER -1)
      set(id_hit TRUE)
    endif()
  endforeach()
  if(id_hit)
    gate_fail(review-blind-leak "${stem} committed id")
  endif()
  set(cite_hit FALSE)
  foreach(x IN LISTS cites)
    string(FIND "${text}" "${x}" pos)
    if(pos GREATER -1)
      set(cite_hit TRUE)
    endif()
  endforeach()
  if(cite_hit)
    gate_fail(review-blind-leak "${stem} committed cite")
  endif()
  string(FIND "${text}" "POL-" pos)
  if(pos GREATER -1)
    gate_fail(review-blind-leak "${stem} POL- string")
  endif()

  set(${out_json} "${text}" PARENT_SCOPE)
  set(${out_map} "${map}" PARENT_SCOPE)
endfunction()

# Number of findings recorded so far (GATE_FAILURES), for callers that check per file.
function(ivs_blind_failed out)
  get_property(f GLOBAL PROPERTY GATE_FAILURES)
  list(LENGTH f n)
  set(${out} "${n}" PARENT_SCOPE)
endfunction()

# Print lines (a CMake list) on stdout without the `-- ` prefix of message(STATUS).
function(ivs_blind_print)
  if("${ARGN}" STREQUAL "")
    return()
  endif()
  list(JOIN ARGN "\n" body)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${body}")
endfunction()

# ---- main (only when run with -P on this file) ----
if(NOT CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  return()
endif()
if(NOT DEFINED ROOT OR "${ROOT}" STREQUAL "")
  message(FATAL_ERROR "vector-blind.cmake is missing ROOT")
endif()

if(POLICY_MAP)
  ivs_blind_policy_tokens("${ROOT}" pairs)
  set(lines "")
  foreach(p IN LISTS pairs)
    list(APPEND lines "policy-token ${p}")
  endforeach()
  ivs_blind_failed(nf)
  if(nf GREATER 0 OR "${lines}" STREQUAL "")
    message(FATAL_ERROR "vector-blind: no policy tokens")
  endif()
  ivs_blind_print(${lines})
  return()
endif()

if(NOT DEFINED OUT_DIR OR "${OUT_DIR}" STREQUAL "")
  set(OUT_DIR "${ROOT}/build/review/blind")
endif()
if(DEFINED FILE AND NOT "${FILE}" STREQUAL "")
  set(stems "${FILE}")
else()
  read_ids(stems "data/expected/cp1610-vector-files.ids" review-blind)
endif()

set(done "")
foreach(stem IN LISTS stems)
  ivs_blind_failed(before)
  ivs_blind_project("${ROOT}/data/cp1610/vectors/${stem}.json" text map)
  ivs_blind_failed(after)
  if(after GREATER before OR "${text}" STREQUAL "")
    file(REMOVE "${OUT_DIR}/${stem}.json")
    continue()
  endif()
  file(MAKE_DIRECTORY "${OUT_DIR}")
  file(WRITE "${OUT_DIR}/${stem}.json" "${text}")
  list(LENGTH map nvec)
  list(APPEND done "blind ${stem} vectors=${nvec}")
endforeach()
ivs_blind_print(${done})
ivs_blind_failed(nf)
if(nf GREATER 0)
  message(FATAL_ERROR "vector-blind: ${nf} failure(s)")
endif()
