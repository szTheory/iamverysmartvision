# Reference documents, page renders and downloads live only in the local cache.
/refs/

# Rights-bearing or derivative binary classes are never committed by accident.
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.int
*.bin
*.rom
*.itv
*.cfg
*.cc3
*.ivsc
# Rendered audio (plan 05-10, D-21, T-05-26): derived audio of rights-bearing content must not be committed.
*.wav
# Raw and operator-side video output (plan 06-01): derived frames of rights-bearing content must not be committed.
*.ppm
*.vraw

# Secrets and local environment.
.env
.env.*

# Build output and OS noise.
/build/
/build-*/
.DS_Store

# Owner-local system-image dumps (plan 07-10, D-30): a GROM or generic image dump must not be committed by accident.
# (`*.exec` is not listed: boot-stub-2.exec is a build-tree name, and ignoring it would only hide a mistaken tracked stub from git status.)
*.grom
*.img
