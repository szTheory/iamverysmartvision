# Reference documents, page renders and downloads live only in the local cache.
/refs/

# Rights-bearing or derivative binary classes are never committed by accident.
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.int
*.bin
*.rom
*.itv
*.cfg
*.cc3
*.ivsc
# Rendered audio (plan 05-10, D-21, T-05-26): derived audio of rights-bearing content must not be committed.
*.wav

# Secrets and local environment.
.env
.env.*

# Build output and OS noise.
/build/
/build-*/
.DS_Store
