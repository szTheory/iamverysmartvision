# SPDX-License-Identifier: MIT
# Decode sweep table generator (D-16, plan 02-13): reads the Phase 1 family table
# data/cp1610/opcode-families.json, an independent transcription of the instruction formats, and
# writes a C initializer table to OUT (build tree only, never committed) for the cpu-sweep suite.
# Usage: cmake -DROOT=<repo> -DOUT=<build>/tests/ivs_sweep.inc -P cmake/IvsSweepTable.cmake
# For each of the 1024 decles: the leaf rows (the rows whose fixed bits and `eq` relations hold,
# minus every match that another match `refines`; two leaves only at an `also_encodes`
# coincidence), and from the leaves' columns:
#   words      `words` (the leaves must agree)
#   base       `cycles_printed` when it is a plain integer and `cycle_modifiers` is empty, else 0
#              (no assertion); two leaves give a base only when both give the same one
#   smask      the `status_bits` flags in the GSWD layout (C 0x10, OV 0x20, Z 0x40, S 0x80); a
#              `N=0: ...; N=1: ...` column picks the set by the N bit, whose position is the `N`
#              of the `printed` column; two leaves give the union
#   pc_check   0 when the row is in group branch or jump, when `printed` ends in DDD and bits 2..0
#              are 111 (the destination is R7), or for a register-register row whose `printed`
#              ends in 111 (JR); else 1. Two leaves: both must allow it
#   sdbd       1 when the `sdbd` column starts with `supported` (every leaf)
# The SHA256 of the family table is embedded as ivs_sweep_sources[] and re-checked by the
# tests-inventory step. A malformed row, an unclaimed decle, three leaves or disagreeing words stop
# the build (fail closed). The table is never an expected-value source for the vectors.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsSweepTable: missing -D${required}")
  endif()
endforeach()

set(REL "data/cp1610/opcode-families.json")
function(st_fail msg)
  message(FATAL_ERROR "IvsSweepTable: ${REL}: ${msg}")
endfunction()

# String member of an object, or "" when absent or not a string.
function(st_str out doc)
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" ${ARGN})
  set(v "")
  if("${e}" STREQUAL "NOTFOUND" AND t STREQUAL "STRING")
    string(JSON v GET "${doc}" ${ARGN})
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Flag mask in the GSWD layout from a list such as "S, Z, C, OV" or "none".
function(st_flags out text)
  set(m 0)
  string(REPLACE "," ";" items "${text}")
  foreach(it IN LISTS items)
    string(STRIP "${it}" it)
    if(it STREQUAL "C")
      math(EXPR m "${m} | 16")
    elseif(it STREQUAL "OV")
      math(EXPR m "${m} | 32")
    elseif(it STREQUAL "Z")
      math(EXPR m "${m} | 64")
    elseif(it STREQUAL "S")
      math(EXPR m "${m} | 128")
    elseif(NOT it STREQUAL "none" AND NOT it STREQUAL "")
      st_fail("unknown status bit '${it}'")
    endif()
  endforeach()
  set(${out} ${m} PARENT_SCOPE)
endfunction()

if(NOT EXISTS "${ROOT}/${REL}")
  st_fail("file missing")
endif()
file(READ "${ROOT}/${REL}" DOC)
file(SHA256 "${ROOT}/${REL}" DIGEST)
string(JSON NROWS ERROR_VARIABLE e LENGTH "${DOC}" rows)
if(NOT "${e}" STREQUAL "NOTFOUND" OR NROWS EQUAL 0)
  st_fail("no rows")
endif()
math(EXPR LAST "${NROWS} - 1")

# Pass 1: per-row columns into parallel lists.
set(IDS "")
foreach(i RANGE ${LAST})
  string(JSON rec GET "${DOC}" rows ${i})
  st_str(id "${rec}" id)
  st_str(pattern "${rec}" pattern)
  st_str(printed "${rec}" printed)
  st_str(group "${rec}" group)
  st_str(cyc "${rec}" cycles_printed)
  st_str(status "${rec}" status_bits)
  st_str(sdbd "${rec}" sdbd)
  string(JSON words ERROR_VARIABLE e GET "${rec}" words)
  if(id STREQUAL "" OR NOT pattern MATCHES "^[01.][01.][01.][01.][01.][01.][01.][01.][01.][01.]$"
      OR NOT "${e}" STREQUAL "NOTFOUND" OR NOT words MATCHES "^[1-3]$")
    st_fail("row ${i} is malformed")
  endif()
  list(APPEND IDS "${id}")
  set(mask 0)
  set(val 0)
  string(REGEX REPLACE "(.)" "\\1;" chars "${pattern}")
  foreach(c IN LISTS chars)
    if(c STREQUAL ".")
      math(EXPR mask "${mask} * 2")
      math(EXPR val "${val} * 2")
    elseif(c STREQUAL "1")
      math(EXPR mask "${mask} * 2 + 1")
      math(EXPR val "${val} * 2 + 1")
    elseif(c STREQUAL "0")
      math(EXPR mask "${mask} * 2 + 1")
      math(EXPR val "${val} * 2")
    endif()
  endforeach()
  set(R${i}_mask ${mask})
  set(R${i}_val ${val})
  set(R${i}_words ${words})
  # eq relations "h:l=h:l"
  set(eqs "")
  string(JSON en ERROR_VARIABLE e LENGTH "${rec}" eq)
  if("${e}" STREQUAL "NOTFOUND" AND en GREATER 0)
    math(EXPR elast "${en} - 1")
    foreach(k RANGE ${elast})
      string(JSON q GET "${rec}" eq ${k})
      if(NOT q MATCHES "^([0-9]+):([0-9]+)=([0-9]+):([0-9]+)$")
        st_fail("row ${id} eq '${q}'")
      endif()
      list(APPEND eqs "${CMAKE_MATCH_1},${CMAKE_MATCH_2},${CMAKE_MATCH_4}")
    endforeach()
  endif()
  set(R${i}_eqs "${eqs}")
  st_str(R${i}_refines "${rec}" refines)
  # base cycles: a plain integer with no modifier
  set(nmod 0)
  string(JSON nmod ERROR_VARIABLE e LENGTH "${rec}" cycle_modifiers)
  if(NOT "${e}" STREQUAL "NOTFOUND")
    set(nmod 0)
  endif()
  set(base 0)
  if(cyc MATCHES "^[0-9]+$" AND nmod EQUAL 0)
    set(base ${cyc})
  endif()
  set(R${i}_base ${base})
  # status masks for N = 0 and N = 1, and the N bit position from `printed`
  string(REPLACE " " "" pr "${printed}")
  string(LENGTH "${pr}" prlen)
  if(NOT prlen EQUAL 10)
    st_fail("row ${id} printed '${printed}' is not 10 bits")
  endif()
  if(status MATCHES "^N=0:(.*); *N=1:(.*)$")
    set(s1 "${CMAKE_MATCH_2}")
    st_flags(m0 "${CMAKE_MATCH_1}")
    st_flags(m1 "${s1}")
    string(FIND "${pr}" "N" npos)
    if(npos LESS 0)
      st_fail("row ${id} has N-dependent status but no N in printed")
    endif()
    math(EXPR nbit "9 - ${npos}")
  else()
    st_flags(m0 "${status}")
    set(m1 ${m0})
    set(nbit 0)
  endif()
  set(R${i}_m0 ${m0})
  set(R${i}_m1 ${m1})
  set(R${i}_nbit ${nbit})
  # pc_check inputs
  string(SUBSTRING "${pr}" 7 3 tail)
  set(R${i}_nopc 0)
  if(group STREQUAL "branch" OR group STREQUAL "jump"
      OR (group STREQUAL "register-register" AND tail STREQUAL "111"))
    set(R${i}_nopc 1)
  endif()
  set(R${i}_dddtail 0)
  if(tail STREQUAL "DDD")
    set(R${i}_dddtail 1)
  endif()
  set(R${i}_sdbd 0)
  if(sdbd MATCHES "^supported")
    set(R${i}_sdbd 1)
  endif()
endforeach()

# refines targets as row indexes
foreach(i RANGE ${LAST})
  set(R${i}_ref -1)
  if(NOT "${R${i}_refines}" STREQUAL "")
    list(FIND IDS "${R${i}_refines}" t)
    if(t LESS 0)
      st_fail("row ${i} refines unknown '${R${i}_refines}'")
    endif()
    set(R${i}_ref ${t})
  endif()
endforeach()

# Pass 2: leaves and columns per decle.
set(out_tab "")
foreach(d RANGE 1023)
  set(matches "")
  foreach(i RANGE ${LAST})
    math(EXPR x "${d} & ${R${i}_mask}")
    if(NOT x EQUAL R${i}_val)
      continue()
    endif()
    set(holds TRUE)
    foreach(q IN LISTS R${i}_eqs)
      string(REPLACE "," ";" f "${q}")
      list(GET f 0 h1)
      list(GET f 1 l1)
      list(GET f 2 l2)
      math(EXPR w "(1 << (${h1} - ${l1} + 1)) - 1")
      math(EXPR a "(${d} >> ${l1}) & ${w}")
      math(EXPR b "(${d} >> ${l2}) & ${w}")
      if(NOT a EQUAL b)
        set(holds FALSE)
      endif()
    endforeach()
    if(holds)
      list(APPEND matches ${i})
    endif()
  endforeach()
  set(leaves "")
  foreach(i IN LISTS matches)
    set(is_target FALSE)
    foreach(j IN LISTS matches)
      if(R${j}_ref EQUAL i)
        set(is_target TRUE)
      endif()
    endforeach()
    if(NOT is_target)
      list(APPEND leaves ${i})
    endif()
  endforeach()
  list(LENGTH leaves nl)
  if(nl EQUAL 0 OR nl GREATER 2)
    st_fail("decle ${d} has ${nl} leaf rows")
  endif()
  list(GET leaves 0 a)
  set(b 255)
  set(words ${R${a}_words})
  set(base ${R${a}_base})
  set(sdbd ${R${a}_sdbd})
  set(pc_ok 1)
  set(smask 0)
  foreach(i IN LISTS leaves)
    if(NOT R${i}_words EQUAL words)
      st_fail("decle ${d}: leaves disagree on words")
    endif()
    if(NOT R${i}_base EQUAL base)
      set(base 0)
    endif()
    if(R${i}_sdbd EQUAL 0)
      set(sdbd 0)
    endif()
    math(EXPR nval "(${d} >> ${R${i}_nbit}) & 1")
    if(nval EQUAL 1)
      math(EXPR smask "${smask} | ${R${i}_m1}")
    else()
      math(EXPR smask "${smask} | ${R${i}_m0}")
    endif()
    math(EXPR dst "${d} & 7")
    if(R${i}_nopc EQUAL 1 OR (R${i}_dddtail EQUAL 1 AND dst EQUAL 7))
      set(pc_ok 0)
    endif()
  endforeach()
  if(nl EQUAL 2)
    list(GET leaves 1 b)
  endif()
  string(APPEND out_tab "  {{${a}u, ${b}u}, ${words}u, ${base}u, ${smask}u, ${pc_ok}u, ${sdbd}u},\n")
endforeach()

set(out_c "/* Generated by cmake/IvsSweepTable.cmake from ${REL}; do not edit. */\n")
string(APPEND out_c "#define IVS_SWEEP_ROWS ${NROWS}u\n")
string(APPEND out_c "static const char *const ivs_sweep_row_id[${NROWS}] = {\n")
foreach(id IN LISTS IDS)
  string(APPEND out_c "  \"${id}\",\n")
endforeach()
string(APPEND out_c "};\n")
string(APPEND out_c "static const ivs_sweep_decle ivs_sweep_table[1024] = {\n${out_tab}};\n")
string(APPEND out_c "static const ivs_test_source ivs_sweep_sources[] = {\n  {\"${REL}\", \"${DIGEST}\"},\n};\n")
file(WRITE "${OUT}" "${out_c}")
