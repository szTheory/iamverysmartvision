# SPDX-License-Identifier: MIT
# Proof that the core's PSG parameters do not depend on the DAC table (AUD-01, D-11, D-12, plan 05-07): copies every
# data/profiles/*.json into a scratch tree with every entry of psg.dac.levels changed, runs the core's parameter
# generator (cmake/IvsPsgTable.cmake) on the real tree and on the scratch tree, and writes ivs_psg_dac_independence.inc
# to OUT with ivs_dac_independent = 1 when the two generated parameter includes are byte-identical (0 otherwise; the
# test psg.profile.dac-levels-not-read-by-core fails on 0). Two profiles that differ only in the DAC table therefore
# give the core the same parameters, so byte-identical samples and digests.
# Usage: cmake -DROOT=<repo> -DOUT=<file> -P cmake/IvsPsgDacIndependence.cmake
# Build output only (the scratch tree lives beside OUT). Fail closed on a profile without the field (the probe's rule).
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsPsgDacIndependence: missing -D${required}")
  endif()
endforeach()

get_filename_component(di_dir "${OUT}" DIRECTORY)
set(di_scratch "${di_dir}/dac-independence-root")
file(REMOVE_RECURSE "${di_scratch}")
file(MAKE_DIRECTORY "${di_scratch}/data/profiles")

file(GLOB di_profiles RELATIVE "${ROOT}" "${ROOT}/data/profiles/*.json")
list(SORT di_profiles)
if(NOT di_profiles)
  message(FATAL_ERROR "IvsPsgDacIndependence: data/profiles: no profile file")
endif()
foreach(rel IN LISTS di_profiles)
  file(READ "${ROOT}/${rel}" doc)
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" fields psg.dac.levels value)
  if(NOT "${e}" STREQUAL "NOTFOUND" OR NOT t STREQUAL "ARRAY")
    message(FATAL_ERROR "IvsPsgDacIndependence: ${rel}: psg.dac.levels: value must be an array")
  endif()
  string(JSON n LENGTH "${doc}" fields psg.dac.levels value)
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last})
    math(EXPR changed "${i} * 7919 + 13")
    string(JSON doc SET "${doc}" fields psg.dac.levels value ${i} ${changed})
  endforeach()
  get_filename_component(base "${rel}" NAME)
  file(WRITE "${di_scratch}/data/profiles/${base}" "${doc}")
endforeach()

set(di_real "${di_dir}/dac-independence-real.inc")
set(di_pert "${di_dir}/dac-independence-perturbed.inc")
set(di_gen "${CMAKE_CURRENT_LIST_DIR}/IvsPsgTable.cmake")
foreach(variant real pert)
  if(variant STREQUAL "real")
    set(root "${ROOT}")
  else()
    set(root "${di_scratch}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${root}" "-DOUT=${di_${variant}}" -P "${di_gen}"
    RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_QUIET)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "IvsPsgDacIndependence: the parameter generator failed on the ${variant} tree: ${err}")
  endif()
endforeach()
file(SHA256 "${di_real}" h_real)
file(SHA256 "${di_pert}" h_pert)
set(same 0)
if(h_real STREQUAL h_pert)
  set(same 1)
endif()
file(REMOVE_RECURSE "${di_scratch}")
file(REMOVE "${di_real}" "${di_pert}")
file(WRITE "${OUT}" "/* Generated by cmake/IvsPsgDacIndependence.cmake; do not edit. 1: the core's generated PSG parameters are\n * byte-identical for two profiles that differ only in psg.dac.levels. */\nstatic const int ivs_dac_independent = ${same};\n")
