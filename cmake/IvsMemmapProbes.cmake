# SPDX-License-Identifier: MIT
# Literal memory-map probe table generator (D-21, D-22, plan 03-06): reads only the sourced
# literal maps data/memmap/*.literal.txt (never data/profiles/) and writes ivs_memmap_probes.inc
# to OUT (build tree only, never committed) for suite memmap (tests/memmap/memmap_rows.c).
# Usage: cmake -DROOT=<repo> -DOUT=<build>/tests/ivs_memmap_probes.inc -P cmake/IvsMemmapProbes.cmake
# Output, per literal row (rows of each file sorted R before W, then by LO): profile id (the file
# stem), view, LO, HI, width, mirror (0 for -), device, impl, gate and the structural projection
# line `<view> <LO>-<HI> <device> w=<n> impl=<x> mirror=<m|-> gate=<g|->` (the first seven
# columns of the row). The SHA256 of every literal file is embedded as ivs_mp_sources[] and
# re-checked by the tests-inventory step. The test derives probe addresses, read-side addresses
# and expected projections from this table only; expected values come from its own rule table.
# Fail closed (message `IvsMemmapProbes: <file>[:<line>]: <reason>`): no literal file; a row that
# does not match the grammar of the literal header; LO above HI; a device outside the literal
# vocabulary; a width above 16; a mirror that is not a power of two; a view that does not tile
# 0000-FFFF exactly once.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsMemmapProbes: missing -D${required}")
  endif()
endforeach()

set(MP_DEVICES stic scratchpad psg sysram exec grom gram cart undriven)
set(MP_GATES - stic-regs gmem)
set(MP_HEX "[0-9A-F][0-9A-F][0-9A-F][0-9A-F]")
set(MP_ROW_RE "^([RW]) (${MP_HEX})-(${MP_HEX}) ([a-z]+) w=([0-9]+) impl=(real|stub|none) mirror=(-|[1-9][0-9]*) gate=([a-z-]+) src=[^ ]+ tag=[^ ]+( conf=C[0-9]+)?$")

function(mp_fail where msg)
  message(FATAL_ERROR "IvsMemmapProbes: ${where}: ${msg}")
endfunction()

file(GLOB mp_files LIST_DIRECTORIES false "${ROOT}/data/memmap/*.literal.txt")
list(SORT mp_files)
if(NOT mp_files)
  mp_fail("data/memmap" "no *.literal.txt file")
endif()

set(rows_c "")
set(sources_c "")
set(n_rows 0)
set(n_files 0)
foreach(path IN LISTS mp_files)
  file(RELATIVE_PATH rel "${ROOT}" "${path}")
  get_filename_component(base "${path}" NAME)
  string(REGEX REPLACE "[.]literal[.]txt$" "" pid "${base}")
  if(NOT pid MATCHES "^[a-z0-9][a-z0-9-]*$")
    mp_fail("${rel}" "profile id '${pid}' is not lowercase letters, digits and dashes")
  endif()
  file(SHA256 "${path}" digest)
  string(APPEND sources_c "  {\"${rel}\", \"${digest}\"},\n")
  math(EXPR n_files "${n_files} + 1")

  file(STRINGS "${path}" lines)
  set(entries "")
  set(lineno 0)
  foreach(l IN LISTS lines)
    math(EXPR lineno "${lineno} + 1")
    if(l STREQUAL "" OR l MATCHES "^#")
      continue()
    endif()
    if(NOT l MATCHES "${MP_ROW_RE}")
      mp_fail("${rel}:${lineno}" "row does not match the literal grammar")
    endif()
    set(view "${CMAKE_MATCH_1}")
    set(lo_h "${CMAKE_MATCH_2}")
    set(hi_h "${CMAKE_MATCH_3}")
    set(dev "${CMAKE_MATCH_4}")
    set(w "${CMAKE_MATCH_5}")
    set(impl "${CMAKE_MATCH_6}")
    set(mirror "${CMAKE_MATCH_7}")
    set(gate "${CMAKE_MATCH_8}")
    math(EXPR lo "0x${lo_h}")
    math(EXPR hi "0x${hi_h}")
    if(lo GREATER hi)
      mp_fail("${rel}:${lineno}" "LO above HI")
    endif()
    if(NOT dev IN_LIST MP_DEVICES)
      mp_fail("${rel}:${lineno}" "device '${dev}'")
    endif()
    if(NOT gate IN_LIST MP_GATES)
      mp_fail("${rel}:${lineno}" "gate '${gate}'")
    endif()
    if(w GREATER 16)
      mp_fail("${rel}:${lineno}" "width ${w} above 16")
    endif()
    set(mval 0)
    if(NOT mirror STREQUAL "-")
      math(EXPR p2 "${mirror} & (${mirror} - 1)")
      if(NOT p2 EQUAL 0 OR mirror GREATER 65536)
        mp_fail("${rel}:${lineno}" "mirror ${mirror} is not a power of two up to 65536")
      endif()
      set(mval ${mirror})
    endif()
    set(proj "${view} ${lo_h}-${hi_h} ${dev} w=${w} impl=${impl} mirror=${mirror} gate=${gate}")
    # Sort key: view then LO (four uppercase hex digits sort numerically).
    list(APPEND entries "${view}${lo_h}|${hi_h}|${dev}|${w}|${impl}|${mval}|${gate}|${proj}")
  endforeach()
  list(SORT entries)

  # Tiling per view, then the C records.
  foreach(v R W)
    set(next 0)
    foreach(e IN LISTS entries)
      if(NOT e MATCHES "^${v}")
        continue()
      endif()
      string(REPLACE "|" ";" f "${e}")
      list(GET f 0 key)
      string(SUBSTRING "${key}" 1 4 lo_h)
      list(GET f 1 hi_h)
      math(EXPR lo "0x${lo_h}")
      math(EXPR hi "0x${hi_h}")
      if(NOT lo EQUAL next)
        mp_fail("${rel}" "view ${v} does not tile 0000-FFFF at ${lo_h}")
      endif()
      math(EXPR next "${hi} + 1")
      list(GET f 2 dev)
      list(GET f 3 w)
      list(GET f 4 impl)
      list(GET f 5 mval)
      list(GET f 6 gate)
      list(GET f 7 proj)
      string(APPEND rows_c "  {\"${pid}\", '${v}', 0x${lo_h}u, 0x${hi_h}u, ${w}u, ${mval}u, \"${dev}\", \"${impl}\", \"${gate}\",\n")
      string(APPEND rows_c "   \"${proj}\"},\n")
      math(EXPR n_rows "${n_rows} + 1")
    endforeach()
    if(NOT next EQUAL 65536)
      mp_fail("${rel}" "view ${v} does not tile 0000-FFFF")
    endif()
  endforeach()
endforeach()

set(out_c "/* Generated by cmake/IvsMemmapProbes.cmake from the literal maps in data/memmap; do not edit. */\n")
string(APPEND out_c "#define IVS_MP_ROWS ${n_rows}u\n")
string(APPEND out_c "#define IVS_MP_SOURCES ${n_files}u\n")
string(APPEND out_c "static const ivs_mp_row ivs_mp_rows[IVS_MP_ROWS] = {\n${rows_c}};\n")
string(APPEND out_c "static const ivs_test_source ivs_mp_sources[IVS_MP_SOURCES] = {\n${sources_c}};\n")
file(WRITE "${OUT}" "${out_c}")
