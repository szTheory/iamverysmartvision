# SPDX-License-Identifier: MIT
# PSG vector table generator (AUD-01, D-07, D-10, D-23, plan 05-04): reads ONE vector family file of
# data/psg/vectors and the register-address literal data/psg/<profile>.regmap.literal.txt, and
# writes a C include for suite psg (tests/psg/psg_reg.c) to OUT (build tree only, never committed).
# It never reads the profile, the core headers, a generated table or a core output: the expected
# values of the suite come from these two sourced text files only.
# Usage: cmake -DROOT=<repo> -DOUT=<file> -DFAMILY=<reg|reset|port|tone|mix|amp> -P cmake/IvsPsgVectors.cmake
#   FAMILY  reg     data/psg/vectors/regs.txt   ids psg.reg.*
#           reset   data/psg/vectors/reset.txt  ids psg.reset.*
#           port    data/psg/vectors/port.txt   ids psg.port.*  (plan 05-05: the optional vector key
#                   pin=<port>:<HH>, the driven-low mask of controller port 0 or 1 applied before the reads;
#                   the reads of $01FE and $01FF follow the pins and the direction bits)
#           tone    data/psg/vectors/tone.txt   ids psg.tone.*  (plan 05-06: engine family, expect kinds
#           mix     data/psg/vectors/mix.txt    ids psg.mix.*    edge-spacing, toggles, level-seq (tone), gate (mix)
#           amp     data/psg/vectors/amp.txt    ids psg.amp.*    and index (amp); writes may carry @<step>; no read)
# The engine families (tone, mix, amp) emit ivs_pe rows (tests/psg/psg_cases.h) instead of ivs_pv rows.
# Later plans extend the family list (noise, env, dac, ampenv, reseng).
#
# Line grammar (the closed grammar of the vector file headers and of the psg-vectors step):
#   V <id> rule=<PSG-Rnn> kind=<source|policy> tier=<tier> cite=<cite> set=<AAAA:HHHH[@<step>][+...]|->
#     [pin=<port>:<HH>] steps=<n> expect=<kind:values> derive=<words>
# Evaluated here: expect kind `read` only (read:AAAA=HHHH[,AAAA=HHHH]*: the register store of each
# address in order, upper byte 0; family port: the value a bus read returns), a pin only in family
# port and writes at step 0; a family that needs more is wired by the plan that adds its engine, and
# this build stops on it rather than skip it.
#
# Output (family name F): ivs_pv_F[IVS_PV_F_COUNT] of ivs_pv (tests/psg/psg_cases.h), each with its
# write and read arrays; ivs_pv_sources_F[] (the vector file and the literal with their SHA-256, for
# the `# source` header lines); for family reg also the 16 rows of the literal, ivs_pv_literal[16].
#
# Engine families (plan 05-06) fail closed on: an expect kind other than the family's, a malformed expect value, a
# toggle window or sequence longer than steps, a level above 255 (envelope or output above 15), a write step after
# the last step, an edge spacing of 0.
#
# Fail closed (message `IvsPsgVectors: <file>[:<line>]: <reason>`): an unknown family; a missing
# file; a line that is not blank, a comment or a vector line of the grammar; a repeated or
# out-of-family id; a rule, kind, tier, cite, set, steps or expect that does not match its shape; a
# pin outside family port, or one that is not <0|1>:<HH>; an expect kind other than read; a write or read address that is not an address of the literal;
# a write at a step above 0; a read value above $00FF; a literal that does not have 16 rows
# $01F0..$01FF in order, or whose mask is above $00FF.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT OUT FAMILY)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsPsgVectors: missing -D${required}")
  endif()
endforeach()

set(PV_FAMILY_reg_file "data/psg/vectors/regs.txt")
set(PV_FAMILY_reg_prefix "psg.reg.")
set(PV_FAMILY_reset_file "data/psg/vectors/reset.txt")
set(PV_FAMILY_reset_prefix "psg.reset.")
set(PV_FAMILY_port_file "data/psg/vectors/port.txt")
set(PV_FAMILY_port_prefix "psg.port.")
set(PV_FAMILY_tone_file "data/psg/vectors/tone.txt")
set(PV_FAMILY_tone_prefix "psg.tone.")
set(PV_FAMILY_mix_file "data/psg/vectors/mix.txt")
set(PV_FAMILY_mix_prefix "psg.mix.")
set(PV_FAMILY_amp_file "data/psg/vectors/amp.txt")
set(PV_FAMILY_amp_prefix "psg.amp.")
if(NOT FAMILY MATCHES "^(reg|reset|port|tone|mix|amp)$")
  message(FATAL_ERROR "IvsPsgVectors: family '${FAMILY}' is not wired (reg, reset, port, tone, mix, amp)")
endif()
set(PV_ENGINE 0)
if(FAMILY MATCHES "^(tone|mix|amp)$")
  set(PV_ENGINE 1)
endif()
set(PV_KINDS_tone "edge-spacing;toggles;level-seq")
set(PV_KINDS_mix "gate")
set(PV_KINDS_amp "index")
set(PV_REL "${PV_FAMILY_${FAMILY}_file}")
set(PV_PREFIX "${PV_FAMILY_${FAMILY}_prefix}")
set(PV_LIT_REL "data/psg/intv-2609-ntsc-family-p1.regmap.literal.txt")

set(PV_CTX "${PV_REL}")
function(pv_fail msg)
  message(FATAL_ERROR "IvsPsgVectors: ${PV_CTX}: ${msg}")
endfunction()

# Lines of a file: ';', '[' and ']' protected so list splitting keeps each line whole.
function(pv_lines out path)
  file(READ "${path}" txt)
  string(REPLACE ";" "<SC>" txt "${txt}")
  string(REPLACE "[" "<LB>" txt "${txt}")
  string(REPLACE "]" "<RB>" txt "${txt}")
  string(REPLACE "\n" ";" txt "${txt}")
  set(${out} "${txt}" PARENT_SCOPE)
endfunction()

function(pv_unprotect out text)
  string(REPLACE "<SC>" ";" text "${text}")
  string(REPLACE "<LB>" "[" text "${text}")
  string(REPLACE "<RB>" "]" text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(pv_lit out v)
  math(EXPR h "${v}" OUTPUT_FORMAT HEXADECIMAL)
  string(SUBSTRING "${h}" 2 -1 h)
  string(TOUPPER "${h}" h)
  string(LENGTH "${h}" n)
  while(n LESS 4)
    set(h "0${h}")
    math(EXPR n "${n} + 1")
  endwhile()
  set(${out} "0x${h}u" PARENT_SCOPE)
endfunction()

foreach(rel "${PV_REL}" "${PV_LIT_REL}")
  if(NOT EXISTS "${ROOT}/${rel}")
    set(PV_CTX "${rel}")
    pv_fail("file missing")
  endif()
endforeach()

set(H4 "[0-9A-F][0-9A-F][0-9A-F][0-9A-F]")

# ---- the register-address literal: sixteen rows in ascending order ----
set(PV_CTX "${PV_LIT_REL}")
pv_lines(llines "${ROOT}/${PV_LIT_REL}")
set(lit_addrs "")
set(lit_c "")
set(lineno 0)
foreach(l IN LISTS llines)
  math(EXPR lineno "${lineno} + 1")
  pv_unprotect(l "${l}")
  if(l STREQUAL "" OR l MATCHES "^#")
    continue()
  endif()
  set(PV_CTX "${PV_LIT_REL}:${lineno}")
  if(NOT l MATCHES "^(${H4}) role=[a-z-]+ gi=R[0-7]+ n=[0-9]+ w=(${H4}) r=(${H4}) src=SRC-[a-z0-9-]+@[A-Za-z0-9._,-]+ tag=[a-z0-9-]+ conf=C[0-9]+$")
    pv_fail("row does not match the register-address literal grammar")
  endif()
  set(a "${CMAKE_MATCH_1}")
  set(w "${CMAKE_MATCH_2}")
  set(r "${CMAKE_MATCH_3}")
  list(LENGTH lit_addrs k)
  math(EXPR want "0x01F0 + ${k}")
  math(EXPR av "0x${a}")
  math(EXPR wv "0x${w}")
  math(EXPR rv "0x${r}")
  if(NOT av EQUAL want)
    pv_fail("address ${a} is not the next address of $01F0..$01FF in order")
  endif()
  if(wv GREATER 255 OR rv GREATER 255)
    pv_fail("a mask is above $00FF")
  endif()
  list(APPEND lit_addrs "${a}")
  pv_lit(al "${av}")
  pv_lit(wl "${wv}")
  pv_lit(rl "${rv}")
  string(APPEND lit_c "  {${al}, ${wl}, ${rl}},\n")
endforeach()
list(LENGTH lit_addrs n_lit)
if(NOT n_lit EQUAL 16)
  set(PV_CTX "${PV_LIT_REL}")
  pv_fail("has ${n_lit} rows, want 16")
endif()

# ---- the vector family ----
pv_lines(vlines "${ROOT}/${PV_REL}")
set(ids_seen "")
set(n_vec 0)
set(decl_c "")
set(table_c "")
set(lineno 0)
foreach(l IN LISTS vlines)
  math(EXPR lineno "${lineno} + 1")
  pv_unprotect(l "${l}")
  if(l STREQUAL "" OR l MATCHES "^#")
    continue()
  endif()
  set(PV_CTX "${PV_REL}:${lineno}")
  # CMake keeps nine match groups (CMAKE_MATCH_1..9): the expect value is matched on its own.
  if(NOT l MATCHES "^V ([A-Za-z0-9.-]+) rule=(PSG-R[0-9][0-9]) kind=(source|policy) tier=([A-Za-z0-9-]+) cite=([A-Za-z0-9@._,-]+) set=([-0-9A-F:@+]+)( pin=[^ ]*)? steps=([0-9]+) expect=[^ ]+ derive=.+$")
    pv_fail("not a vector line of the grammar")
  endif()
  set(id "${CMAKE_MATCH_1}")
  set(rule "${CMAKE_MATCH_2}")
  set(kind "${CMAKE_MATCH_3}")
  set(setv "${CMAKE_MATCH_6}")
  set(pinv "${CMAKE_MATCH_7}")
  set(steps "${CMAKE_MATCH_8}")
  if(NOT l MATCHES " expect=([a-z0-9-]+):([^ ]+) derive=")
    pv_fail("${id}: expect is not <kind>:<values>")
  endif()
  set(ekind "${CMAKE_MATCH_1}")
  set(evals "${CMAKE_MATCH_2}")
  string(FIND "${id}" "${PV_PREFIX}" at)
  if(NOT at EQUAL 0)
    pv_fail("id ${id} does not start with ${PV_PREFIX}")
  endif()
  if(id IN_LIST ids_seen)
    pv_fail("id ${id} is used twice")
  endif()
  list(APPEND ids_seen "${id}")
  set(pin_port -1)
  set(pin_mask 0)
  if(NOT "${pinv}" STREQUAL "")
    if(NOT FAMILY STREQUAL "port")
      pv_fail("${id}: a pin is not evaluated by family ${FAMILY}")
    endif()
    if(NOT pinv MATCHES "^ pin=([01]):([0-9A-F][0-9A-F])$")
      pv_fail("${id}: pin '${pinv}' is not pin=<0|1>:<HH>")
    endif()
    set(pin_port "${CMAKE_MATCH_1}")
    math(EXPR pin_mask "0x${CMAKE_MATCH_2}")
  endif()
  set(e_kind_c "0u")
  set(e_chan 0)
  set(e_n 0)
  set(e_window 0)
  set(e_a 0)
  set(e_b 0)
  set(e_c 0)
  set(e_seq "")
  if(PV_ENGINE)
    if(NOT ekind IN_LIST PV_KINDS_${FAMILY})
      pv_fail("${id}: expect kind '${ekind}' is not evaluated by family ${FAMILY} (${PV_KINDS_${FAMILY}})")
    endif()
    if(ekind STREQUAL "edge-spacing")
      if(NOT evals MATCHES "^([ABC])=([0-9]+)$")
        pv_fail("${id}: edge-spacing is not <C>=<n>")
      endif()
      set(e_kind_c "IVS_PE_EDGE_SPACING")
      set(e_chan_l "${CMAKE_MATCH_1}")
      set(e_n "${CMAKE_MATCH_2}")
      if(e_n EQUAL 0)
        pv_fail("${id}: edge-spacing n is 0")
      endif()
    elseif(ekind STREQUAL "toggles")
      if(NOT evals MATCHES "^([ABC])/([0-9]+)=([0-9]+)$")
        pv_fail("${id}: toggles is not <C>/<W>=<n>")
      endif()
      set(e_kind_c "IVS_PE_TOGGLES")
      set(e_chan_l "${CMAKE_MATCH_1}")
      set(e_window "${CMAKE_MATCH_2}")
      set(e_n "${CMAKE_MATCH_3}")
      if(e_window GREATER steps)
        pv_fail("${id}: toggles window ${e_window} is above steps ${steps}")
      endif()
    elseif(ekind STREQUAL "level-seq")
      if(NOT evals MATCHES "^([ABC])=([0-9]+(,[0-9]+)*)$")
        pv_fail("${id}: level-seq is not <C>=<l>,<l>,...")
      endif()
      set(e_kind_c "IVS_PE_LEVEL_SEQ")
      set(e_chan_l "${CMAKE_MATCH_1}")
      string(REPLACE "," ";" e_seq "${CMAKE_MATCH_2}")
      list(LENGTH e_seq e_nseq)
      if(e_nseq GREATER steps)
        pv_fail("${id}: level-seq has ${e_nseq} entries, above steps ${steps}")
      endif()
      foreach(lv IN LISTS e_seq)
        if(lv GREATER 255)
          pv_fail("${id}: level ${lv} is above 255")
        endif()
      endforeach()
    elseif(ekind STREQUAL "gate")
      if(NOT evals MATCHES "^r7=([0-9A-F][0-9A-F]),tone=([01]),noise=([01]),ch=([ABC]),out=([01])$")
        pv_fail("${id}: gate is not r7=HH,tone=b,noise=b,ch=C,out=b")
      endif()
      set(e_kind_c "IVS_PE_GATE")
      math(EXPR e_a "0x${CMAKE_MATCH_1}")
      set(e_b "${CMAKE_MATCH_2}")
      set(e_c "${CMAKE_MATCH_3}")
      set(e_chan_l "${CMAKE_MATCH_4}")
      set(e_n "${CMAKE_MATCH_5}")
    elseif(ekind STREQUAL "index")
      if(NOT evals MATCHES "^amp=([0-9A-F][0-9A-F]),env=([0-9]+),out=([0-9]+)$")
        pv_fail("${id}: index is not amp=HH,env=n,out=n")
      endif()
      set(e_kind_c "IVS_PE_INDEX")
      math(EXPR e_a "0x${CMAKE_MATCH_1}")
      set(e_b "${CMAKE_MATCH_2}")
      set(e_n "${CMAKE_MATCH_3}")
      set(e_chan_l "A")
      if(e_b GREATER 15 OR e_n GREATER 15)
        pv_fail("${id}: an envelope or output level is above 15")
      endif()
    endif()
    if(e_chan_l STREQUAL "A")
      set(e_chan 0)
    elseif(e_chan_l STREQUAL "B")
      set(e_chan 1)
    else()
      set(e_chan 2)
    endif()
  elseif(NOT ekind STREQUAL "read")
    pv_fail("${id}: expect kind '${ekind}' is not evaluated by this build (read only)")
  endif()
  # writes
  set(w_c "")
  set(n_w 0)
  if(NOT setv STREQUAL "-")
    string(REPLACE "+" ";" parts "${setv}")
    foreach(part IN LISTS parts)
      if(NOT part MATCHES "^(${H4}):(${H4})(@([0-9]+))?$")
        pv_fail("${id}: set entry '${part}' is not AAAA:HHHH[@step]")
      endif()
      set(wa "${CMAKE_MATCH_1}")
      set(wv "${CMAKE_MATCH_2}")
      set(wstep "${CMAKE_MATCH_4}")
      if(NOT wa IN_LIST lit_addrs)
        pv_fail("${id}: write address ${wa} is not an address of the register-address literal")
      endif()
      if("${wstep}" STREQUAL "")
        set(wstep 0)
      endif()
      if(wstep GREATER 0 AND NOT PV_ENGINE)
        pv_fail("${id}: a write at step ${wstep} needs the engine, which family ${FAMILY} does not have")
      endif()
      if(wstep GREATER steps)
        pv_fail("${id}: a write at step ${wstep} is after the last step ${steps}")
      endif()
      math(EXPR wav "0x${wa}")
      math(EXPR wvv "0x${wv}")
      pv_lit(wal "${wav}")
      pv_lit(wvl "${wvv}")
      string(APPEND w_c "  {${wal}, ${wvl}, ${wstep}u},\n")
      math(EXPR n_w "${n_w} + 1")
    endforeach()
  endif()
  # reads (the engine families have none)
  set(r_c "")
  set(n_r 0)
  if(NOT PV_ENGINE)
    string(REPLACE "," ";" parts "${evals}")
    foreach(part IN LISTS parts)
      if(NOT part MATCHES "^(${H4})=(${H4})$")
        pv_fail("${id}: read entry '${part}' is not AAAA=HHHH")
      endif()
      set(ra "${CMAKE_MATCH_1}")
      set(rvh "${CMAKE_MATCH_2}")
      if(NOT ra IN_LIST lit_addrs)
        pv_fail("${id}: read address ${ra} is not an address of the register-address literal")
      endif()
      math(EXPR rav "0x${ra}")
      math(EXPR rvv "0x${rvh}")
      if(rvv GREATER 255)
        pv_fail("${id}: read value ${rvh} is above $00FF (the upper byte of a register read is 0)")
      endif()
      pv_lit(ral "${rav}")
      pv_lit(rvl "${rvv}")
      string(APPEND r_c "  {${ral}, ${rvl}},\n")
      math(EXPR n_r "${n_r} + 1")
    endforeach()
    if(n_r EQUAL 0)
      pv_fail("${id}: no read expectation")
    endif()
  endif()
  set(wref "NULL")
  if(n_w GREATER 0)
    string(APPEND decl_c "static const ivs_pv_write ivs_pv_${FAMILY}_w${n_vec}[] = {\n${w_c}};\n")
    set(wref "ivs_pv_${FAMILY}_w${n_vec}")
  endif()
  set(src_flag 0)
  if(kind STREQUAL "source")
    set(src_flag 1)
  endif()
  if(PV_ENGINE)
    set(sref "NULL")
    set(n_seq 0)
    if(NOT "${e_seq}" STREQUAL "")
      list(LENGTH e_seq n_seq)
      string(REPLACE ";" "u, " seq_c "${e_seq}")
      string(APPEND decl_c "static const uint8_t ivs_pe_${FAMILY}_s${n_vec}[] = {${seq_c}u};\n")
      set(sref "ivs_pe_${FAMILY}_s${n_vec}")
    endif()
    string(APPEND table_c "  {\"${id}\", \"${rule}\", ${src_flag}u, ${wref}, ${n_w}u, ${steps}u, ${e_kind_c}, ${e_chan}u, ${e_n}u, ${e_window}u, ${e_a}u, ${e_b}u, ${e_c}u, ${sref}, ${n_seq}u},\n")
  else()
    set(rref "NULL")
    if(n_r GREATER 0)
      string(APPEND decl_c "static const ivs_pv_read ivs_pv_${FAMILY}_r${n_vec}[] = {\n${r_c}};\n")
      set(rref "ivs_pv_${FAMILY}_r${n_vec}")
    endif()
    string(APPEND table_c "  {\"${id}\", \"${rule}\", ${src_flag}u, ${wref}, ${n_w}u, ${rref}, ${n_r}u, ${steps}u, ${pin_port}, ${pin_mask}u},\n")
  endif()
  math(EXPR n_vec "${n_vec} + 1")
endforeach()
if(n_vec EQUAL 0)
  set(PV_CTX "${PV_REL}")
  pv_fail("holds no vector")
endif()

file(SHA256 "${ROOT}/${PV_REL}" vec_digest)
file(SHA256 "${ROOT}/${PV_LIT_REL}" lit_digest)

set(out_c "/* Generated by cmake/IvsPsgVectors.cmake from ${PV_REL} and ${PV_LIT_REL}; do not edit. */\n")
string(APPEND out_c "#define IVS_PV_${FAMILY}_COUNT ${n_vec}u\n")
string(APPEND out_c "${decl_c}")
if(PV_ENGINE)
  string(APPEND out_c "static const ivs_pe ivs_pe_${FAMILY}[IVS_PV_${FAMILY}_COUNT] = {\n${table_c}};\n")
else()
  string(APPEND out_c "static const ivs_pv ivs_pv_${FAMILY}[IVS_PV_${FAMILY}_COUNT] = {\n${table_c}};\n")
endif()
string(APPEND out_c "static const ivs_test_source ivs_pv_sources_${FAMILY}[2] = {\n  {\"${PV_REL}\", \"${vec_digest}\"},\n  {\"${PV_LIT_REL}\", \"${lit_digest}\"},\n};\n")
if(FAMILY STREQUAL "reg")
  string(APPEND out_c "static const ivs_pv_lit ivs_pv_literal[16] = {\n${lit_c}};\n")
endif()
file(WRITE "${OUT}" "${out_c}")
