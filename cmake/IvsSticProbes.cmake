# SPDX-License-Identifier: MIT
# STIC literal probe generator (plan 06-06, D-02, D-04; test side). Reads ONLY the independent literals, never data/profiles/,
# core headers or core output: the register-address literal data/stic/<id>.regmap.literal.txt (sixty-four rows), the rows of
# devices psg, stic, grom and gram of the memory-map literal data/memmap/<id>.literal.txt (device, gate, address range per
# view), and the geometry literal rows backtab-base and backtab-words of data/video/geometry.literal.txt. Writes ivs_stic_probe.inc
# to OUT (build tree only, never committed) for suite stic (tests/stic/stic_reg.c, stic_hook.c, stic_profile.c).
# Usage: cmake -DROOT=<repo> -DOUT=<build>/tests/ivs_stic_probe.inc -P cmake/IvsSticProbes.cmake
# Output:
#   stic_lit_reg[64]        (a stic_lit_reg_row declared by the includer) {addr, class, wmask, rmask}; class 0 stored, 1 strobe, 2 collision, 3 reserved (the literal's names)
#   stic_lit_hook_rd[4096], stic_lit_hook_wr[4096]  the expected hook class of every 16-word granule per view: 1 for a psg row,
#                           2 for a stic row behind gate stic-regs, 3 for a grom or gram row behind gate gmem, 4 for the BACKTAB
#                           span (both views), 5 (read view only) for the granule of every mode-select address (the base of
#                           each write-view stic block plus the address of the mode-select row of the register literal) that the
#                           read-view rows do not give to device stic
#   stic_lit_mode_addr[], STIC_LIT_MODE_ADDRS   those mode-select addresses
#   stic_lit_sources[]      the three files with their SHA256, for the TAP header
# Fail closed (message `IvsSticProbes: <file>[:<line>]: <reason>`): a missing file, a row outside the grammar, a register row
# missing or repeated, a view that does not tile, a missing geometry row.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsSticProbes: missing -D${required}")
  endif()
endforeach()

function(sp_fail where msg)
  message(FATAL_ERROR "IvsSticProbes: ${where}: ${msg}")
endfunction()

file(GLOB sp_regfiles LIST_DIRECTORIES false "${ROOT}/data/stic/*.regmap.literal.txt")
list(SORT sp_regfiles)
list(LENGTH sp_regfiles sp_n)
if(sp_n EQUAL 0)
  sp_fail("data/stic" "no *.regmap.literal.txt file")
endif()
list(GET sp_regfiles 0 regfile)
get_filename_component(regbase "${regfile}" NAME)
string(REGEX REPLACE "[.]regmap[.]literal[.]txt$" "" pid "${regbase}")
set(memfile "${ROOT}/data/memmap/${pid}.literal.txt")
set(geofile "${ROOT}/data/video/geometry.literal.txt")
foreach(f "${memfile}" "${geofile}")
  if(NOT EXISTS "${f}")
    file(RELATIVE_PATH r "${ROOT}" "${f}")
    sp_fail("${r}" "missing")
  endif()
endforeach()

set(sources_c "")
foreach(f "${regfile}" "${memfile}" "${geofile}")
  file(RELATIVE_PATH r "${ROOT}" "${f}")
  file(SHA256 "${f}" d)
  string(APPEND sources_c "  {\"${r}\", \"${d}\"},\n")
endforeach()

# ---- the register rows ----
set(HEX "[0-9A-F][0-9A-F][0-9A-F][0-9A-F]")
file(STRINGS "${regfile}" reglines)
set(reg_c "")
set(seen "")
set(mode_reg -1)
set(lineno 0)
foreach(l IN LISTS reglines)
  math(EXPR lineno "${lineno} + 1")
  if(l STREQUAL "" OR l MATCHES "^#")
    continue()
  endif()
  if(NOT l MATCHES "^(${HEX}) role=([a-z0-9-]+) class=(stored|strobe|collision|reserved) w=(${HEX}) r=(${HEX}) ")
    sp_fail("${regbase}:${lineno}" "row does not match the register literal grammar")
  endif()
  set(a "${CMAKE_MATCH_1}")
  set(role "${CMAKE_MATCH_2}")
  set(cls "${CMAKE_MATCH_3}")
  set(w "${CMAKE_MATCH_4}")
  set(r "${CMAKE_MATCH_5}")
  math(EXPR av "0x${a}")
  if(av GREATER 63 OR av IN_LIST seen)
    sp_fail("${regbase}:${lineno}" "address ${a} is outside 0000..003F or repeated")
  endif()
  list(APPEND seen ${av})
  if(role STREQUAL "mode-select")
    set(mode_reg ${av})
  endif()
  set(ci 0)
  if(cls STREQUAL "strobe")
    set(ci 1)
  elseif(cls STREQUAL "collision")
    set(ci 2)
  elseif(cls STREQUAL "reserved")
    set(ci 3)
  endif()
  list(APPEND reg_rows "${a}|${ci}|${w}|${r}")
endforeach()
list(LENGTH seen n_seen)
if(NOT n_seen EQUAL 64 OR mode_reg LESS 0)
  sp_fail("${regbase}" "needs sixty-four rows and one mode-select row (found ${n_seen})")
endif()
list(SORT reg_rows)
foreach(e IN LISTS reg_rows)
  string(REPLACE "|" ";" f "${e}")
  list(GET f 0 a)
  list(GET f 1 ci)
  list(GET f 2 w)
  list(GET f 3 r)
  string(APPEND reg_c "  {0x${a}u, ${ci}u, 0x${w}u, 0x${r}u},\n")
endforeach()

# ---- the geometry rows ----
file(STRINGS "${geofile}" geolines)
set(bt_base "")
set(bt_words "")
foreach(l IN LISTS geolines)
  if(l MATCHES "^backtab-base (${HEX}) ")
    set(bt_base "${CMAKE_MATCH_1}")
  elseif(l MATCHES "^backtab-words ([0-9]+) ")
    set(bt_words "${CMAKE_MATCH_1}")
  endif()
endforeach()
if(bt_base STREQUAL "" OR bt_words STREQUAL "")
  sp_fail("geometry.literal.txt" "no backtab-base or backtab-words row")
endif()
math(EXPR bt_lo "0x${bt_base}")

# ---- the memory-map rows: granule classes per view ----
foreach(v rd wr)
  foreach(g RANGE 0 4095)
    set(cls_${v}_${g} 0)
  endforeach()
endforeach()
file(STRINGS "${memfile}" memlines)
set(stic_w_bases "")
set(stic_r_rows "")
set(lineno 0)
foreach(l IN LISTS memlines)
  math(EXPR lineno "${lineno} + 1")
  if(l STREQUAL "" OR l MATCHES "^#")
    continue()
  endif()
  if(NOT l MATCHES "^([RW]) (${HEX})-(${HEX}) ([a-z]+) w=([0-9]+) impl=[a-z]+ mirror=[-0-9]+ gate=([a-z-]+) ")
    sp_fail("${memfile}:${lineno}" "row does not match the memory-map literal grammar")
  endif()
  set(v "${CMAKE_MATCH_1}")
  math(EXPR lo "0x${CMAKE_MATCH_2}")
  math(EXPR hi "0x${CMAKE_MATCH_3}")
  set(dev "${CMAKE_MATCH_4}")
  set(gate "${CMAKE_MATCH_6}")
  set(hk 0)
  if(dev STREQUAL "psg")
    set(hk 1)
  elseif(dev STREQUAL "stic" AND gate STREQUAL "stic-regs")
    set(hk 2)
  elseif((dev STREQUAL "grom" OR dev STREQUAL "gram") AND gate STREQUAL "gmem")
    set(hk 3)
  endif()
  if(dev STREQUAL "stic")
    if(v STREQUAL "R")
      list(APPEND stic_r_rows "${lo}:${hi}")
    else()
      math(EXPR blk "${lo} & 0x3FFF")
      if(blk EQUAL 0)
        list(APPEND stic_w_bases "${lo}")
      endif()
    endif()
  endif()
  if(NOT hk EQUAL 0)
    math(EXPR glo "${lo} >> 4")
    math(EXPR ghi "${hi} >> 4")
    if(v STREQUAL "R")
      set(vv rd)
    else()
      set(vv wr)
    endif()
    foreach(g RANGE ${glo} ${ghi})
      # rows split by register width share a granule; a granule never holds two different classes
      if(NOT cls_${vv}_${g} EQUAL 0 AND NOT cls_${vv}_${g} EQUAL ${hk})
        sp_fail("${memfile}:${lineno}" "granule ${g} of the ${vv} view holds two hook classes")
      endif()
      set(cls_${vv}_${g} ${hk})
    endforeach()
  endif()
endforeach()
# BACKTAB: both views
math(EXPR bt_glo "${bt_lo} >> 4")
math(EXPR bt_ghi "(${bt_lo} + ${bt_words} - 1) >> 4")
foreach(g RANGE ${bt_glo} ${bt_ghi})
  set(cls_rd_${g} 4)
  set(cls_wr_${g} 4)
endforeach()
# the mode-select addresses: the base of every write-view stic block plus the mode-select register
set(mode_c "")
set(n_mode 0)
foreach(b IN LISTS stic_w_bases)
  math(EXPR m "${b} + ${mode_reg}")
  set(m_in_stic 0)
  foreach(rr IN LISTS stic_r_rows)
    string(REPLACE ":" ";" rp "${rr}")
    list(GET rp 0 rlo)
    list(GET rp 1 rhi)
    if(NOT m LESS rlo AND NOT m GREATER rhi)
      set(m_in_stic 1)
    endif()
  endforeach()
  if(m_in_stic EQUAL 0)
    math(EXPR g "${m} >> 4")
    set(cls_rd_${g} 5)
  endif()
  math(EXPR n_mode "${n_mode} + 1")
  string(APPEND mode_c "  ${m}u,\n")
endforeach()

foreach(v rd wr)
  set(tab "")
  foreach(g RANGE 0 4095)
    string(APPEND tab "${cls_${v}_${g}}u,")
    math(EXPR col "${g} % 32")
    if(col EQUAL 31)
      string(APPEND tab "\n")
    endif()
  endforeach()
  set(tab_${v} "${tab}")
endforeach()

set(out_c "/* Generated by cmake/IvsSticProbes.cmake from the independent STIC, memory-map and geometry literals; do not edit. */\n")
string(APPEND out_c "static const stic_lit_reg_row stic_lit_reg[64] = {\n${reg_c}};\n")
string(APPEND out_c "static const uint8_t stic_lit_hook_rd[4096] = {\n${tab_rd}};\n")
string(APPEND out_c "static const uint8_t stic_lit_hook_wr[4096] = {\n${tab_wr}};\n")
string(APPEND out_c "#define STIC_LIT_MODE_ADDRS ${n_mode}u\n")
string(APPEND out_c "static const uint16_t stic_lit_mode_addr[STIC_LIT_MODE_ADDRS] = {\n${mode_c}};\n")
string(APPEND out_c "#define STIC_LIT_SOURCES 3u\n")
string(APPEND out_c "static const ivs_test_source stic_lit_sources[STIC_LIT_SOURCES] = {\n${sources_c}};\n")
file(WRITE "${OUT}" "${out_c}")
