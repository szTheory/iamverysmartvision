# SPDX-License-Identifier: MIT
# Vector table generator (D-14): reads the JSON vector files listed in FILES and writes a C
# initializer table to OUT (build tree only, never committed). No C JSON parser exists.
# Usage: cmake -DROOT=<repo> -DFILES=<cp1610-vector-files.ids> -DSKIPS=<cp1610-skips.ids>
#              -DOUT=<build>/tests/ivs_vectors.inc -P cmake/IvsVectorTable.cmake
# Each vector is extracted once into its own string (fast path, D-14). init is merged with the
# expect delta here, so C compares full states. Vectors are emitted sorted by id; duplicates
# are kept so the harness can reject them before running. The SHA256 of each source file is
# embedded as ivs_vec_sources[] and re-checked by the tests-inventory step.
# Any unknown key, bad hex value or bad name stops the build (fail closed).
# Optional -DMUTATE=<vector id> (named-fault control GEN_EXPECT_MUTATION, D-18): adds 1 to that
# vector's merged expect.cycles, proving that expectations travel from JSON to the harness. The
# vector must exist and assert cycles; the mutated table is written only to a fault build dir.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT FILES SKIPS OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsVectorTable: missing -D${required}")
  endif()
endforeach()

set(VT_CTX "")
function(vt_fail msg)
  message(FATAL_ERROR "IvsVectorTable: ${VT_CTX}: ${msg}")
endfunction()

# JSON type of a path in a document, or MISSING.
function(vt_type out doc)
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" ${ARGN})
  if(NOT "${e}" STREQUAL "NOTFOUND")
    set(t MISSING)
  endif()
  set(${out} "${t}" PARENT_SCOPE)
endfunction()

# Every member key of an object must be in the allowed list.
function(vt_keys doc what)
  string(JSON n LENGTH "${doc}")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON k MEMBER "${doc}" ${i})
      if(NOT k IN_LIST ARGN)
        vt_fail("unknown ${what} key '${k}'")
      endif()
    endforeach()
  endif()
endfunction()

# Validated hex string (1 to 4 digits) -> C literal 0xNNNNu and its numeric value.
function(vt_hex out_lit out_num s what)
  if(NOT s MATCHES "^[0-9A-Fa-f][0-9A-Fa-f]?[0-9A-Fa-f]?[0-9A-Fa-f]?$")
    vt_fail("${what} '${s}' is not a hex word")
  endif()
  string(TOUPPER "${s}" s)
  math(EXPR v "0x${s}")
  set(${out_lit} "0x${s}u" PARENT_SCOPE)
  set(${out_num} "${v}" PARENT_SCOPE)
endfunction()

# Non-negative integer JSON number.
function(vt_uint out doc what)
  vt_type(t "${doc}" ${ARGN})
  if(NOT t STREQUAL "NUMBER")
    vt_fail("${what} must be a number")
  endif()
  string(JSON v GET "${doc}" ${ARGN})
  if(NOT v MATCHES "^[0-9]+$")
    vt_fail("${what} '${v}' is not a non-negative integer")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# 0/1 JSON number.
function(vt_bit out doc what)
  vt_uint(v "${doc}" "${what}" ${ARGN})
  if(v GREATER 1)
    vt_fail("${what} must be 0 or 1")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# C string literal (ASCII only; trigraph-safe).
function(vt_cstr out s)
  if(s MATCHES "[^ -~\n\t]")
    vt_fail("non-ASCII text")
  endif()
  string(REPLACE "\\" "\\\\" s "${s}")
  string(REPLACE "\"" "\\\"" s "${s}")
  string(REPLACE "?" "\\?" s "${s}")
  string(REPLACE "\n" "\\n" s "${s}")
  string(REPLACE "\t" "\\t" s "${s}")
  set(${out} "\"${s}\"" PARENT_SCOPE)
endfunction()

# Required non-empty string member.
function(vt_str out doc key)
  vt_type(t "${doc}" ${key})
  if(NOT t STREQUAL "STRING")
    vt_fail("'${key}' must be a string")
  endif()
  string(JSON v GET "${doc}" ${key})
  if(v STREQUAL "")
    vt_fail("'${key}' is empty")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Name -> C constant from a fixed list.
function(vt_name out prefix name what)
  if(NOT name IN_LIST ARGN)
    vt_fail("unknown ${what} '${name}'")
  endif()
  set(${out} "${prefix}${name}" PARENT_SCOPE)
endfunction()

set(VT_RUN_STATES UNRESET RESET_PENDING RUNNING HALTED FAULTED)
set(VT_FAULTS NONE UNSUPPORTED_SDBD_TARGET UNSUPPORTED_MVO_SSS_EQ_MMM UNSUPPORTED_JUMP_DE BUS_WAIT_LIMIT UNIMPLEMENTED)
set(VT_UNITS INSTR INT_ENTRY RESET_ENTRY BUS_GRANT HALTED FAULT NOT_RESET)
set(VT_EVENTS TCI PCIT HALT_LATCHED STOPPED FAULT BUS_RELEASED)
set(VT_KINDS FETCH READ WRITE ADAR INTAK IAB DW STROBE_TCI STROBE_PCIT)
set(VT_STATUS_BITS S 128 Z 64 OV 32 C 16)
set(VT_STATE_KEYS r status intff dbd prev_interruptible run_state halt_pending busak fault_reason mem)

# Status object {S, Z, OV, C} (each 0/1) applied over a numeric base.
function(vt_status out base doc)
  vt_keys("${doc}" status S Z OV C)
  set(v ${base})
  foreach(flag S Z OV C)
    vt_type(t "${doc}" ${flag})
    if(t STREQUAL "MISSING")
      continue()
    endif()
    vt_bit(b "${doc}" "status ${flag}" ${flag})
    list(FIND VT_STATUS_BITS ${flag} idx)
    math(EXPR idx "${idx} + 1")
    list(GET VT_STATUS_BITS ${idx} bit)
    if(b EQUAL 1)
      math(EXPR v "${v} | ${bit}")
    else()
      math(EXPR v "${v} & (255 - ${bit})")
    endif()
  endforeach()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Lines object {intr, intrm, busrq, stpst} -> C initializer.
function(vt_lines out doc)
  vt_keys("${doc}" lines intr intrm busrq stpst)
  set(parts "")
  foreach(k intr intrm busrq stpst)
    vt_type(t "${doc}" ${k})
    if(t STREQUAL "MISSING")
      set(b 0)
    else()
      vt_bit(b "${doc}" "lines ${k}" ${k})
    endif()
    list(APPEND parts "${b}u")
  endforeach()
  list(JOIN parts ", " parts)
  set(${out} "{${parts}}" PARENT_SCOPE)
endfunction()

# [addr, word] pair list -> C initializer elements.
function(vt_words out doc what)
  vt_type(t "${doc}")
  if(NOT t STREQUAL "ARRAY")
    vt_fail("${what} must be an array of [addr, word] pairs")
  endif()
  string(JSON n LENGTH "${doc}")
  set(elems "")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON pair GET "${doc}" ${i})
      string(JSON plen ERROR_VARIABLE e LENGTH "${pair}")
      if(NOT "${e}" STREQUAL "NOTFOUND" OR NOT plen EQUAL 2)
        vt_fail("${what}[${i}] must be [addr, word]")
      endif()
      string(JSON a GET "${pair}" 0)
      string(JSON w GET "${pair}" 1)
      vt_hex(al an "${a}" "${what} addr")
      vt_hex(wl wn "${w}" "${what} word")
      string(APPEND elems "{${al}, ${wl}}, ")
    endforeach()
  endif()
  set(${out} "${elems}" PARENT_SCOPE)
  set(${out}_N "${n}" PARENT_SCOPE)
endfunction()

# State initializer from register list, numeric status and scalar fields.
function(vt_state out)
  cmake_parse_arguments(S "" "STATUS;INTFF;DBD;PREV;RUN;HALT;FAULT;BUSAK" "R" ${ARGN})
  list(JOIN S_R ", " regs)
  set(${out} "{.r = {${regs}}, .status = ${S_STATUS}u, .intff = ${S_INTFF}u, .dbd = ${S_DBD}u, .prev_interruptible = ${S_PREV}u, .run_state = ${S_RUN}, .halt_pending = ${S_HALT}u, .fault_reason = ${S_FAULT}, .busak = ${S_BUSAK}u, .reserved = {0}}" PARENT_SCOPE)
endfunction()

# Static array for vector k (or NULL, 0 when empty); sets <var>_ref.
macro(vt_array var type elems count)
  if(${count} GREATER 0)
    string(APPEND arrays_c "static const ${type} ivs_v${k}_${var}[] = {${elems}};\n")
    set(${var}_ref "ivs_v${k}_${var}, ${count}u")
  else()
    set(${var}_ref "NULL, 0u")
  endif()
endmacro()

# ---- Inputs ------------------------------------------------------------------------------
file(STRINGS "${FILES}" stems)
set(VT_STEMS "")
foreach(l IN LISTS stems)
  string(STRIP "${l}" l)
  if(l STREQUAL "" OR l MATCHES "^#")
    continue()
  endif()
  if(NOT l MATCHES "^[a-z0-9][a-z0-9-]*$")
    set(VT_CTX "${FILES}")
    vt_fail("bad vector file stem '${l}'")
  endif()
  list(APPEND VT_STEMS "${l}")
endforeach()

set(VT_SKIP_IDS "")
set(VT_SKIP_REASONS "")
file(STRINGS "${SKIPS}" skip_lines)
foreach(l IN LISTS skip_lines)
  string(STRIP "${l}" l)
  if(l STREQUAL "" OR l MATCHES "^#")
    continue()
  endif()
  if(NOT l MATCHES "^([^ \t]+)[ \t]+(C[0-9]+)$")
    set(VT_CTX "${SKIPS}")
    vt_fail("skip line '${l}' is not '<id> <C-id>'")
  endif()
  list(APPEND VT_SKIP_IDS "${CMAKE_MATCH_1}")
  list(APPEND VT_SKIP_REASONS "${CMAKE_MATCH_2}")
endforeach()

set(sources_c "")
set(order "")
set(nvec 0)
foreach(stem IN LISTS VT_STEMS)
  set(rel "data/cp1610/vectors/${stem}.json")
  set(VT_CTX "${rel}")
  if(NOT EXISTS "${ROOT}/${rel}")
    vt_fail("file missing")
  endif()
  file(READ "${ROOT}/${rel}" doc)
  file(SHA256 "${ROOT}/${rel}" digest)
  string(APPEND sources_c "  {\"${rel}\", \"${digest}\"},\n")
  string(JSON nv ERROR_VARIABLE e LENGTH "${doc}" vectors)
  if(NOT "${e}" STREQUAL "NOTFOUND")
    vt_fail("no vectors array (${e})")
  endif()
  vt_keys("${doc}" top schema_version source group note vectors)
  if(nv GREATER 0)
    math(EXPR last "${nv} - 1")
    foreach(i RANGE ${last})
      string(JSON vec GET "${doc}" vectors ${i})
      vt_str(id "${vec}" id)
      if(NOT id MATCHES "^[A-Za-z0-9.@_-]+$")
        vt_fail("bad vector id '${id}'")
      endif()
      set("VT_VEC_${nvec}" "${vec}")
      set("VT_SRC_${nvec}" "${rel}")
      list(APPEND order "${id} ${nvec}")
      math(EXPR nvec "${nvec} + 1")
    endforeach()
  endif()
endforeach()
list(SORT order)

# ---- Per-vector code ---------------------------------------------------------------------
set(arrays_c "")
set(table_c "")
set(k 0)
foreach(entry IN LISTS order)
  string(REGEX REPLACE "^.* " "" idx "${entry}")
  set(vec "${VT_VEC_${idx}}")
  string(JSON id GET "${vec}" id)
  set(VT_CTX "${VT_SRC_${idx}} ${id}")
  vt_keys("${vec}" vector id row kind cite sources asm program derivation init expect covers tier policy
    bus bus_basis steps step_lines config ebci waits iab reset program_at)
  vt_str(row "${vec}" row)
  vt_str(kind "${vec}" kind)
  vt_str(cite "${vec}" cite)
  vt_str(derivation "${vec}" derivation)
  if(NOT kind STREQUAL "source" AND NOT kind STREQUAL "policy")
    vt_fail("kind must be source or policy")
  endif()
  set(policy_c "NULL")
  vt_type(t "${vec}" policy)
  if(NOT t STREQUAL "MISSING")
    vt_str(policy "${vec}" policy)
    vt_cstr(policy_c "${policy}")
  endif()
  set(skip_c "NULL")
  list(FIND VT_SKIP_IDS "${id}" si)
  if(si GREATER -1)
    list(GET VT_SKIP_REASONS ${si} reason)
    set(skip_c "\"${reason}\"")
  endif()

  # init
  vt_type(t "${vec}" init)
  if(NOT t STREQUAL "OBJECT")
    vt_fail("init must be an object")
  endif()
  string(JSON init GET "${vec}" init)
  vt_keys("${init}" init ${VT_STATE_KEYS} lines)
  set(regs 0000 0000 0000 0000 0000 0000 0000 0000)
  vt_type(t "${init}" r)
  if(NOT t STREQUAL "MISSING")
    string(JSON nr ERROR_VARIABLE e LENGTH "${init}" r)
    if(NOT t STREQUAL "ARRAY" OR NOT nr EQUAL 8)
      vt_fail("init.r must be an array of 8 hex words")
    endif()
    set(regs "")
    foreach(ri RANGE 7)
      string(JSON rv GET "${init}" r ${ri})
      vt_hex(lit num "${rv}" "init.r[${ri}]")
      list(APPEND regs "${rv}")
    endforeach()
  endif()
  set(st 0)
  vt_type(t "${init}" status)
  if(NOT t STREQUAL "MISSING")
    string(JSON sdoc GET "${init}" status)
    vt_status(st 0 "${sdoc}")
  endif()
  foreach(f intff dbd halt_pending busak)
    set(i_${f} 0)
    vt_type(t "${init}" ${f})
    if(NOT t STREQUAL "MISSING")
      vt_bit(i_${f} "${init}" "init.${f}" ${f})
    endif()
  endforeach()
  set(i_prev_interruptible 1)
  vt_type(t "${init}" prev_interruptible)
  if(NOT t STREQUAL "MISSING")
    vt_bit(i_prev_interruptible "${init}" "init.prev_interruptible" prev_interruptible)
  endif()
  set(i_run RUNNING)
  vt_type(t "${init}" run_state)
  if(NOT t STREQUAL "MISSING")
    string(JSON i_run GET "${init}" run_state)
  endif()
  set(i_fault NONE)
  vt_type(t "${init}" fault_reason)
  if(NOT t STREQUAL "MISSING")
    string(JSON i_fault GET "${init}" fault_reason)
  endif()
  set(lines_c "{0u, 0u, 0u, 0u}")
  vt_type(t "${init}" lines)
  if(NOT t STREQUAL "MISSING")
    string(JSON ldoc GET "${init}" lines)
    vt_lines(lines_c "${ldoc}")
  endif()

  # program words at program_at (default init R7), then init.mem
  list(GET regs 7 pc)
  vt_type(t "${vec}" program_at)
  if(NOT t STREQUAL "MISSING")
    string(JSON pc GET "${vec}" program_at)
  endif()
  vt_hex(pclit pcnum "${pc}" "program_at")
  set(mem_c "")
  set(n_mem 0)
  vt_type(t "${vec}" program)
  if(NOT t STREQUAL "ARRAY")
    vt_fail("program must be an array")
  endif()
  string(JSON np LENGTH "${vec}" program)
  if(np GREATER 0)
    math(EXPR last "${np} - 1")
    foreach(pi RANGE ${last})
      string(JSON pw GET "${vec}" program ${pi})
      if(NOT pw MATCHES "^([0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ([01 ]+)$")
        vt_fail("program[${pi}] '${pw}' is not '<hex4> <binary grouped>'")
      endif()
      set(hexpart "${CMAKE_MATCH_1}")
      string(REPLACE " " "" bits "${CMAKE_MATCH_2}")
      vt_hex(wl wn "${hexpart}" "program word")
      string(LENGTH "${bits}" nb)
      set(bv 0)
      math(EXPR nb1 "${nb} - 1")
      foreach(bi RANGE ${nb1})
        string(SUBSTRING "${bits}" ${bi} 1 bc)
        math(EXPR bv "${bv} * 2 + ${bc}")
      endforeach()
      if(NOT bv EQUAL wn)
        vt_fail("program[${pi}] binary does not equal its hex word")
      endif()
      math(EXPR a "(${pcnum} + ${pi}) & 65535" OUTPUT_FORMAT HEXADECIMAL)
      string(APPEND mem_c "{${a}u, ${wl}}, ")
      math(EXPR n_mem "${n_mem} + 1")
    endforeach()
  endif()
  vt_type(t "${init}" mem)
  if(NOT t STREQUAL "MISSING")
    string(JSON mdoc GET "${init}" mem)
    vt_words(more "${mdoc}" "init.mem")
    string(APPEND mem_c "${more}")
    math(EXPR n_mem "${n_mem} + ${more_N}")
  endif()

  # expect = init + delta
  vt_type(t "${vec}" expect)
  if(NOT t STREQUAL "OBJECT")
    vt_fail("expect must be an object")
  endif()
  string(JSON exp GET "${vec}" expect)
  vt_keys("${exp}" expect ${VT_STATE_KEYS} cycles units events)
  set(eregs ${regs})
  vt_type(t "${exp}" r)
  if(NOT t STREQUAL "MISSING")
    if(NOT t STREQUAL "OBJECT")
      vt_fail("expect.r must be an object keyed 0..7")
    endif()
    string(JSON rdoc GET "${exp}" r)
    vt_keys("${rdoc}" expect.r 0 1 2 3 4 5 6 7)
    foreach(rk RANGE 7)
      vt_type(t "${rdoc}" ${rk})
      if(t STREQUAL "MISSING")
        continue()
      endif()
      string(JSON rv GET "${rdoc}" ${rk})
      vt_hex(lit num "${rv}" "expect.r.${rk}")
      list(REMOVE_AT eregs ${rk})
      list(INSERT eregs ${rk} "${rv}")
    endforeach()
  endif()
  set(est ${st})
  vt_type(t "${exp}" status)
  if(NOT t STREQUAL "MISSING")
    string(JSON sdoc GET "${exp}" status)
    vt_status(est ${st} "${sdoc}")
  endif()
  foreach(f intff dbd halt_pending busak prev_interruptible)
    set(e_${f} ${i_${f}})
    vt_type(t "${exp}" ${f})
    if(NOT t STREQUAL "MISSING")
      vt_bit(e_${f} "${exp}" "expect.${f}" ${f})
    endif()
  endforeach()
  set(e_run ${i_run})
  vt_type(t "${exp}" run_state)
  if(NOT t STREQUAL "MISSING")
    string(JSON e_run GET "${exp}" run_state)
  endif()
  set(e_fault ${i_fault})
  vt_type(t "${exp}" fault_reason)
  if(NOT t STREQUAL "MISSING")
    string(JSON e_fault GET "${exp}" fault_reason)
  endif()
  set(emem_c "")
  set(n_emem 0)
  vt_type(t "${exp}" mem)
  if(NOT t STREQUAL "MISSING")
    string(JSON mdoc GET "${exp}" mem)
    vt_words(emem_c "${mdoc}" "expect.mem")
    set(n_emem ${emem_c_N})
  endif()
  set(cycles_asserted 0)
  set(cycles 0)
  vt_type(t "${exp}" cycles)
  if(NOT t STREQUAL "MISSING")
    vt_uint(cycles "${exp}" "expect.cycles" cycles)
    set(cycles_asserted 1)
  endif()
  if(DEFINED MUTATE AND id STREQUAL MUTATE)
    if(NOT cycles_asserted)
      vt_fail("MUTATE target asserts no expect.cycles")
    endif()
    math(EXPR cycles "${cycles} + 1")
    set(VT_MUTATED 1)
  endif()
  set(units_c "")
  set(n_units 0)
  vt_type(t "${exp}" units)
  if(NOT t STREQUAL "MISSING")
    string(JSON n_units LENGTH "${exp}" units)
    if(n_units EQUAL 0)
      vt_fail("expect.units is empty")
    endif()
    math(EXPR last "${n_units} - 1")
    foreach(ui RANGE ${last})
      string(JSON un GET "${exp}" units ${ui})
      vt_name(uc IVS_CP1610_UNIT_ "${un}" unit ${VT_UNITS})
      string(APPEND units_c "${uc}, ")
    endforeach()
  endif()
  set(has_events 0)
  set(events_c "0u")
  vt_type(t "${exp}" events)
  if(NOT t STREQUAL "MISSING")
    set(has_events 1)
    string(JSON ne LENGTH "${exp}" events)
    if(ne GREATER 0)
      set(events_c "")
      math(EXPR last "${ne} - 1")
      foreach(ei RANGE ${last})
        string(JSON en GET "${exp}" events ${ei})
        vt_name(ec IVS_CP1610_EV_ "${en}" event ${VT_EVENTS})
        list(APPEND events_c "${ec}")
      endforeach()
      list(JOIN events_c " | " events_c)
    endif()
  endif()

  vt_name(i_run_c IVS_CP1610_RS_ "${i_run}" run_state ${VT_RUN_STATES})
  vt_name(e_run_c IVS_CP1610_RS_ "${e_run}" run_state ${VT_RUN_STATES})
  vt_name(i_fault_c IVS_CP1610_FAULT_ "${i_fault}" fault_reason ${VT_FAULTS})
  vt_name(e_fault_c IVS_CP1610_FAULT_ "${e_fault}" fault_reason ${VT_FAULTS})
  set(iregs "")
  foreach(rv IN LISTS regs)
    string(TOUPPER "${rv}" rv)
    list(APPEND iregs "0x${rv}u")
  endforeach()
  set(xregs "")
  foreach(rv IN LISTS eregs)
    string(TOUPPER "${rv}" rv)
    list(APPEND xregs "0x${rv}u")
  endforeach()
  vt_state(init_c R ${iregs} STATUS ${st} INTFF ${i_intff} DBD ${i_dbd} PREV ${i_prev_interruptible}
    RUN ${i_run_c} HALT ${i_halt_pending} FAULT ${i_fault_c} BUSAK ${i_busak})
  vt_state(expect_c R ${xregs} STATUS ${est} INTFF ${e_intff} DBD ${e_dbd} PREV ${e_prev_interruptible}
    RUN ${e_run_c} HALT ${e_halt_pending} FAULT ${e_fault_c} BUSAK ${e_busak})

  # steps, step_lines, reset, iab, config, ebci, waits, bus
  set(steps 1)
  vt_type(t "${vec}" steps)
  if(NOT t STREQUAL "MISSING")
    vt_uint(steps "${vec}" steps steps)
    if(steps LESS 1)
      vt_fail("steps must be at least 1")
    endif()
  endif()
  set(sl_c "")
  set(n_sl 0)
  vt_type(t "${vec}" step_lines)
  if(NOT t STREQUAL "MISSING")
    string(JSON n_sl LENGTH "${vec}" step_lines)
    if(NOT n_sl EQUAL steps)
      vt_fail("step_lines needs one entry per step")
    endif()
    math(EXPR last "${n_sl} - 1")
    foreach(li RANGE ${last})
      string(JSON ldoc GET "${vec}" step_lines ${li})
      vt_lines(lc "${ldoc}")
      string(APPEND sl_c "${lc}, ")
    endforeach()
  endif()
  set(reset 0)
  vt_type(t "${vec}" reset)
  if(t STREQUAL "BOOLEAN")
    string(JSON rb GET "${vec}" reset)
    if(rb)
      set(reset 1)
    endif()
  elseif(NOT t STREQUAL "MISSING")
    vt_fail("reset must be true or false")
  endif()
  set(has_iab 0)
  set(iab_c "0x0000u")
  vt_type(t "${vec}" iab)
  if(NOT t STREQUAL "MISSING")
    string(JSON iv GET "${vec}" iab)
    vt_hex(iab_c num "${iv}" "iab")
    set(has_iab 1)
  endif()
  set(cfg_mask 0)
  set(cfg_vals 0 0 0)
  vt_type(t "${vec}" config)
  if(NOT t STREQUAL "MISSING")
    string(JSON cdoc GET "${vec}" config)
    vt_keys("${cdoc}" config interrupt_accept_clears_intff release_latency_cpu_cycles wait_limit_cpu_cycles)
    set(ci 0)
    set(cfg_vals "")
    foreach(ck interrupt_accept_clears_intff release_latency_cpu_cycles wait_limit_cpu_cycles)
      vt_type(t "${cdoc}" ${ck})
      if(t STREQUAL "MISSING")
        list(APPEND cfg_vals 0)
      else()
        vt_uint(cv "${cdoc}" "config.${ck}" ${ck})
        if(cv GREATER 255)
          vt_fail("config.${ck} exceeds 255")
        endif()
        list(APPEND cfg_vals ${cv})
        math(EXPR cfg_mask "${cfg_mask} | (1 << ${ci})")
      endif()
      math(EXPR ci "${ci} + 1")
    endforeach()
  endif()
  list(JOIN cfg_vals "u, " cfg_c)
  set(ebci_c "")
  set(n_ebci 0)
  vt_type(t "${vec}" ebci)
  if(NOT t STREQUAL "MISSING")
    string(JSON n_ebci LENGTH "${vec}" ebci)
    if(n_ebci GREATER 0)
      math(EXPR last "${n_ebci} - 1")
      foreach(ei RANGE ${last})
        vt_uint(ev "${vec}" "ebci[${ei}]" ebci ${ei})
        if(ev GREATER 15)
          vt_fail("ebci code ${ev} exceeds 15")
        endif()
        string(APPEND ebci_c "${ev}u, ")
      endforeach()
    endif()
  endif()
  set(waits_c "")
  set(n_waits 0)
  vt_type(t "${vec}" waits)
  if(NOT t STREQUAL "MISSING")
    string(JSON n_waits LENGTH "${vec}" waits)
    if(n_waits GREATER 0)
      math(EXPR last "${n_waits} - 1")
      foreach(wi RANGE ${last})
        string(JSON wa GET "${vec}" waits ${wi} 0)
        vt_hex(wal wan "${wa}" "waits addr")
        vt_uint(wn "${vec}" "waits[${wi}] cycles" waits ${wi} 1)
        string(APPEND waits_c "{${wal}, ${wn}u}, ")
      endforeach()
    endif()
  endif()
  set(has_bus 0)
  set(bus_cyc 0)
  set(bus_c "")
  set(n_bus 0)
  vt_type(t "${vec}" bus)
  if(NOT t STREQUAL "MISSING")
    set(has_bus 1)
    vt_str(basis "${vec}" bus_basis)
    if(basis STREQUAL "figure")
      set(bus_cyc 1)
    elseif(NOT basis STREQUAL "inference")
      vt_fail("bus_basis must be figure or inference")
    endif()
    string(JSON n_bus LENGTH "${vec}" bus)
    if(n_bus GREATER 0)
      math(EXPR last "${n_bus} - 1")
      foreach(bi RANGE ${last})
        string(JSON blen LENGTH "${vec}" bus ${bi})
        if(NOT blen EQUAL 4)
          vt_fail("bus[${bi}] must be [cycle, kind, addr, data]")
        endif()
        vt_uint(bc "${vec}" "bus[${bi}] cycle" bus ${bi} 0)
        string(JSON bk GET "${vec}" bus ${bi} 1)
        string(JSON ba GET "${vec}" bus ${bi} 2)
        string(JSON bd GET "${vec}" bus ${bi} 3)
        vt_name(bkc IVS_ACC_ "${bk}" "bus kind" ${VT_KINDS})
        vt_hex(bal ban "${ba}" "bus addr")
        vt_hex(bdl bdn "${bd}" "bus data")
        string(APPEND bus_c "{${bc}u, ${bal}, ${bdl}, ${bkc}}, ")
      endforeach()
    endif()
  else()
    vt_type(t "${vec}" bus_basis)
    if(NOT t STREQUAL "MISSING")
      vt_fail("bus_basis without bus")
    endif()
  endif()

  # emit
  vt_array(sl ivs_cp1610_lines "${sl_c}" ${n_sl})
  vt_array(mem ivs_vec_word "${mem_c}" ${n_mem})
  vt_array(emem ivs_vec_word "${emem_c}" ${n_emem})
  vt_array(bus ivs_vec_bus "${bus_c}" ${n_bus})
  vt_array(waits ivs_vec_wait "${waits_c}" ${n_waits})
  vt_array(ebci uint8_t "${ebci_c}" ${n_ebci})
  vt_array(units uint8_t "${units_c}" ${n_units})
  vt_cstr(id_c "${id}")
  vt_cstr(row_c "${row}")
  vt_cstr(kind_c "${kind}")
  vt_cstr(cite_c "${cite}")
  vt_cstr(der_c "${derivation}")
  string(APPEND table_c "  {${id_c}, ${row_c}, ${kind_c}, ${policy_c}, ${cite_c},\n   ${der_c},\n"
    "   ${skip_c}, ${steps}u, ${reset}u, ${has_iab}u, ${iab_c}, ${cfg_mask}u, {${cfg_c}u, 0u},\n"
    "   ${init_c},\n   ${expect_c},\n   ${lines_c}, ${sl_ref}, ${mem_ref}, ${emem_ref},\n"
    "   ${cycles_asserted}u, ${cycles}u, ${has_bus}u, ${bus_cyc}u, ${bus_ref}, ${waits_ref}, ${ebci_ref}, ${units_ref},\n"
    "   ${has_events}u, (uint8_t)(${events_c})},\n")
  math(EXPR k "${k} + 1")
endforeach()

if(DEFINED MUTATE AND NOT VT_MUTATED)
  set(VT_CTX "${FILES}")
  vt_fail("MUTATE target '${MUTATE}' is not a vector id")
endif()
if(k EQUAL 0)
  set(table_c "  {0}\n")
endif()
set(out_c "/* Generated by cmake/IvsVectorTable.cmake from the files in data/expected/cp1610-vector-files.ids. */\n")
string(APPEND out_c "/* Build output only: never committed, never edited. */\n")
string(APPEND out_c "${arrays_c}\n")
string(APPEND out_c "static const ivs_vec ivs_vec_table[] = {\n${table_c}};\n")
string(APPEND out_c "static const size_t ivs_vec_count = ${k}u;\n")
if(sources_c STREQUAL "")
  string(APPEND out_c "static const ivs_test_source ivs_vec_sources[1] = {{NULL, NULL}};\nstatic const size_t ivs_vec_source_count = 0u;\n")
else()
  string(APPEND out_c "static const ivs_test_source ivs_vec_sources[] = {\n${sources_c}};\n")
  list(LENGTH VT_STEMS ns)
  string(APPEND out_c "static const size_t ivs_vec_source_count = ${ns}u;\n")
endif()
file(WRITE "${OUT}" "${out_c}")
