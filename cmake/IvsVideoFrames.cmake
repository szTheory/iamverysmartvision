# SPDX-License-Identifier: MIT
# Video frame generator (plans 06-10 and 06-11, D-02, D-18, D-19; test side). Reads ONLY the hand-derived frame literals
# data/video/frames/F-A1.frame .. F-A5.frame, F-B1.frame .. F-B3.frame and the card bit-role literal data/video/cards.literal.txt, never data/profiles/, a core
# header or core output, and writes ivs_video_frames.inc to OUT (build tree only, never committed) for suite video
# (tests/video/video_fgbg.c). The expected planes are the literals; no run of the renderer produces an expectation.
# Usage: cmake -DROOT=<repo> -DOUT=<build>/tests/ivs_video_frames.inc -P cmake/IvsVideoFrames.cmake
# Output (C, after the vf_* types of tests/video/video_cases.h):
#   vf_cells_<F>[], vf_gram_<F>[]  the listed cells (row, column, word, annotation string, source line) and the graphics RAM patterns
#   vf_plane_<F>[96]               the 96 plane lines, 160 symbols each (0-9A-F, and - for the cut-off pixel), spaces removed
#   vf_frames[]                    one vf_frame per frame: mode, display, border, stack, fill word, counts, the arrays, sha256-text
#   vf_roles[64]                   the 64 rows of the card bit-role literal (variant, bit, role)
#   vf_sources[]                   every file read with its SHA-256, for the TAP header
# Frame grammar (as written by plan 06-01): comment lines; then keys frame, tier, oracle, rules, mode (fgbg|cs), display (on|off), border,
# stack (4 color indices, one hex digit each), fill (4 hex digits), cell r c WORD | annotation, gram n b0 .. b7 (8 binary strings of 8 digits), sha256-text (64 hex
# digits), then the line `plane` and exactly 96 lines of 20 groups of 8 symbols.
# Plan 06-13 (D-19, D-20): with -DFRAMESET=diag the script reads ONLY data/video/frames/F-D1.frame and F-D2.frame (the two frames of the third diagnostic)
# and writes the smaller include ivs_diag_frames.inc for suite run (tests/run/run_diag_stic.c): per frame ds_plane_<F>[96] (the plane lines, 160 symbols,
# spaces removed) and ds_sha_<F> (the sha256-text key), and the table ds_frames[2] of the struct ds_frame_lit defined by the including file
# (name, plane, sha-text). The same fail-closed checks of the plane and the key apply; the video suite's table vf_frames is unchanged.
# Fail closed (message `IvsVideoFrames: <file>[:<line>]: <reason>`): a missing file, a row outside the grammar, a missing or repeated
# key, a plane that is not 96 x 20 x 8 symbols, a cell outside 12 x 20, a bit pattern outside 8 binary digits, a card literal that is not
# 64 rows with each variant holding bits 15 down to 0 once.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsVideoFrames: missing -D${required}")
  endif()
endforeach()

if(DEFINED FRAMESET AND "${FRAMESET}" STREQUAL "diag")
  set(dframes F-D1 F-D2)
  set(d_decl "")
  set(d_table "")
  foreach(f IN LISTS dframes)
    set(file "${ROOT}/data/video/frames/${f}.frame")
    file(RELATIVE_PATH rel "${ROOT}" "${file}")
    if(NOT EXISTS "${file}")
      message(FATAL_ERROR "IvsVideoFrames: ${rel}: missing")
    endif()
    string(REPLACE "-" "_" id "${f}")
    file(STRINGS "${file}" lines)
    set(in_plane 0)
    set(plane_rows 0)
    set(plane_c "")
    set(sha "")
    set(lineno 0)
    foreach(line IN LISTS lines)
      math(EXPR lineno "${lineno} + 1")
      if(line STREQUAL "" OR line MATCHES "^#")
        continue()
      endif()
      if(in_plane)
        string(REPLACE " " "" packed "${line}")
        string(LENGTH "${packed}" plen)
        if(NOT plen EQUAL 160 OR NOT packed MATCHES "^[0-9A-F-]+$")
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: plane row ${plane_rows} is not 160 symbols of 0-9A-F and -")
        endif()
        string(APPEND plane_c "    \"${packed}\",\n")
        math(EXPR plane_rows "${plane_rows} + 1")
      elseif(line STREQUAL "plane")
        set(in_plane 1)
      elseif(line MATCHES "^sha256-text ([0-9a-f]+)$")
        set(sha "${CMAKE_MATCH_1}")
        string(LENGTH "${sha}" shl)
        if(NOT shl EQUAL 64)
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: sha256-text is not 64 hex digits")
        endif()
      endif()
    endforeach()
    if(NOT plane_rows EQUAL 96 OR "${sha}" STREQUAL "")
      message(FATAL_ERROR "IvsVideoFrames: ${rel}: ${plane_rows} plane rows or no sha256-text key")
    endif()
    string(APPEND d_decl "static const char *const ds_plane_${id}[96] = {\n${plane_c}};\n")
    string(APPEND d_table "    {\"${f}\", ds_plane_${id}, \"${sha}\"},\n")
  endforeach()
  file(WRITE "${OUT}" "/* Generated by cmake/IvsVideoFrames.cmake (FRAMESET=diag) from data/video/frames/F-D1.frame and F-D2.frame. Do not edit. */\n${d_decl}static const ds_frame_lit ds_frames[2] = {\n${d_table}};\n")
  return()
endif()

# Plan 08-04 (D-05, VID-05; test side): with -DFRAMESET=mob the script reads ONLY data/video/frames/F-M0.frame .. F-M9.frame (the ten hand-derived
# frames of the oracle plan 08-03, frozen after the blind read) and, for the one test video.mob.params-match-profile, the three profile values
# video.mob_field_origin, video.mob_line_sample and video.mob_prio_hides (a read of the profile that is independent of cmake/IvsSticTable.cmake:
# separate code, no value shared with the core; the same test-side precedent as cmake/IvsPsgProfileProbe.cmake). It writes ivs_mob_frames.inc
# for suite video (tests/video/video_mob.c): per frame vm_cells_<F>[], vm_gram_<F>[], vm_plane_<F>[96] (160 symbols per line, spaces removed,
# `-` kept as the wildcard: a position inside an unknown rectangle, and the cut-off pixel of column 19) and the table vm_frames[10] of the
# struct vm_frame (tests/video/video_cases.h): name, mode, display, border, stack, fill, cells, grams, plane, the hash text (empty for
# `sha256-text none`), the number of `unknown` rectangles and the line of the plane keyword. The `mob` and `unknown` records and the hash
# value `none` are accepted (the frame grammar of plan 08-03); every other check is the one of the default set. The table is kept apart from
# vf_frames[], so no existing loop of the video suite sees an F-M frame. Also vm_roles[48] (the rows of the MOB bit-role literal
# data/video/mob.literal.txt: register mobx, moby or moba, bit, role; the register-bit sweep reads its roles from here and never from the
# core decode; fail closed on a row count other than 48, a row outside the grammar or a repeated (register, bit)), vm_sources[] (every file
# read with its SHA-256) and VM_PROFILE_ORIGIN_X/_Y, VM_PROFILE_LINE_SAMPLE, VM_PROFILE_PRIO_HIDES. Fail closed with the same message shape.
if(DEFINED FRAMESET AND "${FRAMESET}" STREQUAL "mob")
  set(mframes F-M0 F-M1 F-M2 F-M3 F-M4 F-M5 F-M6 F-M7 F-M8 F-M9)
  set(m_decl "")
  set(m_table "")
  set(m_sources "")
  set(m_count 0)
  foreach(f IN LISTS mframes)
    set(file "${ROOT}/data/video/frames/${f}.frame")
    file(RELATIVE_PATH rel "${ROOT}" "${file}")
    if(NOT EXISTS "${file}")
      message(FATAL_ERROR "IvsVideoFrames: ${rel}: missing")
    endif()
    file(SHA256 "${file}" digest)
    string(APPEND m_sources "  {\"${rel}\", \"${digest}\"},\n")
    string(REPLACE "-" "_" id "${f}")
    file(STRINGS "${file}" lines)
    set(lineno 0)
    set(in_plane 0)
    set(plane_rows 0)
    set(plane_c "")
    set(cells_c "")
    set(gram_c "")
    set(n_cells 0)
    set(n_gram 0)
    set(n_unk 0)
    set(seen "")
    set(mode "")
    set(display "")
    set(border "")
    set(stack "")
    set(fill "")
    set(sha "")
    set(plane_line 0)
    foreach(line IN LISTS lines)
      math(EXPR lineno "${lineno} + 1")
      if(line STREQUAL "" OR line MATCHES "^#")
        continue()
      endif()
      if(in_plane)
        string(REPLACE " " "" packed "${line}")
        string(LENGTH "${packed}" plen)
        if(NOT plen EQUAL 160 OR NOT packed MATCHES "^[0-9A-F-]+$")
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: plane row ${plane_rows} is not 160 symbols of 0-9A-F and -")
        endif()
        string(APPEND plane_c "    \"${packed}\",\n")
        math(EXPR plane_rows "${plane_rows} + 1")
        continue()
      endif()
      if(line STREQUAL "plane")
        set(in_plane 1)
        set(plane_line ${lineno})
        continue()
      endif()
      string(REGEX MATCH "^([a-z0-9-]+) (.*)$" m "${line}")
      if(NOT m)
        message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: row outside the grammar: ${line}")
      endif()
      set(key "${CMAKE_MATCH_1}")
      set(val "${CMAKE_MATCH_2}")
      if(key STREQUAL "cell")
        string(REGEX MATCH "^([0-9]+) ([0-9]+) ([0-9A-F][0-9A-F][0-9A-F][0-9A-F]) \\| (.+)$" cm "${val}")
        if(NOT cm)
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: cell row outside the grammar")
        endif()
        if(CMAKE_MATCH_1 GREATER 11 OR CMAKE_MATCH_2 GREATER 19)
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: cell outside 12 x 20")
        endif()
        string(APPEND cells_c "    {${CMAKE_MATCH_1}u, ${CMAKE_MATCH_2}u, 0x${CMAKE_MATCH_3}u, ${lineno}u, \"${CMAKE_MATCH_4}\"},\n")
        math(EXPR n_cells "${n_cells} + 1")
        continue()
      endif()
      if(key STREQUAL "gram")
        string(REGEX MATCH "^([0-9]+) ([01]+) ([01]+) ([01]+) ([01]+) ([01]+) ([01]+) ([01]+) ([01]+)$" gm "${val}")
        if(NOT gm)
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: gram row outside the grammar")
        endif()
        set(gcard "${CMAKE_MATCH_1}")
        set(bytes "")
        foreach(i RANGE 2 9)
          string(LENGTH "${CMAKE_MATCH_${i}}" blen)
          if(NOT blen EQUAL 8)
            message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: gram byte is not 8 binary digits")
          endif()
          set(b "${CMAKE_MATCH_${i}}")
          set(v 0)
          foreach(k RANGE 0 7)
            string(SUBSTRING "${b}" ${k} 1 digit)
            math(EXPR v "${v} * 2 + ${digit}")
          endforeach()
          string(APPEND bytes "${v}u, ")
        endforeach()
        string(APPEND gram_c "    {${gcard}u, {${bytes}}},\n")
        math(EXPR n_gram "${n_gram} + 1")
        continue()
      endif()
      if(key STREQUAL "mob")
        # a MOB record (index, rectangle, color, pixel count): the video step checks it; the test counts positions itself
        if(NOT val MATCHES "^[0-7] [0-9]+ [0-9]+ [0-9]+ [0-9]+ color=[0-9a-f]+ pixels=[0-9]+$")
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: mob row outside the grammar")
        endif()
        continue()
      endif()
      if(key STREQUAL "unknown")
        if(NOT val MATCHES "^[0-9]+ [0-9]+ [0-9]+ [0-9]+$")
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: unknown row outside the grammar")
        endif()
        math(EXPR n_unk "${n_unk} + 1")
        continue()
      endif()
      if(key IN_LIST seen)
        message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: key ${key} repeated")
      endif()
      list(APPEND seen "${key}")
      if(key STREQUAL "mode")
        if(val STREQUAL "fgbg")
          set(mode 0)
        elseif(val STREQUAL "cs")
          set(mode 1)
        else()
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: mode ${val}")
        endif()
      elseif(key STREQUAL "display")
        if(val STREQUAL "on")
          set(display 1)
        elseif(val STREQUAL "off")
          set(display 0)
        else()
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: display ${val}")
        endif()
      elseif(key STREQUAL "border")
        if(NOT val MATCHES "^[0-9]+$" OR val GREATER 15)
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: border ${val}")
        endif()
        set(border "${val}")
      elseif(key STREQUAL "stack")
        if(NOT val MATCHES "^[0-9A-F] [0-9A-F] [0-9A-F] [0-9A-F]$")
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: stack ${val}")
        endif()
        string(REPLACE " " "" stackdigits "${val}")
        set(stack "")
        foreach(k RANGE 0 3)
          string(SUBSTRING "${stackdigits}" ${k} 1 sd)
          string(APPEND stack "0x${sd}u, ")
        endforeach()
      elseif(key STREQUAL "fill")
        if(NOT val MATCHES "^[0-9A-F][0-9A-F][0-9A-F][0-9A-F]$")
          message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: fill ${val}")
        endif()
        set(fill "0x${val}u")
      elseif(key STREQUAL "sha256-text")
        if(val STREQUAL "none")
          set(sha "")
        else()
          if(NOT val MATCHES "^[0-9a-f]+$")
            message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: sha256-text is not lower-case hex")
          endif()
          string(LENGTH "${val}" slen)
          if(NOT slen EQUAL 64)
            message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: sha256-text is not 64 digits")
          endif()
          set(sha "${val}")
        endif()
      elseif(NOT key MATCHES "^(frame|tier|oracle|rules)$")
        message(FATAL_ERROR "IvsVideoFrames: ${rel}:${lineno}: unknown key ${key}")
      endif()
    endforeach()
    foreach(k mode display border stack fill sha256-text frame)
      if(NOT k IN_LIST seen)
        message(FATAL_ERROR "IvsVideoFrames: ${rel}: missing key ${k}")
      endif()
    endforeach()
    if(NOT plane_rows EQUAL 96)
      message(FATAL_ERROR "IvsVideoFrames: ${rel}: plane has ${plane_rows} rows, not 96")
    endif()
    if(n_cells EQUAL 0)
      set(cells_c "    {0u, 0u, 0u, 0u, \"\"},\n")
    endif()
    if(n_gram EQUAL 0)
      set(gram_c "    {0u, {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u}},\n")
    endif()
    string(APPEND m_decl "static const vf_cell vm_cells_${id}[] = {\n${cells_c}};\n")
    string(APPEND m_decl "static const vf_gram vm_gram_${id}[] = {\n${gram_c}};\n")
    string(APPEND m_decl "static const char *const vm_plane_${id}[96] = {\n${plane_c}};\n")
    string(APPEND m_table "    {\"${f}\", ${mode}u, ${display}u, ${border}u, {${stack}}, ${fill}, ${n_cells}u, vm_cells_${id}, ${n_gram}u, vm_gram_${id}, vm_plane_${id}, \"${sha}\", ${n_unk}u, ${plane_line}u},\n")
    math(EXPR m_count "${m_count} + 1")
  endforeach()
  # the MOB bit-role literal: 48 rows, each (register, bit) once
  set(m_litfile "${ROOT}/data/video/mob.literal.txt")
  file(RELATIVE_PATH m_litrel "${ROOT}" "${m_litfile}")
  if(NOT EXISTS "${m_litfile}")
    message(FATAL_ERROR "IvsVideoFrames: ${m_litrel}: missing")
  endif()
  file(SHA256 "${m_litfile}" m_litdigest)
  string(APPEND m_sources "  {\"${m_litrel}\", \"${m_litdigest}\"},\n")
  file(STRINGS "${m_litfile}" m_litlines)
  set(m_roles_c "")
  set(m_nroles 0)
  set(m_litno 0)
  foreach(line IN LISTS m_litlines)
    math(EXPR m_litno "${m_litno} + 1")
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    string(REGEX MATCH "^(mobx|moby|moba) ([0-9]+) ([a-z0-9]+) src=" rm "${line}")
    if(NOT rm)
      message(FATAL_ERROR "IvsVideoFrames: ${m_litrel}:${m_litno}: row outside the grammar")
    endif()
    if(CMAKE_MATCH_2 GREATER 15)
      message(FATAL_ERROR "IvsVideoFrames: ${m_litrel}:${m_litno}: bit above 15")
    endif()
    if(DEFINED seen_${CMAKE_MATCH_1}_${CMAKE_MATCH_2})
      message(FATAL_ERROR "IvsVideoFrames: ${m_litrel}:${m_litno}: bit ${CMAKE_MATCH_2} of ${CMAKE_MATCH_1} repeated")
    endif()
    set(seen_${CMAKE_MATCH_1}_${CMAKE_MATCH_2} 1)
    string(APPEND m_roles_c "    {\"${CMAKE_MATCH_1}\", ${CMAKE_MATCH_2}u, \"${CMAKE_MATCH_3}\"},\n")
    math(EXPR m_nroles "${m_nroles} + 1")
  endforeach()
  if(NOT m_nroles EQUAL 48)
    message(FATAL_ERROR "IvsVideoFrames: ${m_litrel}: ${m_nroles} rows, not 48")
  endif()
  # the three profile values of the moving-object pins, read by their own code
  file(GLOB m_profiles RELATIVE "${ROOT}" "${ROOT}/data/profiles/*.json")
  list(SORT m_profiles)
  if(NOT m_profiles)
    message(FATAL_ERROR "IvsVideoFrames: data/profiles: no profile file")
  endif()
  list(GET m_profiles 0 m_prof_rel)
  file(READ "${ROOT}/${m_prof_rel}" m_doc)
  file(SHA256 "${ROOT}/${m_prof_rel}" m_prof_digest)
  string(APPEND m_sources "  {\"${m_prof_rel}\", \"${m_prof_digest}\"},\n")
  string(JSON m_ox ERROR_VARIABLE m_e GET "${m_doc}" fields video.mob_field_origin value x)
  string(JSON m_oy ERROR_VARIABLE m_e2 GET "${m_doc}" fields video.mob_field_origin value y)
  string(JSON m_ls ERROR_VARIABLE m_e3 GET "${m_doc}" fields video.mob_line_sample value)
  string(JSON m_ph ERROR_VARIABLE m_e4 GET "${m_doc}" fields video.mob_prio_hides value)
  foreach(v ${m_ox} ${m_oy} ${m_ls} ${m_ph})
    if(NOT v MATCHES "^[0-9]+$")
      message(FATAL_ERROR "IvsVideoFrames: ${m_prof_rel}: a video.mob_* value is missing or not a non-negative integer")
    endif()
  endforeach()
  file(WRITE "${OUT}" "/* Generated by cmake/IvsVideoFrames.cmake (FRAMESET=mob) from data/video/frames/F-M0.frame .. F-M9.frame, data/video/mob.literal.txt and the three video.mob_* profile values. Do not edit. */\n${m_decl}static const vm_frame vm_frames[${m_count}] = {\n${m_table}};\nstatic const vm_role vm_roles[48] = {\n${m_roles_c}};\nstatic const ivs_test_source vm_sources[] = {\n${m_sources}};\n#define VM_PROFILE_ORIGIN_X ${m_ox}u\n#define VM_PROFILE_ORIGIN_Y ${m_oy}u\n#define VM_PROFILE_LINE_SAMPLE ${m_ls}u\n#define VM_PROFILE_PRIO_HIDES ${m_ph}u\n")
  return()
endif()

set(frames F-A1 F-A2 F-A3 F-A4 F-A5 F-B1 F-B2 F-B3)
set(cardfile "${ROOT}/data/video/cards.literal.txt")

function(vf_fail where msg)
  message(FATAL_ERROR "IvsVideoFrames: ${where}: ${msg}")
endfunction()

function(vf_rel out file)
  file(RELATIVE_PATH r "${ROOT}" "${file}")
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

set(sources_c "")
set(decl_c "")
set(table_c "")
set(frame_count 0)

foreach(f IN LISTS frames)
  set(file "${ROOT}/data/video/frames/${f}.frame")
  vf_rel(rel "${file}")
  if(NOT EXISTS "${file}")
    vf_fail("${rel}" "missing")
  endif()
  file(SHA256 "${file}" digest)
  string(APPEND sources_c "  {\"${rel}\", \"${digest}\"},\n")
  string(REPLACE "-" "_" id "${f}")
  file(STRINGS "${file}" lines)
  set(lineno 0)
  set(in_plane 0)
  set(plane_rows 0)
  set(plane_c "")
  set(cells_c "")
  set(gram_c "")
  set(n_cells 0)
  set(n_gram 0)
  set(seen "")
  set(mode "")
  set(display "")
  set(border "")
  set(stack "")
  set(fill "")
  set(sha "")
  set(plane_line 0)
  foreach(line IN LISTS lines)
    math(EXPR lineno "${lineno} + 1")
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    if(in_plane)
      string(REPLACE " " "" packed "${line}")
      string(LENGTH "${packed}" plen)
      if(NOT plen EQUAL 160 OR NOT packed MATCHES "^[0-9A-F-]+$")
        vf_fail("${rel}:${lineno}" "plane row ${plane_rows} is not 160 symbols of 0-9A-F and -")
      endif()
      string(APPEND plane_c "    \"${packed}\",\n")
      math(EXPR plane_rows "${plane_rows} + 1")
      continue()
    endif()
    if(line STREQUAL "plane")
      set(in_plane 1)
      set(plane_line ${lineno})
      continue()
    endif()
    string(REGEX MATCH "^([a-z0-9-]+) (.*)$" m "${line}")
    if(NOT m)
      vf_fail("${rel}:${lineno}" "row outside the grammar: ${line}")
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(val "${CMAKE_MATCH_2}")
    if(key STREQUAL "cell")
      string(REGEX MATCH "^([0-9]+) ([0-9]+) ([0-9A-F][0-9A-F][0-9A-F][0-9A-F]) \\| (.+)$" cm "${val}")
      if(NOT cm)
        vf_fail("${rel}:${lineno}" "cell row outside the grammar")
      endif()
      if(CMAKE_MATCH_1 GREATER 11 OR CMAKE_MATCH_2 GREATER 19)
        vf_fail("${rel}:${lineno}" "cell outside 12 x 20")
      endif()
      string(APPEND cells_c "    {${CMAKE_MATCH_1}u, ${CMAKE_MATCH_2}u, 0x${CMAKE_MATCH_3}u, ${lineno}u, \"${CMAKE_MATCH_4}\"},\n")
      math(EXPR n_cells "${n_cells} + 1")
      continue()
    endif()
    if(key STREQUAL "gram")
      string(REGEX MATCH "^([0-9]+) ([01]+) ([01]+) ([01]+) ([01]+) ([01]+) ([01]+) ([01]+) ([01]+)$" gm "${val}")
      if(NOT gm)
        vf_fail("${rel}:${lineno}" "gram row outside the grammar")
      endif()
      set(bytes "")
      foreach(i RANGE 2 9)
        string(LENGTH "${CMAKE_MATCH_${i}}" blen)
        if(NOT blen EQUAL 8)
          vf_fail("${rel}:${lineno}" "gram byte is not 8 binary digits")
        endif()
        set(b "${CMAKE_MATCH_${i}}")
        set(v 0)
        foreach(k RANGE 0 7)
          string(SUBSTRING "${b}" ${k} 1 digit)
          math(EXPR v "${v} * 2 + ${digit}")
        endforeach()
        string(APPEND bytes "${v}u, ")
      endforeach()
      string(APPEND gram_c "    {${CMAKE_MATCH_1}u, {${bytes}}},\n")
      math(EXPR n_gram "${n_gram} + 1")
      continue()
    endif()
    if(key IN_LIST seen)
      vf_fail("${rel}:${lineno}" "key ${key} repeated")
    endif()
    list(APPEND seen "${key}")
    if(key STREQUAL "mode")
      if(val STREQUAL "fgbg")
        set(mode 0)
      elseif(val STREQUAL "cs")
        set(mode 1)
      else()
        vf_fail("${rel}:${lineno}" "mode ${val}")
      endif()
    elseif(key STREQUAL "display")
      if(val STREQUAL "on")
        set(display 1)
      elseif(val STREQUAL "off")
        set(display 0)
      else()
        vf_fail("${rel}:${lineno}" "display ${val}")
      endif()
    elseif(key STREQUAL "border")
      if(NOT val MATCHES "^[0-9]+$" OR val GREATER 15)
        vf_fail("${rel}:${lineno}" "border ${val}")
      endif()
      set(border "${val}")
    elseif(key STREQUAL "stack")
      # four color indices, each one hex digit 0-9A-F (the plane symbols' alphabet)
      if(NOT val MATCHES "^[0-9A-F] [0-9A-F] [0-9A-F] [0-9A-F]$")
        vf_fail("${rel}:${lineno}" "stack ${val}")
      endif()
      string(REPLACE " " "" stackdigits "${val}")
      set(stack "")
      foreach(k RANGE 0 3)
        string(SUBSTRING "${stackdigits}" ${k} 1 sd)
        string(APPEND stack "0x${sd}u, ")
      endforeach()
    elseif(key STREQUAL "fill")
      if(NOT val MATCHES "^[0-9A-F][0-9A-F][0-9A-F][0-9A-F]$")
        vf_fail("${rel}:${lineno}" "fill ${val}")
      endif()
      set(fill "0x${val}u")
    elseif(key STREQUAL "sha256-text")
      if(NOT val MATCHES "^[0-9a-f]+$")
        vf_fail("${rel}:${lineno}" "sha256-text is not lower-case hex")
      endif()
      string(LENGTH "${val}" slen)
      if(NOT slen EQUAL 64)
        vf_fail("${rel}:${lineno}" "sha256-text is not 64 digits")
      endif()
      set(sha "${val}")
    elseif(NOT key MATCHES "^(frame|tier|oracle|rules)$")
      vf_fail("${rel}:${lineno}" "unknown key ${key}")
    endif()
  endforeach()
  foreach(k mode display border stack fill sha256-text frame)
    if(NOT k IN_LIST seen)
      vf_fail("${rel}" "missing key ${k}")
    endif()
  endforeach()
  if(NOT plane_rows EQUAL 96)
    vf_fail("${rel}" "plane has ${plane_rows} rows, not 96")
  endif()
  if(n_cells EQUAL 0)
    set(cells_c "    {0u, 0u, 0u, 0u, \"\"},\n")
  endif()
  if(n_gram EQUAL 0)
    set(gram_c "    {0u, {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u}},\n")
  endif()
  string(APPEND decl_c "static const vf_cell vf_cells_${id}[] = {\n${cells_c}};\n")
  string(APPEND decl_c "static const vf_gram vf_gram_${id}[] = {\n${gram_c}};\n")
  string(APPEND decl_c "static const char *const vf_plane_${id}[96] = {\n${plane_c}};\n")
  string(APPEND table_c "    {\"${f}\", ${mode}u, ${display}u, ${border}u, {${stack}}, ${fill}, ${n_cells}u, vf_cells_${id}, ${n_gram}u, vf_gram_${id}, vf_plane_${id}, \"${sha}\", ${plane_line}u},\n")
  math(EXPR frame_count "${frame_count} + 1")
endforeach()

# The card bit-role literal: 64 rows, each variant holding the bits 15 down to 0 once.
vf_rel(cardrel "${cardfile}")
if(NOT EXISTS "${cardfile}")
  vf_fail("${cardrel}" "missing")
endif()
file(SHA256 "${cardfile}" cdigest)
string(APPEND sources_c "  {\"${cardrel}\", \"${cdigest}\"},\n")
file(STRINGS "${cardfile}" clines)
set(roles_c "")
set(nroles 0)
set(clineno 0)
foreach(line IN LISTS clines)
  math(EXPR clineno "${clineno} + 1")
  if(line STREQUAL "" OR line MATCHES "^#")
    continue()
  endif()
  string(REGEX MATCH "^(fgbg|cs-grom|cs-gram|cs-sq) ([0-9]+) ([a-z0-9]+) src=" rm "${line}")
  if(NOT rm)
    vf_fail("${cardrel}:${clineno}" "row outside the grammar")
  endif()
  if(CMAKE_MATCH_2 GREATER 15)
    vf_fail("${cardrel}:${clineno}" "bit above 15")
  endif()
  if(DEFINED seen_${CMAKE_MATCH_1}_${CMAKE_MATCH_2})
    vf_fail("${cardrel}:${clineno}" "bit ${CMAKE_MATCH_2} of ${CMAKE_MATCH_1} repeated")
  endif()
  set(seen_${CMAKE_MATCH_1}_${CMAKE_MATCH_2} 1)
  string(APPEND roles_c "    {\"${CMAKE_MATCH_1}\", ${CMAKE_MATCH_2}u, \"${CMAKE_MATCH_3}\"},\n")
  math(EXPR nroles "${nroles} + 1")
endforeach()
if(NOT nroles EQUAL 64)
  vf_fail("${cardrel}" "${nroles} rows, not 64")
endif()

set(out_c "/* Generated by cmake/IvsVideoFrames.cmake from data/video/frames/F-A1..F-A5, F-B1..F-B3 (.frame) and data/video/cards.literal.txt. Do not edit. */\n")
string(APPEND out_c "${decl_c}")
string(APPEND out_c "static const vf_frame vf_frames[${frame_count}] = {\n${table_c}};\n")
string(APPEND out_c "static const vf_role vf_roles[64] = {\n${roles_c}};\n")
string(APPEND out_c "static const ivs_test_source vf_sources[] = {\n${sources_c}};\n")
file(WRITE "${OUT}" "${out_c}")
