# SPDX-License-Identifier: MIT
# SHA-256 vector table generator and independent oracle (D-28, plan 03-02). Reads
# data/sha256/vectors.txt and writes a C initializer table to OUT (build tree only, never
# committed). Usage:
#   cmake -DROOT=<repo> -DOUT=<build>/tests/ivs_sha_vectors.inc -P cmake/IvsShaVectors.cmake
# Every line `<id> <message-spec> <sha256-hex>` is re-derived here with CMake's own
# string(SHA256) over the expanded message (lit:, pat: and rep: alike; the 1,000,000-byte rep:
# message costs about 15 ms as a CMake string, so no line is exempt), and any disagreement
# stops the build: the literal digests are checked by a second SHA-256 implementation on every
# regeneration, so the code under test never supplies its own expectations.
# Strict grammar (fail closed): ids [A-Za-z0-9._-] and unique; lit: text [A-Za-z0-9]*;
# pat:<length> with length at most 65536; rep:<char>:<count> with char [A-Za-z0-9] and count
# 1..1000000; the digest is 64 lowercase hex digits; the file holds no ';', '\', '[', ']', TAB
# or CR (they would change CMake list splitting). The SHA256 of vectors.txt is embedded as
# ivs_sha_sources[] so the tests-inventory step re-hashes the source of every result file.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsShaVectors: missing -D${required}")
  endif()
endforeach()

set(SV_REL "data/sha256/vectors.txt")
set(SV_CTX "${SV_REL}")
function(sv_fail msg)
  message(FATAL_ERROR "IvsShaVectors: ${SV_CTX}: ${msg}")
endfunction()

# The pat: alphabet: byte i of a pattern message is character (i mod 62) of this string.
set(SV_ALPHABET "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789")

# Expand a pattern message of n bytes.
function(sv_pattern out n)
  math(EXPR reps "(${n} + 61) / 62")
  string(REPEAT "${SV_ALPHABET}" ${reps} full)
  string(SUBSTRING "${full}" 0 ${n} msg)
  set(${out} "${msg}" PARENT_SCOPE)
endfunction()

# 64 lowercase hex digits -> C initializer of 32 bytes.
function(sv_bytes out hex)
  set(c "")
  foreach(i RANGE 0 62 2)
    string(SUBSTRING "${hex}" ${i} 2 b)
    string(TOUPPER "${b}" b)
    if(i EQUAL 0)
      string(APPEND c "0x${b}u")
    else()
      string(APPEND c ", 0x${b}u")
    endif()
  endforeach()
  set(${out} "{${c}}" PARENT_SCOPE)
endfunction()

if(NOT EXISTS "${ROOT}/${SV_REL}")
  sv_fail("file missing")
endif()
file(READ "${ROOT}/${SV_REL}" text)
file(SHA256 "${ROOT}/${SV_REL}" source_digest)
if(text MATCHES "[;\\\\\t\r]" OR text MATCHES "\\[" OR text MATCHES "\\]")
  sv_fail("contains one of ';' '\\' '[' ']' TAB CR")
endif()
string(REPLACE "\n" ";" lines "${text}")

set(ids "")
set(rows_c "")
set(funcs_c "")
set(cases_c "")
set(n 0)
set(lineno 0)
foreach(line IN LISTS lines)
  math(EXPR lineno "${lineno} + 1")
  if(line STREQUAL "" OR line MATCHES "^#")
    continue()
  endif()
  set(SV_CTX "${SV_REL} line ${lineno}")
  if(NOT line MATCHES "^([^ ]+) ([^ ]+) ([^ ]+)$")
    sv_fail("expected `<id> <message-spec> <sha256-hex>`")
  endif()
  set(id "${CMAKE_MATCH_1}")
  set(spec "${CMAKE_MATCH_2}")
  set(want "${CMAKE_MATCH_3}")
  if(NOT id MATCHES "^[A-Za-z0-9._-]+$")
    sv_fail("bad id '${id}'")
  endif()
  if(id IN_LIST ids)
    sv_fail("duplicate id '${id}'")
  endif()
  list(APPEND ids "${id}")
  set(SV_CTX "${id}")
  if(NOT want MATCHES "^[0-9a-f]+$")
    sv_fail("digest '${want}' is not lowercase hex")
  endif()
  string(LENGTH "${want}" want_len)
  if(NOT want_len EQUAL 64)
    sv_fail("digest '${want}' is not 64 hex digits")
  endif()
  if(spec MATCHES "^lit:([A-Za-z0-9]*)$")
    set(msg "${CMAKE_MATCH_1}")
    string(LENGTH "${msg}" len)
    set(kind "IVS_SHA_SPEC_LIT")
    set(text_c "\"${msg}\"")
    set(rep_c "0u")
  elseif(spec MATCHES "^pat:(0|[1-9][0-9]*)$")
    set(len "${CMAKE_MATCH_1}")
    if(len GREATER 65536)
      sv_fail("pattern length ${len} is above 65536")
    endif()
    sv_pattern(msg ${len})
    set(kind "IVS_SHA_SPEC_PAT")
    set(text_c "NULL")
    set(rep_c "0u")
  elseif(spec MATCHES "^rep:([A-Za-z0-9]):([1-9][0-9]*)$")
    set(ch "${CMAKE_MATCH_1}")
    set(len "${CMAKE_MATCH_2}")
    if(len GREATER 1000000)
      sv_fail("repeat count ${len} is above 1000000")
    endif()
    string(REPEAT "${ch}" ${len} msg)
    set(kind "IVS_SHA_SPEC_REP")
    set(text_c "NULL")
    set(rep_c "'${ch}'")
  else()
    sv_fail("bad message spec '${spec}'")
  endif()
  string(SHA256 got "${msg}")
  if(NOT got STREQUAL want)
    sv_fail("literal ${want} != string(SHA256) ${got}")
  endif()
  sv_bytes(bytes_c "${want}")
  string(APPEND rows_c "  {\"machine.sha256.${id}\", ${kind}, ${len}u, ${text_c}, ${rep_c}, ${bytes_c}},\n")
  string(APPEND funcs_c "static int ivs_sha_vec_case_${n}(void) { return ivs_sha_vec_run(${n}u); }\n")
  string(APPEND cases_c "  {\"machine.sha256.${id}\", ivs_sha_vec_case_${n}, NULL}, \\\n")
  math(EXPR n "${n} + 1")
endforeach()
set(SV_CTX "${SV_REL}")
if(n EQUAL 0)
  sv_fail("no vectors")
endif()

set(out_c "/* Generated by cmake/IvsShaVectors.cmake from ${SV_REL}; every digest re-derived with string(SHA256). */\n")
string(APPEND out_c "/* Build output only: never committed, never edited. */\n")
string(APPEND out_c "static const ivs_sha_vec ivs_sha_vectors[] = {\n${rows_c}};\n")
string(APPEND out_c "#define IVS_SHA_VEC_COUNT ${n}u\n")
string(APPEND out_c "${funcs_c}")
string(APPEND out_c "#define IVS_SHA_VEC_CASES \\\n${cases_c}\n")
string(APPEND out_c "static const ivs_test_source ivs_sha_sources[] = {\n  {\"${SV_REL}\", \"${source_digest}\"},\n};\n")
file(WRITE "${OUT}" "${out_c}")
