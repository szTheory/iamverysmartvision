# SPDX-License-Identifier: MIT
# STIC parameter generator (D-03, D-05, D-07, D-08, D-09, D-12, D-13, D-15, A-11, plan 06-04): reads every
# data/profiles/*.json in sorted order (the same order as the registry of cmake/IvsMemmapTable.cmake, so a
# profile's index is the same in all four tables) and writes ivs_stic_params.inc to OUT (build tree only,
# never committed). The only includer is core/src/stic/stic_params.c. No C JSON parser exists (H14).
# Usage: cmake -DROOT=<tree> -DOUT=<file> -P cmake/IvsSticTable.cmake
# The output is a pure function of the profile files: no host path, no time. Only static const data is written.
#
# Profile fields read (every one carries the profile record's tag, cite and conflict):
#   time base      ticks_per_cpu_cycle, cpu_cycles_per_scanline, scanlines_per_frame (each 1..65535) and
#                  psg.max_unit_ticks (U): the frame is F = ticks_per_cpu_cycle x cpu_cycles_per_scanline x
#                  scanlines_per_frame master ticks and must fit a uint32.
#   windows        stic.reg_window_cpu_cycles, stic.gmem_window_cpu_cycles, stic.irq_low_cpu_cycles,
#                  bus.line_sample_lag_cpu_cycles (0..65535 CPU cycles) and stic.access_strobe_ticks (0..255):
#                  every cycle value is converted to master ticks once, here.
#   bus windows    stic.bus.count (1..65535), stic.bus.rows, stic.bus.first_start_cpu_cycles,
#                  stic.bus.pitch_cpu_cycles, stic.bus.hold_cpu_cycles, stic.bus.fetch_offset_cpu_cycles.
#   frame phase    stic.frame_phase_ticks (0..F-1). A nonzero phase is allowed: the interval before the first
#                  frame start schedules nothing (the gates stay open and no line is driven).
#   registers      stic.regmap (an array of exactly 64 records {addr, name, class, wmask, rmask}, addresses
#                  $0000..$003F once each in order, class stored, strobe, collision or reserved, masks $XXXX),
#                  stic.access_effects (records {addr, access R|W, effect none|arm|mode_fgbg|mode_cs}, 1..8),
#                  stic.mode_select_addrs (1..8 distinct $XXXX addresses, each inside a memmap.region.stic_*
#                  range), stic.alias_read_sensitive (0 or 1), stic.power_on {registers "zero", mode "fgbg" or
#                  "color-stack", display_latch 0 or 1}, stic.backtab {lo, words} and stic.bus_bits (14).
#   policy         stic.irq_line "INTRM", stic.late_grant "fetch-at-schedule", stic.access_gating_when_off "apply",
#                  video.display_off_fill "border", video.last_card_column_drop "right": the only values the
#                  engine implements; any other value is refused and names the missing implementation.
#   video          video.card_columns, video.card_rows, video.card_size_px {w, h}, video.object_grid {w, h},
#                  video.colors, video.last_card_column_px, video.row_lines, video.blank_value and
#                  stic.video_slack_frames. The generator does NOT read data/video/geometry.literal.txt: the
#                  width is DERIVED as (card_columns - 1) x card_w + last_card_column_px, so a one-field reversal
#                  of last_card_column_px to 8 gives 160 with no literal edited (the literal is compared by tests).
#
# Fail closed (message `IvsSticTable: <profile>: <field>: <reason>`): a missing field, a field of a wrong type or
# outside its range, an unknown or missing record key, a tag of tier5-emulator-hint, an unknown-default-chosen field
# without resolving evidence or revisit trigger, a regmap that is not exactly 64 records with addresses $0000..$003F
# once each, a mask above 16 bits, a policy selector other than the implemented value, and the relations
#   first_start + (count - 1) x pitch + hold <= frame cycles         (the window train fits the frame)
#   pitch >= hold                                                    (windows do not overlap)
#   fetch_offset <= hold                                             (the row latch is inside its window)
#   rows <= count and 4 + rows <= 16                                 (a window per row; the event table holds 16)
#   reg_window <= gmem_window <= first_start                         (the access windows close in order)
#   irq_low <= frame cycles, frame_phase_ticks < F, every product within a uint32
#   1 <= last_card_column_px <= card_w, width <= grid.w, height <= grid.h, blank_value >= colors
#   2 x psg.max_unit_ticks < F and video_slack_frames == ceil(U / F)  (the D-15 capacity rule)
#   bus.release_latency_cpu_cycles x ticks_per_cpu_cycle <= psg.max_unit_ticks  (plan 06-08: the release unit of a bus grant is within U)
#   backtab words == card_columns x card_rows, stic_regs spans $0000..$003F.
#
# Output: IVS_STIC_PROFILE_COUNT and ivs_stic_params_table[profile] (designated initializers of the members of
# ivs_stic_params, core/src/stic/stic_params.h) with _Static_asserts on the counts. The per-frame event table has
# 4 + rows entries in ascending tick order, ticks counted from the frame start: FRAME_START at 0, REG_CLOSE,
# GMEM_CLOSE, ROW_FETCH(i) at first_start + i x pitch + fetch_offset for i below rows, and FRAME_END at F.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsSticTable: missing -D${required}")
  endif()
endforeach()

set(ST_CTX "")
function(st_fail msg)
  message(FATAL_ERROR "IvsSticTable: ${ST_CTX}: ${msg}")
endfunction()

# JSON type of a path in a document, or MISSING.
function(st_type out doc)
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" ${ARGN})
  if(NOT "${e}" STREQUAL "NOTFOUND")
    set(t MISSING)
  endif()
  set(${out} "${t}" PARENT_SCOPE)
endfunction()

# The member keys of an object must be exactly the listed keys (unknown and missing both fail).
function(st_keys doc what)
  string(JSON n LENGTH "${doc}")
  set(seen "")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON k MEMBER "${doc}" ${i})
      if(NOT k IN_LIST ARGN)
        st_fail("unknown ${what} key '${k}'")
      endif()
      list(APPEND seen "${k}")
    endforeach()
  endif()
  foreach(k IN LISTS ARGN)
    if(NOT k IN_LIST seen)
      st_fail("missing ${what} key '${k}'")
    endif()
  endforeach()
endfunction()

# Required string at a path.
function(st_str out doc what)
  st_type(t "${doc}" ${ARGN})
  if(NOT t STREQUAL "STRING")
    st_fail("${what} must be a string")
  endif()
  string(JSON v GET "${doc}" ${ARGN})
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Required non-negative integer at a path, at most max.
function(st_uint out doc what max)
  st_type(t "${doc}" ${ARGN})
  if(NOT t STREQUAL "NUMBER")
    st_fail("${what} must be a number")
  endif()
  string(JSON v GET "${doc}" ${ARGN})
  if(NOT v MATCHES "^[0-9]+$")
    st_fail("${what} '${v}' is not a non-negative integer")
  endif()
  if(v GREATER ${max})
    st_fail("${what} ${v} is above ${max}")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# "$XXXX" -> numeric value.
function(st_hex out s what)
  if(NOT s MATCHES "^[$][0-9A-F][0-9A-F][0-9A-F][0-9A-F]$")
    st_fail("${what} '${s}' is not a \$XXXX hex word")
  endif()
  string(SUBSTRING "${s}" 1 4 digits)
  math(EXPR v "0x${digits}")
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Four-digit uppercase C literal of a number.
function(st_lit out v)
  math(EXPR h "${v}" OUTPUT_FORMAT HEXADECIMAL)
  string(SUBSTRING "${h}" 2 -1 h)
  string(TOUPPER "${h}" h)
  string(LENGTH "${h}" n)
  while(n LESS 4)
    set(h "0${h}")
    math(EXPR n "${n} + 1")
  endwhile()
  set(${out} "0x${h}u" PARENT_SCOPE)
endfunction()

# A field record the generator reads: present, a tag that is not tier5-emulator-hint, and an
# unknown-default-chosen field carries resolving evidence and a revisit trigger (D-04, T-11).
function(st_field doc name)
  set(ST_CTX "${ST_PROFILE}: ${name}")
  st_type(t "${doc}" fields ${name})
  if(NOT t STREQUAL "OBJECT")
    st_fail("missing")
  endif()
  st_str(tag "${doc}" "tag" fields ${name} tag)
  if(tag STREQUAL "tier5-emulator-hint")
    st_fail("tag tier5-emulator-hint is never the tag of a profile field")
  endif()
  if(tag STREQUAL "unknown-default-chosen")
    foreach(k resolving_evidence revisit_trigger)
      st_type(t "${doc}" fields ${name} ${k})
      if(NOT t STREQUAL "STRING")
        st_fail("an unknown-default-chosen field needs ${k}")
      endif()
      string(JSON v GET "${doc}" fields ${name} ${k})
      string(STRIP "${v}" v)
      if(v STREQUAL "")
        st_fail("an unknown-default-chosen field needs a nonblank ${k}")
      endif()
    endforeach()
  endif()
endfunction()

# A numeric field value in 0..max (macros: the result lands in the caller's scope).
macro(st_num var field max)
  st_field("${doc}" ${field})
  set(ST_CTX "${rel}: ${field}")
  st_uint(${var} "${doc}" "value" ${max} fields ${field} value)
endmacro()

# A string field value that must be the one implemented policy.
macro(st_policy var field want missing_impl)
  st_field("${doc}" ${field})
  set(ST_CTX "${rel}: ${field}")
  st_str(${var} "${doc}" "value" fields ${field} value)
  if(NOT "${${var}}" STREQUAL "${want}")
    st_fail("value '${${var}}' is not '${want}' (${missing_impl})")
  endif()
endmacro()

# A {w, h} object with both members in 1..max.
macro(st_dims wvar hvar field max)
  st_field("${doc}" ${field})
  set(ST_CTX "${rel}: ${field}")
  st_type(t "${doc}" fields ${field} value)
  if(NOT t STREQUAL "OBJECT")
    st_fail("value must be an object {\"w\": n, \"h\": n}")
  endif()
  string(JSON dobj GET "${doc}" fields ${field} value)
  st_keys("${dobj}" "value" w h)
  st_uint(${wvar} "${dobj}" "w" ${max} w)
  st_uint(${hvar} "${dobj}" "h" ${max} h)
  if(${wvar} EQUAL 0 OR ${hvar} EQUAL 0)
    st_fail("w and h must be at least 1")
  endif()
endmacro()

# Comma-joined C initializer list from a CMake list.
function(st_join out)
  list(JOIN ARGN ", " s)
  set(${out} "${s}" PARENT_SCOPE)
endfunction()

file(GLOB st_profiles RELATIVE "${ROOT}" "${ROOT}/data/profiles/*.json")
list(SORT st_profiles)
if(NOT st_profiles)
  set(ST_CTX "data/profiles")
  st_fail("no profile file")
endif()
list(LENGTH st_profiles n_profiles)

set(table_c "")
foreach(rel IN LISTS st_profiles)
  file(READ "${ROOT}/${rel}" doc)
  set(ST_PROFILE "${rel}")
  set(ST_CTX "${rel}: id")
  st_str(pid "${doc}" "profile id" id)

  # ---- time base and frame length
  st_num(tpc ticks_per_cpu_cycle 65535)
  st_num(cpc cpu_cycles_per_scanline 65535)
  st_num(spf scanlines_per_frame 65535)
  if(tpc EQUAL 0 OR cpc EQUAL 0 OR spf EQUAL 0)
    st_fail("ticks_per_cpu_cycle, cpu_cycles_per_scanline and scanlines_per_frame must each be at least 1")
  endif()
  math(EXPR frame_cycles "${cpc} * ${spf}")
  math(EXPR frame_ticks "${frame_cycles} * ${tpc}")
  set(ST_CTX "${rel}: frame length")
  if(frame_ticks GREATER 4294967295)
    st_fail("F ${frame_ticks} = ticks_per_cpu_cycle x cpu_cycles_per_scanline x scanlines_per_frame does not fit a uint32")
  endif()
  st_num(unit_max psg.max_unit_ticks 4294967295)
  set(ST_CTX "${rel}: psg.max_unit_ticks")
  math(EXPR two_u "2 * ${unit_max}")
  if(NOT two_u LESS frame_ticks)
    st_fail("2 x U (${two_u}) is not below the frame F (${frame_ticks}): the capacity rule of D-15 assumes U < F and the frame events of one call stay at floor(D / F) + 2")
  endif()
  math(EXPR slack_want "(${unit_max} + ${frame_ticks} - 1) / ${frame_ticks}")
  st_num(slack stic.video_slack_frames 255)
  set(ST_CTX "${rel}: stic.video_slack_frames")
  if(NOT slack EQUAL slack_want)
    st_fail("value ${slack} is not ceil(U / F) (${slack_want}) with U ${unit_max} and F ${frame_ticks}")
  endif()

  # ---- the bus-grant release unit is bounded by U (plan 06-08, D-10): the grant and hold units are 1 cycle, the release unit
  # bus.release_latency_cpu_cycles; the interrupt entry (a CPU constant of 9 cycles) is covered by the runtime probe
  # stic.bounds.g-and-u-full-machine.
  st_num(release_lat bus.release_latency_cpu_cycles 65535)
  set(ST_CTX "bounds")
  math(EXPR release_ticks "${release_lat} * ${tpc}")
  if(release_ticks GREATER unit_max)
    st_fail("${rel}: bus.release_latency_cpu_cycles ${release_lat} x ticks_per_cpu_cycle ${tpc} = ${release_ticks} ticks exceeds psg.max_unit_ticks ${unit_max}; a bus-grant release unit longer than U would break the published bounds")
  endif()

  # ---- frame phase
  st_num(phase stic.frame_phase_ticks 4294967295)
  set(ST_CTX "${rel}: stic.frame_phase_ticks")
  if(NOT phase LESS frame_ticks)
    st_fail("value ${phase} is not below the frame length ${frame_ticks}")
  endif()

  # ---- windows, line, sampling lag (CPU cycles, converted once to ticks)
  st_num(reg_win stic.reg_window_cpu_cycles 65535)
  st_num(gmem_win stic.gmem_window_cpu_cycles 65535)
  st_num(irq_low stic.irq_low_cpu_cycles 65535)
  st_num(lag bus.line_sample_lag_cpu_cycles 65535)
  st_num(strobe stic.access_strobe_ticks 255)
  st_num(bus_count stic.bus.count 65535)
  st_num(bus_rows stic.bus.rows 65535)
  st_num(first_start stic.bus.first_start_cpu_cycles 65535)
  st_num(pitch stic.bus.pitch_cpu_cycles 65535)
  st_num(hold stic.bus.hold_cpu_cycles 65535)
  st_num(fetch_off stic.bus.fetch_offset_cpu_cycles 65535)
  set(ST_CTX "${rel}: stic.bus.count")
  if(bus_count EQUAL 0)
    st_fail("must be at least 1")
  endif()
  set(ST_CTX "${rel}: stic.bus.rows")
  if(bus_rows EQUAL 0)
    st_fail("must be at least 1")
  endif()
  if(bus_rows GREATER bus_count)
    st_fail("rows ${bus_rows} is above the window count ${bus_count} (a card row needs a window)")
  endif()
  math(EXPR n_events "4 + ${bus_rows}")
  if(n_events GREATER 16)
    st_fail("rows ${bus_rows} gives ${n_events} frame events, the table holds 16 (at most 12 rows)")
  endif()
  set(ST_CTX "${rel}: stic.bus.hold_cpu_cycles")
  if(pitch LESS hold)
    st_fail("pitch ${pitch} is below the hold ${hold}: bus windows would overlap")
  endif()
  set(ST_CTX "${rel}: stic.bus.fetch_offset_cpu_cycles")
  if(fetch_off GREATER hold)
    st_fail("offset ${fetch_off} is above the hold ${hold}: the row latch would fall outside its window")
  endif()
  set(ST_CTX "${rel}: stic.bus")
  math(EXPR train_end "${first_start} + (${bus_count} - 1) * ${pitch} + ${hold}")
  if(train_end GREATER frame_cycles)
    st_fail("the window train ends at cycle ${train_end}, after the frame end ${frame_cycles}: first_start + (count - 1) x pitch + hold must not exceed the frame")
  endif()
  set(ST_CTX "${rel}: stic.gmem_window_cpu_cycles")
  if(reg_win GREATER gmem_win)
    st_fail("the register window ${reg_win} is longer than the graphics-memory window ${gmem_win}")
  endif()
  if(gmem_win GREATER first_start)
    st_fail("the graphics-memory window ${gmem_win} is longer than the time to the first bus window ${first_start}")
  endif()
  set(ST_CTX "${rel}: stic.irq_low_cpu_cycles")
  if(irq_low GREATER frame_cycles)
    st_fail("value ${irq_low} is longer than the frame ${frame_cycles}")
  endif()
  math(EXPR reg_win_t "${reg_win} * ${tpc}")
  math(EXPR gmem_win_t "${gmem_win} * ${tpc}")
  math(EXPR irq_low_t "${irq_low} * ${tpc}")
  math(EXPR lag_t "${lag} * ${tpc}")
  math(EXPR first_start_t "${first_start} * ${tpc}")
  math(EXPR pitch_t "${pitch} * ${tpc}")
  math(EXPR hold_t "${hold} * ${tpc}")
  math(EXPR fetch_off_t "${fetch_off} * ${tpc}")
  foreach(v ${reg_win_t} ${gmem_win_t} ${irq_low_t} ${lag_t} ${first_start_t} ${pitch_t} ${hold_t} ${fetch_off_t})
    if(v GREATER 4294967295)
      set(ST_CTX "${rel}: tick conversion")
      st_fail("a cycle value converts to ${v} ticks, which does not fit a uint32")
    endif()
  endforeach()

  # ---- policy selectors (only the implemented value)
  st_policy(irq_line stic.irq_line "INTRM" "no other interrupt line is implemented")
  st_policy(late_grant stic.late_grant "fetch-at-schedule" "no waiting-for-grant policy is implemented")
  st_policy(gating_off stic.access_gating_when_off "apply" "no policy that opens the windows while the display is off is implemented")
  st_policy(off_fill video.display_off_fill "border" "no other display-off fill is implemented")
  st_policy(drop video.last_card_column_drop "right" "no left clip of the 20th card column is implemented")

  # ---- STIC bus width and the BACKTAB span
  st_num(bus_bits stic.bus_bits 255)
  set(ST_CTX "${rel}: stic.bus_bits")
  if(NOT bus_bits EQUAL 14)
    st_fail("value ${bus_bits} is not 14 (the STIC data bus is 14 bits wide)")
  endif()

  # ---- video geometry
  st_num(cards_x video.card_columns 255)
  st_num(cards_y video.card_rows 255)
  if(cards_x EQUAL 0 OR cards_y EQUAL 0)
    set(ST_CTX "${rel}: video.card_columns")
    st_fail("video.card_columns and video.card_rows must each be at least 1")
  endif()
  st_dims(card_w card_h video.card_size_px 255)
  st_dims(grid_w grid_h video.object_grid 65535)
  st_num(colors video.colors 255)
  st_num(last_px video.last_card_column_px 255)
  st_num(row_lines video.row_lines 255)
  st_num(blank video.blank_value 255)
  set(ST_CTX "${rel}: video.colors")
  if(colors EQUAL 0)
    st_fail("must be at least 1")
  endif()
  set(ST_CTX "${rel}: video.last_card_column_px")
  if(last_px EQUAL 0 OR last_px GREATER card_w)
    st_fail("value ${last_px} is not in 1..${card_w} (the card width)")
  endif()
  set(ST_CTX "${rel}: video.blank_value")
  if(blank LESS colors)
    st_fail("value ${blank} is below video.colors ${colors}: the not-displayed marker would be a color")
  endif()
  math(EXPR width "(${cards_x} - 1) * ${card_w} + ${last_px}")
  math(EXPR height "${cards_y} * ${card_h}")
  set(ST_CTX "${rel}: video.object_grid")
  if(width GREATER grid_w OR height GREATER grid_h)
    st_fail("the published ${width} x ${height} does not fit the ${grid_w} x ${grid_h} grid")
  endif()
  math(EXPR plane "${width} * ${height}")
  set(header 32)
  math(EXPR slot "${header} + ${plane}")

  st_field("${doc}" stic.backtab)
  set(ST_CTX "${rel}: stic.backtab")
  st_type(t "${doc}" fields stic.backtab value)
  if(NOT t STREQUAL "OBJECT")
    st_fail("value must be an object {\"lo\": \"$XXXX\", \"words\": n}")
  endif()
  string(JSON bobj GET "${doc}" fields stic.backtab value)
  st_keys("${bobj}" "value" lo words)
  st_str(s "${bobj}" "lo" lo)
  st_hex(backtab_lo "${s}" "lo")
  st_uint(backtab_words "${bobj}" "words" 65535 words)
  math(EXPR want "${cards_x} * ${cards_y}")
  if(NOT backtab_words EQUAL want)
    st_fail("words ${backtab_words} is not video.card_columns x video.card_rows (${want})")
  endif()

  # ---- STIC regions: stic_regs spans $0000..$003F; every mode-select address lies in a stic region
  set(ST_CTX "${rel}: memmap.region.stic_regs")
  st_type(t "${doc}" fields memmap.region.stic_regs value)
  if(NOT t STREQUAL "OBJECT")
    st_fail("missing")
  endif()
  st_str(s "${doc}" "lo" fields memmap.region.stic_regs value lo)
  st_hex(r_lo "${s}" "lo")
  st_str(s "${doc}" "hi" fields memmap.region.stic_regs value hi)
  st_hex(r_hi "${s}" "hi")
  if(NOT r_lo EQUAL 0 OR NOT r_hi EQUAL 63)
    st_fail("the region is not \$0000..\$003F (the 64 registers of stic.regmap)")
  endif()
  set(stic_regions "")
  string(JSON nfields LENGTH "${doc}" fields)
  math(EXPR lastf "${nfields} - 1")
  foreach(fi RANGE 0 ${lastf})
    string(JSON fk MEMBER "${doc}" fields ${fi})
    if(fk MATCHES "^memmap[.]region[.]stic_")
      set(ST_CTX "${rel}: ${fk}")
      st_str(s "${doc}" "lo" fields ${fk} value lo)
      st_hex(g_lo "${s}" "lo")
      st_str(s "${doc}" "hi" fields ${fk} value hi)
      st_hex(g_hi "${s}" "hi")
      list(APPEND stic_regions "${g_lo}:${g_hi}")
    endif()
  endforeach()

  # ---- stic.regmap: sixty-four records
  st_field("${doc}" stic.regmap)
  set(ST_CTX "${rel}: stic.regmap")
  st_type(t "${doc}" fields stic.regmap value)
  if(NOT t STREQUAL "ARRAY")
    st_fail("value must be an array of 64 records")
  endif()
  string(JSON nrec LENGTH "${doc}" fields stic.regmap value)
  if(NOT nrec EQUAL 64)
    st_fail("has ${nrec} records, want exactly 64 (addresses \$0000..\$003F)")
  endif()
  set(wm_l "")
  set(rm_l "")
  set(cl_l "")
  foreach(i RANGE 0 63)
    set(ST_CTX "${rel}: stic.regmap[${i}]")
    st_type(t "${doc}" fields stic.regmap value ${i})
    if(NOT t STREQUAL "OBJECT")
      st_fail("record must be an object")
    endif()
    string(JSON rec GET "${doc}" fields stic.regmap value ${i})
    st_keys("${rec}" "record" addr name class wmask rmask)
    st_str(s "${rec}" "addr" addr)
    st_hex(addr "${s}" "addr")
    if(NOT addr EQUAL i)
      st_lit(want_l "${i}")
      st_fail("addr '${s}' is not the next address ${want_l} of the block \$0000..\$003F in order")
    endif()
    st_str(nm "${rec}" "name" name)
    if(NOT nm MATCHES "^[a-z][a-z0-9-]*$")
      st_fail("name '${nm}' is not lowercase letters, digits and dashes")
    endif()
    st_str(cls "${rec}" "class" class)
    if(cls STREQUAL "stored")
      set(cls_c "IVS_STIC_CLASS_STORED")
    elseif(cls STREQUAL "strobe")
      set(cls_c "IVS_STIC_CLASS_STROBE")
    elseif(cls STREQUAL "collision")
      set(cls_c "IVS_STIC_CLASS_COLLISION")
    elseif(cls STREQUAL "reserved")
      set(cls_c "IVS_STIC_CLASS_RESERVED")
    else()
      st_fail("class '${cls}' is not stored, strobe, collision or reserved")
    endif()
    st_str(s "${rec}" "wmask" wmask)
    st_hex(wmask "${s}" "wmask")
    st_str(s "${rec}" "rmask" rmask)
    st_hex(rmask "${s}" "rmask")
    st_lit(wm "${wmask}")
    st_lit(rm "${rmask}")
    list(APPEND wm_l "${wm}")
    list(APPEND rm_l "${rm}")
    list(APPEND cl_l "${cls_c}")
  endforeach()

  # ---- stic.access_effects: rows {addr, access, effect}
  st_field("${doc}" stic.access_effects)
  set(ST_CTX "${rel}: stic.access_effects")
  st_type(t "${doc}" fields stic.access_effects value)
  if(NOT t STREQUAL "ARRAY")
    st_fail("value must be an array of rows {addr, access, effect}")
  endif()
  string(JSON n_eff LENGTH "${doc}" fields stic.access_effects value)
  if(n_eff LESS 1 OR n_eff GREATER 8)
    st_fail("has ${n_eff} rows, want 1..8")
  endif()
  set(ea_l "")
  set(ek_l "")
  set(ec_l "")
  set(eff_seen "")
  math(EXPR last_eff "${n_eff} - 1")
  foreach(i RANGE 0 ${last_eff})
    set(ST_CTX "${rel}: stic.access_effects[${i}]")
    st_type(t "${doc}" fields stic.access_effects value ${i})
    if(NOT t STREQUAL "OBJECT")
      st_fail("row must be an object")
    endif()
    string(JSON rec GET "${doc}" fields stic.access_effects value ${i})
    st_keys("${rec}" "row" addr access effect)
    st_str(s "${rec}" "addr" addr)
    st_hex(addr "${s}" "addr")
    if(addr GREATER 63)
      st_fail("addr '${s}' is not a register address (\$0000..\$003F)")
    endif()
    st_str(acc "${rec}" "access" access)
    if(acc STREQUAL "R")
      set(acc_c "IVS_STIC_ACCESS_READ")
    elseif(acc STREQUAL "W")
      set(acc_c "IVS_STIC_ACCESS_WRITE")
    else()
      st_fail("access '${acc}' is not R or W")
    endif()
    st_str(eff "${rec}" "effect" effect)
    if(eff STREQUAL "none")
      set(eff_c "IVS_STIC_EFFECT_NONE")
    elseif(eff STREQUAL "arm")
      set(eff_c "IVS_STIC_EFFECT_ARM")
    elseif(eff STREQUAL "mode_fgbg")
      set(eff_c "IVS_STIC_EFFECT_MODE_FGBG")
    elseif(eff STREQUAL "mode_cs")
      set(eff_c "IVS_STIC_EFFECT_MODE_CS")
    else()
      st_fail("effect '${eff}' is not none, arm, mode_fgbg or mode_cs")
    endif()
    if("${addr}:${acc}" IN_LIST eff_seen)
      st_fail("addr '${s}' access ${acc} appears twice")
    endif()
    list(APPEND eff_seen "${addr}:${acc}")
    st_lit(a_l "${addr}")
    list(APPEND ea_l "${a_l}")
    list(APPEND ek_l "${acc_c}")
    list(APPEND ec_l "${eff_c}")
  endforeach()

  # ---- stic.mode_select_addrs
  st_field("${doc}" stic.mode_select_addrs)
  set(ST_CTX "${rel}: stic.mode_select_addrs")
  st_type(t "${doc}" fields stic.mode_select_addrs value)
  if(NOT t STREQUAL "ARRAY")
    st_fail("value must be an array of \$XXXX addresses")
  endif()
  string(JSON n_mode LENGTH "${doc}" fields stic.mode_select_addrs value)
  if(n_mode LESS 1 OR n_mode GREATER 8)
    st_fail("has ${n_mode} addresses, want 1..8")
  endif()
  set(ma_l "")
  set(ma_seen "")
  math(EXPR last_mode "${n_mode} - 1")
  foreach(i RANGE 0 ${last_mode})
    st_str(s "${doc}" "address ${i}" fields stic.mode_select_addrs value ${i})
    st_hex(addr "${s}" "address ${i}")
    if(addr IN_LIST ma_seen)
      st_fail("address '${s}' appears twice")
    endif()
    list(APPEND ma_seen "${addr}")
    set(inside FALSE)
    foreach(rg IN LISTS stic_regions)
      string(REPLACE ":" ";" rgp "${rg}")
      list(GET rgp 0 g_lo)
      list(GET rgp 1 g_hi)
      if(NOT addr LESS g_lo AND NOT addr GREATER g_hi)
        set(inside TRUE)
      endif()
    endforeach()
    if(NOT inside)
      st_fail("address '${s}' is inside no memmap.region.stic_* range")
    endif()
    st_lit(a_l "${addr}")
    list(APPEND ma_l "${a_l}")
  endforeach()
  st_num(alias_sens stic.alias_read_sensitive 1)

  # ---- stic.power_on
  st_field("${doc}" stic.power_on)
  set(ST_CTX "${rel}: stic.power_on")
  st_type(t "${doc}" fields stic.power_on value)
  if(NOT t STREQUAL "OBJECT")
    st_fail("value must be an object {\"registers\": \"zero\", \"mode\": ..., \"display_latch\": 0 or 1}")
  endif()
  string(JSON pobj GET "${doc}" fields stic.power_on value)
  st_keys("${pobj}" "value" registers mode display_latch)
  st_str(s "${pobj}" "registers" registers)
  if(NOT s STREQUAL "zero")
    st_fail("registers '${s}' is not 'zero' (the register fill is power_on_fill.stic)")
  endif()
  st_str(s "${pobj}" "mode" mode)
  if(s STREQUAL "fgbg")
    set(pmode_c "IVS_STIC_MODE_FGBG")
  elseif(s STREQUAL "color-stack")
    set(pmode_c "IVS_STIC_MODE_COLOR_STACK")
  else()
    st_fail("mode '${s}' is not 'fgbg' or 'color-stack'")
  endif()
  st_uint(pl "${pobj}" "display_latch" 1 display_latch)

  # ---- the per-frame event table, ticks from the frame start, ascending
  set(ev_t "0")
  set(ev_k "IVS_STIC_EV_FRAME_START")
  set(ev_a "0")
  list(APPEND ev_t "${reg_win_t}" "${gmem_win_t}")
  list(APPEND ev_k "IVS_STIC_EV_REG_CLOSE" "IVS_STIC_EV_GMEM_CLOSE")
  list(APPEND ev_a "0" "0")
  math(EXPR last_row "${bus_rows} - 1")
  foreach(i RANGE 0 ${last_row})
    math(EXPR tk "${first_start_t} + ${i} * ${pitch_t} + ${fetch_off_t}")
    list(APPEND ev_t "${tk}")
    list(APPEND ev_k "IVS_STIC_EV_ROW_FETCH")
    list(APPEND ev_a "${i}")
  endforeach()
  list(APPEND ev_t "${frame_ticks}")
  list(APPEND ev_k "IVS_STIC_EV_FRAME_END")
  list(APPEND ev_a "0")
  set(prev 0)
  foreach(tk IN LISTS ev_t)
    if(tk LESS prev OR tk GREATER frame_ticks)
      set(ST_CTX "${rel}: stic frame events")
      st_fail("event tick ${tk} is out of order or past the frame end ${frame_ticks}")
    endif()
    set(prev "${tk}")
  endforeach()
  list(TRANSFORM ev_t APPEND "u")
  list(TRANSFORM ev_a APPEND "u")

  st_join(wm_c ${wm_l})
  st_join(rm_c ${rm_l})
  st_join(cl_c ${cl_l})
  st_join(ma_c ${ma_l})
  st_join(ea_c ${ea_l})
  st_join(ek_c ${ek_l})
  st_join(ec_c ${ec_l})
  st_join(evt_c ${ev_t})
  st_join(evk_c ${ev_k})
  st_join(eva_c ${ev_a})
  string(APPEND table_c "  { /* ${pid} */\n"
    "    .ticks_per_cpu_cycle = ${tpc}u, .frame_ticks = ${frame_ticks}u, .frame_phase_ticks = ${phase}u,\n"
    "    .reg_window_cycles = ${reg_win}u, .reg_window_ticks = ${reg_win_t}u,\n"
    "    .gmem_window_cycles = ${gmem_win}u, .gmem_window_ticks = ${gmem_win_t}u,\n"
    "    .irq_low_cycles = ${irq_low}u, .irq_low_ticks = ${irq_low_t}u,\n"
    "    .line_sample_lag_cycles = ${lag}u, .line_sample_lag_ticks = ${lag_t}u,\n"
    "    .access_strobe_ticks = ${strobe}u,\n"
    "    .bus_count = ${bus_count}u, .bus_rows = ${bus_rows}u,\n"
    "    .bus_first_start_cycles = ${first_start}u, .bus_first_start_ticks = ${first_start_t}u,\n"
    "    .bus_pitch_cycles = ${pitch}u, .bus_pitch_ticks = ${pitch_t}u,\n"
    "    .bus_hold_cycles = ${hold}u, .bus_hold_ticks = ${hold_t}u,\n"
    "    .bus_fetch_offset_cycles = ${fetch_off}u, .bus_fetch_offset_ticks = ${fetch_off_t}u,\n"
    "    .event_count = ${n_events}u,\n"
    "    .event_tick = {${evt_c}},\n"
    "    .event_kind = {${evk_c}},\n"
    "    .event_arg = {${eva_c}},\n"
    "    .reg_wmask = {${wm_c}},\n"
    "    .reg_rmask = {${rm_c}},\n"
    "    .reg_class = {${cl_c}},\n"
    "    .mode_addr_count = ${n_mode}u, .mode_addr = {${ma_c}},\n"
    "    .effect_count = ${n_eff}u, .effect_addr = {${ea_c}},\n"
    "    .effect_access = {${ek_c}},\n"
    "    .effect_code = {${ec_c}},\n"
    "    .alias_read_sensitive = ${alias_sens}u,\n"
    "    .backtab_lo = ${backtab_lo}u, .backtab_words = ${backtab_words}u,\n"
    "    .power_on_mode = ${pmode_c}, .power_on_display_latch = ${pl}u,\n"
    "    .video_card_columns = ${cards_x}u, .video_card_rows = ${cards_y}u,\n"
    "    .video_card_w = ${card_w}u, .video_card_h = ${card_h}u,\n"
    "    .video_grid_w = ${grid_w}u, .video_grid_h = ${grid_h}u, .video_colors = ${colors}u,\n"
    "    .video_width = ${width}u, .video_height = ${height}u, .video_stride = ${width}u,\n"
    "    .video_plane_bytes = ${plane}u, .video_header_bytes = ${header}u, .video_slot_bytes = ${slot}u,\n"
    "    .video_slack_frames = ${slack}u, .video_row_lines = ${row_lines}u,\n"
    "    .video_last_column_px = ${last_px}u, .video_blank_value = ${blank}u,\n"
    "    .video_display_off_fill = IVS_STIC_FILL_BORDER\n  },\n")
endforeach()

set(out_c "/* Generated by cmake/IvsSticTable.cmake from the files in data/profiles (plan 06-04). */\n")
string(APPEND out_c "/* Build output only: never committed, never edited. */\n")
string(APPEND out_c "#define IVS_STIC_PROFILE_COUNT ${n_profiles}u\n")
string(APPEND out_c "_Static_assert(IVS_STIC_REG_COUNT == 64u, \"the generator emits 64 register rows\");\n")
string(APPEND out_c "_Static_assert(IVS_STIC_EVENT_MAX == 16u, \"the generator emits at most 16 frame events\");\n")
string(APPEND out_c "static const ivs_stic_params ivs_stic_params_table[IVS_STIC_PROFILE_COUNT] = {\n${table_c}};\n")
string(APPEND out_c "_Static_assert(sizeof ivs_stic_params_table / sizeof ivs_stic_params_table[0] == IVS_STIC_PROFILE_COUNT, \"one parameter row per profile\");\n")
file(WRITE "${OUT}" "${out_c}")
