# SPDX-License-Identifier: MIT
# PSG parameter generator (D-08, D-12, A-06, plan 05-04): reads every data/profiles/*.json in sorted
# order (the same order as the registry of cmake/IvsMemmapTable.cmake, so a profile's index is the
# same in both tables) and writes ivs_psg_params.inc to OUT (build tree only, never committed). The
# only includer is core/src/psg/psg_regs.c. No C JSON parser exists (H14).
# Usage: cmake -DROOT=<tree> -DOUT=<file> -P cmake/IvsPsgTable.cmake
# The output is a pure function of the profile files: no host path, no time.
#
# Profile fields read (every one carries the profile record's tag, cite and conflict):
#   psg.regmap   array of exactly 16 records {addr, name, gi_octal, wmask, rmask}, ascending CPU
#                addresses "$01F0".."$01FF" (hex values are "$XXXX": four uppercase digits);
#                name is lowercase letters and dashes, unique; gi_octal is the data sheet register
#                number in octal ("R0".."R17"), unique; wmask and rmask are at most "$00FF": only the
#                low byte of a bus word is driven (C64). A store keeps value & wmask, a read gives the
#                store & rmask.
#   psg.mirrors  "none" (C74): the only value implemented.
#   input.line_idle        "$XX" (D-02): the low byte a port in input mode reads with no switch closed.
#   input.port_output_read "latch" (C65): the only value implemented; a port in output mode reads its latch.
#   psg.mixer.port_dir_bits  {"A": a, "B": b, "output": o} (D-04, C73): the bit numbers 0..7 of the mixer
#                register that select the direction of port 0 (A) and port 1 (B), and the bit value (0 or 1)
#                that means output; A and B differ.
#   (plan 05-06, D-09, D-10, D-15, D-17) the time chain and the tone, mixer and amplitude rules:
#   psg.clocks_per_step (1..255), ticks_per_psg_clock (1..65535), psg.sample_period_ticks (must equal their
#                product), psg.counter_model ("down-reload" only), psg.period_zero.tone (1..4096),
#                psg.mixer.bits {"polarity": 0, "tone": [b, b, b], "noise": [b, b, b]} (six distinct bit numbers
#                0..7), psg.amp.env_select {"fixed": [hi, lo], "select": [hi, lo], "shift": [s1, s2, s3]} (the
#                fixed field is 4 bits wide at bit 0, the select field 2 bits wide, shifts 0..3), psg.reset
#                (an object with the keys registers, tone_output, tone_counter, lfsr, envelope, ports; registers
#                "zero", tone_output 0, tone_counter "reload-on-first-step"), psg.clock_phase_ticks (0 only),
#                psg.write_strobe_ticks (0..255) and psg.max_unit_ticks (must equal
#                (12 + 3 * bus.wait_limit_cpu_cycles) * ticks_per_cpu_cycle).
# Later plans append their psg.* fields to this generator and to ivs_psg_params.
#
# Fail closed (message `IvsPsgTable: <profile>: <field>: <reason>`): a profile without psg.regmap
# or psg.mirrors; a regmap that is not an array of exactly 16 records; a record that is not an
# object, or has a missing or unknown key; an addr that is not the next of $01F0..$01FF in order
# (a gap, a duplicate, a wrong order, or a value outside the block); a name or gi_octal of a wrong
# shape or used twice; a mask that is not a $XXXX word or has a bit above the low byte; a mirrors
# value other than "none"; (plan 05-05) an input.line_idle that is not $XX, an input.port_output_read other
# than "latch", a psg.mixer.port_dir_bits that is not an object with exactly the keys A, B and output,
# a bit number above 7 or non-numeric, A equal to B, or an output value other than 0 or 1.
#
# Output: IVS_PSG_PROFILE_COUNT, ivs_psg_params_table[profile] ({reg_wmask[16]}, {reg_rmask[16]},
# port_idle, port_output_read_latch, port_dir_bit[2], port_dir_output, then the plan 05-06 members as
# designated initializers), and _Static_asserts on the counts.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsPsgTable: missing -D${required}")
  endif()
endforeach()

set(PT_CTX "")
function(pt_fail msg)
  message(FATAL_ERROR "IvsPsgTable: ${PT_CTX}: ${msg}")
endfunction()

# JSON type of a path in a document, or MISSING.
function(pt_type out doc)
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" ${ARGN})
  if(NOT "${e}" STREQUAL "NOTFOUND")
    set(t MISSING)
  endif()
  set(${out} "${t}" PARENT_SCOPE)
endfunction()

# The member keys of an object must be exactly the listed keys (unknown and missing both fail).
function(pt_keys doc what)
  string(JSON n LENGTH "${doc}")
  set(seen "")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON k MEMBER "${doc}" ${i})
      if(NOT k IN_LIST ARGN)
        pt_fail("unknown ${what} key '${k}'")
      endif()
      list(APPEND seen "${k}")
    endforeach()
  endif()
  foreach(k IN LISTS ARGN)
    if(NOT k IN_LIST seen)
      pt_fail("missing ${what} key '${k}'")
    endif()
  endforeach()
endfunction()

# Required string at a path.
function(pt_str out doc what)
  pt_type(t "${doc}" ${ARGN})
  if(NOT t STREQUAL "STRING")
    pt_fail("${what} must be a string")
  endif()
  string(JSON v GET "${doc}" ${ARGN})
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Required non-negative integer at a path, at most max.
function(pt_uint out doc what max)
  pt_type(t "${doc}" ${ARGN})
  if(NOT t STREQUAL "NUMBER")
    pt_fail("${what} must be a number")
  endif()
  string(JSON v GET "${doc}" ${ARGN})
  if(NOT v MATCHES "^[0-9]+$")
    pt_fail("${what} '${v}' is not a non-negative integer")
  endif()
  if(v GREATER ${max})
    pt_fail("${what} ${v} is above ${max}")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# "$XXXX" -> numeric value.
function(pt_hex out s what)
  if(NOT s MATCHES "^[$][0-9A-F][0-9A-F][0-9A-F][0-9A-F]$")
    pt_fail("${what} '${s}' is not a \$XXXX hex word")
  endif()
  string(SUBSTRING "${s}" 1 4 digits)
  math(EXPR v "0x${digits}")
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# "$XX" -> numeric value.
function(pt_byte out s what)
  if(NOT s MATCHES "^[$][0-9A-F][0-9A-F]$")
    pt_fail("${what} '${s}' is not a \$XX hex byte")
  endif()
  string(SUBSTRING "${s}" 1 2 digits)
  math(EXPR v "0x${digits}")
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Four-digit uppercase C literal of a number.
function(pt_lit out v)
  math(EXPR h "${v}" OUTPUT_FORMAT HEXADECIMAL)
  string(SUBSTRING "${h}" 2 -1 h)
  string(TOUPPER "${h}" h)
  string(LENGTH "${h}" n)
  while(n LESS 4)
    set(h "0${h}")
    math(EXPR n "${n} + 1")
  endwhile()
  set(${out} "0x${h}u" PARENT_SCOPE)
endfunction()

file(GLOB pt_profiles RELATIVE "${ROOT}" "${ROOT}/data/profiles/*.json")
list(SORT pt_profiles)
if(NOT pt_profiles)
  set(PT_CTX "data/profiles")
  pt_fail("no profile file")
endif()
list(LENGTH pt_profiles n_profiles)

set(table_c "")
foreach(rel IN LISTS pt_profiles)
  file(READ "${ROOT}/${rel}" doc)
  set(PT_CTX "${rel}: id")
  pt_str(pid "${doc}" "profile id" id)

  # psg.mirrors: only "none".
  set(PT_CTX "${rel}: psg.mirrors")
  pt_type(t "${doc}" fields psg.mirrors value)
  if(t STREQUAL "MISSING")
    pt_fail("missing")
  endif()
  pt_str(mirrors "${doc}" "value" fields psg.mirrors value)
  if(NOT mirrors STREQUAL "none")
    pt_fail("value '${mirrors}' is not 'none' (only an undecoded repeat is implemented, C74)")
  endif()

  # The port parameters (plan 05-05): input.line_idle, input.port_output_read, psg.mixer.port_dir_bits.
  set(PT_CTX "${rel}: input.line_idle")
  pt_type(t "${doc}" fields input.line_idle value)
  if(t STREQUAL "MISSING")
    pt_fail("missing")
  endif()
  pt_str(s "${doc}" "value" fields input.line_idle value)
  pt_byte(port_idle "${s}" "value")
  set(PT_CTX "${rel}: input.port_output_read")
  pt_type(t "${doc}" fields input.port_output_read value)
  if(t STREQUAL "MISSING")
    pt_fail("missing")
  endif()
  pt_str(s "${doc}" "value" fields input.port_output_read value)
  if(NOT s STREQUAL "latch")
    pt_fail("value '${s}' is not 'latch' (only the latch read of an output port is implemented, C65)")
  endif()
  set(PT_CTX "${rel}: psg.mixer.port_dir_bits")
  pt_type(t "${doc}" fields psg.mixer.port_dir_bits value)
  if(t STREQUAL "MISSING")
    pt_fail("missing")
  endif()
  if(NOT t STREQUAL "OBJECT")
    pt_fail("value must be an object {\"A\": n, \"B\": n, \"output\": 0 or 1}")
  endif()
  string(JSON dobj GET "${doc}" fields psg.mixer.port_dir_bits value)
  pt_keys("${dobj}" "value" A B output)
  foreach(dk A B output)
    pt_type(t "${dobj}" ${dk})
    if(NOT t STREQUAL "NUMBER")
      pt_fail("${dk} must be a number")
    endif()
    string(JSON dv GET "${dobj}" ${dk})
    if(NOT dv MATCHES "^[0-9]$")
      pt_fail("${dk} '${dv}' is not a bit number 0..7 (or the output value 0 or 1)")
    endif()
    set(dir_${dk} "${dv}")
  endforeach()
  if(dir_A GREATER 7 OR dir_B GREATER 7)
    pt_fail("a direction bit number is above 7")
  endif()
  if(dir_A EQUAL dir_B)
    pt_fail("A and B name the same bit ${dir_A}")
  endif()
  if(dir_output GREATER 1)
    pt_fail("output '${dir_output}' is not 0 or 1")
  endif()
  pt_lit(idle_l "${port_idle}")
  string(REGEX REPLACE "^0x00" "0x" idle_l "${idle_l}")

  # The time chain and the tone, mixer and amplitude rules (plan 05-06).
  set(PT_CTX "${rel}: psg.clocks_per_step")
  pt_uint(clocks_per_step "${doc}" "value" 255 fields psg.clocks_per_step value)
  if(clocks_per_step EQUAL 0)
    pt_fail("must be nonzero")
  endif()
  set(PT_CTX "${rel}: ticks_per_psg_clock")
  pt_uint(ticks_per_psg_clock "${doc}" "value" 65535 fields ticks_per_psg_clock value)
  if(ticks_per_psg_clock EQUAL 0)
    pt_fail("must be nonzero")
  endif()
  set(PT_CTX "${rel}: psg.sample_period_ticks")
  pt_uint(sample_period "${doc}" "value" 65535 fields psg.sample_period_ticks value)
  math(EXPR want "${ticks_per_psg_clock} * ${clocks_per_step}")
  if(NOT sample_period EQUAL want)
    pt_fail("value ${sample_period} is not ticks_per_psg_clock times psg.clocks_per_step (${want})")
  endif()
  set(PT_CTX "${rel}: psg.counter_model")
  pt_str(s "${doc}" "value" fields psg.counter_model value)
  if(NOT s STREQUAL "down-reload")
    pt_fail("value '${s}' is not 'down-reload' (the only counter model implemented, C12)")
  endif()
  set(PT_CTX "${rel}: psg.period_zero.tone")
  pt_uint(period_zero_tone "${doc}" "value" 4096 fields psg.period_zero.tone value)
  if(period_zero_tone EQUAL 0)
    pt_fail("must be 1..4096")
  endif()
  set(PT_CTX "${rel}: psg.mixer.bits")
  pt_type(t "${doc}" fields psg.mixer.bits value)
  if(NOT t STREQUAL "OBJECT")
    pt_fail("value must be an object {\"polarity\": 0, \"tone\": [..3], \"noise\": [..3]}")
  endif()
  string(JSON mobj GET "${doc}" fields psg.mixer.bits value)
  pt_keys("${mobj}" "value" polarity tone noise)
  pt_uint(mixer_polarity "${mobj}" "polarity" 1 polarity)
  if(NOT mixer_polarity EQUAL 0)
    pt_fail("polarity ${mixer_polarity} is not 0 (a 0 bit enables the generator; the only sense implemented)")
  endif()
  set(mixer_seen "")
  foreach(mk tone noise)
    pt_type(t "${mobj}" ${mk})
    if(NOT t STREQUAL "ARRAY")
      pt_fail("${mk} must be an array of 3 bit numbers")
    endif()
    string(JSON mn LENGTH "${mobj}" ${mk})
    if(NOT mn EQUAL 3)
      pt_fail("${mk} has ${mn} entries, want 3")
    endif()
    set(mixer_${mk}_c "")
    foreach(ci RANGE 0 2)
      pt_uint(mb "${mobj}" "${mk}[${ci}]" 7 ${mk} ${ci})
      if(mb IN_LIST mixer_seen)
        pt_fail("bit ${mb} is named twice")
      endif()
      list(APPEND mixer_seen "${mb}")
      if(ci EQUAL 0)
        set(mixer_${mk}_c "${mb}u")
      else()
        string(APPEND mixer_${mk}_c ", ${mb}u")
      endif()
    endforeach()
  endforeach()
  set(PT_CTX "${rel}: psg.amp.env_select")
  pt_type(t "${doc}" fields psg.amp.env_select value)
  if(NOT t STREQUAL "OBJECT")
    pt_fail("value must be an object {\"fixed\": [hi, lo], \"select\": [hi, lo], \"shift\": [s1, s2, s3]}")
  endif()
  string(JSON aobj GET "${doc}" fields psg.amp.env_select value)
  pt_keys("${aobj}" "value" fixed select shift)
  foreach(ak fixed select shift)
    pt_type(t "${aobj}" ${ak})
    if(NOT t STREQUAL "ARRAY")
      pt_fail("${ak} must be an array")
    endif()
  endforeach()
  string(JSON n LENGTH "${aobj}" fixed)
  if(NOT n EQUAL 2)
    pt_fail("fixed has ${n} entries, want [high bit, low bit]")
  endif()
  pt_uint(fixed_hi "${aobj}" "fixed[0]" 7 fixed 0)
  pt_uint(fixed_lo "${aobj}" "fixed[1]" 7 fixed 1)
  if(NOT fixed_lo EQUAL 0 OR NOT fixed_hi EQUAL 3)
    pt_fail("fixed is [${fixed_hi}, ${fixed_lo}], want [3, 0] (a 4-bit level at bit 0)")
  endif()
  string(JSON n LENGTH "${aobj}" select)
  if(NOT n EQUAL 2)
    pt_fail("select has ${n} entries, want [high bit, low bit]")
  endif()
  pt_uint(select_hi "${aobj}" "select[0]" 7 select 0)
  pt_uint(select_lo "${aobj}" "select[1]" 7 select 1)
  math(EXPR select_w "${select_hi} - ${select_lo} + 1")
  if(select_hi LESS select_lo OR NOT select_w EQUAL 2 OR select_lo LESS 4)
    pt_fail("select is [${select_hi}, ${select_lo}], want a 2-bit field above the fixed level")
  endif()
  string(JSON n LENGTH "${aobj}" shift)
  if(NOT n EQUAL 3)
    pt_fail("shift has ${n} entries, want 3 (select 1, 2, 3)")
  endif()
  set(amp_shift_c "")
  foreach(si RANGE 0 2)
    pt_uint(sh "${aobj}" "shift[${si}]" 3 shift ${si})
    if(si EQUAL 0)
      set(amp_shift_c "${sh}u")
    else()
      string(APPEND amp_shift_c ", ${sh}u")
    endif()
  endforeach()
  set(PT_CTX "${rel}: psg.reset")
  pt_type(t "${doc}" fields psg.reset value)
  if(NOT t STREQUAL "OBJECT")
    pt_fail("value must be an object")
  endif()
  string(JSON robj GET "${doc}" fields psg.reset value)
  pt_keys("${robj}" "value" registers tone_output tone_counter lfsr envelope ports)
  pt_str(s "${robj}" "registers" registers)
  if(NOT s STREQUAL "zero")
    pt_fail("registers '${s}' is not 'zero'")
  endif()
  pt_uint(tone_out0 "${robj}" "tone_output" 1 tone_output)
  if(NOT tone_out0 EQUAL 0)
    pt_fail("tone_output ${tone_out0} is not 0")
  endif()
  pt_str(s "${robj}" "tone_counter" tone_counter)
  if(NOT s STREQUAL "reload-on-first-step")
    pt_fail("tone_counter '${s}' is not 'reload-on-first-step'")
  endif()
  set(PT_CTX "${rel}: psg.clock_phase_ticks")
  pt_uint(clock_phase "${doc}" "value" 65535 fields psg.clock_phase_ticks value)
  if(NOT clock_phase EQUAL 0)
    pt_fail("value ${clock_phase} is not 0 (only phase 0 is implemented, C76)")
  endif()
  set(PT_CTX "${rel}: psg.write_strobe_ticks")
  pt_uint(write_strobe "${doc}" "value" 255 fields psg.write_strobe_ticks value)
  set(PT_CTX "${rel}: psg.max_unit_ticks")
  pt_uint(max_unit "${doc}" "value" 65535 fields psg.max_unit_ticks value)
  pt_uint(wait_limit "${doc}" "bus.wait_limit_cpu_cycles" 255 fields bus.wait_limit_cpu_cycles value)
  pt_uint(ticks_per_cpu "${doc}" "ticks_per_cpu_cycle" 65535 fields ticks_per_cpu_cycle value)
  math(EXPR want "(12 + 3 * ${wait_limit}) * ${ticks_per_cpu}")
  if(NOT max_unit EQUAL want)
    pt_fail("value ${max_unit} is not (12 + 3 * bus.wait_limit_cpu_cycles) * ticks_per_cpu_cycle (${want})")
  endif()
  math(EXPR amp_select_mask "(1 << ${select_w}) - 1")

  # psg.regmap: sixteen consecutive records.
  set(PT_CTX "${rel}: psg.regmap")
  pt_type(t "${doc}" fields psg.regmap value)
  if(t STREQUAL "MISSING")
    pt_fail("missing")
  endif()
  if(NOT t STREQUAL "ARRAY")
    pt_fail("value must be an array of 16 records")
  endif()
  string(JSON nrec LENGTH "${doc}" fields psg.regmap value)
  if(NOT nrec EQUAL 16)
    pt_fail("has ${nrec} records, want exactly 16 (addresses \$01F0..\$01FF)")
  endif()
  set(wm_c "")
  set(rm_c "")
  set(names "")
  set(gis "")
  foreach(i RANGE 0 15)
    set(PT_CTX "${rel}: psg.regmap[${i}]")
    pt_type(t "${doc}" fields psg.regmap value ${i})
    if(NOT t STREQUAL "OBJECT")
      pt_fail("record must be an object")
    endif()
    string(JSON rec GET "${doc}" fields psg.regmap value ${i})
    pt_keys("${rec}" "record" addr name gi_octal wmask rmask)
    pt_str(s "${rec}" "addr" addr)
    pt_hex(addr "${s}" "addr")
    math(EXPR want "0x01F0 + ${i}")
    if(NOT addr EQUAL want)
      pt_lit(want_l "${want}")
      pt_fail("addr '${s}' is not the next address ${want_l} of the block \$01F0..\$01FF in order")
    endif()
    pt_str(nm "${rec}" "name" name)
    if(NOT nm MATCHES "^[a-z][a-z-]*$")
      pt_fail("name '${nm}' is not lowercase letters and dashes")
    endif()
    if(nm IN_LIST names)
      pt_fail("name '${nm}' is used twice")
    endif()
    list(APPEND names "${nm}")
    pt_str(gi "${rec}" "gi_octal" gi_octal)
    if(NOT gi MATCHES "^R[0-7]+$")
      pt_fail("gi_octal '${gi}' is not R followed by octal digits")
    endif()
    if(gi IN_LIST gis)
      pt_fail("gi_octal '${gi}' is used twice")
    endif()
    list(APPEND gis "${gi}")
    pt_str(s "${rec}" "wmask" wmask)
    pt_hex(wmask "${s}" "wmask")
    pt_str(s "${rec}" "rmask" rmask)
    pt_hex(rmask "${s}" "rmask")
    if(wmask GREATER 255 OR rmask GREATER 255)
      pt_fail("a mask has a bit above the low byte (only bits 7..0 of a bus word are driven, C64)")
    endif()
    pt_lit(wm_l "${wmask}")
    pt_lit(rm_l "${rmask}")
    if(i EQUAL 0)
      set(wm_c "${wm_l}")
      set(rm_c "${rm_l}")
    else()
      string(APPEND wm_c ", ${wm_l}")
      string(APPEND rm_c ", ${rm_l}")
    endif()
  endforeach()
  string(APPEND table_c "  { /* ${pid} */\n    {${wm_c}},\n    {${rm_c}},\n    ${idle_l}, 1u, {${dir_A}u, ${dir_B}u}, ${dir_output}u,\n"
    "    .sample_period_ticks = ${sample_period}u, .period_zero_tone = ${period_zero_tone}u,\n"
    "    .write_strobe_ticks = ${write_strobe}u, .max_unit_ticks = ${max_unit}u,\n"
    "    .mixer_tone_bit = {${mixer_tone_c}}, .mixer_noise_bit = {${mixer_noise_c}},\n"
    "    .amp_fixed_mask = 15u, .amp_select_shift = ${select_lo}u, .amp_select_mask = ${amp_select_mask}u,\n"
    "    .amp_env_shift = {${amp_shift_c}}\n  },\n")
endforeach()

set(out_c "/* Generated by cmake/IvsPsgTable.cmake from the files in data/profiles (A-06). */\n")
string(APPEND out_c "/* Build output only: never committed, never edited. */\n")
string(APPEND out_c "#define IVS_PSG_PROFILE_COUNT ${n_profiles}u\n")
string(APPEND out_c "_Static_assert(IVS_PSG_REG_COUNT == 16u, \"the generator emits 16 register masks\");\n")
string(APPEND out_c "static const ivs_psg_params ivs_psg_params_table[IVS_PSG_PROFILE_COUNT] = {\n${table_c}};\n")
string(APPEND out_c "_Static_assert(sizeof ivs_psg_params_table / sizeof ivs_psg_params_table[0] == IVS_PSG_PROFILE_COUNT, \"one parameter row per profile\");\n")
file(WRITE "${OUT}" "${out_c}")
