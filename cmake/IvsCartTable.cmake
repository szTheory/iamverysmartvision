string(APPEND out_c "static const ivs_cart_fixture ivs_cart_table[] = {\n${table_c}};\n")
string(APPEND out_c "static const size_t ivs_cart_count = ${k}u;\n")
string(APPEND out_c "static const ivs_test_source ivs_cart_sources[] = {\n${sources_c}};\n")
