# SPDX-License-Identifier: MIT
# Cartridge fixture table generator (D-34, plan 03-07): reads the IVSC v1 fixture files
# data/cart/<stem>.json listed in FILES and writes a C initializer table to OUT (build tree
# only, never committed) for suite ivsc (tests/ivsc/ivsc_main.c). No C JSON parser exists.
# Usage: cmake -DROOT=<repo> -DFILES=<data/expected/cart-fixture-files.ids>
#              -DIDS=<data/expected/tests/ivsc.ids> -DOUT=<build>/tests/ivs_cart_table.inc
#              -P cmake/IvsCartTable.cmake
# File shape: {schema_version: 1, source: "project-authored", group: <file stem>, note,
# fixtures: [...]}. Record kinds:
#   positive  {id, kind, note?, hex, whole_sha256, span?, expect: {status: "OK", segments:
#             [{addr, len_words}]}}: the whole container as hex text (groups of lowercase hex
#             digit pairs separated by single spaces); its trailer and whole_sha256 were computed
#             at authoring time with `cmake -E sha256sum`, an implementation independent of the
#             core's SHA-256.
#   build     {id, kind, note?, segments: [{addr, repeat: [{word, count}]}], trailer,
#             whole_sha256, span?, expect: {status: "OK"}}: a long container described by runs;
#             the test assembles the prefix, entries and words and appends the typed trailer.
#   patch     {id, kind, note?, base, patch: [{offset, hex | insert | delete}], truncate?,
#             reseal, expect: {status, reason, segment_index?, byte_offset?}}: a positive base
#             changed in place. Operations apply in listed order, each offset referring to the
#             bytes left by the operations before it (hex replaces bytes, insert adds bytes,
#             delete removes a count of bytes); truncate then cuts to that many bytes. The
#             patched bytes are written here; reseal (test time, core SHA-256) rewrites the last
#             32 bytes with the digest of every byte before them.
# Span rule (D-34): every segment of a positive or build record must lie inside an R cart row
# of every literal map data/memmap/*.literal.txt, so a change of the cartridge span cannot pass
# silently. A record marked span "format-edge" (address-space edges are format facts, not map
# facts) must have at least one segment outside a cart row, or the mark is refused.
# Fail closed (message `IvsCartTable: <context>: <reason>`): an unlisted or missing file, an
# unknown key, a bad id (form ivsc.<class><nn>-<slug>), a duplicate id, an id not listed in
# IDS, bad hex, a patch outside the bytes, a base that is not a positive record, a reason
# unknown or not mapped to its status by the spec, a span rule violation. The SHA256 of every
# fixture file and literal map read is embedded as ivs_cart_sources[] and re-checked by the
# tests-inventory step.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT FILES IDS OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsCartTable: missing -D${required}")
  endif()
endforeach()

set(CT_CTX "")
function(ct_fail msg)
  message(FATAL_ERROR "IvsCartTable: ${CT_CTX}: ${msg}")
endfunction()

# JSON type of a path in a document, or MISSING.
function(ct_type out doc)
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" ${ARGN})
  if(NOT "${e}" STREQUAL "NOTFOUND")
    set(t MISSING)
  endif()
  set(${out} "${t}" PARENT_SCOPE)
endfunction()

# Every member key of an object must be in the allowed list.
function(ct_keys doc what)
  string(JSON n LENGTH "${doc}")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON k MEMBER "${doc}" ${i})
      if(NOT k IN_LIST ARGN)
        ct_fail("unknown ${what} key '${k}'")
      endif()
    endforeach()
  endif()
endfunction()

# Required non-empty string member.
function(ct_str out doc key)
  ct_type(t "${doc}" ${key})
  if(NOT t STREQUAL "STRING")
    ct_fail("'${key}' must be a string")
  endif()
  string(JSON v GET "${doc}" ${key})
  if(v STREQUAL "")
    ct_fail("'${key}' is empty")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Non-negative integer JSON number.
function(ct_uint out doc what)
  ct_type(t "${doc}" ${ARGN})
  if(NOT t STREQUAL "NUMBER")
    ct_fail("${what} must be a number")
  endif()
  string(JSON v GET "${doc}" ${ARGN})
  if(NOT v MATCHES "^[0-9]+$")
    ct_fail("${what} '${v}' is not a non-negative integer")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Four uppercase hex digits -> number.
function(ct_word out s what)
  if(NOT s MATCHES "^[0-9A-F][0-9A-F][0-9A-F][0-9A-F]$")
    ct_fail("${what} '${s}' is not four uppercase hex digits")
  endif()
  math(EXPR v "0x${s}")
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Hex text: groups of lowercase hex digit pairs separated by single spaces -> plain hex string.
function(ct_hex out s what)
  if(NOT s MATCHES "^[0-9a-f]+( [0-9a-f]+)*$")
    ct_fail("${what} is not lowercase hex groups separated by single spaces")
  endif()
  string(REPLACE " " ";" groups "${s}")
  foreach(g IN LISTS groups)
    string(LENGTH "${g}" n)
    math(EXPR odd "${n} % 2")
    if(odd)
      ct_fail("${what} has a group with an odd number of digits ('${g}')")
    endif()
  endforeach()
  string(REPLACE " " "" s "${s}")
  set(${out} "${s}" PARENT_SCOPE)
endfunction()

# 64 lowercase hex digits (a SHA-256 digest) -> C byte initializer.
function(ct_digest out doc key)
  ct_str(s "${doc}" ${key})
  if(NOT s MATCHES "^[0-9a-f]+$")
    ct_fail("'${key}' is not lowercase hex")
  endif()
  string(LENGTH "${s}" n)
  if(NOT n EQUAL 64)
    ct_fail("'${key}' is not 64 hex digits")
  endif()
  ct_bytes_c(c "${s}")
  set(${out} "${c}" PARENT_SCOPE)
endfunction()

# Plain hex string -> "0xNNu, 0xNNu, ..." (no trailing comma).
function(ct_bytes_c out hex)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1u, " c "${hex}")
  string(REGEX REPLACE ", $" "" c "${c}")
  set(${out} "${c}" PARENT_SCOPE)
endfunction()

# Spec reason table (docs/formats/ivsc-v1.md): fixture reason name, C reason constant, status.
set(CT_REASONS
  truncated TRUNCATED MALFORMED
  too-large TOO_LARGE OVERSIZED
  magic MAGIC MALFORMED
  version VERSION MALFORMED
  flags FLAGS MALFORMED
  reserved RESERVED MALFORMED
  trailing TRAILING MALFORMED
  segment-count SEGMENT_COUNT MALFORMED
  size-mismatch SIZE_MISMATCH MALFORMED
  segment-length SEGMENT_LENGTH MALFORMED
  segment-width SEGMENT_WIDTH MALFORMED
  segment-attr SEGMENT_ATTR MALFORMED
  segment-reserved SEGMENT_RESERVED MALFORMED
  addr-wrap ADDR_WRAP OUT_OF_RANGE
  order ORDER MALFORMED
  overlap OVERLAP OVERLAP
  digest DIGEST DIGEST_MISMATCH
  word-range WORD_RANGE MALFORMED)

# ---- Literal cartridge spans ------------------------------------------------------------
set(CT_HEX4 "[0-9A-F][0-9A-F][0-9A-F][0-9A-F]")
file(GLOB ct_literals LIST_DIRECTORIES false "${ROOT}/data/memmap/*.literal.txt")
list(SORT ct_literals)
if(NOT ct_literals)
  set(CT_CTX "data/memmap")
  ct_fail("no *.literal.txt file")
endif()
set(sources_c "")
set(n_sources 0)
set(CT_SPAN_FILES "")
foreach(path IN LISTS ct_literals)
  file(RELATIVE_PATH rel "${ROOT}" "${path}")
  set(CT_CTX "${rel}")
  file(SHA256 "${path}" digest)
  string(APPEND sources_c "  {\"${rel}\", \"${digest}\"},\n")
  math(EXPR n_sources "${n_sources} + 1")
  file(STRINGS "${path}" lines REGEX "^R ${CT_HEX4}-${CT_HEX4} cart ")
  set(spans "")
  foreach(l IN LISTS lines)
    string(REGEX MATCH "^R (${CT_HEX4})-(${CT_HEX4}) " _m "${l}")
    math(EXPR lo "0x${CMAKE_MATCH_1}")
    math(EXPR hi "0x${CMAKE_MATCH_2}")
    list(APPEND spans "${lo}:${hi}")
  endforeach()
  if(NOT spans)
    ct_fail("no R cart row")
  endif()
  list(APPEND CT_SPAN_FILES "${rel}")
  set("CT_SPANS_${rel}" "${spans}")
endforeach()

# 1 when [lo, lo+len-1] lies inside a cart row of every literal map, else 0.
function(ct_in_span out lo len)
  math(EXPR last "${lo} + ${len} - 1")
  set(all 1)
  foreach(rel IN LISTS CT_SPAN_FILES)
    set(inside 0)
    foreach(sp IN LISTS "CT_SPANS_${rel}")
      string(REPLACE ":" ";" sp "${sp}")
      list(GET sp 0 slo)
      list(GET sp 1 shi)
      if(lo GREATER_EQUAL slo AND last LESS_EQUAL shi)
        set(inside 1)
      endif()
    endforeach()
    if(NOT inside)
      set(all 0)
    endif()
  endforeach()
  set(${out} "${all}" PARENT_SCOPE)
endfunction()

# ---- Inventories --------------------------------------------------------------------------
set(CT_CTX "${FILES}")
file(STRINGS "${FILES}" stem_lines)
set(CT_STEMS "")
foreach(l IN LISTS stem_lines)
  string(STRIP "${l}" l)
  if(l STREQUAL "" OR l MATCHES "^#")
    continue()
  endif()
  if(NOT l MATCHES "^[a-z0-9][a-z0-9-]*$")
    ct_fail("bad fixture file stem '${l}'")
  endif()
  if(l IN_LIST CT_STEMS)
    ct_fail("fixture file stem '${l}' listed twice")
  endif()
  list(APPEND CT_STEMS "${l}")
endforeach()
if(NOT CT_STEMS)
  ct_fail("no fixture file listed")
endif()
file(GLOB ct_present LIST_DIRECTORIES false RELATIVE "${ROOT}/data/cart" "${ROOT}/data/cart/*")
foreach(f IN LISTS ct_present)
  string(REGEX REPLACE "[.]json$" "" stem "${f}")
  if(NOT f MATCHES "[.]json$" OR NOT stem IN_LIST CT_STEMS)
    ct_fail("data/cart/${f} is not a listed fixture file")
  endif()
endforeach()

set(CT_CTX "${IDS}")
file(STRINGS "${IDS}" id_lines)
set(CT_LISTED "")
foreach(l IN LISTS id_lines)
  if(l MATCHES "^#" OR l MATCHES "^[ \t]*$")
    continue()
  endif()
  string(REGEX MATCH "^[^ \t]+" first "${l}")
  list(APPEND CT_LISTED "${first}")
endforeach()

# ---- Records ------------------------------------------------------------------------------
set(order "")
set(nrec 0)
set(CT_IDS "")
foreach(stem IN LISTS CT_STEMS)
  set(rel "data/cart/${stem}.json")
  set(CT_CTX "${rel}")
  if(NOT EXISTS "${ROOT}/${rel}")
    ct_fail("file missing")
  endif()
  file(READ "${ROOT}/${rel}" doc)
  file(SHA256 "${ROOT}/${rel}" digest)
  string(APPEND sources_c "  {\"${rel}\", \"${digest}\"},\n")
  math(EXPR n_sources "${n_sources} + 1")
  ct_keys("${doc}" top schema_version source group note fixtures)
  ct_uint(sv "${doc}" schema_version schema_version)
  if(NOT sv EQUAL 1)
    ct_fail("schema_version must be 1")
  endif()
  ct_str(src "${doc}" source)
  if(NOT src STREQUAL "project-authored")
    ct_fail("source must be project-authored")
  endif()
  ct_str(group "${doc}" group)
  if(NOT group STREQUAL stem)
    ct_fail("group '${group}' is not the file stem")
  endif()
  ct_str(note "${doc}" note)
  string(JSON nf ERROR_VARIABLE e LENGTH "${doc}" fixtures)
  if(NOT "${e}" STREQUAL "NOTFOUND")
    ct_fail("no fixtures array (${e})")
  endif()
  if(nf GREATER 0)
    math(EXPR last "${nf} - 1")
    foreach(i RANGE ${last})
      string(JSON rec GET "${doc}" fixtures ${i})
      ct_str(id "${rec}" id)
      if(NOT id MATCHES "^ivsc[.][PBNXL][0-9][0-9]-[a-z0-9][a-z0-9-]*$")
        ct_fail("bad fixture id '${id}' (form ivsc.<class><nn>-<slug>)")
      endif()
      if(id IN_LIST CT_IDS)
        ct_fail("duplicate fixture id '${id}'")
      endif()
      if(NOT id IN_LIST CT_LISTED)
        ct_fail("fixture id '${id}' is not listed in data/expected/tests/ivsc.ids")
      endif()
      list(APPEND CT_IDS "${id}")
      set("CT_REC_${id}" "${rec}")
      set("CT_SRC_${id}" "${rel}")
    endforeach()
  endif()
endforeach()
list(SORT CT_IDS)

# Pass 1: positive records (bases) and their hex.
foreach(id IN LISTS CT_IDS)
  set(rec "${CT_REC_${id}}")
  set(CT_CTX "${CT_SRC_${id}} ${id}")
  ct_str(kind "${rec}" kind)
  if(kind STREQUAL "positive")
    ct_str(hex_text "${rec}" hex)
    ct_hex(hex "${hex_text}" "hex")
    set("CT_HEX_${id}" "${hex}")
  elseif(NOT kind STREQUAL "build" AND NOT kind STREQUAL "patch")
    ct_fail("kind must be positive, build or patch")
  endif()
  set("CT_KIND_${id}" "${kind}")
endforeach()

# Segments of a positive (expect.segments) or build (segments) record: checks the span rule
# and appends C initializers; sets SEGS_C, RUNS_C, N_SEGS, N_RUNS in the caller.
macro(ct_segments_and_span arr_doc arr_path is_build)
  string(JSON ns ERROR_VARIABLE e LENGTH "${arr_doc}" ${arr_path})
  if(NOT "${e}" STREQUAL "NOTFOUND" OR ns EQUAL 0)
    ct_fail("segments must be a non-empty array")
  endif()
  set(SEGS_C "")
  set(RUNS_C "")
  set(N_SEGS ${ns})
  set(N_RUNS 0)
  set(outside 0)
  math(EXPR slast "${ns} - 1")
  foreach(si RANGE ${slast})
    string(JSON seg GET "${arr_doc}" ${arr_path} ${si})
    if(${is_build})
      ct_keys("${seg}" segment addr repeat)
    else()
      ct_keys("${seg}" segment addr len_words)
    endif()
    ct_str(a_s "${seg}" addr)
    ct_word(addr "${a_s}" "segment addr")
    if(${is_build})
      string(JSON nr ERROR_VARIABLE e LENGTH "${seg}" repeat)
      if(NOT "${e}" STREQUAL "NOTFOUND" OR nr EQUAL 0)
        ct_fail("segment ${si}: repeat must be a non-empty array")
      endif()
      set(seg_len 0)
      math(EXPR rlast "${nr} - 1")
      foreach(ri RANGE ${rlast})
        string(JSON run GET "${seg}" repeat ${ri})
        ct_keys("${run}" repeat word count)
        ct_str(w_s "${run}" word)
        ct_word(w "${w_s}" "repeat word")
        ct_uint(cnt "${run}" "repeat count" count)
        if(cnt EQUAL 0)
          ct_fail("segment ${si}: repeat count 0")
        endif()
        math(EXPR seg_len "${seg_len} + ${cnt}")
        string(APPEND RUNS_C "{${si}u, 0x${w_s}u, ${cnt}u}, ")
        math(EXPR N_RUNS "${N_RUNS} + 1")
      endforeach()
    else()
      ct_uint(seg_len "${seg}" "len_words" len_words)
    endif()
    if(seg_len LESS 1 OR seg_len GREATER 65535)
      ct_fail("segment ${si}: length ${seg_len} is outside 1..65535")
    endif()
    ct_in_span(inside ${addr} ${seg_len})
    if(NOT inside)
      set(outside 1)
    endif()
    string(APPEND SEGS_C "{0x${a_s}u, ${seg_len}u}, ")
  endforeach()
  ct_type(span_t "${rec}" span)
  if(span_t STREQUAL "MISSING")
    if(outside)
      ct_fail("a segment lies outside the cartridge span of a literal map (mark span format-edge only for address-space edge cases)")
    endif()
  else()
    ct_str(span "${rec}" span)
    if(NOT span STREQUAL "format-edge")
      ct_fail("span must be format-edge when present")
    endif()
    if(NOT outside)
      ct_fail("span format-edge, but every segment lies inside the cartridge span")
    endif()
  endif()
endmacro()

# Pass 2: C code per record.
set(arrays_c "")
set(table_c "")
set(k 0)
foreach(id IN LISTS CT_IDS)
  set(rec "${CT_REC_${id}}")
  set(kind "${CT_KIND_${id}}")
  set(CT_CTX "${CT_SRC_${id}} ${id}")
  set(base_c "NULL")
  set(bytes_ref "NULL, 0u")
  set(segs_ref "NULL, 0u")
  set(runs_ref "NULL, 0u")
  set(trailer_ref "NULL")
  set(whole_ref "NULL")
  set(reseal 0)
  set(has_seg 0)
  set(seg_v 0)
  set(has_off 0)
  set(off_v 0)
  set(reason_c "IVS_IVSC_R_NONE")
  ct_type(t "${rec}" note)
  if(NOT t STREQUAL "MISSING")
    ct_str(rnote "${rec}" note)
  endif()

  if(kind STREQUAL "positive" OR kind STREQUAL "build")
    if(kind STREQUAL "positive")
      ct_keys("${rec}" record id kind note hex whole_sha256 span expect)
      string(JSON exp GET "${rec}" expect)
      ct_keys("${exp}" expect status segments)
      ct_segments_and_span("${exp}" segments FALSE)
      ct_bytes_c(bc "${CT_HEX_${id}}")
      string(LENGTH "${CT_HEX_${id}}" hl)
      math(EXPR nb "${hl} / 2")
      string(APPEND arrays_c "static const uint8_t ivs_ct_b${k}[] = {${bc}};\n")
      set(bytes_ref "ivs_ct_b${k}, ${nb}u")
    else()
      ct_keys("${rec}" record id kind note segments trailer whole_sha256 span expect)
      string(JSON exp GET "${rec}" expect)
      ct_keys("${exp}" expect status)
      ct_segments_and_span("${rec}" segments TRUE)
      ct_digest(tc "${rec}" trailer)
      string(APPEND arrays_c "static const uint8_t ivs_ct_t${k}[32] = {${tc}};\n")
      set(trailer_ref "ivs_ct_t${k}")
      string(APPEND arrays_c "static const ivs_cart_run ivs_ct_r${k}[] = {${RUNS_C}};\n")
      set(runs_ref "ivs_ct_r${k}, ${N_RUNS}u")
    endif()
    ct_str(status "${exp}" status)
    if(NOT status STREQUAL "OK")
      ct_fail("a ${kind} record expects status OK")
    endif()
    set(status_c "IVS_OK")
    string(APPEND arrays_c "static const ivs_cart_seg ivs_ct_s${k}[] = {${SEGS_C}};\n")
    set(segs_ref "ivs_ct_s${k}, ${N_SEGS}u")
    ct_digest(wc "${rec}" whole_sha256)
    string(APPEND arrays_c "static const uint8_t ivs_ct_w${k}[32] = {${wc}};\n")
    set(whole_ref "ivs_ct_w${k}")
  else()
    ct_keys("${rec}" record id kind note base patch truncate reseal expect)
    ct_str(base "${rec}" base)
    if(NOT DEFINED "CT_KIND_${base}" OR NOT "${CT_KIND_${base}}" STREQUAL "positive")
      ct_fail("base '${base}' is not a positive record")
    endif()
    set(base_c "\"${base}\"")
    set(hex "${CT_HEX_${base}}")
    string(JSON np ERROR_VARIABLE e LENGTH "${rec}" patch)
    if(NOT "${e}" STREQUAL "NOTFOUND")
      ct_fail("patch must be an array")
    endif()
    if(np GREATER 0)
      math(EXPR plast "${np} - 1")
      foreach(pi RANGE ${plast})
        string(JSON op GET "${rec}" patch ${pi})
        ct_keys("${op}" "patch operation" offset hex insert delete)
        ct_uint(off "${op}" "patch ${pi} offset" offset)
        string(LENGTH "${hex}" hl)
        math(EXPR blen "${hl} / 2")
        set(nops 0)
        foreach(opk hex insert delete)
          ct_type(ot "${op}" ${opk})
          if(NOT ot STREQUAL "MISSING")
            math(EXPR nops "${nops} + 1")
            set(opkind "${opk}")
          endif()
        endforeach()
        if(NOT nops EQUAL 1)
          ct_fail("patch ${pi} must have exactly one of hex, insert, delete")
        endif()
        math(EXPR c0 "${off} * 2")
        if(opkind STREQUAL "delete")
          ct_uint(cnt "${op}" "patch ${pi} delete" delete)
          math(EXPR end "${off} + ${cnt}")
          if(cnt EQUAL 0 OR end GREATER blen)
            ct_fail("patch ${pi} deletes outside the ${blen} bytes")
          endif()
          math(EXPR c1 "${end} * 2")
          string(SUBSTRING "${hex}" 0 ${c0} pre)
          string(SUBSTRING "${hex}" ${c1} -1 post)
          set(hex "${pre}${post}")
        else()
          ct_str(ph_text "${op}" ${opkind})
          ct_hex(ph "${ph_text}" "patch ${pi} ${opkind}")
          string(LENGTH "${ph}" phl)
          math(EXPR pn "${phl} / 2")
          if(opkind STREQUAL "hex")
            math(EXPR end "${off} + ${pn}")
            if(end GREATER blen)
              ct_fail("patch ${pi} writes past the ${blen} bytes")
            endif()
            math(EXPR c1 "${end} * 2")
          else()
            if(off GREATER blen)
              ct_fail("patch ${pi} inserts past the ${blen} bytes")
            endif()
            set(c1 ${c0})
          endif()
          string(SUBSTRING "${hex}" 0 ${c0} pre)
          string(SUBSTRING "${hex}" ${c1} -1 post)
          set(hex "${pre}${ph}${post}")
        endif()
      endforeach()
    endif()
    ct_type(t "${rec}" truncate)
    if(NOT t STREQUAL "MISSING")
      ct_uint(tr "${rec}" truncate truncate)
      string(LENGTH "${hex}" hl)
      math(EXPR blen "${hl} / 2")
      if(tr GREATER_EQUAL blen)
        ct_fail("truncate ${tr} does not shorten the ${blen} bytes")
      endif()
      math(EXPR c1 "${tr} * 2")
      string(SUBSTRING "${hex}" 0 ${c1} hex)
    endif()
    if(np EQUAL 0 AND t STREQUAL "MISSING")
      ct_fail("a patch record must change its base")
    endif()
    ct_type(t "${rec}" reseal)
    if(NOT t STREQUAL "BOOLEAN")
      ct_fail("reseal must be true or false")
    endif()
    string(JSON rs GET "${rec}" reseal)
    string(LENGTH "${hex}" hl)
    math(EXPR nb "${hl} / 2")
    if(rs)
      set(reseal 1)
      if(nb LESS 32)
        ct_fail("reseal needs at least 32 bytes")
      endif()
    endif()
    if(nb GREATER 0)
      ct_bytes_c(bc "${hex}")
      string(APPEND arrays_c "static const uint8_t ivs_ct_b${k}[] = {${bc}};\n")
      set(bytes_ref "ivs_ct_b${k}, ${nb}u")
    endif()
    string(JSON exp GET "${rec}" expect)
    ct_keys("${exp}" expect status reason segment_index byte_offset)
    ct_str(status "${exp}" status)
    ct_str(reason "${exp}" reason)
    list(FIND CT_REASONS "${reason}" ri)
    math(EXPR ri_mod "${ri} % 3")
    if(ri LESS 0 OR NOT ri_mod EQUAL 0)
      ct_fail("unknown reason '${reason}'")
    endif()
    math(EXPR ri_c "${ri} + 1")
    math(EXPR ri_s "${ri} + 2")
    list(GET CT_REASONS ${ri_c} reason_name)
    list(GET CT_REASONS ${ri_s} reason_status)
    if(NOT status STREQUAL reason_status)
      ct_fail("reason ${reason} maps to status ${reason_status}, not ${status}")
    endif()
    set(status_c "IVS_E_${status}")
    set(reason_c "IVS_IVSC_R_${reason_name}")
    ct_type(t "${exp}" segment_index)
    if(NOT t STREQUAL "MISSING")
      ct_uint(seg_v "${exp}" segment_index segment_index)
      set(has_seg 1)
    endif()
    ct_type(t "${exp}" byte_offset)
    if(NOT t STREQUAL "MISSING")
      ct_uint(off_v "${exp}" byte_offset byte_offset)
      set(has_off 1)
    endif()
  endif()

  string(APPEND table_c "  {\"${id}\", ${base_c}, IVS_CART_${kind}, ${bytes_ref}, ${reseal}u, ${segs_ref}, ${runs_ref},\n"
    "   ${trailer_ref}, ${whole_ref}, ${status_c}, ${reason_c}, ${has_seg}u, ${seg_v}u, ${has_off}u, ${off_v}u},\n")
  math(EXPR k "${k} + 1")
endforeach()
string(REPLACE "IVS_CART_positive" "IVS_CART_POSITIVE" table_c "${table_c}")
string(REPLACE "IVS_CART_build" "IVS_CART_BUILD" table_c "${table_c}")
string(REPLACE "IVS_CART_patch" "IVS_CART_PATCH" table_c "${table_c}")

if(k EQUAL 0)
  set(CT_CTX "${FILES}")
  ct_fail("no fixture record")
endif()
set(out_c "/* Generated by cmake/IvsCartTable.cmake from the files in data/expected/cart-fixture-files.ids. */\n")
string(APPEND out_c "/* Build output only: never committed, never edited. */\n")
