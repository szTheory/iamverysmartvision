# SPDX-License-Identifier: MIT
# Test-side read of the profile DAC table (AUD-01, D-11, D-12, plan 05-07): reads ONLY the profile field
# psg.dac.levels (one string(JSON) pass per entry) of every data/profiles/*.json in sorted order and writes
# ivs_psg_probe.inc to OUT (build tree only, never committed). THE CORE NEVER READS THIS FIELD: this script is
# a test-side generator (tests/psg/psg_dac.c and psg_profile.c include its output), IvsPsgTable.cmake does not
# read the field, and nothing generated for the core carries it, so a wrong table cannot invalidate a raw audio
# golden.
# Usage: cmake -DROOT=<repo> -DOUT=<file> -P cmake/IvsPsgProfileProbe.cmake
#
# Output: IVS_PROBE_PROFILE_ID (the id of the profile whose table follows, the first profile) and
# ivs_probe_dac_levels[16] (index = the 4-bit level, units of 1e-8 of full scale, uint32_t).
#
# Fail closed (message `IvsPsgProfileProbe: <profile>: psg.dac.levels: <reason>`): a profile without the field,
# a value that is not an array of exactly 16 numbers, an entry that is not a non-negative decimal integer, or an
# entry above 4,294,967,295 (the table is uint32_t).
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsPsgProfileProbe: missing -D${required}")
  endif()
endforeach()

file(GLOB pp_profiles RELATIVE "${ROOT}" "${ROOT}/data/profiles/*.json")
list(SORT pp_profiles)
if(NOT pp_profiles)
  message(FATAL_ERROR "IvsPsgProfileProbe: data/profiles: no profile file")
endif()

set(pp_first "")
set(pp_levels_c "")
foreach(rel IN LISTS pp_profiles)
  file(READ "${ROOT}/${rel}" doc)
  string(JSON pid ERROR_VARIABLE e GET "${doc}" id)
  if(NOT "${e}" STREQUAL "NOTFOUND")
    message(FATAL_ERROR "IvsPsgProfileProbe: ${rel}: id: missing")
  endif()
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" fields psg.dac.levels value)
  if(NOT "${e}" STREQUAL "NOTFOUND" OR NOT t STREQUAL "ARRAY")
    message(FATAL_ERROR "IvsPsgProfileProbe: ${pid}: psg.dac.levels: value must be an array of 16 numbers")
  endif()
  string(JSON n LENGTH "${doc}" fields psg.dac.levels value)
  if(NOT n EQUAL 16)
    message(FATAL_ERROR "IvsPsgProfileProbe: ${pid}: psg.dac.levels: has ${n} entries, want 16")
  endif()
  set(entries "")
  foreach(i RANGE 0 15)
    string(JSON et TYPE "${doc}" fields psg.dac.levels value ${i})
    if(NOT et STREQUAL "NUMBER")
      message(FATAL_ERROR "IvsPsgProfileProbe: ${pid}: psg.dac.levels: entry ${i} is not a number")
    endif()
    string(JSON v GET "${doc}" fields psg.dac.levels value ${i})
    if(NOT v MATCHES "^[0-9]+$")
      message(FATAL_ERROR "IvsPsgProfileProbe: ${pid}: psg.dac.levels: entry ${i} '${v}' is not a non-negative integer")
    endif()
    if(v GREATER 4294967295)
      message(FATAL_ERROR "IvsPsgProfileProbe: ${pid}: psg.dac.levels: entry ${i} ${v} does not fit 32 bits")
    endif()
    list(APPEND entries "${v}u")
  endforeach()
  if("${pp_first}" STREQUAL "")
    set(pp_first "${pid}")
    string(REPLACE ";" ", " pp_levels_c "${entries}")
  endif()
endforeach()

set(out_c "/* Generated by cmake/IvsPsgProfileProbe.cmake from the profile field psg.dac.levels; do not edit. */\n")
string(APPEND out_c "/* Build output only: never committed. Test side only: the core never reads this table (D-11). */\n")
string(APPEND out_c "#define IVS_PROBE_PROFILE_ID \"${pp_first}\"\n")
string(APPEND out_c "static const uint32_t ivs_probe_dac_levels[16] = {${pp_levels_c}};\n")
file(WRITE "${OUT}" "${out_c}")
