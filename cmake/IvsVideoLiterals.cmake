# Video literal generator (plan 06-09, D-12, D-13, D-16; test side). Reads ONLY the two independent literals
# data/video/geometry.literal.txt and data/video/chain-framing.literal.txt, never data/profiles/, a core header or core output, and
# writes ivs_video_lit.inc to OUT (build tree only, never committed) for suite video (tests/video/video_geom.c, video_slot.c).
# Usage: cmake -DROOT=<repo> -DOUT=<build>/tests/ivs_video_lit.inc -P cmake/IvsVideoLiterals.cmake
# Output (C, included once by tests/video/video_cases.h users through video_lit.h):
#   vl_geo_*              the geometry numbers of the page (card columns and rows, card pixels, last column pixels, width, height, plane,
#                         slot, header, not-displayed sentinel, row lines)
#   vl_chain_h0, vl_chain_h1, vl_chain_h2            the chain values (32 bytes each)
#   vl_chain_slot0_header, vl_chain_slot1_header      the framed 32-byte headers of the first two display-off slots
#   vl_chain_slot0_sha, vl_chain_slot1_sha            the SHA-256 of the whole first two slots
#   vl_sources[]          the two files with their SHA-256, for the TAP header
# Fail closed (message `IvsVideoLiterals: <file>: <reason>`): a missing file, a missing or repeated key, a value outside the grammar.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsVideoLiterals: missing -D${required}")
  endif()
endforeach()

function(vl_fail where msg)
  message(FATAL_ERROR "IvsVideoLiterals: ${where}: ${msg}")
endfunction()

set(geofile "${ROOT}/data/video/geometry.literal.txt")
set(chainfile "${ROOT}/data/video/chain-framing.literal.txt")
foreach(f "${geofile}" "${chainfile}")
  if(NOT EXISTS "${f}")
    file(RELATIVE_PATH r "${ROOT}" "${f}")
    vl_fail("${r}" "missing")
  endif()
endforeach()

set(sources_c "")
foreach(f "${geofile}" "${chainfile}")
  file(RELATIVE_PATH r "${ROOT}" "${f}")
  file(SHA256 "${f}" d)
  string(APPEND sources_c "  {\"${r}\", \"${d}\"},\n")
endforeach()

# Reads one literal into <prefix>_<key> variables (the value tokens before the tag= token); a key appearing twice fails.
function(vl_read file prefix)
  file(RELATIVE_PATH r "${ROOT}" "${file}")
  file(STRINGS "${file}" lines)
  set(seen "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^#" OR line STREQUAL "")
      continue()
    endif()
    string(REGEX MATCH "^([a-z0-9-]+) ([^ ].*)$" m "${line}")
    if(NOT m)
      vl_fail("${r}" "row outside the grammar: ${line}")
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(rest "${CMAKE_MATCH_2}")
    string(REGEX REPLACE " tag=.*$" "" rest "${rest}")
    if(key IN_LIST seen)
      vl_fail("${r}" "key ${key} repeated")
    endif()
    list(APPEND seen "${key}")
    string(REPLACE " " ";" toks "${rest}")
    set(${prefix}_${key} "${toks}" PARENT_SCOPE)
  endforeach()
  set(${prefix}_keys "${seen}" PARENT_SCOPE)
endfunction()

vl_read("${geofile}" geo)
vl_read("${chainfile}" ch)

function(vl_need prefix key file_rel)
  if(NOT ${prefix}_keys MATCHES "(^|;)${key}(;|$)")
    vl_fail("${file_rel}" "missing key ${key}")
  endif()
endfunction()
foreach(k card-columns card-rows card-px last-column-px width height plane-bytes slot-bytes header-bytes not-displayed-sentinel row-lines)
  vl_need(geo ${k} "data/video/geometry.literal.txt")
endforeach()
foreach(k h0 h1 h2 slot0-header slot1-header slot0-sha256 slot1-sha256)
  vl_need(ch ${k} "data/video/chain-framing.literal.txt")
endforeach()

function(vl_num out prefix key idx)
  list(GET ${prefix}_${key} ${idx} v)
  if(NOT v MATCHES "^(0x[0-9A-Fa-f]+|[0-9]+)$")
    vl_fail("${prefix}" "key ${key}: ${v} is not a number")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# 64 hex digits (any case) to the 32 comma-separated bytes of a C initializer.
function(vl_bytes out prefix key)
  set(h "${${prefix}_${key}}")
  string(LENGTH "${h}" n)
  if(NOT h MATCHES "^[0-9a-fA-F]+$" OR NOT n EQUAL 64)
    vl_fail("${prefix}" "key ${key}: not 64 hex digits")
  endif()
  set(res "")
  foreach(i RANGE 0 62 2)
    string(SUBSTRING "${h}" ${i} 2 b)
    string(APPEND res "0x${b}u, ")
  endforeach()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

vl_num(card_cols geo card-columns 0)
vl_num(card_rows geo card-rows 0)
vl_num(card_w geo card-px 0)
vl_num(card_h geo card-px 1)
vl_num(last_px geo last-column-px 0)
vl_num(width geo width 0)
vl_num(height geo height 0)
vl_num(plane geo plane-bytes 0)
vl_num(slot geo slot-bytes 0)
vl_num(header geo header-bytes 0)
vl_num(blank geo not-displayed-sentinel 0)
vl_num(row_lines geo row-lines 0)
vl_bytes(h0 ch h0)
vl_bytes(h1 ch h1)
vl_bytes(h2 ch h2)
vl_bytes(hd0 ch slot0-header)
vl_bytes(hd1 ch slot1-header)
vl_bytes(sh0 ch slot0-sha256)
vl_bytes(sh1 ch slot1-sha256)

# The headers of the literal are 32 bytes written as 64 upper-case hex digits (the same grammar as the digests).
set(out_c "/* Generated by cmake/IvsVideoLiterals.cmake from data/video/geometry.literal.txt and data/video/chain-framing.literal.txt. Do not edit. */\n")
string(APPEND out_c "#define VL_GEO_CARD_COLUMNS ${card_cols}u\n#define VL_GEO_CARD_ROWS ${card_rows}u\n")
string(APPEND out_c "#define VL_GEO_CARD_W ${card_w}u\n#define VL_GEO_CARD_H ${card_h}u\n#define VL_GEO_LAST_COLUMN_PX ${last_px}u\n")
string(APPEND out_c "#define VL_GEO_WIDTH ${width}u\n#define VL_GEO_HEIGHT ${height}u\n#define VL_GEO_PLANE_BYTES ${plane}u\n")
string(APPEND out_c "#define VL_GEO_SLOT_BYTES ${slot}u\n#define VL_GEO_HEADER_BYTES ${header}u\n#define VL_GEO_BLANK ${blank}u\n#define VL_GEO_ROW_LINES ${row_lines}u\n")
string(APPEND out_c "static const uint8_t vl_chain_h0[32] = {${h0}};\nstatic const uint8_t vl_chain_h1[32] = {${h1}};\nstatic const uint8_t vl_chain_h2[32] = {${h2}};\n")
string(APPEND out_c "static const uint8_t vl_chain_slot0_header[32] = {${hd0}};\nstatic const uint8_t vl_chain_slot1_header[32] = {${hd1}};\n")
string(APPEND out_c "static const uint8_t vl_chain_slot0_sha[32] = {${sh0}};\nstatic const uint8_t vl_chain_slot1_sha[32] = {${sh1}};\n")
string(APPEND out_c "static const ivs_test_source vl_sources[] = {\n${sources_c}};\n")
file(WRITE "${OUT}" "${out_c}")
