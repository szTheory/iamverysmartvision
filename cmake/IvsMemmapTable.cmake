# SPDX-License-Identifier: MIT
# Memory-map and profile-registry generator (D-16, D-18, D-03, plan 03-04): reads every
# data/profiles/*.json in sorted order and writes ivs_profiles.inc to OUT (build tree only,
# never committed). The only includer is core/src/memmap/memsys.c. No C JSON parser exists (H14).
# Usage: cmake -DROOT=<tree> -DOUT=<file> [-DMUTATE=<region name>] -P cmake/IvsMemmapTable.cmake
# The output is a pure function of the profile files: no host path, no time.
#
# Profile fields read (every one carries the profile record's tag, cite and conflict):
#   memmap.undriven_read          "$XXXX"
#   memmap.device.<kind>          {bits, rmask, fill, store}; kind rom10 grom8 ram8 ram16 stub
#   memmap.region.<name>          {view R|W|RW, lo, hi, device, size_words, gate, impl}
#   memmap.cart_span              {lo, hi} (A-02; no alignment field, A-01)
#   cartridge.features_supported  u32 mask (D-32)
#   system_images.exec|grom       {units, unit_bits, base, required} (D-24, D-26)
#   reset.r7, interrupt.iab_value, cpu.interrupt_accept_clears_intff,
#   bus.release_latency_cpu_cycles, bus.wait_limit_cpu_cycles, power_on_fill.*,
#   ticks_per_cpu_cycle (1..65535; the machine converts a CPU unit's cycles to master ticks, D2)
#   scanlines_per_frame, cpu_cycles_per_scanline (1..65535 each; the nominal frame timebase that
#   ivs_info publishes, D-06/D-09, plan 04-09; nominal figures, never a frame event)
#   input.controllers (1..4: connected hand controllers, event word index = PSG port; the run
#   call refuses a nonzero controller word at or above it, D-13/D-15, plan 04-12)
# Hex values are "$XXXX" strings (four uppercase digits), as in reset.r7.
#
# Fail closed (message `IvsMemmapTable: <profile>: <field>: <reason>`): hi < lo; lo or hi+1 not
# on a 16-word granule; an overlap within one view; size_words not a power of two; an extent
# (hi - lo + 1) that is neither at most size_words nor a whole multiple of it; an unknown device
# kind, gate, impl, view, physical device or memmap key; a missing or unknown key inside a value
# object; a missing field of the list above (every device kind, the span, the slots and the
# registry scalars are required; regions are listed by the profile); a read-driving region inside
# the cartridge span; a power-on fill other than zero; a region name with a glossary unit token.
# The physical device of a region is its name up to the first `_` (stic, scratchpad, psg,
# sysram, exec, grom, gram); regions sharing one physical device share its backing array.
#
# Output: the const region array, rd_region[profile][4096] and wr_region[profile][4096] (one u8
# region index per 16-word granule, addr >> 4; 0xFF undriven, 0xFE the cartridge span in the
# read view), the device records per profile and the profile registry, plus _Static_asserts
# tying the numeric ids to memsys.h and every backing size to its capacity macro.
# Optional -DMUTATE=<region name> (named-fault control GEN_MAP_MUTATION): after validation, that
# region's lo moves up by one 16-word granule. The region must exist and keep a granule.
cmake_minimum_required(VERSION 3.25)

foreach(required ROOT OUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "IvsMemmapTable: missing -D${required}")
  endif()
endforeach()

set(MM_CTX "")
function(mm_fail msg)
  message(FATAL_ERROR "IvsMemmapTable: ${MM_CTX}: ${msg}")
endfunction()

# JSON type of a path in a document, or MISSING.
function(mm_type out doc)
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" ${ARGN})
  if(NOT "${e}" STREQUAL "NOTFOUND")
    set(t MISSING)
  endif()
  set(${out} "${t}" PARENT_SCOPE)
endfunction()

# The member keys of an object must be exactly the listed keys (unknown and missing both fail).
function(mm_keys doc what)
  string(JSON n LENGTH "${doc}")
  set(seen "")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON k MEMBER "${doc}" ${i})
      if(NOT k IN_LIST ARGN)
        mm_fail("unknown ${what} key '${k}'")
      endif()
      list(APPEND seen "${k}")
    endforeach()
  endif()
  foreach(k IN LISTS ARGN)
    if(NOT k IN_LIST seen)
      mm_fail("missing ${what} key '${k}'")
    endif()
  endforeach()
endfunction()

# "$XXXX" -> numeric value.
function(mm_hex out s what)
  if(NOT s MATCHES "^[$][0-9A-F][0-9A-F][0-9A-F][0-9A-F]$")
    mm_fail("${what} '${s}' is not a \$XXXX hex word")
  endif()
  string(SUBSTRING "${s}" 1 4 digits)
  math(EXPR v "0x${digits}")
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Four-digit uppercase C literal of a number.
function(mm_lit out v)
  math(EXPR h "${v}" OUTPUT_FORMAT HEXADECIMAL)
  string(SUBSTRING "${h}" 2 -1 h)
  string(TOUPPER "${h}" h)
  string(LENGTH "${h}" n)
  while(n LESS 4)
    set(h "0${h}")
    math(EXPR n "${n} + 1")
  endwhile()
  set(${out} "0x${h}u" PARENT_SCOPE)
endfunction()

# Non-negative integer JSON number at a path, at most max.
function(mm_uint out doc what max)
  mm_type(t "${doc}" ${ARGN})
  if(NOT t STREQUAL "NUMBER")
    mm_fail("${what} must be a number")
  endif()
  string(JSON v GET "${doc}" ${ARGN})
  if(NOT v MATCHES "^[0-9]+$" OR v GREATER max)
    mm_fail("${what} '${v}' is not an integer in 0..${max}")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Required string at a path.
function(mm_str out doc what)
  mm_type(t "${doc}" ${ARGN})
  if(NOT t STREQUAL "STRING")
    mm_fail("${what} must be a string")
  endif()
  string(JSON v GET "${doc}" ${ARGN})
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

# Index of a name in a fixed list, or a failure.
function(mm_enum out name what)
  list(FIND ARGN "${name}" i)
  if(i EQUAL -1)
    mm_fail("unknown ${what} '${name}'")
  endif()
  set(${out} "${i}" PARENT_SCOPE)
endfunction()

# Lowercase zero-padded 5-digit decimal (sort key).
function(mm_key out v)
  set(k "${v}")
  string(LENGTH "${k}" n)
  while(n LESS 5)
    set(k "0${k}")
    math(EXPR n "${n} + 1")
  endwhile()
  set(${out} "${k}" PARENT_SCOPE)
endfunction()

# Numeric ids; the order is the id (memsys.h repeats them and the output asserts equality).
set(MM_DEVICES undriven rom10 grom8 ram8 ram16 stub)
set(MM_DEVICE_MACROS UNDRIVEN ROM10 GROM8 RAM8 RAM16 STUB)
set(MM_GATES none stic-regs gmem)
set(MM_GATE_MACROS NONE STIC_REGS GMEM)
set(MM_IMPLS none real stub)
set(MM_IMPL_MACROS NONE REAL STUB)
set(MM_PHYS undriven stic scratchpad psg sysram exec grom gram cart)
set(MM_PHYS_MACROS UNDRIVEN STIC SCRATCHPAD PSG SYSRAM EXEC GROM GRAM CART)
set(MM_VIEWS - R W RW)
set(MM_STUB_PHYS stic psg)
# Backed physical devices and the memsys.h capacity macro of each.
set(MM_CAP_scratchpad IVS_MEMSYS_SCRATCHPAD_WORDS)
set(MM_CAP_sysram IVS_MEMSYS_SYSRAM_WORDS)
set(MM_CAP_exec IVS_MEMSYS_EXEC_WORDS)
set(MM_CAP_grom IVS_MEMSYS_GROM_WORDS)
set(MM_CAP_gram IVS_MEMSYS_GRAM_WORDS)
set(MM_UNIT_TOKENS window offset hold duration delay period latency interval timeout)

file(GLOB mm_profiles RELATIVE "${ROOT}" "${ROOT}/data/profiles/*.json")
list(SORT mm_profiles)
if(NOT mm_profiles)
  set(MM_CTX "data/profiles")
  mm_fail("no profile file")
endif()
list(LENGTH mm_profiles n_profiles)

set(regions_c "")
set(rd_c "")
set(wr_c "")
set(dev_c "")
set(reg_c "")
set(asserts_c "")
set(n_regions 0)
set(MM_MUTATED 0)
set(ids_seen "")

foreach(rel IN LISTS mm_profiles)
  file(READ "${ROOT}/${rel}" doc)
  foreach(pn IN LISTS MM_PHYS)
    unset(mm_phys_${pn}_size)
    unset(mm_phys_${pn}_dev)
  endforeach()
  set(MM_CTX "${rel}: id")
  mm_str(pid "${doc}" "profile id" id)
  string(LENGTH "${pid}" pid_len)
  if(NOT pid MATCHES "^[a-z0-9][a-z0-9-]*$" OR pid_len GREATER 63)
    mm_fail("profile id '${pid}' is not 1..63 characters of [a-z0-9-]")
  endif()
  if(pid IN_LIST ids_seen)
    mm_fail("profile id '${pid}' is used twice")
  endif()
  list(APPEND ids_seen "${pid}")
  set(MM_CTX "${rel}: fields")
  mm_type(t "${doc}" fields)
  if(NOT t STREQUAL "OBJECT")
    mm_fail("must be an object")
  endif()

  # Every field name, and the value of each memmap/registry field.
  string(JSON nf LENGTH "${doc}" fields)
  set(names "")
  if(nf GREATER 0)
    math(EXPR last "${nf} - 1")
    foreach(i RANGE ${last})
      string(JSON k MEMBER "${doc}" fields ${i})
      list(APPEND names "${k}")
    endforeach()
  endif()
  set(region_names "")
  set(device_names "")
  foreach(k IN LISTS names)
    set(MM_CTX "${rel}: ${k}")
    if(k MATCHES "^memmap[.]")
      if(k MATCHES "^memmap[.]region[.]([a-z][a-z0-9_]*)$")
        list(APPEND region_names "${CMAKE_MATCH_1}")
      elseif(k MATCHES "^memmap[.]device[.](.*)$")
        set(kind "${CMAKE_MATCH_1}")
        if(kind STREQUAL "undriven" OR NOT kind IN_LIST MM_DEVICES)
          mm_fail("unknown device kind '${kind}'")
        endif()
        list(APPEND device_names "${kind}")
      elseif(NOT k STREQUAL "memmap.undriven_read" AND NOT k STREQUAL "memmap.cart_span")
        mm_fail("unknown memmap key")
      endif()
    elseif(k MATCHES "^power_on_fill[.]")
      mm_type(t "${doc}" fields "${k}" value)
      set(v "")
      if(t STREQUAL "STRING")
        string(JSON v GET "${doc}" fields "${k}" value)
      endif()
      if(NOT v STREQUAL "zero")
        mm_fail("power-on fill '${v}' is not zero (only zero is implemented)")
      endif()
    endif()
  endforeach()

  # Registry scalars.
  set(MM_CTX "${rel}: memmap.undriven_read")
  mm_str(s "${doc}" "value" fields memmap.undriven_read value)
  mm_hex(undriven "${s}" "value")
  set(MM_CTX "${rel}: reset.r7")
  mm_str(s "${doc}" "value" fields reset.r7 value)
  mm_hex(reset_r7 "${s}" "value")
  set(MM_CTX "${rel}: interrupt.iab_value")
  mm_str(s "${doc}" "value" fields interrupt.iab_value value)
  mm_hex(iab "${s}" "value")
  set(MM_CTX "${rel}: cpu.interrupt_accept_clears_intff")
  mm_uint(intff "${doc}" "value" 1 fields cpu.interrupt_accept_clears_intff value)
  set(MM_CTX "${rel}: bus.release_latency_cpu_cycles")
  mm_uint(release "${doc}" "value" 255 fields bus.release_latency_cpu_cycles value)
  set(MM_CTX "${rel}: bus.wait_limit_cpu_cycles")
  mm_uint(wait_limit "${doc}" "value" 255 fields bus.wait_limit_cpu_cycles value)
  set(MM_CTX "${rel}: ticks_per_cpu_cycle")
  mm_uint(ticks_per_cpu "${doc}" "value" 65535 fields ticks_per_cpu_cycle value)
  if(ticks_per_cpu EQUAL 0)
    mm_fail("must be nonzero")
  endif()
  foreach(tb scanlines_per_frame cpu_cycles_per_scanline)
    set(MM_CTX "${rel}: ${tb}")
    mm_uint(${tb} "${doc}" "value" 65535 fields ${tb} value)
    if(${tb} EQUAL 0)
      mm_fail("must be nonzero")
    endif()
  endforeach()
  set(MM_CTX "${rel}: input.controllers")
  mm_uint(input_controllers "${doc}" "value" 4 fields input.controllers value)
  if(input_controllers EQUAL 0)
    mm_fail("must be 1 to 4")
  endif()

  # Required registry fields (a missing one fails closed).
  foreach(need cartridge.features_supported system_images.exec system_images.grom memmap.cart_span
          memmap.device.rom10 memmap.device.grom8 memmap.device.ram8 memmap.device.ram16
          memmap.device.stub)
    if(NOT need IN_LIST names)
      set(MM_CTX "${rel}: ${need}")
      mm_fail("missing")
    endif()
  endforeach()
  set(MM_CTX "${rel}: cartridge.features_supported")
  mm_uint(features "${doc}" "value" 4294967295 fields cartridge.features_supported value)

  # Slot descriptors.
  foreach(slot exec grom)
    set(MM_CTX "${rel}: system_images.${slot}")
    mm_type(t "${doc}" fields "system_images.${slot}" value)
    if(NOT t STREQUAL "OBJECT")
      mm_fail("value must be an object")
    endif()
    string(JSON sv GET "${doc}" fields "system_images.${slot}" value)
    mm_keys("${sv}" "slot" units unit_bits base required)
    mm_uint(units "${sv}" "units" 65536 units)
    mm_uint(unit_bits "${sv}" "unit_bits" 16 unit_bits)
    mm_str(s "${sv}" "base" base)
    mm_hex(base "${s}" "base")
    mm_uint(req "${sv}" "required" 1 required)
    if(units EQUAL 0 OR unit_bits EQUAL 0)
      mm_fail("units and unit_bits must be nonzero")
    endif()
    mm_lit(base_l "${base}")
    set(slot_${slot}_c "{${units}u, ${base_l}, ${unit_bits}u, ${req}u}")
    if(slot STREQUAL "exec")
      string(APPEND asserts_c "_Static_assert(${units}u <= IVS_MEMSYS_EXEC_WORDS, \"${pid}: EXEC slot units\");\n")
    else()
      string(APPEND asserts_c "_Static_assert(${units}u <= IVS_MEMSYS_GROM_WORDS, \"${pid}: GROM slot units\");\n")
    endif()
  endforeach()

  # Device records; kind 0 is the undriven record.
  mm_lit(und_l "${undriven}")
  set(devrow "{0x0000u, ${und_l}, 0u, 0u}")
  foreach(kind IN LISTS MM_DEVICES)
    if(kind STREQUAL "undriven")
      continue()
    endif()
    set(have_${kind} 0)
    set(MM_CTX "${rel}: memmap.device.${kind}")
    mm_type(t "${doc}" fields "memmap.device.${kind}" value)
    if(NOT t STREQUAL "OBJECT")
      mm_fail("value must be an object")
    endif()
    string(JSON dv GET "${doc}" fields "memmap.device.${kind}" value)
    mm_keys("${dv}" "device" bits rmask fill store)
    mm_uint(bits "${dv}" "bits" 16 bits)
    mm_str(s "${dv}" "rmask" rmask)
    mm_hex(rmask "${s}" "rmask")
    mm_str(s "${dv}" "fill" fill)
    mm_hex(fill "${s}" "fill")
    mm_str(store "${dv}" "store" store)
    mm_enum(keep "${store}" "store" drop keep)
    math(EXPR want "(1 << ${bits}) - 1")
    if(NOT rmask EQUAL want)
      mm_fail("rmask does not hold exactly the low ${bits} bits")
    endif()
    mm_lit(rmask_l "${rmask}")
    mm_lit(fill_l "${fill}")
    string(APPEND devrow ", {${rmask_l}, ${fill_l}, ${keep}u, 0u}")
    set(have_${kind} 1)
  endforeach()
  string(APPEND dev_c "  {${devrow}}, /* ${pid} */\n")

  # Cartridge span (A-01, A-02).
  set(has_span 0)
  set(MM_CTX "${rel}: memmap.cart_span")
  mm_type(t "${doc}" fields memmap.cart_span value)
  if(NOT t STREQUAL "OBJECT")
    mm_fail("value must be an object")
  endif()
  string(JSON cv GET "${doc}" fields memmap.cart_span value)
  mm_keys("${cv}" "cart_span" lo hi)
  mm_str(s "${cv}" "lo" lo)
  mm_hex(span_lo "${s}" "lo")
  mm_str(s "${cv}" "hi" hi)
  mm_hex(span_hi "${s}" "hi")
  math(EXPR a "${span_lo} % 16")
  math(EXPR b "(${span_hi} + 1) % 16")
  if(span_hi LESS span_lo OR NOT a EQUAL 0 OR NOT b EQUAL 0)
    mm_fail("span must have hi >= lo on 16-word granules")
  endif()
  math(EXPR span_words "${span_hi} - ${span_lo} + 1")
  string(APPEND asserts_c "_Static_assert(${span_words}u <= IVS_MEMSYS_CART_WORDS, \"${pid}: cartridge span\");\n")
  set(has_span 1)

  # Regions.
  set(rd_entries "")
  set(wr_entries "")
  foreach(rname IN LISTS region_names)
    set(field "memmap.region.${rname}")
    set(MM_CTX "${rel}: ${field}")
    string(REPLACE "_" ";" segs "${rname}")
    foreach(sg IN LISTS segs)
      if(sg IN_LIST MM_UNIT_TOKENS)
        mm_fail("region name segment '${sg}' is a glossary unit token (H4)")
      endif()
    endforeach()
    mm_type(t "${doc}" fields "${field}" value)
    if(NOT t STREQUAL "OBJECT")
      mm_fail("value must be an object")
    endif()
    string(JSON rv GET "${doc}" fields "${field}" value)
    mm_keys("${rv}" "region" view lo hi device size_words gate impl)
    mm_str(s "${rv}" "view" view)
    if(s STREQUAL "-")
      mm_fail("unknown view '-'")
    endif()
    mm_enum(view "${s}" "view" ${MM_VIEWS})
    mm_str(s "${rv}" "lo" lo)
    mm_hex(lo "${s}" "lo")
    mm_str(s "${rv}" "hi" hi)
    mm_hex(hi "${s}" "hi")
    mm_str(dname "${rv}" "device" device)
    if(dname STREQUAL "undriven")
      mm_fail("unknown device 'undriven'")
    endif()
    mm_enum(device "${dname}" "device" ${MM_DEVICES})
    if(NOT have_${dname})
      mm_fail("device '${dname}' has no memmap.device.${dname} record")
    endif()
    mm_uint(size "${rv}" "size_words" 32768 size_words)
    mm_str(s "${rv}" "gate" gate)
    mm_enum(gate "${s}" "gate" ${MM_GATES})
    mm_str(s "${rv}" "impl" impl)
    if(s STREQUAL "none")
      mm_fail("unknown impl 'none'")
    endif()
    mm_enum(impl "${s}" "impl" ${MM_IMPLS})
    string(FIND "${rname}" "_" us)
    if(us EQUAL -1)
      set(pname "${rname}")
    else()
      string(SUBSTRING "${rname}" 0 ${us} pname)
    endif()
    if(pname STREQUAL "undriven" OR pname STREQUAL "cart")
      mm_fail("unknown physical device '${pname}'")
    endif()
    mm_enum(phys "${pname}" "physical device" ${MM_PHYS})

    if(hi LESS lo)
      mm_fail("hi is below lo")
    endif()
    math(EXPR a "${lo} % 16")
    math(EXPR b "(${hi} + 1) % 16")
    if(NOT a EQUAL 0)
      mm_fail("lo is not aligned to 16 words")
    endif()
    if(NOT b EQUAL 0)
      mm_fail("hi + 1 is not aligned to 16 words")
    endif()
    math(EXPR p2 "${size} & (${size} - 1)")
    if(size EQUAL 0 OR NOT p2 EQUAL 0)
      mm_fail("size_words ${size} is not a power of two")
    endif()
    math(EXPR extent "${hi} - ${lo} + 1")
    math(EXPR rem "${extent} % ${size}")
    if(extent GREATER size AND NOT rem EQUAL 0)
      mm_fail("extent ${extent} is neither at most size_words ${size} nor a whole multiple of it")
    endif()
    if(dname STREQUAL "stub")
      if(NOT s STREQUAL "stub" OR NOT pname IN_LIST MM_STUB_PHYS)
        mm_fail("a stub device needs impl stub and a stub physical device (stic, psg)")
      endif()
    else()
      if(NOT s STREQUAL "real" OR pname IN_LIST MM_STUB_PHYS)
        mm_fail("a backed device needs impl real and a backed physical device")
      endif()
      if(DEFINED mm_phys_${pname}_size)
        if(NOT mm_phys_${pname}_size EQUAL size OR NOT mm_phys_${pname}_dev STREQUAL dname)
          mm_fail("physical device '${pname}' is declared with two sizes or device kinds")
        endif()
      else()
        set(mm_phys_${pname}_size ${size})
        set(mm_phys_${pname}_dev "${dname}")
        string(APPEND asserts_c "_Static_assert(${size}u <= ${MM_CAP_${pname}}, \"${pid}: ${pname} backing\");\n")
      endif()
    endif()
    # A read-driving region inside the cartridge span would hide cartridge ROM.
    if(has_span AND (view EQUAL 1 OR view EQUAL 3) AND NOT lo GREATER span_hi AND NOT hi LESS span_lo)
      mm_fail("read-driving region inside the cartridge span")
    endif()

    if(DEFINED MUTATE AND rname STREQUAL MUTATE)
      math(EXPR lo "${lo} + 16")
      if(lo GREATER hi)
        mm_fail("MUTATE target keeps no granule")
      endif()
      set(MM_MUTATED 1)
    endif()

    if(n_regions GREATER 252)
      mm_fail("more than 253 regions")
    endif()
    mm_lit(lo_l "${lo}")
    mm_lit(hi_l "${hi}")
    string(APPEND regions_c "  {${lo_l}, ${hi_l}, ${size}u, ${view}u, ${device}u, ${gate}u, ${impl}u, ${phys}u, 0u}, /* ${n_regions} ${pid} ${rname} */\n")
    math(EXPR glo "${lo} >> 4")
    math(EXPR ghi "${hi} >> 4")
    mm_key(kk "${glo}")
    if(view EQUAL 1 OR view EQUAL 3)
      list(APPEND rd_entries "${kk}:${ghi}:${n_regions}:${rname}")
    endif()
    if(view EQUAL 2 OR view EQUAL 3)
      list(APPEND wr_entries "${kk}:${ghi}:${n_regions}:${rname}")
    endif()
    math(EXPR n_regions "${n_regions} + 1")
  endforeach()
  if(has_span)
    math(EXPR glo "${span_lo} >> 4")
    math(EXPR ghi "${span_hi} >> 4")
    mm_key(kk "${glo}")
    list(APPEND rd_entries "${kk}:${ghi}:254:cartridge span")
  endif()

  # Granule tables; an overlap within a view fails.
  foreach(vw rd wr)
    set(entries "${${vw}_entries}")
    list(SORT entries)
    set(tab "  { /* ${pid} */\n")
    set(cursor 0)
    set(prev "")
    foreach(e IN LISTS entries)
      string(REPLACE ":" ";" parts "${e}")
      list(GET parts 0 glo)
      list(GET parts 1 ghi)
      list(GET parts 2 idx)
      list(GET parts 3 nm)
      math(EXPR glo "${glo}")
      if(glo LESS cursor)
        set(MM_CTX "${rel}: memmap.region.${nm}")
        mm_fail("overlaps ${prev} in the ${vw} view")
      endif()
      math(EXPR gap "${glo} - ${cursor}")
      if(gap GREATER 0)
        string(REPEAT "0xFFu," ${gap} run)
        string(APPEND tab "    ${run} /* undriven */\n")
      endif()
      math(EXPR cnt "${ghi} - ${glo} + 1")
      string(REPEAT "${idx}u," ${cnt} run)
      string(APPEND tab "    ${run} /* ${nm} */\n")
      math(EXPR cursor "${ghi} + 1")
      set(prev "${nm}")
    endforeach()
    math(EXPR gap "4096 - ${cursor}")
    if(gap GREATER 0)
      string(REPEAT "0xFFu," ${gap} run)
      string(APPEND tab "    ${run} /* undriven */\n")
    endif()
    string(APPEND tab "  },\n")
    string(APPEND ${vw}_c "${tab}")
  endforeach()

  mm_lit(r7_l "${reset_r7}")
  mm_lit(iab_l "${iab}")
  mm_lit(slo_l "${span_lo}")
  mm_lit(shi_l "${span_hi}")
  string(APPEND reg_c
    "  {\"${pid}\", ${r7_l}, ${iab_l}, ${und_l}, ${slo_l}, ${shi_l}, ${ticks_per_cpu}u, ${has_span}u, ${intff}u, ${release}u,\n"
    "   ${wait_limit}u, ${features}u, ${slot_exec_c}, ${slot_grom_c}, ${scanlines_per_frame}u,\n"
    "   ${cpu_cycles_per_scanline}u, ${input_controllers}u},\n")
endforeach()

if(DEFINED MUTATE AND NOT MUTATE STREQUAL "" AND NOT MM_MUTATED)
  set(MM_CTX "data/profiles")
  mm_fail("MUTATE target '${MUTATE}' is not a region")
endif()
if(n_regions EQUAL 0)
  set(regions_c "  {0x0000u, 0x0000u, 1u, 0u, 0u, 0u, 0u, 0u, 0u},\n")
  set(n_regions_decl 1)
else()
  set(n_regions_decl ${n_regions})
endif()

set(ids_c "")
foreach(group DEVICE GATE IMPL PHYS)
  set(i 0)
  foreach(name IN LISTS MM_${group}_MACROS)
    string(APPEND ids_c "_Static_assert(IVS_MEMSYS_${group}_${name} == ${i}u, \"${group} id ${name}\");\n")
    math(EXPR i "${i} + 1")
  endforeach()
endforeach()

set(out_c "/* Generated by cmake/IvsMemmapTable.cmake from the files in data/profiles (D-16). */\n")
string(APPEND out_c "/* Build output only: never committed, never edited. */\n")
string(APPEND out_c "#define IVS_MM_PROFILE_COUNT ${n_profiles}u\n")
string(APPEND out_c "#define IVS_MM_REGION_COUNT ${n_regions}u\n")
string(APPEND out_c "${ids_c}${asserts_c}")
string(APPEND out_c "static const ivs_mm_region ivs_mm_regions[${n_regions_decl}] = {\n${regions_c}};\n")
string(APPEND out_c "static const ivs_mm_device ivs_mm_devices[${n_profiles}][IVS_MEMSYS_DEVICE_KINDS] = {\n${dev_c}};\n")
string(APPEND out_c "static const uint8_t ivs_mm_rd_region[${n_profiles}][4096] = {\n${rd_c}};\n")
string(APPEND out_c "static const uint8_t ivs_mm_wr_region[${n_profiles}][4096] = {\n${wr_c}};\n")
string(APPEND out_c "static const ivs_profile_desc ivs_mm_profiles[${n_profiles}] = {\n${reg_c}};\n")
file(WRITE "${OUT}" "${out_c}")
