# SPDX-License-Identifier: MIT
# Turns the assert lines of a predicate file (data/golden/<id>.expect, D-11, plan 04-16) into a C
# include of X-macro lines, so a test reads the expected values from the reviewed file instead of
# retyping them. Build output only, never committed.
# Usage: cmake -DIN=<file.expect> -DOUT=<file.inc> -P expect-inc.cmake
# Accepted body lines (the runner grammar of plan 04-17, the subset the in-process tests need):
#   assert halted == yes|no      -> IVS_EXPECT_HALTED(1|0)
#   assert reg R<0-7> == HHHH    -> IVS_EXPECT_REG(<n>u, 0xHHHHu)
#   assert mem AAAA == HHHH      -> IVS_EXPECT_MEM(0xAAAAu, 0xHHHHu)
# Plan 05-11 adds the two PSG write-log forms of data/golden/diag-ctrl-psg-pass.expect (the write
# list of the second diagnostic):
#   assert psglog count == N     -> IVS_EXPECT_PSGCOUNT(Nu)
#   assert psglog I addr=A value=HHHH source=cpu-write|cpu-dw
#                                -> IVS_EXPECT_PSGLOG(Iu, Au, 0xHHHHu, 1u|2u)   (source 1 CPU write, 2 DW)
# Plan 06-13 adds the four video forms of data/golden/diag-stic-fgbg-pass.expect and diag-stic-cstack-pass.expect:
#   assert frame N displayed == yes|no       -> IVS_EXPECT_FRAME_DISPLAYED(Nu, 1|0)
#   assert frame N pixel X Y == V            -> IVS_EXPECT_FRAME_PIXEL(Nu, Xu, Yu, Vu)   (V a color number 0..15, decimal)
#   assert frame N hash == <64 lower-case hex> -> IVS_EXPECT_FRAME_HASH(Nu, "<hex>")
#   assert video count == N                  -> IVS_EXPECT_VIDEO_COUNT(Nu)
# HHHH and AAAA are 4 upper-case hex digits. '#' lines and blank lines are skipped. Any other line
# (another subject, '!=', a range, lower-case hex) stops the build: a clause the test cannot check
# must not be dropped silently. A file without one assert line also stops the build.
# -DFORM=text (plan 04-17) writes each accepted line instead as one C string literal
# "<line>\n", so suite runner feeds the file's own text to the scenario parser and compares the
# result with the X-macro reading of the same lines.
cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED IN OR NOT DEFINED OUT)
  message(FATAL_ERROR "expect-inc: IN and OUT are required")
endif()
if(NOT DEFINED FORM)
  set(FORM xmacro)
endif()
if(NOT FORM STREQUAL "xmacro" AND NOT FORM STREQUAL "text")
  message(FATAL_ERROR "expect-inc: FORM must be xmacro or text (got ${FORM})")
endif()
file(STRINGS "${IN}" lines)
get_filename_component(in_name "${IN}" NAME)
set(body "/* Generated from data/golden/${in_name} by tests/expect-inc.cmake: build output only, never committed. */\n")
set(text_lines "")
set(n 0)
set(lineno 0)
foreach(l IN LISTS lines)
  math(EXPR lineno "${lineno} + 1")
  if(l STREQUAL "" OR l MATCHES "^#")
    continue()
  endif()
  if(l MATCHES "^assert halted == (yes|no)$")
    if(CMAKE_MATCH_1 STREQUAL "yes")
      string(APPEND body "IVS_EXPECT_HALTED(1)\n")
    else()
      string(APPEND body "IVS_EXPECT_HALTED(0)\n")
    endif()
  elseif(l MATCHES "^assert reg R([0-7]) == ([0-9A-F][0-9A-F][0-9A-F][0-9A-F])$")
    string(APPEND body "IVS_EXPECT_REG(${CMAKE_MATCH_1}u, 0x${CMAKE_MATCH_2}u)\n")
  elseif(l MATCHES "^assert mem ([0-9A-F][0-9A-F][0-9A-F][0-9A-F]) == ([0-9A-F][0-9A-F][0-9A-F][0-9A-F])$")
    string(APPEND body "IVS_EXPECT_MEM(0x${CMAKE_MATCH_1}u, 0x${CMAKE_MATCH_2}u)\n")
  elseif(l MATCHES "^assert psglog count == ([0-9]+)$")
    string(APPEND body "IVS_EXPECT_PSGCOUNT(${CMAKE_MATCH_1}u)\n")
  elseif(l MATCHES "^assert psglog ([0-9]+) addr=([0-9]+) value=([0-9A-F][0-9A-F][0-9A-F][0-9A-F]) source=(cpu-write|cpu-dw)$")
    if(CMAKE_MATCH_4 STREQUAL "cpu-write")
      set(src_code 1)
    else()
      set(src_code 2)
    endif()
    string(APPEND body "IVS_EXPECT_PSGLOG(${CMAKE_MATCH_1}u, ${CMAKE_MATCH_2}u, 0x${CMAKE_MATCH_3}u, ${src_code}u)\n")
  elseif(l MATCHES "^assert frame ([0-9]+) displayed == (yes|no)$")
    if(CMAKE_MATCH_2 STREQUAL "yes")
      set(dflag 1)
    else()
      set(dflag 0)
    endif()
    string(APPEND body "IVS_EXPECT_FRAME_DISPLAYED(${CMAKE_MATCH_1}u, ${dflag})\n")
  elseif(l MATCHES "^assert frame ([0-9]+) pixel ([0-9]+) ([0-9]+) == ([0-9]+)$")
    if(CMAKE_MATCH_4 GREATER 15)
      message(FATAL_ERROR "expect-inc: ${IN}:${lineno}: pixel value above 15: ${l}")
    endif()
    string(APPEND body "IVS_EXPECT_FRAME_PIXEL(${CMAKE_MATCH_1}u, ${CMAKE_MATCH_2}u, ${CMAKE_MATCH_3}u, ${CMAKE_MATCH_4}u)\n")
  elseif(l MATCHES "^assert frame ([0-9]+) hash == ([0-9a-f]+)$")
    set(fidx "${CMAKE_MATCH_1}")
    set(fhex "${CMAKE_MATCH_2}")
    string(LENGTH "${fhex}" fhl)
    if(NOT fhl EQUAL 64)
      message(FATAL_ERROR "expect-inc: ${IN}:${lineno}: a frame hash is 64 lower-case hex digits: ${l}")
    endif()
    string(APPEND body "IVS_EXPECT_FRAME_HASH(${fidx}u, \"${fhex}\")\n")
  elseif(l MATCHES "^assert video count == ([0-9]+)$")
    string(APPEND body "IVS_EXPECT_VIDEO_COUNT(${CMAKE_MATCH_1}u)\n")
  else()
    message(FATAL_ERROR "expect-inc: ${IN}:${lineno}: unsupported line: ${l}")
  endif()
  if(FORM STREQUAL "text")
    string(APPEND text_lines "\"${l}\\n\"\n")
  endif()
  math(EXPR n "${n} + 1")
endforeach()
if(n EQUAL 0)
  message(FATAL_ERROR "expect-inc: ${IN} has no assert line")
endif()
if(FORM STREQUAL "text")
  set(body "/* Generated from data/golden/${in_name} by tests/expect-inc.cmake (FORM=text): build output only, never committed. */\n${text_lines}")
endif()
file(WRITE "${OUT}" "${body}")
