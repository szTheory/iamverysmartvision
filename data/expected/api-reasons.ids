# Refusal reason numbers (IVS_REASON_*) of every report (plan 04-08, D-04, D-05): NAME VALUE.
# Append-only: never renumber, never reuse. Runner reports and goldens print these numbers.
# 1..18 are the IVSC v1 reason table, 19..33 the load reasons, 34 and up the run reasons (plan
# 04-07). The set equals the IVS_REASON_* defines of core/include/ivs/*.h (generic define pin of
# tools/check/api-effects.cmake).
IVS_REASON_NONE 0
IVS_REASON_TRUNCATED 1
IVS_REASON_TOO_LARGE 2
IVS_REASON_MAGIC 3
IVS_REASON_VERSION 4
IVS_REASON_FLAGS 5
IVS_REASON_RESERVED 6
IVS_REASON_TRAILING 7
IVS_REASON_SEGMENT_COUNT 8
IVS_REASON_SIZE_MISMATCH 9
IVS_REASON_SEGMENT_LENGTH 10
IVS_REASON_SEGMENT_WIDTH 11
IVS_REASON_SEGMENT_ATTR 12
IVS_REASON_SEGMENT_RESERVED 13
IVS_REASON_ADDR_WRAP 14
IVS_REASON_ORDER 15
IVS_REASON_OVERLAP 16
IVS_REASON_DIGEST 17
IVS_REASON_WORD_RANGE 18
IVS_REASON_OUT_OF_SPAN 19
IVS_REASON_FEATURES 20
IVS_REASON_IMAGE_SHORT 21
IVS_REASON_IMAGE_LONG 22
IVS_REASON_IMAGE_WORD 23
IVS_REASON_EXPECT_DIGEST 24
IVS_REASON_ARG_KIND 25
IVS_REASON_ARG_NULL_BYTES 26
IVS_REASON_ARG_STRUCT_SIZE 27
IVS_REASON_ARG_INPUT_OVERLAP 28
IVS_REASON_HANDLE 29
IVS_REASON_OPTION_FLAGS 30
IVS_REASON_OPTION_TAIL 31
IVS_REASON_STATE_POWERED 32
IVS_REASON_SLOT_OCCUPIED 33
IVS_REASON_RUN_NULL_ARG 34
IVS_REASON_RUN_STRUCT_SIZE 35
IVS_REASON_RUN_REPORT_OVERLAP 36
IVS_REASON_RUN_FLAGS 37
IVS_REASON_RUN_TAIL 38
IVS_REASON_RUN_STATE_OFF 39
IVS_REASON_RUN_TARGET_RANGE 40
IVS_REASON_RUN_BUFFER_SMALL 41
IVS_REASON_RUN_BUFFER_NULL 42
IVS_REASON_RUN_BUFFER_OVERLAP 43
