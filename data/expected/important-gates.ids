api-define-pins control api-input-bit-duplicate RUN-01
runner-parse fault RUNNER_DOTDOT_ACCEPTED RUN-01
runner-parse fault RUNNER_LINE_CAP_UNCHECKED RUN-01
runner-exec fault RUNNER_ASSERT_ALWAYS_PASS RUN-01
runner-exec fault RUNNER_STOP_EXPECT_IGNORED RUN-01
runner-exec fault RUNNER_KEY_ORDER_SWAPPED RUN-01
runner-exec fault RUNNER_OVERSHOOT_NOT_REPORTED RUN-01
runner-scan control runner-scan-header RUN-01
runner-scan control runner-scan-internal-include RUN-01
runner-scan control runner-scan-posix-define RUN-01
runner-process mutant runner-process.judge.no-report-end RUN-01

