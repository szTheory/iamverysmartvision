# Pinned bit indices of the logical controller input names (plan 04-13, D-12, D-16): `NAME BITINDEX`
# for every `#define IVS_CTRL_<NAME> (1u << n)` of core/include/ivs/*.h (IVS_CTRL_RESERVED_MASK is
# excluded), checked by the api-effects step. Append-only: a bit index never moves and is never
# reused, because scenarios and goldens record input by these bits.
IVS_CTRL_KEY_1 0
IVS_CTRL_KEY_2 1
IVS_CTRL_KEY_3 2
IVS_CTRL_KEY_4 3
IVS_CTRL_KEY_5 4
IVS_CTRL_KEY_6 5
IVS_CTRL_KEY_7 6
IVS_CTRL_KEY_8 7
IVS_CTRL_KEY_9 8
IVS_CTRL_KEY_CLEAR 9
IVS_CTRL_KEY_0 10
IVS_CTRL_KEY_ENTER 11
IVS_CTRL_DISC_N 12
IVS_CTRL_DISC_NNE 13
IVS_CTRL_DISC_NE 14
IVS_CTRL_DISC_ENE 15
IVS_CTRL_DISC_E 16
IVS_CTRL_DISC_ESE 17
IVS_CTRL_DISC_SE 18
IVS_CTRL_DISC_SSE 19
IVS_CTRL_DISC_S 20
IVS_CTRL_DISC_SSW 21
IVS_CTRL_DISC_SW 22
IVS_CTRL_DISC_WSW 23
IVS_CTRL_DISC_W 24
IVS_CTRL_DISC_WNW 25
IVS_CTRL_DISC_NW 26
IVS_CTRL_DISC_NNW 27
IVS_CTRL_SIDE_TOP 28
IVS_CTRL_SIDE_LOWER_LEFT 29
IVS_CTRL_SIDE_LOWER_RIGHT 30
