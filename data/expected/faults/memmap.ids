# suite=memmap; columns: <FAULT_ID> <must-fail> <allowed-prefixes> <must-pass>
# Memory-map named faults (D-37, plan 03-04). GEN_MAP_MUTATION is a generator-path control (no
# site; the mutated ivs_profiles.inc is consumed by core/src/memmap/memsys.c); every other id has
# one IVS_FAULT_<ID> site in core/src/memmap/memsys.c.
GEN_MAP_MUTATION memmap.anchor.sysram-lo memmap.anchor.sysram-|memmap.describe.|memmap.dump. memmap.bus.iab-reset
MEM_UNDRIVEN_ZERO memmap.unloaded.exec-reads-ffff memmap.unloaded.|memmap.width.undriven-|memmap.gate.|memmap.cart.|memmap.anchor.stic-alias-w|memmap.anchor.gram-alias-w memmap.bus.iab-reset
MEM_CART_END_INCLUSIVE memmap.cart.above-5001 memmap.cart. memmap.bus.iab-reset
MEM_WO_READS_DEVICE memmap.anchor.gram-alias-w7-lo memmap.anchor.gram-alias-w|memmap.unloaded.cart-|memmap.cart. memmap.bus.iab-reset
MEM_MIRROR_MASK memmap.mirror.gram-3a00 memmap.mirror.|memmap.dump. memmap.bus.iab-reset
MEM_IAB_VECTOR_SWAPPED memmap.bus.iab-reset memmap.bus.iab- memmap.anchor.exec-lo
