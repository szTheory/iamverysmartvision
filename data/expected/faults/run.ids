# suite=run; columns: <FAULT_ID> <must-fail> <allowed-prefixes> <must-pass>
# Run named faults (plan 04-06, D-08). Each id has one IVS_FAULT_<ID> site in
# core/src/machine/machine_inspect.c (observation must not disturb what it observes).
# PEEK_ADVANCES_TIME: every accepted peek adds one master tick to machine time; both side-effect
# cases see the storage, the INSTANCE and composite digests and machine time change.
PEEK_ADVANCES_TIME run.observe.no-side-effect-powered run.observe.|run.peek.|run.refuse.peek. run.cpu-state.off
# PEEK_GATE_IGNORED: peek reads the backing word as if every gate were open; only the closed-gate
# case sees GROM and GRAM data behind gate gmem.
PEEK_GATE_IGNORED run.peek.gated run.peek.gated run.peek.loaded-words
# Run-bound faults (plan 04-07, D-07), one site each in core/src/machine/machine_bound.c (the run
# loop must neither run past its target range, stop short of the target nor step a faulted CPU).
# RUN_TARGET_UNCHECKED: the OUT_OF_RANGE stage is skipped; the refusal case tries the targets on a
# FAULTED CPU first, so the run ends at once with IVS_OK (never a run toward 2^64). From plan
# 04-10 the precedence case range-over-capacity (target above 2^63 with an undersized buffer)
# then reaches BUFFER_TOO_SMALL instead of OUT_OF_RANGE.
RUN_TARGET_UNCHECKED run.refuse.target-above-2-63 run.refuse.target-above-2-63|run.prec.range-over-capacity run.stop-name.known
# RUN_STOP_BEFORE_OVERSHOOT: a unit that would end past the target is taken back (CPU and time),
# so the run stops at the last boundary below the target. Collateral by the same rule: every case
# whose target lies inside a unit (overshoot window, run(now + 1), the idle target h + 41, and the
# positive controls of report-inside-instance and tail-nonzero that expect now >= 1000) and, from
# plan 04-09, the slicing family run.slice.* (its per-call oracle ends at the first boundary at or
# after each target); from plan 04-10 the accepted buffer runs run.buffers.* (they expect
# now >= target); from plan 04-11 the input family run.input.* (its calls end at the first
# boundary at or after targets inside units); from plan 04-13 the seeded fuzz run.fuzz.* (its
# reference expects one unit per run(now + 1) call); from plan 04-14 the boot stub family
# run.stub.* (one unit per run(now + 1) call from reset).
# From plan 04-16 the slicing replay of the real diagnostic (run.diag.slice) sees this fault, the
# budget carry and the static input carry too (the input cases run before it, so the carried words
# differ between its replay and its reference).
RUN_STOP_BEFORE_OVERSHOOT run.target.ends-at-first-boundary-ge-target run.target.|run.overshoot.|run.single-step.|run.stop.halt-no-flag|run.refuse.report-inside-instance|run.refuse.tail-nonzero|run.slice.|run.buffers.|run.input.|run.fuzz.|run.stub.|run.diag. run.stop-name.known
# RUN_FAULT_STEPS: a FAULTED CPU is stepped (a zero-progress unit, counted) and the stop order
# tests the target before the fault, so a fault on the target boundary reports TARGET and later
# calls execute a unit. Collateral: every guest-fault stop case and the 2^63 boundary on a
# faulted CPU (an extra unit); from plan 04-09 the slicing family's fault program (run.slice.,
# its calls after the fault boundary must run nothing and stop GUEST_FAULT).
RUN_FAULT_STEPS run.stop.fault-sticky run.stop.|run.target.max-accepted|run.slice. run.cpu-state.off
# Slicing and info-growth faults (plan 04-09, D-07, A-02).
# RUN_BUDGET_CARRY (core/src/machine/machine_bound.c): a file-scope carry of the last call's
# overshoot is taken off the next call's target when that call continues the same handle from
# where the last one ended, so a sliced run ends at other boundaries than one call. Collateral by
# the same rule: every case that slices one run over consecutive calls (target windows, the
# overshoot sequence, run(now + 1) single steps; from plan 04-10 the buffer cases that run twice
# on one instance, run.buffers.*; from plan 04-11 the input cases, run.input.*; from plan 04-13
# the seeded slicing fuzz, run.fuzz.*; from plan 04-14 the boot stub family, run.stub.*, whose
# run(now + 1) calls continue one handle).
RUN_BUDGET_CARRY run.slice.halt.fixed-7 run.slice.|run.target.|run.overshoot.|run.single-step.|run.buffers.|run.input.|run.fuzz.|run.stub.|run.diag. run.info.timebase
# INFO_TAIL_UNGUARDED (core/src/machine/machine.c): info writes the whole grown ivs_info whatever
# the caller's struct_size, past a v1-sized caller's struct.
INFO_TAIL_UNGUARDED run.info.v1-size-caller run.info.v1-size-caller run.info.timebase
# Output-buffer faults (plan 04-10, D-06, D-07), one site each in core/src/machine/machine_bound.c.
# RUN_CAPACITY_AFTER_STEP: the BUFFER_TOO_SMALL check runs after the first unit, so an undersized
# buffer is refused with a unit already executed (the storage and digests changed). From plan
# 04-11 the precedence case capacity-over-event-order then sees the per-event refusal instead.
RUN_CAPACITY_AFTER_STEP run.buffers.too-small-video run.buffers.|run.prec.capacity-over-event-order run.buffers.real-layout-zero
# OUTBUF_PARTIAL_WRITE: a refused run writes one byte into the caller's video buffer (from plan
# 04-11 also seen by the input refusal that checks its buffer arena, run.input.refuse.*).
OUTBUF_PARTIAL_WRITE run.buffers.video-audio-overlap run.buffers.|run.prec.|run.input.refuse. run.buffers.exact-fit-video
# Input faults (plan 04-11, D-05, D-07, D-14, D-16): sites in core/src/machine/machine_bound.c
# (INPUT_APPLY_AT_RUN_START, RUN_EVENTS_UNCHECKED) and core/src/machine/machine_input.c (the
# other four). Collateral stays inside the input family (run.input.*) and its precedence cases;
# from plan 04-13 the seeded slicing fuzz (run.fuzz.*, random schedules and slicings against a
# unit-by-unit reference) also sees the four timing faults and INPUT_STATIC_CARRY (its reference
# and sliced instances run one after the other, so a carried static leaks into the second).
# INPUT_APPLY_AT_RUN_START: every event with at_tick below the target is applied once at call
# start, so a call whose target lies past an event's tick inside the last unit consumes it.
INPUT_APPLY_AT_RUN_START run.input.one-event run.input.|run.fuzz. run.target.ends-at-first-boundary-ge-target
# INPUT_LOG_SLICE_RELATIVE_TICK: the chain records at_tick minus the call's entry time, so sliced
# runs differ from one call (and the literal chains differ).
INPUT_LOG_SLICE_RELATIVE_TICK run.input.overshoot-window run.input.|run.fuzz. run.slice.halt.fixed-7
# INPUT_NO_FLOOR_CHECK: an event below the input floor is accepted.
INPUT_NO_FLOOR_CHECK run.input.refuse.below-floor run.input.refuse. run.slice.halt.fixed-7
# INPUT_STATIC_CARRY: a file-scope copy of the last applied words becomes the words in force of
# whichever instance begins a unit next.
INPUT_STATIC_CARRY run.input.isolation run.input.|run.fuzz.|run.diag.slice run.slice.halt.fixed-7
# RUN_EVENT_AT_TARGET_ONLY: an event applies only at a unit starting exactly at its at_tick.
RUN_EVENT_AT_TARGET_ONLY run.input.one-event run.input.|run.fuzz. run.target.ends-at-first-boundary-ge-target
# RUN_EVENTS_UNCHECKED: the event span overlap test (instance, report, buffers) is skipped.
RUN_EVENTS_UNCHECKED run.input.refuse.events-inside-instance run.input.refuse. run.buffers.inside-instance
