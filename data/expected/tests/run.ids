# Family struct (plan 05-02, D-19, A-02, A-04): the pinned v1 minimums of the grown run request (v2
# appends psg_log and psg_log_capacity) and run report (v2 appends audio_first_index,
# psg_log_bytes_written, psg_log_first_index): a v1-sized caller in a poisoned larger buffer runs as
# the v2-sized form and no byte past its size is written; the appended fields' offsets; the tail rule
# rebased on the core's own size; one byte below either v1 minimum refused.
run.struct.request-v1-caller
run.struct.report-v1-caller
run.struct.request-v2-fields skip-ok
run.struct.report-v2-fields
run.struct.tail-nonzero
# Frozen v1 sizes (plan 04-13, A-02, Pitfall 13): offsetof and sizeof literals of the pointer-free
# structs and request prefix; the pointer-bearing request size is checked only with 64-bit pointers.
run.struct.v1-sizes
run.struct.v1-sizes-lp64 skip-ok
# Family stub (plan 04-14, D-28..D-30): the project boot stub (a hand-assembled listing packed by
# tools/pack into the build tree) with a 2048-byte zero GROM, from a power-on reset through the
# public API: R7 at unit starts 1000, 1010, 1011, 1013, 5000.
run.stub.path
# Trap (plan 04-14, D-29): one INTR pulse at 5000 enters 1004, writes [035F] = 1 and halts at 100A;
# halt-needs-follower shows HLT stopping only after its TSTR R0 follower, and with the follower
# patched to a zero word the CPU runs on to 1013 (zero fill is not a trap).
run.stub.trap
run.stub.halt-needs-follower
# Family diag (plan 04-16, D-27, D-31, RUN-06): ivs-diag-cpu-1 behind the boot stub from a
# power-on reset; one run with STOP_ON_HALT to a 4000-CPU-cycle bound stops CPU_HALTED and meets
# the hand-derived predicate read from data/golden/diag-cpu-1.expect (halted, R0-R6, ten words).
run.diag.predicate
# Slice (D-07 on the real program): the five slicing patterns of family slice against a
# unit-by-unit reference, CPU digest per call boundary, all domain digests and storage at the
# sampled ends. Repeat: two fresh instances (different storage poison) give the same stop report
# and equal composite and domain digests.
run.diag.slice
run.diag.repeat
