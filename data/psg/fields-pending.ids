# Profile fields that a rule of data/psg/rules.json names and that a later plan adds (plan 05-04, D-07, D-12).
# One line per field: `<profile field path> <owning plan>`. The psg-vectors step requires every `fields` path of a rule
# to be a line of data/expected/profile-fields.ids or a line here (token psg-rule-field-missing), and a line here whose
# field is already in the profile inventory is stale (token psg-field-pending-stale): the plan that adds a field deletes
# its line in the same commit. Plan 05-07 leaves this file with no line.
psg.clocks_per_step 05-06
psg.sample_period_ticks 05-06
psg.counter_model 05-06
psg.period_zero.tone 05-06
psg.mixer.bits 05-06
psg.amp.env_select 05-06
psg.reset 05-06
psg.clock_phase_ticks 05-06
psg.write_strobe_ticks 05-06
psg.period_zero.noise 05-07
psg.period_zero.envelope 05-07
psg.noise.steps_per_np 05-07
psg.noise.lfsr 05-07
psg.envelope.steps_per_ep 05-07
psg.envelope.shape_bits 05-07
psg.dac.levels 05-07
